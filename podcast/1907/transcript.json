[
  {
    "start": 0.0,
    "end": 1.98,
    "text": "为什么同一场期中考试"
  },
  {
    "start": 1.98,
    "end": 3.24,
    "text": "不改最终等级"
  },
  {
    "start": 3.24,
    "end": 4.56,
    "text": "只把总分提高"
  },
  {
    "start": 4.56,
    "end": 5.62,
    "text": "学生的态度"
  },
  {
    "start": 5.62,
    "end": 7.56,
    "text": "就会从愤怒变成开心"
  },
  {
    "start": 7.56,
    "end": 10.46,
    "text": "要解开这个"
  },
  {
    "start": 10.46,
    "end": 12.32,
    "text": "让人有点啼笑皆非的谜团"
  },
  {
    "start": 12.32,
    "end": 14.34,
    "text": "咱们得翻翻错误的行为"
  },
  {
    "start": 14.34,
    "end": 16.28,
    "text": "这本书里记录的一个真实场景"
  },
  {
    "start": 16.28,
    "end": 18.78,
    "text": "就是理查德泰勒教授"
  },
  {
    "start": 18.78,
    "end": 20.12,
    "text": "刚当老师那会儿"
  },
  {
    "start": 20.12,
    "end": 21.84,
    "text": "他给学生出了一份期中卷子"
  },
  {
    "start": 21.84,
    "end": 23.44,
    "text": "总分设定为100分"
  },
  {
    "start": 23.44,
    "end": 24.84,
    "text": "结果你猜怎么着"
  },
  {
    "start": 24.84,
    "end": 27.06,
    "text": "全班平均分只有72分"
  },
  {
    "start": 27.06,
    "end": 28.3,
    "text": "哇"
  },
  {
    "start": 28.3,
    "end": 29.88,
    "text": "那学生肯定炸锅了吧"
  },
  {
    "start": 29.88,
    "end": 31.82,
    "text": "觉得老师故意刁难人"
  },
  {
    "start": 31.82,
    "end": 32.82,
    "text": "对"
  },
  {
    "start": 32.82,
    "end": 34.82,
    "text": "学生极其愤怒"
  },
  {
    "start": 34.82,
    "end": 36.0,
    "text": "因为按学校惯例"
  },
  {
    "start": 36.0,
    "end": 37.56,
    "text": "这个分数对应的最终评级"
  },
  {
    "start": 37.56,
    "end": 38.66,
    "text": "其实完全不受影响"
  },
  {
    "start": 38.66,
    "end": 40.98,
    "text": "但他还是被学生的怒火给淹没了"
  },
  {
    "start": 40.98,
    "end": 43.2,
    "text": "所以到了下一次考试"
  },
  {
    "start": 43.2,
    "end": 44.84,
    "text": "泰勒教授就学聪明了"
  },
  {
    "start": 44.84,
    "end": 46.14,
    "text": "他悄悄做了个调整"
  },
  {
    "start": 46.14,
    "end": 48.84,
    "text": "也就是把总分给改了"
  },
  {
    "start": 48.84,
    "end": 49.46,
    "text": "没错"
  },
  {
    "start": 49.46,
    "end": 52.04,
    "text": "他把总分改成了137分"
  },
  {
    "start": 52.04,
    "end": 53.48,
    "text": "这次的诗卷"
  },
  {
    "start": 53.48,
    "end": 55.12,
    "text": "其实反而稍微变难了一些"
  },
  {
    "start": 55.12,
    "end": 57.12,
    "text": "学生们大概只能答对大部分题"
  },
  {
    "start": 57.12,
    "end": 59.04,
    "text": "但最终算下来的平均分"
  },
  {
    "start": 59.04,
    "end": 60.38,
    "text": "达到了96分"
  },
  {
    "start": 60.38,
    "end": 62.72,
    "text": "结果学生们变得十分开心"
  },
  {
    "start": 62.72,
    "end": 63.86,
    "text": "等一下"
  },
  {
    "start": 63.86,
    "end": 65.66,
    "text": "这完全不符合常理啊"
  },
  {
    "start": 65.66,
    "end": 66.72,
    "text": "你想啊"
  },
  {
    "start": 66.72,
    "end": 69.04,
    "text": "把分数换算回常规的百分之"
  },
  {
    "start": 69.04,
    "end": 71.18,
    "text": "其实也就是70分出头"
  },
  {
    "start": 71.18,
    "end": 73.02,
    "text": "甚至比第一次考试的得分"
  },
  {
    "start": 73.02,
    "end": 73.92,
    "text": "还要低一点点"
  },
  {
    "start": 73.92,
    "end": 77.02,
    "text": "既然最终拿A还是拿B的等级算法"
  },
  {
    "start": 77.02,
    "end": 77.7,
    "text": "完全没变"
  },
  {
    "start": 77.7,
    "end": 79.96,
    "text": "为什么大家的反应会完全不同"
  },
  {
    "start": 79.96,
    "end": 82.6,
    "text": "这个问题特别合心"
  },
  {
    "start": 82.6,
    "end": 84.1,
    "text": "他其实向你揭示了"
  },
  {
    "start": 84.1,
    "end": 85.98,
    "text": "传统经济学的一个巨大漏洞"
  },
  {
    "start": 85.98,
    "end": 86.58,
    "text": "你看"
  },
  {
    "start": 86.58,
    "end": 88.02,
    "text": "传统模型总是假设"
  },
  {
    "start": 88.02,
    "end": 89.58,
    "text": "你我是完全理性的"
  },
  {
    "start": 89.58,
    "end": 90.92,
    "text": "也就是所谓的经济人"
  },
  {
    "start": 90.92,
    "end": 92.88,
    "text": "脑子就像一台精密的计算器"
  },
  {
    "start": 92.88,
    "end": 95.64,
    "text": "但现实是我们根本不是那样"
  },
  {
    "start": 95.64,
    "end": 96.76,
    "text": "对"
  },
  {
    "start": 96.76,
    "end": 97.6,
    "text": "现实中"
  },
  {
    "start": 97.6,
    "end": 99.3,
    "text": "我们都是普通的真实人"
  },
  {
    "start": 99.3,
    "end": 101.2,
    "text": "普通人就是会被表面上"
  },
  {
    "start": 101.2,
    "end": 102.82,
    "text": "看起来的高分给哄得很开心"
  },
  {
    "start": 102.82,
    "end": 104.58,
    "text": "哪怕背后的比例根本没变"
  },
  {
    "start": 104.58,
    "end": 106.04,
    "text": "可是我记得"
  },
  {
    "start": 106.04,
    "end": 109.92,
    "text": "传统经济学家总是喜欢用那个似乎的理论来反驳"
  },
  {
    "start": 109.92,
    "end": 112.7,
    "text": "比如用职业台球选手的类比"
  },
  {
    "start": 112.7,
    "end": 116.72,
    "text": "说人们即使不懂那些复杂的物理和几何公式"
  },
  {
    "start": 116.72,
    "end": 120.38,
    "text": "行动起来也似乎能做出最优化选择"
  },
  {
    "start": 120.38,
    "end": 120.7,
    "text": "是的"
  },
  {
    "start": 120.7,
    "end": 123.94,
    "text": "这个似乎理论听着很有道理"
  },
  {
    "start": 123.94,
    "end": 125.6,
    "text": "但泰勒直接指出了他的破绽"
  },
  {
    "start": 125.6,
    "end": 129.44,
    "text": "经济学理论应该适用于包括你在内的所有人"
  },
  {
    "start": 129.44,
    "end": 129.74,
    "text": "对吧"
  },
  {
    "start": 129.74,
    "end": 130.72,
    "text": "你想想"
  },
  {
    "start": 130.72,
    "end": 132.24,
    "text": "现实里的业余玩家"
  },
  {
    "start": 132.24,
    "end": 134.34,
    "text": "往往连最简单的球都打不进"
  },
  {
    "start": 134.34,
    "end": 136.7,
    "text": "面对客观上更优的选项"
  },
  {
    "start": 136.7,
    "end": 138.24,
    "text": "人们依然会选错"
  },
  {
    "start": 138.24,
    "end": 139.3,
    "text": "也就是说"
  },
  {
    "start": 139.3,
    "end": 141.66,
    "text": "这绝不是什么似乎作对了"
  },
  {
    "start": 141.66,
    "end": 143.96,
    "text": "我们就是会实打实的犯错"
  },
  {
    "start": 143.96,
    "end": 144.82,
    "text": "确实如此"
  },
  {
    "start": 144.82,
    "end": 147.76,
    "text": "既然我们不是时刻保持理性的经纪人"
  },
  {
    "start": 147.76,
    "end": 149.86,
    "text": "那我们在日常花钱的时候"
  },
  {
    "start": 149.86,
    "end": 152.96,
    "text": "脑子里到底遵循这什么奇怪的逻辑"
  },
  {
    "start": 152.96,
    "end": 154.98,
    "text": "这就不得不提我们的心理账户了"
  },
  {
    "start": 154.98,
    "end": 157.36,
    "text": "设想你现在要去买一床双人被"
  },
  {
    "start": 157.36,
    "end": 159.34,
    "text": "这是个特别经典的例子"
  },
  {
    "start": 159.34,
    "end": 159.56,
    "text": "对"
  },
  {
    "start": 159.56,
    "end": 162.32,
    "text": "假设超大马豪华款标价300美元"
  },
  {
    "start": 162.32,
    "end": 164.0,
    "text": "豪华款250美元"
  },
  {
    "start": 164.0,
    "end": 165.52,
    "text": "普通款200美元"
  },
  {
    "start": 165.52,
    "end": 167.64,
    "text": "感小现在遇上现实特价"
  },
  {
    "start": 167.64,
    "end": 169.96,
    "text": "所有尺码都只卖150美元"
  },
  {
    "start": 169.96,
    "end": 171.16,
    "text": "你会怎么选"
  },
  {
    "start": 171.16,
    "end": 173.78,
    "text": "绝大多数人都会直接买下最大的那一床"
  },
  {
    "start": 173.78,
    "end": 174.26,
    "text": "没错"
  },
  {
    "start": 174.26,
    "end": 176.66,
    "text": "你大概率会像书里的玛雅一样"
  },
  {
    "start": 176.66,
    "end": 178.2,
    "text": "直接挑最大的买"
  },
  {
    "start": 178.2,
    "end": 180.0,
    "text": "但为什么要这么干呢"
  },
  {
    "start": 180.0,
    "end": 183.34,
    "text": "这就需要带领你去理解背后的交易效用了"
  },
  {
    "start": 183.34,
    "end": 183.94,
    "text": "你看"
  },
  {
    "start": 183.94,
    "end": 187.26,
    "text": "经济学家看中的是商铺本身的实际价值"
  },
  {
    "start": 187.26,
    "end": 190.04,
    "text": "也就是这双被子对你实不实用"
  },
  {
    "start": 190.04,
    "end": 195.82,
    "text": "但咱们普通人看中的是实际支付价格和参考价格之间的差额"
  },
  {
    "start": 195.82,
    "end": 196.8,
    "text": "我懂了"
  },
  {
    "start": 196.8,
    "end": 200.44,
    "text": "就是买超大马被子让我觉得占了最大的便宜"
  },
  {
    "start": 200.44,
    "end": 200.78,
    "text": "没错"
  },
  {
    "start": 200.78,
    "end": 202.62,
    "text": "你觉得省下的差价最多"
  },
  {
    "start": 202.62,
    "end": 205.32,
    "text": "这就是正向的交易效用"
  },
  {
    "start": 205.32,
    "end": 207.14,
    "text": "这种占便宜带来的快感"
  },
  {
    "start": 207.14,
    "end": 210.92,
    "text": "直接盖过了你其实根本不需要那么大被子的事实"
  },
  {
    "start": 210.92,
    "end": 213.94,
    "text": "这就完全解释了那个经典的沙滩啤酒调查"
  },
  {
    "start": 213.94,
    "end": 216.14,
    "text": "想象你正躺在沙滩上"
  },
  {
    "start": 216.14,
    "end": 217.34,
    "text": "特别想喝啤酒"
  },
  {
    "start": 217.34,
    "end": 219.72,
    "text": "如果是去高档度假酒店买"
  },
  {
    "start": 219.72,
    "end": 223.2,
    "text": "大家愿意支付的现金中位数是7.25美元"
  },
  {
    "start": 223.2,
    "end": 226.38,
    "text": "但如果是去又小又破的杂货店"
  },
  {
    "start": 226.38,
    "end": 228.62,
    "text": "大家只愿意付4.10美元"
  },
  {
    "start": 228.62,
    "end": 230.74,
    "text": "明明是同一种啤酒"
  },
  {
    "start": 230.74,
    "end": 232.42,
    "text": "你在同一个沙滩上喝"
  },
  {
    "start": 232.42,
    "end": 234.18,
    "text": "解渴的程度完全一样"
  },
  {
    "start": 234.18,
    "end": 235.84,
    "text": "为什么心理价位差这么多"
  },
  {
    "start": 235.84,
    "end": 238.26,
    "text": "因为你的心理预期完全不同"
  },
  {
    "start": 238.26,
    "end": 239.72,
    "text": "高档酒店卖的贵"
  },
  {
    "start": 239.72,
    "end": 241.6,
    "text": "这是在你预料之中的对吧"
  },
  {
    "start": 241.6,
    "end": 243.12,
    "text": "对因为它本来就该贵"
  },
  {
    "start": 243.12,
    "end": 246.22,
    "text": "但是如果那个破杂货店要是敢开高价"
  },
  {
    "start": 246.22,
    "end": 247.94,
    "text": "就会立刻激怒你"
  },
  {
    "start": 247.94,
    "end": 250.96,
    "text": "这种对参考价格的执念特别有意思"
  },
  {
    "start": 250.96,
    "end": 253.9,
    "text": "它不仅会让你对合理的价格感到愤怒"
  },
  {
    "start": 253.9,
    "end": 256.58,
    "text": "还会引诱你买下根本不需要的东西"
  },
  {
    "start": 256.58,
    "end": 259.94,
    "text": "哇连商家都会被这种执念给绕进去吧"
  },
  {
    "start": 259.94,
    "end": 261.72,
    "text": "比如某家百货公司"
  },
  {
    "start": 261.72,
    "end": 264.18,
    "text": "仅仅因为减少了30%的优惠券"
  },
  {
    "start": 264.18,
    "end": 266.24,
    "text": "想要搞天天平价"
  },
  {
    "start": 266.24,
    "end": 267.88,
    "text": "哎结果销售额助降"
  },
  {
    "start": 267.88,
    "end": 270.14,
    "text": "对最后不得不赶紧恢复"
  },
  {
    "start": 270.14,
    "end": 272.76,
    "text": "因为顾客一旦失去了参考价格"
  },
  {
    "start": 272.76,
    "end": 275.66,
    "text": "就感受不到那种占商家便宜的快感了"
  },
  {
    "start": 275.66,
    "end": 278.68,
    "text": "也就是交易效用一直在诱惑我们掏钱"
  },
  {
    "start": 278.68,
    "end": 280.6,
    "text": "但是买完之后呢"
  },
  {
    "start": 280.6,
    "end": 283.14,
    "text": "比如一家滑雪厂推出了14套票"
  },
  {
    "start": 283.14,
    "end": 285.44,
    "text": "比零售票便宜了40%"
  },
  {
    "start": 285.44,
    "end": 288.3,
    "text": "这在当下看绝对是很划算的"
  },
  {
    "start": 288.3,
    "end": 290.32,
    "text": "买的时候确实觉得赚到了"
  },
  {
    "start": 290.32,
    "end": 292.26,
    "text": "但经过三年的记录分析"
  },
  {
    "start": 292.26,
    "end": 293.16,
    "text": "你猜怎么着"
  },
  {
    "start": 293.16,
    "end": 293.74,
    "text": "怎么了"
  },
  {
    "start": 293.74,
    "end": 297.0,
    "text": "发现其实只有60%的套票真正被使用"
  },
  {
    "start": 297.0,
    "end": 299.32,
    "text": "剩下一大半全白白作废了"
  },
  {
    "start": 299.32,
    "end": 300.72,
    "text": "这不就亏大了吗"
  },
  {
    "start": 300.72,
    "end": 302.4,
    "text": "既然买的时候觉得划算"
  },
  {
    "start": 302.4,
    "end": 303.58,
    "text": "后来为什么不去了"
  },
  {
    "start": 303.58,
    "end": 306.2,
    "text": "这就引出了沉默成本的概念吧"
  },
  {
    "start": 306.2,
    "end": 306.78,
    "text": "没错"
  },
  {
    "start": 306.78,
    "end": 308.46,
    "text": "人们在预付了钱之后"
  },
  {
    "start": 308.46,
    "end": 309.6,
    "text": "随着时间推移"
  },
  {
    "start": 309.6,
    "end": 311.66,
    "text": "当初那种划算的交易效用感"
  },
  {
    "start": 311.66,
    "end": 312.86,
    "text": "会慢慢消退"
  },
  {
    "start": 312.86,
    "end": 314.0,
    "text": "然后去滑雪"
  },
  {
    "start": 314.0,
    "end": 317.7,
    "text": "就变成了一项为了平障而不得不做的苦差事"
  },
  {
    "start": 317.7,
    "end": 319.32,
    "text": "最后动力没了"
  },
  {
    "start": 319.32,
    "end": 320.52,
    "text": "票也就烂在手里了"
  },
  {
    "start": 320.52,
    "end": 322.12,
    "text": "但这里我想反驳一下"
  },
  {
    "start": 322.12,
    "end": 325.2,
    "text": "如果把听众放到真实的自由市场里"
  },
  {
    "start": 325.2,
    "end": 326.82,
    "text": "有充分的学习机会"
  },
  {
    "start": 326.82,
    "end": 328.28,
    "text": "这些奇怪的行为"
  },
  {
    "start": 328.28,
    "end": 331.5,
    "text": "会不会像传统经济学家预测的那样自动消失"
  },
  {
    "start": 331.5,
    "end": 333.82,
    "text": "大家吃过亏总该变聪明了吧"
  },
  {
    "start": 333.82,
    "end": 334.84,
    "text": "并没有"
  },
  {
    "start": 334.84,
    "end": 336.46,
    "text": "为了回应这种质疑"
  },
  {
    "start": 336.46,
    "end": 338.3,
    "text": "泰勒在康奈尔大学的本科班"
  },
  {
    "start": 338.3,
    "end": 340.5,
    "text": "专门做了一个马克杯实验"
  },
  {
    "start": 340.5,
    "end": 342.02,
    "text": "赶紧给我们讲讲这个实验"
  },
  {
    "start": 342.02,
    "end": 343.52,
    "text": "他用了44名学生"
  },
  {
    "start": 343.52,
    "end": 345.94,
    "text": "先发下22个代币进行练习"
  },
  {
    "start": 345.94,
    "end": 349.0,
    "text": "这一步是为了证明市场运转机制没问题"
  },
  {
    "start": 349.0,
    "end": 350.6,
    "text": "大家都懂怎么交易"
  },
  {
    "start": 350.6,
    "end": 353.0,
    "text": "排除了大家不懂规则的因素"
  },
  {
    "start": 353.0,
    "end": 355.88,
    "text": "接下来他换成了真实的校园商品"
  },
  {
    "start": 355.88,
    "end": 359.44,
    "text": "就是应有校辉价值6美元的马克杯"
  },
  {
    "start": 359.44,
    "end": 362.68,
    "text": "以及标价3.98美元的圆珠笔"
  },
  {
    "start": 362.68,
    "end": 364.34,
    "text": "一半人拿到杯子"
  },
  {
    "start": 364.34,
    "end": 365.34,
    "text": "一半人拿到笔"
  },
  {
    "start": 365.34,
    "end": 367.28,
    "text": "都是很日常的东西"
  },
  {
    "start": 367.28,
    "end": 367.8,
    "text": "对"
  },
  {
    "start": 367.8,
    "end": 369.94,
    "text": "为了给学生充分的学习机会"
  },
  {
    "start": 369.94,
    "end": 371.94,
    "text": "实验足足进行了四次"
  },
  {
    "start": 371.94,
    "end": 372.92,
    "text": "按理说"
  },
  {
    "start": 372.92,
    "end": 376.14,
    "text": "想要杯子的人和想要笔的人会互相交易"
  },
  {
    "start": 376.14,
    "end": 376.84,
    "text": "对吧"
  },
  {
    "start": 376.84,
    "end": 377.46,
    "text": "结果呢"
  },
  {
    "start": 377.46,
    "end": 379.14,
    "text": "真实的交易量应该很高吧"
  },
  {
    "start": 379.14,
    "end": 380.48,
    "text": "结果令人震惊"
  },
  {
    "start": 380.48,
    "end": 383.46,
    "text": "真实的交易量依然极其惨淡"
  },
  {
    "start": 383.46,
    "end": 385.54,
    "text": "大家就是死活不愿意换"
  },
  {
    "start": 385.54,
    "end": 386.34,
    "text": "为什么"
  },
  {
    "start": 386.34,
    "end": 388.32,
    "text": "因为禀赋效应啊"
  },
  {
    "start": 388.32,
    "end": 390.18,
    "text": "一旦你拥有了某样东西"
  },
  {
    "start": 390.18,
    "end": 392.36,
    "text": "你对它的估值就会立刻飙升"
  },
  {
    "start": 392.36,
    "end": 394.82,
    "text": "你根本不愿意按市场价换出去"
  },
  {
    "start": 394.82,
    "end": 395.54,
    "text": "哇"
  },
  {
    "start": 395.54,
    "end": 397.24,
    "text": "也就是我拿着这个杯子"
  },
  {
    "start": 397.24,
    "end": 398.96,
    "text": "我觉得它比实际价格贵得多"
  },
  {
    "start": 398.96,
    "end": 400.62,
    "text": "谁来买我都觉得亏"
  },
  {
    "start": 400.62,
    "end": 401.46,
    "text": "哎"
  },
  {
    "start": 401.46,
    "end": 404.38,
    "text": "既然你现在已经知道了这些思维陷阱"
  },
  {
    "start": 404.38,
    "end": 406.14,
    "text": "也知道我们总是不理性"
  },
  {
    "start": 406.14,
    "end": 409.02,
    "text": "为什么你不能干脆靠意志力去克服他们"
  },
  {
    "start": 409.02,
    "end": 410.86,
    "text": "为什么自我控制这么难"
  },
  {
    "start": 410.86,
    "end": 412.94,
    "text": "这个机制就更有趣了"
  },
  {
    "start": 412.94,
    "end": 415.06,
    "text": "它能帮你拆解自我"
  },
  {
    "start": 415.06,
    "end": 419.22,
    "text": "泰勒将人类的内部分为两个相互牵制的角色"
  },
  {
    "start": 419.22,
    "end": 420.5,
    "text": "一个是计划者"
  },
  {
    "start": 420.5,
    "end": 421.64,
    "text": "另一个是行动者"
  },
  {
    "start": 421.64,
    "end": 423.92,
    "text": "就是我们脑子里有两个小人在打架"
  },
  {
    "start": 423.92,
    "end": 424.44,
    "text": "哎"
  },
  {
    "start": 424.44,
    "end": 424.84,
    "text": "差不多"
  },
  {
    "start": 424.84,
    "end": 427.76,
    "text": "计划者希望着眼长远"
  },
  {
    "start": 427.76,
    "end": 429.08,
    "text": "比如存钱啊"
  },
  {
    "start": 429.08,
    "end": 430.34,
    "text": "保持健康啊"
  },
  {
    "start": 430.34,
    "end": 431.3,
    "text": "而行动者呢"
  },
  {
    "start": 431.3,
    "end": 433.86,
    "text": "只在乎当下的诱惑和短期的快感"
  },
  {
    "start": 433.86,
    "end": 437.3,
    "text": "就像你的计划者设定了完美的存钱计划"
  },
  {
    "start": 437.3,
    "end": 440.24,
    "text": "但你的行动者转头就拿去清空了购物车"
  },
  {
    "start": 440.24,
    "end": 441.76,
    "text": "如果是这样"
  },
  {
    "start": 441.76,
    "end": 444.48,
    "text": "那单纯死磕意志力肯定是没用的"
  },
  {
    "start": 444.48,
    "end": 445.12,
    "text": "正是如此"
  },
  {
    "start": 445.12,
    "end": 446.6,
    "text": "所以书里强调"
  },
  {
    "start": 446.6,
    "end": 449.5,
    "text": "千万不要把这些行为当成心理疾病"
  },
  {
    "start": 449.5,
    "end": 451.74,
    "text": "而是要认识到这是人类常态"
  },
  {
    "start": 451.74,
    "end": 453.38,
    "text": "那既然是常态"
  },
  {
    "start": 453.38,
    "end": 455.26,
    "text": "想要破局总得有个招吧"
  },
  {
    "start": 455.26,
    "end": 457.38,
    "text": "必须使用承诺策略"
  },
  {
    "start": 457.38,
    "end": 458.56,
    "text": "意思就是说"
  },
  {
    "start": 458.56,
    "end": 460.72,
    "text": "你得预先制定刚性规则"
  },
  {
    "start": 460.72,
    "end": 462.3,
    "text": "在行动者捣乱之前"
  },
  {
    "start": 462.3,
    "end": 465.6,
    "text": "就把计划者的理性选择给死死锁定住"
  },
  {
    "start": 465.6,
    "end": 467.9,
    "text": "就是不要给行动者发挥的空间"
  },
  {
    "start": 467.9,
    "end": 470.48,
    "text": "不过这种内在的冲动"
  },
  {
    "start": 470.48,
    "end": 472.34,
    "text": "不仅影响我们自我控制"
  },
  {
    "start": 472.34,
    "end": 474.7,
    "text": "还会影响我们如何看待外界吧"
  },
  {
    "start": 474.7,
    "end": 477.06,
    "text": "比如当企业涨价时"
  },
  {
    "start": 477.06,
    "end": 479.66,
    "text": "你的行动者是不是立刻感到愤怒"
  },
  {
    "start": 479.66,
    "end": 480.3,
    "text": "是的"
  },
  {
    "start": 480.3,
    "end": 483.38,
    "text": "我们在安大略省和英属哥伦比亚省"
  },
  {
    "start": 483.38,
    "end": 484.5,
    "text": "进行的电话调查"
  },
  {
    "start": 484.5,
    "end": 485.62,
    "text": "就印证了这一点"
  },
  {
    "start": 485.62,
    "end": 487.8,
    "text": "普通人对什么是公平"
  },
  {
    "start": 487.8,
    "end": 489.02,
    "text": "什么是不公平"
  },
  {
    "start": 489.02,
    "end": 490.84,
    "text": "有着极度敏感的界限"
  },
  {
    "start": 490.84,
    "end": 493.26,
    "text": "只要打破了心理上的参考价格"
  },
  {
    "start": 493.26,
    "end": 495.06,
    "text": "就算客观上是合理的"
  },
  {
    "start": 495.06,
    "end": 496.8,
    "text": "大家依然会觉得被占了便宜"
  },
  {
    "start": 496.8,
    "end": 497.88,
    "text": "觉得很不公平"
  },
  {
    "start": 497.88,
    "end": 498.52,
    "text": "对"
  },
  {
    "start": 498.52,
    "end": 500.8,
    "text": "这种情绪反应是非常强烈的"
  },
  {
    "start": 500.8,
    "end": 503.72,
    "text": "那这里我要抛出一个终极挑战了"
  },
  {
    "start": 503.72,
    "end": 507.6,
    "text": "普通消费者固然会被这种情感和认知偏差左右"
  },
  {
    "start": 507.6,
    "end": 510.06,
    "text": "但那些受过极高训练"
  },
  {
    "start": 510.06,
    "end": 512.16,
    "text": "面对极高利益的专业人士呢"
  },
  {
    "start": 512.16,
    "end": 514.22,
    "text": "比如华尔街的金融大额"
  },
  {
    "start": 514.22,
    "end": 516.18,
    "text": "他们总该是完美的经纪人了吧"
  },
  {
    "start": 516.18,
    "end": 519.48,
    "text": "这种不理智的行为在金融市场总该消失了"
  },
  {
    "start": 519.48,
    "end": 520.56,
    "text": "绝非如此"
  },
  {
    "start": 520.56,
    "end": 524.48,
    "text": "这就来到了本书高潮迭起的金融市场争论环节"
  },
  {
    "start": 524.48,
    "end": 525.3,
    "text": "你看"
  },
  {
    "start": 525.3,
    "end": 529.88,
    "text": "泰勒明确把能否跑赢大盘和价格是否合理分开了"
  },
  {
    "start": 529.88,
    "end": 532.32,
    "text": "就是能赚钱不代表定价合理"
  },
  {
    "start": 532.32,
    "end": 533.16,
    "text": "没错"
  },
  {
    "start": 533.16,
    "end": 537.12,
    "text": "从股市的过度反应到封闭式基金的折价"
  },
  {
    "start": 537.12,
    "end": 539.58,
    "text": "再到诸如帕尔姆与三康公司之间"
  },
  {
    "start": 539.58,
    "end": 541.54,
    "text": "那种极其荒谬的估值倒挂"
  },
  {
    "start": 541.54,
    "end": 544.78,
    "text": "那个倒挂是不是母公司的市值"
  },
  {
    "start": 544.78,
    "end": 547.04,
    "text": "比他持有的子公司股份还要低"
  },
  {
    "start": 547.04,
    "end": 547.76,
    "text": "是的"
  },
  {
    "start": 547.76,
    "end": 550.74,
    "text": "这简直违背了基本的数学逻辑"
  },
  {
    "start": 550.74,
    "end": 552.34,
    "text": "那传统金融学不是说"
  },
  {
    "start": 552.34,
    "end": 554.42,
    "text": "有人套利就能把价格拉回来吗"
  },
  {
    "start": 554.42,
    "end": 556.76,
    "text": "现实中套利极其困难"
  },
  {
    "start": 556.76,
    "end": 558.64,
    "text": "所以这些都在证明一点"
  },
  {
    "start": 558.64,
    "end": 561.54,
    "text": "一价定律在现实中经常失效"
  },
  {
    "start": 561.54,
    "end": 563.94,
    "text": "哇连华尔街精英都会犯错"
  },
  {
    "start": 563.94,
    "end": 566.48,
    "text": "就连职业专业球队选秀"
  },
  {
    "start": 566.48,
    "end": 568.98,
    "text": "或者高奖金电视节目里的专业参与者"
  },
  {
    "start": 568.98,
    "end": 570.8,
    "text": "也无法消除这些行为模式"
  },
  {
    "start": 570.8,
    "end": 573.14,
    "text": "人类总是被狭窄框架束缚"
  },
  {
    "start": 573.14,
    "end": 574.22,
    "text": "常常盲目乐观"
  },
  {
    "start": 574.22,
    "end": 574.86,
    "text": "对"
  },
  {
    "start": 574.86,
    "end": 577.14,
    "text": "没有人能完全逃离这些弱点"
  },
  {
    "start": 577.14,
    "end": 579.98,
    "text": "既然从普通消费者到华尔街精英"
  },
  {
    "start": 579.98,
    "end": 581.14,
    "text": "甚至是你我"
  },
  {
    "start": 581.14,
    "end": 583.42,
    "text": "全都不可避免的带有真实人的弱点"
  },
  {
    "start": 583.42,
    "end": 586.94,
    "text": "那我们该如何在一个充满诱惑的社会里生存"
  },
  {
    "start": 586.94,
    "end": 589.96,
    "text": "这就是泰勒想要带给世界的解药了"
  },
  {
    "start": 589.96,
    "end": 591.62,
    "text": "那就是助推计划"
  },
  {
    "start": 591.62,
    "end": 593.24,
    "text": "助推计划"
  },
  {
    "start": 593.24,
    "end": 594.32,
    "text": "怎么理解呢"
  },
  {
    "start": 594.32,
    "end": 596.78,
    "text": "既然我们总是被环境影响"
  },
  {
    "start": 596.78,
    "end": 598.98,
    "text": "那不如主动优化选择架构"
  },
  {
    "start": 598.98,
    "end": 601.02,
    "text": "实行自由家长主义"
  },
  {
    "start": 601.02,
    "end": 604.3,
    "text": "有没有什么具体的例子展示一下它的成效"
  },
  {
    "start": 604.3,
    "end": 605.38,
    "text": "比如说"
  },
  {
    "start": 605.38,
    "end": 607.68,
    "text": "在公共部门的一个催脚实验中"
  },
  {
    "start": 607.68,
    "end": 610.0,
    "text": "面对多达12万的纳税人"
  },
  {
    "start": 610.0,
    "end": 613.28,
    "text": "政府仅仅是改变了信件中的某些表述"
  },
  {
    "start": 613.28,
    "end": 615.12,
    "text": "加了句什么话"
  },
  {
    "start": 615.12,
    "end": 618.36,
    "text": "就只是加了一句暗示别人都已经交了的话"
  },
  {
    "start": 618.36,
    "end": 623.32,
    "text": "结果就让在23天内补缴的人数提高了超过5个百分点"
  },
  {
    "start": 623.32,
    "end": 624.2,
    "text": "哇"
  },
  {
    "start": 624.2,
    "end": 626.7,
    "text": "仅仅改革措辞效果就这么好"
  },
  {
    "start": 626.7,
    "end": 629.84,
    "text": "这就是默认选项的威力啊"
  },
  {
    "start": 629.84,
    "end": 631.22,
    "text": "不强迫你做决定"
  },
  {
    "start": 631.22,
    "end": 633.08,
    "text": "但通过聪明的制度设计"
  },
  {
    "start": 633.08,
    "end": 636.52,
    "text": "把那条对你最有利的路铺成阻力最小的路"
  },
  {
    "start": 636.52,
    "end": 637.46,
    "text": "没错"
  },
  {
    "start": 637.46,
    "end": 639.92,
    "text": "在不知不觉中帮你做对选择"
  },
  {
    "start": 639.92,
    "end": 643.12,
    "text": "当人们总是偏离完全理性假设时"
  },
  {
    "start": 643.12,
    "end": 646.44,
    "text": "制度设计怎样在不剥夺选择权的前提下"
  },
  {
    "start": 646.44,
    "end": 647.8,
    "text": "帮人少犯错"
  }
]
