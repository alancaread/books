  {
    "start": 447.9,
    "end": 449.16,
    "text": "听起来很有道理"
  },
  {
    "start": 449.16,
    "end": 449.74,
    "text": "但是"
  },
  {
    "start": 449.74,
    "end": 450.56,
    "text": "在这里"
  },
  {
    "start": 450.56,
    "end": 452.52,
    "text": "我必须代表理性的声音"
  },
  {
    "start": 452.52,
    "end": 455.02,
    "text": "再次进行关键的证据追问"
