  {
    "start": 546.58,
    "end": 547.44,
    "text": "为什么"
  },
  {
    "start": 547.44,
    "end": 549.3,
    "text": "数据总不会骗人吧"
  },
  {
    "start": 549.3,
    "end": 551.14,
    "text": "数据本身也许不骗人"
  },
  {
    "start": 551.14,
    "end": 552.9,
    "text": "但它有严重的滞后性"
  },
  {
    "start": 552.9,
    "end": 554.4,
    "text": "滞后性"
  },
  {
    "start": 554.4,
    "end": 558.12,
    "text": "笔记里探讨了美国和中国经济的同步指标"
