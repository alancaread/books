  {
    "start": 428.02,
    "end": 429.58,
    "text": "基本上可以这么理解"
  },
  {
    "start": 429.58,
    "end": 431.36,
    "text": "当换手率极快"
  },
  {
    "start": 431.36,
    "end": 433.6,
    "text": "而且无论向上还是向下的"
  },
  {
    "start": 433.6,
    "end": 435.12,
    "text": "这种极端回报率"
  },
  {
    "start": 435.12,
    "end": 438.26,
    "text": "在极短的时间窗口内密集出现的时候"
  },
  {
    "start": 438.26,
    "end": 439.36,
    "text": "也就是上上下跳"
