[
  {
    "start": 0.0,
    "end": 1.58,
    "text": "如果市场参与者的偏见"
  },
  {
    "start": 1.58,
    "end": 3.52,
    "text": "本身就会改变资产走势"
  },
  {
    "start": 3.52,
    "end": 5.8,
    "text": "均衡理论为什么还会失效"
  },
  {
    "start": 5.8,
    "end": 8.5,
    "text": "想象这么个场景"
  },
  {
    "start": 8.5,
    "end": 10.5,
    "text": "你觉得房间里有点热"
  },
  {
    "start": 10.5,
    "end": 12.06,
    "text": "然后你看了一眼"
  },
  {
    "start": 12.06,
    "end": 13.68,
    "text": "墙上的温度计来确认一下"
  },
  {
    "start": 13.68,
    "end": 15.44,
    "text": "很自然的反应吗"
  },
  {
    "start": 15.44,
    "end": 15.64,
    "text": "对"
  },
  {
    "start": 15.64,
    "end": 17.76,
    "text": "但诡异的事情发生了"
  },
  {
    "start": 17.76,
    "end": 20.02,
    "text": "仅仅是因为你看温度计"
  },
  {
    "start": 20.02,
    "end": 21.84,
    "text": "并且觉得热这个动作"
  },
  {
    "start": 21.84,
    "end": 23.38,
    "text": "房间里的暖气系统"
  },
  {
    "start": 23.38,
    "end": 24.48,
    "text": "竟然自己启动了"
  },
  {
    "start": 24.48,
    "end": 26.32,
    "text": "然后温度开始疯狂飙升"
  },
  {
    "start": 26.32,
    "end": 27.14,
    "text": "哇"
  },
  {
    "start": 27.14,
    "end": 29.84,
    "text": "这听起来有点像科幻恐怖片了"
  },
  {
    "start": 29.84,
    "end": 30.48,
    "text": "是吧"
  },
  {
    "start": 30.48,
    "end": 31.86,
    "text": "但在金融市场里"
  },
  {
    "start": 31.86,
    "end": 34.12,
    "text": "这就是每天都在上演的日常"
  },
  {
    "start": 34.12,
    "end": 35.44,
    "text": "这就是我们今天这次"
  },
  {
    "start": 35.44,
    "end": 37.64,
    "text": "深度拆解的核心灵魂拷问"
  },
  {
    "start": 37.64,
    "end": 38.88,
    "text": "刚才那个问题"
  },
  {
    "start": 38.88,
    "end": 40.68,
    "text": "其实直接把传统经济学"
  },
  {
    "start": 40.68,
    "end": 41.72,
    "text": "摁在地上摩擦了"
  },
  {
    "start": 41.72,
    "end": 42.08,
    "text": "没错"
  },
  {
    "start": 42.08,
    "end": 45.14,
    "text": "因为当咱们在探讨资本市场的时候"
  },
  {
    "start": 45.14,
    "end": 47.6,
    "text": "其实是在解剖"
  },
  {
    "start": 47.6,
    "end": 49.2,
    "text": "人类认知的天然缺陷"
  },
  {
    "start": 49.2,
    "end": 50.86,
    "text": "那个主流经济学"
  },
  {
    "start": 50.86,
    "end": 53.48,
    "text": "一直试图把市场描绘成一台"
  },
  {
    "start": 53.48,
    "end": 54.44,
    "text": "精密的"
  },
  {
    "start": 54.44,
    "end": 57.52,
    "text": "总是能自动找到完美平衡的机器"
  },
  {
    "start": 57.52,
    "end": 57.72,
    "text": "对"
  },
  {
    "start": 57.72,
    "end": 59.36,
    "text": "就像个上了发条的钟表"
  },
  {
    "start": 59.36,
    "end": 59.72,
    "text": "对"
  },
  {
    "start": 59.72,
    "end": 60.92,
    "text": "但现实呢"
  },
  {
    "start": 60.92,
    "end": 63.36,
    "text": "现实是一个充满了自我干涉"
  },
  {
    "start": 63.36,
    "end": 65.6,
    "text": "永远无法达到完美均衡的"
  },
  {
    "start": 65.6,
    "end": 67.52,
    "text": "动态混沌系统"
  },
  {
    "start": 67.52,
    "end": 69.74,
    "text": "带着这个足以颠覆常识的视角"
  },
  {
    "start": 69.74,
    "end": 71.0,
    "text": "我们要为你揭开"
  },
  {
    "start": 71.0,
    "end": 74.12,
    "text": "乔治索罗斯金融炼金术的神秘面纱"
  },
  {
    "start": 74.12,
    "end": 75.66,
    "text": "而且请注意啊"
  },
  {
    "start": 75.66,
    "end": 76.76,
    "text": "这绝对不是一本"
  },
  {
    "start": 76.76,
    "end": 78.12,
    "text": "教你暗图所记"
  },
  {
    "start": 78.12,
    "end": 80.4,
    "text": "几步实现财务自由的炒股秘籍"
  },
  {
    "start": 80.4,
    "end": 81.68,
    "text": "肯定不是"
  },
  {
    "start": 81.68,
    "end": 83.88,
    "text": "想找财富代码的可以划走了"
  },
  {
    "start": 83.88,
    "end": 84.54,
    "text": "对"
  },
  {
    "start": 84.54,
    "end": 90.42,
    "text": "这是一场彻底打破市场均衡与有效市场假说迷信的认知重塑"
  },
  {
    "start": 90.42,
    "end": 94.66,
    "text": "我们将带你进入一场跨越数十年的金融实验室之旅"
  },
  {
    "start": 94.66,
    "end": 101.7,
    "text": "去看看那些被象牙塔封为圭臬的经济学铁律是怎么在真金白银的绞杀中被击得粉碎的"
  },
  {
    "start": 101.7,
    "end": 105.22,
    "text": "其实传统经济学历有一个根深蒂固的假设"
  },
  {
    "start": 105.22,
    "end": 108.36,
    "text": "就是认为价格像是一面被动的镜子"
  },
  {
    "start": 108.36,
    "end": 110.26,
    "text": "或者就像你刚才说的那个温度计"
  },
  {
    "start": 110.26,
    "end": 111.72,
    "text": "只负责测量"
  },
  {
    "start": 111.72,
    "end": 112.58,
    "text": "不负责干预"
  },
  {
    "start": 112.58,
    "end": 112.86,
    "text": "对"
  },
  {
    "start": 112.86,
    "end": 115.54,
    "text": "它只是客观的反映经济的基本面"
  },
  {
    "start": 115.54,
    "end": 117.12,
    "text": "无论参与者怎么想"
  },
  {
    "start": 117.12,
    "end": 118.3,
    "text": "基本面就在那里"
  },
  {
    "start": 118.3,
    "end": 119.2,
    "text": "不悲不喜"
  },
  {
    "start": 119.2,
    "end": 120.68,
    "text": "但在全书的核心"
  },
  {
    "start": 120.68,
    "end": 124.96,
    "text": "索罗斯抛出了一个直接推翻这种静态视角的概念"
  },
  {
    "start": 124.96,
    "end": 126.64,
    "text": "叫做反身性"
  },
  {
    "start": 126.64,
    "end": 127.5,
    "text": "好"
  },
  {
    "start": 127.5,
    "end": 130.96,
    "text": "那咱们先把反身性这个听着有点学术的词"
  },
  {
    "start": 130.96,
    "end": 132.2,
    "text": "给掰碎了"
  },
  {
    "start": 132.2,
    "end": 132.72,
    "text": "揉烂了"
  },
  {
    "start": 132.72,
    "end": 134.48,
    "text": "如果在传统视角里"
  },
  {
    "start": 134.48,
    "end": 138.26,
    "text": "基本面决定价格是一条单向车道"
  },
  {
    "start": 138.26,
    "end": 140.48,
    "text": "那反身性是不是在说"
  },
  {
    "start": 140.48,
    "end": 143.18,
    "text": "这其实是一条双向互动的车道"
  },
  {
    "start": 143.18,
    "end": 144.8,
    "text": "完全可以这么理解"
  },
  {
    "start": 144.8,
    "end": 148.76,
    "text": "索罗斯把人类的行为拆成了两个同步的过程"
  },
  {
    "start": 148.76,
    "end": 150.12,
    "text": "一个是求知过程"
  },
  {
    "start": 150.12,
    "end": 151.2,
    "text": "在这个状态下"
  },
  {
    "start": 151.2,
    "end": 152.82,
    "text": "现实是以知量"
  },
  {
    "start": 152.82,
    "end": 155.98,
    "text": "咱们的大脑试图去理解外边这个复杂的世界"
  },
  {
    "start": 155.98,
    "end": 159.3,
    "text": "另外一个是参与过程"
  },
  {
    "start": 159.3,
    "end": 160.78,
    "text": "这时候参与者的思想"
  },
  {
    "start": 160.78,
    "end": 161.84,
    "text": "变成了以知量"
  },
  {
    "start": 161.84,
    "end": 163.94,
    "text": "我们根据自己大脑里的理解"
  },
  {
    "start": 163.94,
    "end": 165.12,
    "text": "去采取行动"
  },
  {
    "start": 165.12,
    "end": 166.6,
    "text": "进而改变外在世界"
  },
  {
    "start": 166.6,
    "end": 167.58,
    "text": "也就是说"
  },
  {
    "start": 167.58,
    "end": 170.28,
    "text": "知和行在同时发生"
  },
  {
    "start": 170.28,
    "end": 170.9,
    "text": "没错"
  },
  {
    "start": 170.9,
    "end": 172.08,
    "text": "关键点来了"
  },
  {
    "start": 172.08,
    "end": 174.56,
    "text": "这二者之间并不是平行的"
  },
  {
    "start": 174.56,
    "end": 178.24,
    "text": "它们存在了一种极其剧烈的双向循环反馈"
  },
  {
    "start": 178.24,
    "end": 180.44,
    "text": "这就带来了一个躲不开的逻辑"
  },
  {
    "start": 180.44,
    "end": 182.98,
    "text": "因为我们参与了现实的塑造"
  },
  {
    "start": 182.98,
    "end": 184.82,
    "text": "所以我们对现实的理解"
  },
  {
    "start": 184.82,
    "end": 186.56,
    "text": "永远是不完美的"
  },
  {
    "start": 186.56,
    "end": 187.28,
    "text": "等等"
  },
  {
    "start": 187.28,
    "end": 189.8,
    "text": "我想在这里稍微打断挑战一下"
  },
  {
    "start": 189.8,
    "end": 191.06,
    "text": "因为乍一听"
  },
  {
    "start": 191.06,
    "end": 194.88,
    "text": "这不就是华尔街老生常谈的情绪化吗"
  },
  {
    "start": 194.88,
    "end": 195.58,
    "text": "哦"
  },
  {
    "start": 195.58,
    "end": 196.22,
    "text": "怎么说"
  },
  {
    "start": 196.22,
    "end": 197.34,
    "text": "你想啊"
  },
  {
    "start": 197.34,
    "end": 199.06,
    "text": "大家在市场里追涨杀跌"
  },
  {
    "start": 199.06,
    "end": 200.86,
    "text": "看到利好一窝蜂冲进去"
  },
  {
    "start": 200.86,
    "end": 202.68,
    "text": "看到暴跌就恐慌踩踏"
  },
  {
    "start": 202.68,
    "end": 204.8,
    "text": "投资者偏离理性"
  },
  {
    "start": 204.8,
    "end": 207.28,
    "text": "这算是什么石破天惊的新理论呢"
  },
  {
    "start": 207.28,
    "end": 208.2,
    "text": "呃"
  },
  {
    "start": 208.2,
    "end": 209.84,
    "text": "这是一个非常普遍"
  },
  {
    "start": 209.84,
    "end": 211.66,
    "text": "但也极其危险的误解"
  },
  {
    "start": 211.66,
    "end": 212.62,
    "text": "怎么讲"
  },
  {
    "start": 212.62,
    "end": 213.84,
    "text": "情绪化"
  },
  {
    "start": 213.84,
    "end": 215.56,
    "text": "仅仅是在描述偏见"
  },
  {
    "start": 215.56,
    "end": 218.32,
    "text": "会让资产价格偏离它应有的基本面"
  },
  {
    "start": 218.32,
    "end": 220.98,
    "text": "也就是咱们常说的泡沫或者错杀"
  },
  {
    "start": 220.98,
    "end": 224.0,
    "text": "但反身性的恐怖之处不仅限于此"
  },
  {
    "start": 224.0,
    "end": 225.42,
    "text": "它的核心在于"
  },
  {
    "start": 225.42,
    "end": 226.86,
    "text": "参与者的偏见"
  },
  {
    "start": 226.86,
    "end": 228.56,
    "text": "不仅会让价格偏离基本面"
  },
  {
    "start": 228.56,
    "end": 231.6,
    "text": "它还会作为一种实实在在的物理力量"
  },
  {
    "start": 231.6,
    "end": 234.1,
    "text": "反过来直接改变基本面本身"
  },
  {
    "start": 234.1,
    "end": 236.12,
    "text": "改变基本面本身"
  },
  {
    "start": 236.12,
    "end": 236.76,
    "text": "呃"
  },
  {
    "start": 236.76,
    "end": 238.64,
    "text": "你能给我一个具体的画面吗"
  },
  {
    "start": 238.64,
    "end": 240.84,
    "text": "这听着有点像量子力学里"
  },
  {
    "start": 240.84,
    "end": 243.46,
    "text": "观察者直接改变了量子状态"
  },
  {
    "start": 243.46,
    "end": 243.7,
    "text": "哼"
  },
  {
    "start": 243.7,
    "end": 244.18,
    "text": "对"
  },
  {
    "start": 244.18,
    "end": 246.74,
    "text": "用保罗沃尔克在新版序言里"
  },
  {
    "start": 246.74,
    "end": 248.4,
    "text": "回忆的一个真实场景来解释"
  },
  {
    "start": 248.4,
    "end": 249.12,
    "text": "最合适了"
  },
  {
    "start": 249.12,
    "end": 251.92,
    "text": "当年索罗斯受邀去普林斯敦大学"
  },
  {
    "start": 251.92,
    "end": 253.46,
    "text": "花了一整个晚上的时间"
  },
  {
    "start": 253.46,
    "end": 255.04,
    "text": "跟一个学术小组交流"
  },
  {
    "start": 255.04,
    "end": 256.34,
    "text": "普林斯敦"
  },
  {
    "start": 256.34,
    "end": 258.94,
    "text": "那底下坐着的都是顶尖大佬吧"
  },
  {
    "start": 258.94,
    "end": 259.3,
    "text": "对"
  },
  {
    "start": 259.3,
    "end": 261.64,
    "text": "全是最顶尖的经济系教员"
  },
  {
    "start": 261.64,
    "end": 264.24,
    "text": "结果索罗斯毫不留情的当面直言"
  },
  {
    "start": 264.24,
    "end": 266.32,
    "text": "说主流的平衡理论"
  },
  {
    "start": 266.32,
    "end": 268.42,
    "text": "与资本市场的实际运作方式"
  },
  {
    "start": 268.42,
    "end": 269.4,
    "text": "毫无联系"
  },
  {
    "start": 269.4,
    "end": 269.98,
    "text": "哇"
  },
  {
    "start": 269.98,
    "end": 272.38,
    "text": "这就等于指着和尚骂秃驴了"
  },
  {
    "start": 272.38,
    "end": 272.84,
    "text": "是的"
  },
  {
    "start": 272.84,
    "end": 274.52,
    "text": "这番话极其刺耳"
  },
  {
    "start": 274.52,
    "end": 276.22,
    "text": "甚至逼得一位年轻教授"
  },
  {
    "start": 276.22,
    "end": 278.5,
    "text": "终于鼓起勇气站出来去挑战他"
  },
  {
    "start": 278.5,
    "end": 280.7,
    "text": "为什么学者们反应这么大"
  },
  {
    "start": 280.7,
    "end": 282.22,
    "text": "因为掀桌子了呀"
  },
  {
    "start": 282.22,
    "end": 282.76,
    "text": "没错"
  },
  {
    "start": 282.76,
    "end": 284.48,
    "text": "因为在学术界看来"
  },
  {
    "start": 284.48,
    "end": 285.68,
    "text": "承认反身性"
  },
  {
    "start": 285.68,
    "end": 289.74,
    "text": "就等于承认传统经济学大厦的地基是建在流沙上的"
  },
  {
    "start": 289.74,
    "end": 292.14,
    "text": "你以为你在研究一个独立的课题"
  },
  {
    "start": 292.14,
    "end": 296.42,
    "text": "但实际上你的研究和预期本身就在重塑那个课题"
  },
  {
    "start": 296.42,
    "end": 298.28,
    "text": "我想到一个比喻"
  },
  {
    "start": 298.28,
    "end": 302.82,
    "text": "传统理论觉得市场就像是在坚固的水泥桥上开车"
  },
  {
    "start": 302.82,
    "end": 303.7,
    "text": "无论你怎么开"
  },
  {
    "start": 303.7,
    "end": 305.14,
    "text": "桥本身是不变的"
  },
  {
    "start": 305.14,
    "end": 308.68,
    "text": "但反身性告诉你市场其实是一座冰桥"
  },
  {
    "start": 309.2,
    "end": 312.14,
    "text": "你在桥上开车的摩擦力会产生热量"
  },
  {
    "start": 312.14,
    "end": 313.98,
    "text": "直接融化这座桥的根基"
  },
  {
    "start": 313.98,
    "end": 315.2,
    "text": "你开的越快"
  },
  {
    "start": 315.2,
    "end": 316.12,
    "text": "觉得越安全"
  },
  {
    "start": 316.12,
    "end": 318.06,
    "text": "桥面反而融化的越快"
  },
  {
    "start": 318.06,
    "end": 320.62,
    "text": "这个冰桥的比喻太绝了"
  },
  {
    "start": 320.62,
    "end": 322.42,
    "text": "既然理论这么反直觉"
  },
  {
    "start": 322.42,
    "end": 326.22,
    "text": "咱们不妨把时间拨回20世纪70年代的历史现场"
  },
  {
    "start": 326.22,
    "end": 327.62,
    "text": "去看看这座冰桥"
  },
  {
    "start": 327.62,
    "end": 330.04,
    "text": "是怎么在现实的外汇市场里运作的"
  },
  {
    "start": 330.04,
    "end": 331.0,
    "text": "好啊"
  },
  {
    "start": 331.0,
    "end": 332.8,
    "text": "按照传统的教科书"
  },
  {
    "start": 332.8,
    "end": 335.5,
    "text": "如果一个国家的汇率定值过高"
  },
  {
    "start": 335.5,
    "end": 337.42,
    "text": "也就是货币持续升值"
  },
  {
    "start": 337.42,
    "end": 340.28,
    "text": "这会像重力一样自然的抑制它的出口"
  },
  {
    "start": 340.28,
    "end": 341.42,
    "text": "同时刺激进口"
  },
  {
    "start": 341.42,
    "end": 341.88,
    "text": "对"
  },
  {
    "start": 341.88,
    "end": 343.1,
    "text": "东西卖的贵了"
  },
  {
    "start": 343.1,
    "end": 344.56,
    "text": "国外买家自然就少了吗"
  },
  {
    "start": 344.56,
    "end": 344.96,
    "text": "没错"
  },
  {
    "start": 344.96,
    "end": 346.68,
    "text": "最终贸易逆差"
  },
  {
    "start": 346.68,
    "end": 349.04,
    "text": "会让汇率重新跌回到一个均衡水平"
  },
  {
    "start": 349.04,
    "end": 351.16,
    "text": "这是个完美的自我修正闭桥"
  },
  {
    "start": 351.16,
    "end": 352.78,
    "text": "逻辑上无懈可击啊"
  },
  {
    "start": 352.78,
    "end": 354.6,
    "text": "理论上确实无懈可击"
  },
  {
    "start": 354.6,
    "end": 356.1,
    "text": "但当时的德国"
  },
  {
    "start": 356.1,
    "end": 359.02,
    "text": "展现了一幅彻底粉碎这个闭桥的画面"
  },
  {
    "start": 359.02,
    "end": 361.24,
    "text": "当时德国货币持续升值"
  },
  {
    "start": 361.24,
    "end": 363.14,
    "text": "不但没有摧毁它的出口经济"
  },
  {
    "start": 363.14,
    "end": 365.02,
    "text": "反而让它变得更强了"
  },
  {
    "start": 365.02,
    "end": 365.66,
    "text": "为什么"
  },
  {
    "start": 365.66,
    "end": 367.64,
    "text": "这在机制上是怎么发生的"
  },
  {
    "start": 367.64,
    "end": 370.78,
    "text": "这就是反身性改变基本面的经典案例了"
  },
  {
    "start": 370.78,
    "end": 371.8,
    "text": "你想啊"
  },
  {
    "start": 371.8,
    "end": 373.54,
    "text": "德国出口的工业产品里"
  },
  {
    "start": 373.54,
    "end": 376.32,
    "text": "包含极大比例的进口原材料和加工品"
  },
  {
    "start": 376.32,
    "end": 376.9,
    "text": "哦"
  },
  {
    "start": 376.9,
    "end": 377.7,
    "text": "我懂了"
  },
  {
    "start": 377.7,
    "end": 378.64,
    "text": "汇率高了"
  },
  {
    "start": 378.64,
    "end": 380.26,
    "text": "进口成本就降了"
  },
  {
    "start": 380.26,
    "end": 380.48,
    "text": "对"
  },
  {
    "start": 380.48,
    "end": 382.44,
    "text": "当德国货币升值时"
  },
  {
    "start": 382.44,
    "end": 384.2,
    "text": "这些进口成本骤降"
  },
  {
    "start": 384.2,
    "end": 385.48,
    "text": "更关键的是"
  },
  {
    "start": 385.48,
    "end": 386.5,
    "text": "坚挺的汇率"
  },
  {
    "start": 386.5,
    "end": 388.58,
    "text": "极大抑制了国内的通货膨胀"
  },
  {
    "start": 388.58,
    "end": 389.7,
    "text": "物价便宜了"
  },
  {
    "start": 389.7,
    "end": 392.18,
    "text": "工人们要求涨工资的诉求就降低了"
  },
  {
    "start": 392.18,
    "end": 394.24,
    "text": "这就稳住了劳动力成本"
  },
  {
    "start": 394.24,
    "end": 394.62,
    "text": "没错"
  },
  {
    "start": 394.62,
    "end": 396.02,
    "text": "原材料便宜了"
  },
  {
    "start": 396.02,
    "end": 396.94,
    "text": "人工也没涨"
  },
  {
    "start": 396.94,
    "end": 399.04,
    "text": "这就导致哪怕汇率很高"
  },
  {
    "start": 399.04,
    "end": 403.18,
    "text": "德国造的汽车机械在国际上依然竞争力爆表"
  },
  {
    "start": 403.18,
    "end": 403.9,
    "text": "你看"
  },
  {
    "start": 403.9,
    "end": 406.9,
    "text": "汇率上涨这个所谓的价格虚高现象啊"
  },
  {
    "start": 406.9,
    "end": 409.22,
    "text": "实实在在的改变了德国产业竞争力"
  },
  {
    "start": 409.22,
    "end": 409.98,
    "text": "这个基本面"
  },
  {
    "start": 409.98,
    "end": 411.6,
    "text": "我完全明白了"
  },
  {
    "start": 411.6,
    "end": 413.76,
    "text": "等于市场偏见推高了汇率"
  },
  {
    "start": 413.76,
    "end": 416.86,
    "text": "而这个高汇率反过来改造了德国经济结构"
  },
  {
    "start": 416.86,
    "end": 418.86,
    "text": "让他配得上这个高汇率"
  },
  {
    "start": 418.86,
    "end": 419.4,
    "text": "对"
  },
  {
    "start": 419.4,
    "end": 421.34,
    "text": "就像你认定一个人是天才"
  },
  {
    "start": 421.34,
    "end": 422.44,
    "text": "给他无限资源"
  },
  {
    "start": 422.44,
    "end": 424.22,
    "text": "结果他真成了天才"
  },
  {
    "start": 424.22,
    "end": 426.86,
    "text": "这在后来的美元身上也印证了"
  },
  {
    "start": 426.86,
    "end": 428.66,
    "text": "当时美元极其坚挺"
  },
  {
    "start": 428.66,
    "end": 431.84,
    "text": "但同期美国的贸易收支却在不断恶化"
  },
  {
    "start": 431.84,
    "end": 435.3,
    "text": "价格和基本面完全走向背离"
  },
  {
    "start": 435.3,
    "end": 435.58,
    "text": "是的"
  },
  {
    "start": 435.58,
    "end": 438.34,
    "text": "基本因素对价格趋势的决定作用啊"
  },
  {
    "start": 438.34,
    "end": 441.58,
    "text": "在外汇市场简直比在股票市场还要模糊"
  },
  {
    "start": 441.58,
    "end": 444.68,
    "text": "但如果我们觉得外汇市场已经够颠覆了"
  },
  {
    "start": 444.68,
    "end": 448.42,
    "text": "那他在信贷周期里的表现才真正叫惊心动魄"
  },
  {
    "start": 448.42,
    "end": 449.88,
    "text": "提到信贷周期"
  },
  {
    "start": 449.88,
    "end": 452.2,
    "text": "结合刚才那个冰桥的比喻"
  },
  {
    "start": 452.2,
    "end": 454.66,
    "text": "当银行开始大规模放贷的时候"
  },
  {
    "start": 454.66,
    "end": 458.38,
    "text": "那种繁荣景象本身是不是就在掩盖风险"
  },
  {
    "start": 458.38,
    "end": 462.04,
    "text": "索罗斯深入解剖了贷款与抵押品之间的致命连接"
  },
  {
    "start": 462.04,
    "end": 465.42,
    "text": "通常我们认为银行是因为抵押品价值高"
  },
  {
    "start": 465.42,
    "end": 466.54,
    "text": "才愿意放出贷款"
  },
  {
    "start": 466.54,
    "end": 467.16,
    "text": "对啊"
  },
  {
    "start": 467.16,
    "end": 469.26,
    "text": "你房子值钱我才借给你钱吗"
  },
  {
    "start": 469.26,
    "end": 470.9,
    "text": "但在反身性框架下"
  },
  {
    "start": 470.9,
    "end": 471.96,
    "text": "逻辑反过来了"
  },
  {
    "start": 471.96,
    "end": 474.88,
    "text": "正是因为银行不断涌入的新增贷款"
  },
  {
    "start": 474.88,
    "end": 477.18,
    "text": "直接推高了抵押品的账面价值"
  },
  {
    "start": 477.18,
    "end": 477.7,
    "text": "哇"
  },
  {
    "start": 477.7,
    "end": 479.02,
    "text": "自己买自己的单"
  },
  {
    "start": 479.02,
    "end": 480.94,
    "text": "在信贷扩张早期"
  },
  {
    "start": 480.94,
    "end": 482.16,
    "text": "大家胆子还小"
  },
  {
    "start": 482.16,
    "end": 484.98,
    "text": "新资金拉动估价看起来很稳健"
  },
  {
    "start": 484.98,
    "end": 486.84,
    "text": "但随着时间退移"
  },
  {
    "start": 486.84,
    "end": 488.16,
    "text": "旧债务在累积"
  },
  {
    "start": 488.16,
    "end": 489.82,
    "text": "为了维持这种繁荣"
  },
  {
    "start": 489.82,
    "end": 492.72,
    "text": "新贷款总量必须指数级上升"
  },
  {
    "start": 492.72,
    "end": 495.06,
    "text": "让我听一下理清这个因果啊"
  },
  {
    "start": 495.06,
    "end": 496.72,
    "text": "就是说那块抵押品"
  },
  {
    "start": 496.72,
    "end": 498.62,
    "text": "不管是土地还是国家信用"
  },
  {
    "start": 498.62,
    "end": 500.64,
    "text": "它之所以看起来值钱"
  },
  {
    "start": 500.64,
    "end": 503.08,
    "text": "全靠源源不断的新贷款在拖底"
  },
  {
    "start": 503.08,
    "end": 506.04,
    "text": "这简直是个自我催眠的死亡螺旋啊"
  },
  {
    "start": 506.04,
    "end": 507.72,
    "text": "疯狂的时候能到什么程度"
  },
  {
    "start": 507.72,
    "end": 509.2,
    "text": "极度疯狂"
  },
  {
    "start": 509.2,
    "end": 511.06,
    "text": "在信贷扩张的后期"
  },
  {
    "start": 511.06,
    "end": 512.32,
    "text": "为了维持幻觉"
  },
  {
    "start": 512.32,
    "end": 514.92,
    "text": "大型金融机构的资本运作杠杆倍率"
  },
  {
    "start": 514.92,
    "end": 517.28,
    "text": "直接干到了14至16倍"
  },
  {
    "start": 517.28,
    "end": 520.08,
    "text": "美洲银行甚至飙升到了20倍"
  },
  {
    "start": 520.08,
    "end": 521.28,
    "text": "我的天"
  },
  {
    "start": 521.28,
    "end": 523.56,
    "text": "这杠杆稍微哆嗦一下就全完了"
  },
  {
    "start": 523.56,
    "end": 525.04,
    "text": "还不止呢"
  },
  {
    "start": 525.04,
    "end": 526.34,
    "text": "你能想象吗"
  },
  {
    "start": 526.34,
    "end": 529.26,
    "text": "花旗银行当时有四分之一强的收益"
  },
  {
    "start": 529.26,
    "end": 532.64,
    "text": "居然仅仅来自巴西这一个国家的债务运转"
  },
  {
    "start": 532.64,
    "end": 535.82,
    "text": "而牵涉处理墨西哥债务的商业银行数量"
  },
  {
    "start": 535.82,
    "end": 536.98,
    "text": "多达500家"
  },
  {
    "start": 536.98,
    "end": 538.06,
    "text": "这太可怕了"
  },
  {
    "start": 538.06,
    "end": 540.24,
    "text": "大家完全被自己创造的繁荣蒙蔽了"
  },
  {
    "start": 540.24,
    "end": 541.14,
    "text": "没错"
  },
  {
    "start": 541.14,
    "end": 542.7,
    "text": "当转折点到来"
  },
  {
    "start": 542.7,
    "end": 545.62,
    "text": "重债五国的资金金额在极短时间内"
  },
  {
    "start": 545.62,
    "end": 547.62,
    "text": "从流入501亿美元"
  },
  {
    "start": 547.62,
    "end": 550.14,
    "text": "剧烈且毫无预兆的反转为"
  },
  {
    "start": 550.14,
    "end": 552.4,
    "text": "反向流出138亿美元"
  },
  {
    "start": 552.4,
    "end": 553.58,
    "text": "瞬间抽干"
  },
  {
    "start": 553.58,
    "end": 555.12,
    "text": "断崖式反转"
  },
  {
    "start": 555.12,
    "end": 558.66,
    "text": "这就揭示了信贷周期里一个致命的不对称性"
  },
  {
    "start": 558.66,
    "end": 561.94,
    "text": "繁荣是长期的渐进的自我麻醉的"
  },
  {
    "start": 561.94,
    "end": 565.32,
    "text": "而萧条是突发的不留余地的灾难性的"
  },
  {
    "start": 565.32,
    "end": 566.52,
    "text": "为什么会这样"
  },
  {
    "start": 566.52,
    "end": 568.58,
    "text": "繁荣好多年崩盘就几天"
  },
  {
    "start": 568.58,
    "end": 571.36,
    "text": "核心机制是时间的压迫感"
  },
  {
    "start": 571.36,
    "end": 573.84,
    "text": "放贷和升值可以慢慢来"
  },
  {
    "start": 573.84,
    "end": 576.82,
    "text": "但清偿贷款有强制性的时间红线"
  },
  {
    "start": 576.82,
    "end": 578.46,
    "text": "大环境一逆转"
  },
  {
    "start": 578.46,
    "end": 579.62,
    "text": "银行恐慌了"
  },
  {
    "start": 579.62,
    "end": 581.14,
    "text": "逼着你立刻还钱"
  },
  {
    "start": 581.14,
    "end": 582.24,
    "text": "借款人拿不出钱"
  },
  {
    "start": 582.24,
    "end": 583.6,
    "text": "只能砸盘抛售抵押品"
  },
  {
    "start": 583.6,
    "end": 584.28,
    "text": "对"
  },
  {
    "start": 584.28,
    "end": 586.7,
    "text": "集中抛售导致价格暴跌"
  },
  {
    "start": 586.7,
    "end": 587.76,
    "text": "抵押品一跌"
  },
  {
    "start": 587.76,
    "end": 589.24,
    "text": "银行更恐慌"
  },
  {
    "start": 589.24,
    "end": 590.8,
    "text": "要补保证金或者抽贷"
  },
  {
    "start": 590.8,
    "end": 592.58,
    "text": "旅行的速度越快"
  },
  {
    "start": 592.58,
    "end": 595.02,
    "text": "对抵押品价值的碾压就越惨烈"
  },
  {
    "start": 595.02,
    "end": 597.2,
    "text": "向下螺旋一旦开启"
  },
  {
    "start": 597.2,
    "end": 598.22,
    "text": "那就是雪崩"
  },
  {
    "start": 598.22,
    "end": 599.74,
    "text": "听得我后背发凉"
  },
  {
    "start": 599.74,
    "end": 602.22,
    "text": "不过在宏观层面"
  },
  {
    "start": 602.22,
    "end": 604.52,
    "text": "开上帝视角分析总是很清晰的"
  },
  {
    "start": 604.52,
    "end": 606.78,
    "text": "但在真金白银实战中"
  },
  {
    "start": 606.78,
    "end": 608.24,
    "text": "情况也会这么明朗吗"
  },
  {
    "start": 608.24,
    "end": 611.04,
    "text": "这就引出了全书最不可思议的部分"
  },
  {
    "start": 611.04,
    "end": 612.4,
    "text": "历时实验"
  },
  {
    "start": 612.4,
    "end": 613.36,
    "text": "哦"
  },
  {
    "start": 613.36,
    "end": 614.44,
    "text": "日记那部分"
  },
  {
    "start": 614.44,
    "end": 615.16,
    "text": "对"
  },
  {
    "start": 615.16,
    "end": 617.8,
    "text": "经济学家通常只做马后炮的分析"
  },
  {
    "start": 617.8,
    "end": 620.8,
    "text": "但索罗斯直接把自己当成实验室小白鼠"
  },
  {
    "start": 620.8,
    "end": 624.34,
    "text": "他公开了一份有赚有亏的实时交易日记"
  },
  {
    "start": 624.34,
    "end": 627.2,
    "text": "把焦虑误判全摊开给咱们看了"
  },
  {
    "start": 627.2,
    "end": 629.1,
    "text": "这是一个极其罕见"
  },
  {
    "start": 629.1,
    "end": 630.9,
    "text": "甚至有点残酷的自我解剖"
  },
  {
    "start": 630.9,
    "end": 632.9,
    "text": "如果你翻看日记开局"
  },
  {
    "start": 632.9,
    "end": 634.28,
    "text": "你会惊讶的发现"
  },
  {
    "start": 634.28,
    "end": 635.76,
    "text": "这位金融大鳄起步"
  },
  {
    "start": 635.76,
    "end": 637.18,
    "text": "简直是一场灾难"
  },
  {
    "start": 637.18,
    "end": 638.42,
    "text": "是吧"
  },
  {
    "start": 638.42,
    "end": 641.3,
    "text": "他非常坦诚的记录了低级错误"
  },
  {
    "start": 641.3,
    "end": 643.26,
    "text": "比如在债券价格明显上扬"
  },
  {
    "start": 643.26,
    "end": 644.72,
    "text": "趋势已经形成时"
  },
  {
    "start": 644.72,
    "end": 646.54,
    "text": "他居然因为主观固执"
  },
  {
    "start": 646.54,
    "end": 647.78,
    "text": "放弃了空头头寸"
  },
  {
    "start": 647.78,
    "end": 650.2,
    "text": "外币多头明明在流血亏损"
  },
  {
    "start": 650.2,
    "end": 651.9,
    "text": "他却像普通散户一样"
  },
  {
    "start": 651.9,
    "end": 652.68,
    "text": "死扛不放"
  },
  {
    "start": 652.68,
    "end": 654.96,
    "text": "到了次年的一月份那个阶段"
  },
  {
    "start": 654.96,
    "end": 656.9,
    "text": "我深切感受到了窒息感"
  },
  {
    "start": 656.9,
    "end": 658.66,
    "text": "那个月股债双杀"
  },
  {
    "start": 658.66,
    "end": 659.5,
    "text": "他直接写"
  },
  {
    "start": 659.5,
    "end": 661.24,
    "text": "遭受了极大的损失"
  },
  {
    "start": 661.24,
    "end": 663.08,
    "text": "当崩盘持续一周后"
  },
  {
    "start": 663.08,
    "end": 666.06,
    "text": "他痛苦的承认自己反应太慢了"
  },
  {
    "start": 666.06,
    "end": 668.48,
    "text": "晚一步就是万丈深渊"
  },
  {
    "start": 668.48,
    "end": 668.84,
    "text": "是的"
  },
  {
    "start": 668.84,
    "end": 670.68,
    "text": "等他终于动手平仓的时候"
  },
  {
    "start": 670.68,
    "end": 673.18,
    "text": "市场已经跌了好几个标准差了"
  },
  {
    "start": 673.18,
    "end": 674.96,
    "text": "这些记录生动的说明"
  },
  {
    "start": 674.96,
    "end": 677.22,
    "text": "他根本不是什么全知全能的先知"
  },
  {
    "start": 677.22,
    "end": 678.48,
    "text": "他跟普通人一样"
  },
  {
    "start": 678.48,
    "end": 680.56,
    "text": "也在边猜边亏边改"
  },
  {
    "start": 680.56,
    "end": 682.48,
    "text": "这正是我最大的疑惑"
  },
  {
    "start": 682.48,
    "end": 684.34,
    "text": "如果他在日记里这么挣扎"
  },
  {
    "start": 684.34,
    "end": 685.04,
    "text": "经常看错"
  },
  {
    "start": 685.04,
    "end": 687.18,
    "text": "那这套反身性理论到底有啥用"
  },
  {
    "start": 687.18,
    "end": 689.3,
    "text": "这完全没有科学预测能力"
  },
  {
    "start": 689.3,
    "end": 692.3,
    "text": "听着就像蒙着眼在黑森林里乱开枪"
  },
  {
    "start": 692.3,
    "end": 693.64,
    "text": "问得好"
  },
  {
    "start": 693.64,
    "end": 697.3,
    "text": "但这恰恰触及了反身性理论最高级的智慧"
  },
  {
    "start": 697.3,
    "end": 698.34,
    "text": "先投资"
  },
  {
    "start": 698.34,
    "end": 699.22,
    "text": "后研究"
  },
  {
    "start": 699.22,
    "end": 699.94,
    "text": "等等"
  },
  {
    "start": 699.94,
    "end": 701.52,
    "text": "先开枪再瞄准"
  },
  {
    "start": 701.52,
    "end": 703.18,
    "text": "这我也被投资常识了吧"
  },
  {
    "start": 703.18,
    "end": 705.28,
    "text": "不该是做足禁调再出手吗"
  },
  {
    "start": 705.28,
    "end": 707.3,
    "text": "在静态思维里是这样"
  },
  {
    "start": 707.3,
    "end": 709.2,
    "text": "但在反身性的世界里"
  },
  {
    "start": 709.2,
    "end": 710.2,
    "text": "市场是活的"
  },
  {
    "start": 710.2,
    "end": 711.44,
    "text": "没法精确预测"
  },
  {
    "start": 711.44,
    "end": 713.5,
    "text": "所以他所谓的先投资"
  },
  {
    "start": 713.5,
    "end": 715.3,
    "text": "其实是扔个侦察兵"
  },
  {
    "start": 715.3,
    "end": 717.08,
    "text": "建立个初始头寸去试探"
  },
  {
    "start": 717.08,
    "end": 718.0,
    "text": "哦"
  },
  {
    "start": 718.0,
    "end": 720.76,
    "text": "拿真金白银去买市场的真实反馈"
  },
  {
    "start": 720.76,
    "end": 721.6,
    "text": "对"
  },
  {
    "start": 721.6,
    "end": 723.54,
    "text": "去检验大脑里的假说"
  },
  {
    "start": 723.54,
    "end": 724.12,
    "text": "比如"
  },
  {
    "start": 724.12,
    "end": 726.76,
    "text": "当他发现日本长期资本投资的数据"
  },
  {
    "start": 726.76,
    "end": 731.06,
    "text": "从177亿美元猛增至497亿美元时"
  },
  {
    "start": 731.06,
    "end": 732.64,
    "text": "这个巨大的现实反馈"
  },
  {
    "start": 732.64,
    "end": 734.32,
    "text": "立刻击碎了他的预设"
  },
  {
    "start": 734.32,
    "end": 736.5,
    "text": "所以他在日记里马上承认"
  },
  {
    "start": 736.5,
    "end": 738.16,
    "text": "自己之前完全没注意到"
  },
  {
    "start": 738.16,
    "end": 739.94,
    "text": "根本性的资金流向变化"
  },
  {
    "start": 739.94,
    "end": 741.62,
    "text": "瞬间推翻旧模型"
  },
  {
    "start": 741.62,
    "end": 742.52,
    "text": "掉头调整"
  },
  {
    "start": 742.52,
    "end": 743.26,
    "text": "没错"
  },
  {
    "start": 743.26,
    "end": 746.68,
    "text": "反身性从来不是个能给你精确点位的水晶球"
  },
  {
    "start": 746.68,
    "end": 748.46,
    "text": "它是个认知探测器"
  },
  {
    "start": 748.46,
    "end": 750.2,
    "text": "它承认人类天生无知"
  },
  {
    "start": 750.2,
    "end": 752.28,
    "text": "提供了一个能让你快速认错"
  },
  {
    "start": 752.28,
    "end": 754.18,
    "text": "动态纠错的生存框架"
  },
  {
    "start": 754.18,
    "end": 755.72,
    "text": "总结的太透彻了"
  },
  {
    "start": 755.72,
    "end": 756.88,
    "text": "最核心的法则"
  },
  {
    "start": 756.88,
    "end": 758.1,
    "text": "其实非常朴素"
  },
  {
    "start": 758.1,
    "end": 761.06,
    "text": "逃跑的人才能活下来对抗新的一天"
  },
  {
    "start": 761.06,
    "end": 762.2,
    "text": "你看日记结局"
  },
  {
    "start": 762.2,
    "end": 763.5,
    "text": "即便错盘无数"
  },
  {
    "start": 763.5,
    "end": 765.34,
    "text": "他基金表现依然极好"
  },
  {
    "start": 765.34,
    "end": 768.78,
    "text": "因为他扣的是石油与美元空头的准确重注"
  },
  {
    "start": 768.78,
    "end": 770.56,
    "text": "还有个股选择的成功"
  },
  {
    "start": 770.56,
    "end": 773.06,
    "text": "保住本金永远是第一位的"
  },
  {
    "start": 773.06,
    "end": 774.4,
    "text": "敢于承认无知"
  },
  {
    "start": 774.4,
    "end": 775.84,
    "text": "果断挥刀纠错"
  },
  {
    "start": 775.84,
    "end": 777.62,
    "text": "这心理素质太强了"
  },
  {
    "start": 777.62,
    "end": 779.56,
    "text": "而且在书的评数部分"
  },
  {
    "start": 779.56,
    "end": 781.44,
    "text": "索罗斯也带着我们审视了"
  },
  {
    "start": 781.44,
    "end": 783.04,
    "text": "他自己早年的分析框架"
  },
  {
    "start": 783.04,
    "end": 784.86,
    "text": "毫不留情的鞭视自己"
  },
  {
    "start": 784.86,
    "end": 785.44,
    "text": "是的"
  },
  {
    "start": 785.44,
    "end": 787.32,
    "text": "比如他剖析自己曾错判"
  },
  {
    "start": 787.32,
    "end": 789.24,
    "text": "以为只有不到一半的利息"
  },
  {
    "start": 789.24,
    "end": 790.64,
    "text": "是以新增贷款偿付的"
  },
  {
    "start": 790.64,
    "end": 792.46,
    "text": "得出了错误的负债模型"
  },
  {
    "start": 792.46,
    "end": 795.16,
    "text": "而且严重低估了债务国绝境下的"
  },
  {
    "start": 795.16,
    "end": 796.24,
    "text": "出口创汇能力"
  },
  {
    "start": 796.24,
    "end": 798.34,
    "text": "现实数据总比模型有弹性"
  },
  {
    "start": 798.34,
    "end": 801.44,
    "text": "像巴西当时的官方出口目标是90亿美元"
  },
  {
    "start": 801.44,
    "end": 803.8,
    "text": "按常规分析已经是天花板了"
  },
  {
    "start": 803.8,
    "end": 806.7,
    "text": "但实际却硬生生超过了120亿美元"
  },
  {
    "start": 806.7,
    "end": 809.66,
    "text": "这导致他早年分析过度悲观"
  },
  {
    "start": 809.66,
    "end": 811.44,
    "text": "把商疤接给全世界看"
  },
  {
    "start": 811.44,
    "end": 814.1,
    "text": "在到处都是幸存者偏差的金融圈"
  },
  {
    "start": 814.1,
    "end": 815.48,
    "text": "真的太少见了"
  },
  {
    "start": 815.48,
    "end": 816.54,
    "text": "那问题来了"
  },
  {
    "start": 816.54,
    "end": 819.08,
    "text": "既然他在实战中赚的盆满钵满"
  },
  {
    "start": 819.08,
    "end": 820.82,
    "text": "还这么坦诚公开心法"
  },
  {
    "start": 820.82,
    "end": 822.38,
    "text": "高高在上的学术界"
  },
  {
    "start": 822.38,
    "end": 824.2,
    "text": "是怎么看这道反身性理论呢"
  },
  {
    "start": 824.2,
    "end": 825.52,
    "text": "学术界的态度"
  },
  {
    "start": 825.52,
    "end": 826.9,
    "text": "充满了戏剧性的撕裂"
  },
  {
    "start": 826.9,
    "end": 828.22,
    "text": "实物界态度"
  },
  {
    "start": 828.22,
    "end": 830.52,
    "text": "像保罗沃尔克评价极高"
  },
  {
    "start": 830.52,
    "end": 832.48,
    "text": "因为他们常年在泥潭搏沙"
  },
  {
    "start": 832.48,
    "end": 833.98,
    "text": "懂着洞察有多深"
  },
  {
    "start": 833.98,
    "end": 835.74,
    "text": "但象牙塔里的声音"
  },
  {
    "start": 835.74,
    "end": 836.7,
    "text": "异常冷漠"
  },
  {
    "start": 836.7,
    "end": 837.38,
    "text": "甚至敌视"
  },
  {
    "start": 837.38,
    "end": 840.82,
    "text": "为什么排斥一个在现实里能赚大钱的理论"
  },
  {
    "start": 840.82,
    "end": 842.12,
    "text": "因为它不够优美"
  },
  {
    "start": 842.12,
    "end": 843.42,
    "text": "也难以被量化"
  },
  {
    "start": 843.42,
    "end": 845.48,
    "text": "当时凯布奈提卡"
  },
  {
    "start": 845.48,
    "end": 847.86,
    "text": "期刊上的一篇书评非常尖锐"
  },
  {
    "start": 847.86,
    "end": 850.5,
    "text": "质疑反身性根本没啥新颖的"
  },
  {
    "start": 850.64,
    "end": 853.04,
    "text": "就是重新发现了控制论的反馈概念"
  },
  {
    "start": 853.04,
    "end": 855.36,
    "text": "还批评他系统理论基础薄弱"
  },
  {
    "start": 855.36,
    "end": 857.16,
    "text": "学术界通病"
  },
  {
    "start": 857.16,
    "end": 858.76,
    "text": "更看重模型完美"
  },
  {
    "start": 858.76,
    "end": 860.56,
    "text": "哪怕现实行不通"
  },
  {
    "start": 860.56,
    "end": 861.54,
    "text": "还有别的批评吗"
  },
  {
    "start": 861.54,
    "end": 866.4,
    "text": "另一家Journal of Economic Methodology的论文综述评价更复杂"
  },
  {
    "start": 866.4,
    "end": 868.88,
    "text": "他们承认特定正反馈下"
  },
  {
    "start": 868.88,
    "end": 871.56,
    "text": "会出现近似的自我实现预期均衡"
  },
  {
    "start": 871.56,
    "end": 873.26,
    "text": "但紧接着反驳说"
  },
  {
    "start": 873.26,
    "end": 875.06,
    "text": "这个支点太窄了"
  },
  {
    "start": 875.06,
    "end": 877.08,
    "text": "不足以单独支撑整套理论"
  },
  {
    "start": 877.08,
    "end": 878.34,
    "text": "听得出来"
  },
  {
    "start": 878.34,
    "end": 880.92,
    "text": "宁愿抱着精美的沉船意气淹死"
  },
  {
    "start": 880.92,
    "end": 882.82,
    "text": "也不接纳实战总结的哲学"
  },
  {
    "start": 882.82,
    "end": 884.3,
    "text": "这种排斥"
  },
  {
    "start": 884.3,
    "end": 886.78,
    "text": "恰恰暴露了社会科学的终极窘境"
  },
  {
    "start": 886.78,
    "end": 888.02,
    "text": "在物理里"
  },
  {
    "start": 888.02,
    "end": 889.86,
    "text": "水的废点是客观的"
  },
  {
    "start": 889.86,
    "end": 890.86,
    "text": "但在金融里"
  },
  {
    "start": 890.86,
    "end": 891.92,
    "text": "写论文的"
  },
  {
    "start": 891.92,
    "end": 892.94,
    "text": "定政策的"
  },
  {
    "start": 892.94,
    "end": 893.74,
    "text": "管制者"
  },
  {
    "start": 893.74,
    "end": 896.42,
    "text": "自己也是带偏见和不完备理解的参与者"
  },
  {
    "start": 896.42,
    "end": 898.5,
    "text": "你找不到一个局外的上帝视角"
  },
  {
    "start": 898.5,
    "end": 901.06,
    "text": "这引出了一个更深远的担忧"
  },
  {
    "start": 901.06,
    "end": 903.2,
    "text": "让我们把视线放向未来"
  },
  {
    "start": 903.2,
    "end": 905.86,
    "text": "既然参与者和监管者都有认知缺陷"
  },
  {
    "start": 905.86,
    "end": 908.1,
    "text": "金融体系的前景在哪"
  },
  {
    "start": 908.1,
    "end": 910.56,
    "text": "还能迷信市场的自我调节吗"
  },
  {
    "start": 910.56,
    "end": 912.7,
    "text": "索罗斯给出了明确警告"
  },
  {
    "start": 912.7,
    "end": 915.64,
    "text": "自由市场绝对无法自动趋向均衡"
  },
  {
    "start": 915.64,
    "end": 917.12,
    "text": "后来发生的事件"
  },
  {
    "start": 917.12,
    "end": 920.56,
    "text": "比如泰国汇率制度被打破引发的金融危机"
  },
  {
    "start": 920.56,
    "end": 923.1,
    "text": "就有力证明了合理预期理论的时效"
  },
  {
    "start": 923.1,
    "end": 925.36,
    "text": "但现实打脸这么多次"
  },
  {
    "start": 925.36,
    "end": 927.22,
    "text": "观念转变依然很慢啊"
  },
  {
    "start": 927.22,
    "end": 929.68,
    "text": "这就是观念与现实的悖论"
  },
  {
    "start": 929.68,
    "end": 931.12,
    "text": "虽然学术前沿"
  },
  {
    "start": 931.12,
    "end": 932.6,
    "text": "关于多重均衡的讨论"
  },
  {
    "start": 932.6,
    "end": 933.84,
    "text": "开始承认反身性了"
  },
  {
    "start": 933.84,
    "end": 936.28,
    "text": "但公共话语层面毫无进展"
  },
  {
    "start": 936.28,
    "end": 937.92,
    "text": "市场原教制主义"
  },
  {
    "start": 937.92,
    "end": 939.48,
    "text": "反而更具影响力了"
  },
  {
    "start": 939.48,
    "end": 942.64,
    "text": "索罗斯主张必须依赖协调性的监管"
  },
  {
    "start": 942.64,
    "end": 944.52,
    "text": "和开放社会的自我纠错"
  },
  {
    "start": 944.52,
    "end": 946.14,
    "text": "才能防范系统性崩溃"
  },
  {
    "start": 946.14,
    "end": 948.1,
    "text": "把思考带回当下"
  },
  {
    "start": 948.1,
    "end": 949.82,
    "text": "这就更阵容乏馈了"
  },
  {
    "start": 949.82,
    "end": 952.2,
    "text": "现在大家都在谈AI大模型"
  },
  {
    "start": 952.2,
    "end": 952.7,
    "text": "对吧"
  },
  {
    "start": 952.7,
    "end": 953.64,
    "text": "嗯"
  },
  {
    "start": 953.64,
    "end": 955.16,
    "text": "海量数据喂出来的"
  },
  {
    "start": 955.16,
    "end": 957.7,
    "text": "但不管算法多强大"
  },
  {
    "start": 957.7,
    "end": 959.44,
    "text": "基于人类不确定性原则"
  },
  {
    "start": 959.44,
    "end": 961.4,
    "text": "它依然是对过去的拟合"
  },
  {
    "start": 961.4,
    "end": 963.4,
    "text": "一旦庞大资金基于"
  },
  {
    "start": 963.4,
    "end": 965.28,
    "text": "同一个完美模型去行动"
  },
  {
    "start": 965.28,
    "end": 967.16,
    "text": "这种同质化动作本身"
  },
  {
    "start": 967.16,
    "end": 968.04,
    "text": "就会引发踩踏"
  },
  {
    "start": 968.04,
    "end": 969.76,
    "text": "直接改变现实"
  },
  {
    "start": 969.76,
    "end": 969.96,
    "text": "对"
  },
  {
    "start": 969.96,
    "end": 971.84,
    "text": "预测未来的动作"
  },
  {
    "start": 971.84,
    "end": 973.5,
    "text": "创造了历史数据里"
  },
  {
    "start": 973.5,
    "end": 975.16,
    "text": "没有的新未来"
  },
  {
    "start": 975.16,
    "end": 976.56,
    "text": "这就是AI模型"
  },
  {
    "start": 976.56,
    "end": 978.4,
    "text": "与现实的反身性循环"
  },
  {
    "start": 978.4,
    "end": 979.34,
    "text": "所以"
  },
  {
    "start": 979.34,
    "end": 980.64,
    "text": "永远不要以为"
  },
  {
    "start": 980.64,
    "end": 981.8,
    "text": "能完全掌控未来"
  },
  {
    "start": 981.8,
    "end": 982.58,
    "text": "好了"
  },
  {
    "start": 982.58,
    "end": 984.02,
    "text": "在这次拆解即将"
  },
  {
    "start": 984.02,
    "end": 985.02,
    "text": "画上句号的时刻"
  },
  {
    "start": 985.02,
    "end": 986.56,
    "text": "我为你梳理了三个"
  },
  {
    "start": 986.56,
    "end": 988.14,
    "text": "立刻能用的思维工具"
  },
  {
    "start": 988.14,
    "end": 988.86,
    "text": "第一"
  },
  {
    "start": 988.86,
    "end": 990.28,
    "text": "下次听到价格涨"
  },
  {
    "start": 990.28,
    "end": 991.52,
    "text": "是因为基本面好"
  },
  {
    "start": 991.52,
    "end": 992.54,
    "text": "先反问一句"
  },
  {
    "start": 992.54,
    "end": 993.68,
    "text": "价格上涨"
  },
  {
    "start": 993.68,
    "end": 994.86,
    "text": "本身有没有改变"
  },
  {
    "start": 994.86,
    "end": 995.44,
    "text": "那个基本面"
  },
  {
    "start": 995.44,
    "end": 995.98,
    "text": "嗯"
  },
  {
    "start": 995.98,
    "end": 997.1,
    "text": "很好的切入点"
  },
  {
    "start": 997.1,
    "end": 997.64,
    "text": "第二"
  },
  {
    "start": 997.64,
    "end": 999.48,
    "text": "读任何借贷报复故事"
  },
  {
    "start": 999.48,
    "end": 1000.68,
    "text": "先看抵押品价值"
  },
  {
    "start": 1000.68,
    "end": 1001.48,
    "text": "靠什么撑着"
  },
  {
    "start": 1001.48,
    "end": 1003.08,
    "text": "撑它的新增贷款"
  },
  {
    "start": 1003.08,
    "end": 1004.4,
    "text": "能不能一直增长"
  },
  {
    "start": 1004.4,
    "end": 1004.98,
    "text": "第三"
  },
  {
    "start": 1004.98,
    "end": 1006.26,
    "text": "像写日记一样"
  },
  {
    "start": 1006.26,
    "end": 1008.0,
    "text": "记录重大决策时的"
  },
  {
    "start": 1008.0,
    "end": 1009.6,
    "text": "信息判断和行动"
  },
  {
    "start": 1009.6,
    "end": 1011.54,
    "text": "用结果来反向验证"
  },
  {
    "start": 1011.54,
    "end": 1013.46,
    "text": "一个在实战中"
  },
  {
    "start": 1013.46,
    "end": 1014.74,
    "text": "赚钱的投资假说"
  },
  {
    "start": 1014.74,
    "end": 1015.88,
    "text": "怎样证明"
  },
  {
    "start": 1015.88,
    "end": 1017.0,
    "text": "它不只是一次"
  },
  {
    "start": 1017.0,
    "end": 1017.74,
    "text": "偶然的幸运"
  },
  {
    "start": 1017.74,
    "end": 1018.0,
    "text": "对"
  }
]
