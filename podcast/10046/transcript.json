[
  {
    "start": 0.0,
    "end": 0.8,
    "text": "想象一下"
  },
  {
    "start": 0.8,
    "end": 2.54,
    "text": "现在是凌晨三点"
  },
  {
    "start": 2.54,
    "end": 4.92,
    "text": "你清醒的躺在黑暗里"
  },
  {
    "start": 4.92,
    "end": 6.82,
    "text": "然后听着时钟滴答作响"
  },
  {
    "start": 6.82,
    "end": 9.6,
    "text": "这个场景太有画面感了"
  },
  {
    "start": 9.6,
    "end": 9.92,
    "text": "对吧"
  },
  {
    "start": 9.92,
    "end": 11.46,
    "text": "你明知道几个小时后"
  },
  {
    "start": 11.46,
    "end": 12.8,
    "text": "还有一个特别重要的早会"
  },
  {
    "start": 12.8,
    "end": 14.22,
    "text": "但你的大脑就是"
  },
  {
    "start": 14.22,
    "end": 15.2,
    "text": "怎么说呢"
  },
  {
    "start": 15.2,
    "end": 16.3,
    "text": "就是不肯关机"
  },
  {
    "start": 16.3,
    "end": 18.44,
    "text": "这时候你的直觉反应是什么"
  },
  {
    "start": 18.44,
    "end": 20.38,
    "text": "肯定是继续躺着"
  },
  {
    "start": 20.38,
    "end": 20.72,
    "text": "没错"
  },
  {
    "start": 20.72,
    "end": 21.92,
    "text": "你大概会想"
  },
  {
    "start": 21.92,
    "end": 23.18,
    "text": "既然睡不着"
  },
  {
    "start": 23.18,
    "end": 25.24,
    "text": "那我就在床上多躺一会儿"
  },
  {
    "start": 25.24,
    "end": 25.86,
    "text": "闭目养神"
  },
  {
    "start": 25.86,
    "end": 28.04,
    "text": "无论如何把欠的觉补回来"
  },
  {
    "start": 28.04,
    "end": 29.76,
    "text": "这听起来简直是天经地义的"
  },
  {
    "start": 29.76,
    "end": 30.52,
    "text": "对吧"
  },
  {
    "start": 30.52,
    "end": 31.2,
    "text": "确实如此"
  },
  {
    "start": 31.2,
    "end": 32.78,
    "text": "就是这完全符合"
  },
  {
    "start": 32.78,
    "end": 35.16,
    "text": "我们人类骨子里的那种补偿心理"
  },
  {
    "start": 35.16,
    "end": 36.18,
    "text": "工作没做完"
  },
  {
    "start": 36.18,
    "end": 36.9,
    "text": "我们就加班"
  },
  {
    "start": 36.9,
    "end": 38.16,
    "text": "体力透支了"
  },
  {
    "start": 38.16,
    "end": 39.38,
    "text": "我们就多休息"
  },
  {
    "start": 39.38,
    "end": 40.68,
    "text": "可是如果你是一个"
  },
  {
    "start": 40.68,
    "end": 42.2,
    "text": "长期被失眠困扰"
  },
  {
    "start": 42.2,
    "end": 44.68,
    "text": "或者正在依靠助眠药物"
  },
  {
    "start": 44.68,
    "end": 45.86,
    "text": "才能勉强入睡的人"
  },
  {
    "start": 45.86,
    "end": 48.38,
    "text": "你肯定早就绝望的发现了"
  },
  {
    "start": 48.38,
    "end": 50.3,
    "text": "这个加倍努力的公式"
  },
  {
    "start": 50.3,
    "end": 51.72,
    "text": "在睡眠这件事上"
  },
  {
    "start": 51.72,
    "end": 53.18,
    "text": "不仅会彻底失灵"
  },
  {
    "start": 53.18,
    "end": 55.68,
    "text": "而且经常是越努力越清醒"
  },
  {
    "start": 55.68,
    "end": 57.1,
    "text": "越想睡越睡不着"
  },
  {
    "start": 57.1,
    "end": 57.28,
    "text": "对"
  },
  {
    "start": 57.28,
    "end": 58.18,
    "text": "所以呢"
  },
  {
    "start": 58.18,
    "end": 59.68,
    "text": "在今天的探讨里"
  },
  {
    "start": 59.68,
    "end": 61.58,
    "text": "我们要为你深度拆解一本"
  },
  {
    "start": 61.58,
    "end": 63.44,
    "text": "专门反击这种直觉的书"
  },
  {
    "start": 63.44,
    "end": 65.22,
    "text": "叫干掉失眠"
  },
  {
    "start": 65.22,
    "end": 67.54,
    "text": "这本书最让人难以置信的地方"
  },
  {
    "start": 67.54,
    "end": 68.02,
    "text": "就在于"
  },
  {
    "start": 68.02,
    "end": 70.34,
    "text": "它偏偏要让你少躺"
  },
  {
    "start": 70.34,
    "end": 71.48,
    "text": "少躺"
  },
  {
    "start": 71.48,
    "end": 73.34,
    "text": "这可是完全颠覆认知的"
  },
  {
    "start": 73.34,
    "end": 73.72,
    "text": "是的"
  },
  {
    "start": 73.72,
    "end": 75.06,
    "text": "它教的是一套"
  },
  {
    "start": 75.06,
    "end": 76.2,
    "text": "目前在医学界"
  },
  {
    "start": 76.2,
    "end": 77.88,
    "text": "极受重视的心理疗法"
  },
  {
    "start": 77.88,
    "end": 80.42,
    "text": "叫做失眠认知行为疗法"
  },
  {
    "start": 80.42,
    "end": 81.76,
    "text": "通常被简称为"
  },
  {
    "start": 81.76,
    "end": 82.9,
    "text": "CBT-I"
  },
  {
    "start": 82.9,
    "end": 83.62,
    "text": "同时"
  },
  {
    "start": 83.62,
    "end": 84.74,
    "text": "它还结合了那个"
  },
  {
    "start": 84.74,
    "end": 86.32,
    "text": "接纳与承诺疗法"
  },
  {
    "start": 86.32,
    "end": 90.32,
    "text": "不过在开始这场极其有违直觉的探讨之前"
  },
  {
    "start": 90.32,
    "end": 92.62,
    "text": "有一件非常重要的事情要先做"
  },
  {
    "start": 92.62,
    "end": 94.54,
    "text": "我们要为这次深度解析"
  },
  {
    "start": 94.54,
    "end": 96.08,
    "text": "划定一个明确的边界"
  },
  {
    "start": 96.08,
    "end": 96.42,
    "text": "对"
  },
  {
    "start": 96.42,
    "end": 98.28,
    "text": "这个安全提醒极其重要"
  },
  {
    "start": 98.28,
    "end": 99.68,
    "text": "正如你刚才提到的"
  },
  {
    "start": 99.68,
    "end": 101.08,
    "text": "这是一本自助手册"
  },
  {
    "start": 101.08,
    "end": 103.06,
    "text": "教的是心理层面的行为改变"
  },
  {
    "start": 103.06,
    "end": 104.52,
    "text": "它绝对不是药物"
  },
  {
    "start": 104.52,
    "end": 105.94,
    "text": "也不代替医生的诊断"
  },
  {
    "start": 105.94,
    "end": 107.38,
    "text": "书里说的很清楚"
  },
  {
    "start": 107.38,
    "end": 108.98,
    "text": "睡眠呼吸暂停"
  },
  {
    "start": 108.98,
    "end": 110.4,
    "text": "周期性肢体抽动"
  },
  {
    "start": 110.4,
    "end": 111.46,
    "text": "不安腿综合征"
  },
  {
    "start": 111.46,
    "end": 112.38,
    "text": "这几种病"
  },
  {
    "start": 112.38,
    "end": 114.08,
    "text": "作者说需要医生医治"
  },
  {
    "start": 114.08,
    "end": 116.2,
    "text": "建议在开始这套疗法前"
  },
  {
    "start": 116.2,
    "end": 117.8,
    "text": "先接受医生的治疗"
  },
  {
    "start": 117.8,
    "end": 118.06,
    "text": "好"
  },
  {
    "start": 118.06,
    "end": 119.64,
    "text": "这点必须听清"
  },
  {
    "start": 119.64,
    "end": 122.54,
    "text": "那对于有些特定的精神状况呢"
  },
  {
    "start": 122.54,
    "end": 124.06,
    "text": "也是要非常小心的"
  },
  {
    "start": 124.06,
    "end": 126.34,
    "text": "有双相障碍或癫痫的人"
  },
  {
    "start": 126.34,
    "end": 127.64,
    "text": "作者强烈建议"
  },
  {
    "start": 127.64,
    "end": 130.1,
    "text": "在受过失眠认知行为疗法培训"
  },
  {
    "start": 130.1,
    "end": 133.02,
    "text": "有相关病情经验的专业人士的指导"
  },
  {
    "start": 133.02,
    "end": 134.76,
    "text": "和密切监督下使用本书"
  },
  {
    "start": 134.76,
    "end": 138.86,
    "text": "原因是这套疗法一开始会让人休息或睡眠更少"
  },
  {
    "start": 138.86,
    "end": 142.54,
    "text": "这会使这类人更容易癫痫发作或情绪不稳"
  },
  {
    "start": 142.54,
    "end": 142.9,
    "text": "哦哇"
  },
  {
    "start": 142.9,
    "end": 144.38,
    "text": "这个真的不能自己乱来"
  },
  {
    "start": 144.38,
    "end": 145.12,
    "text": "另外"
  },
  {
    "start": 145.12,
    "end": 147.46,
    "text": "关于目前已经在吃药的听众"
  },
  {
    "start": 147.46,
    "end": 149.4,
    "text": "我也必须把书里的原话带到"
  },
  {
    "start": 149.4,
    "end": 150.28,
    "text": "作者说"
  },
  {
    "start": 150.28,
    "end": 152.74,
    "text": "他们不是诊断看病开药的医生"
  },
  {
    "start": 152.74,
    "end": 155.68,
    "text": "无论用哪种形式的药物来改善睡眠"
  },
  {
    "start": 155.68,
    "end": 157.5,
    "text": "事先请咨询内科医生"
  },
  {
    "start": 157.5,
    "end": 159.4,
    "text": "有些用来治失眠的药"
  },
  {
    "start": 159.4,
    "end": 160.78,
    "text": "同时也在治别的病"
  },
  {
    "start": 160.78,
    "end": 161.84,
    "text": "比如抑郁症"
  },
  {
    "start": 161.84,
    "end": 162.82,
    "text": "双相障碍"
  },
  {
    "start": 162.82,
    "end": 163.46,
    "text": "焦虑"
  },
  {
    "start": 163.46,
    "end": 165.26,
    "text": "改变之前要问医生"
  },
  {
    "start": 165.26,
    "end": 167.94,
    "text": "避免无意中停掉对其他疾病的治疗"
  },
  {
    "start": 167.94,
    "end": 169.86,
    "text": "确实是安全第一"
  },
  {
    "start": 169.86,
    "end": 172.8,
    "text": "最后还有一个极其现实的安全提醒"
  },
  {
    "start": 172.8,
    "end": 174.74,
    "text": "治疗初期可能更累"
  },
  {
    "start": 174.74,
    "end": 175.74,
    "text": "作者提醒"
  },
  {
    "start": 175.74,
    "end": 177.16,
    "text": "如果担心驾驶安全"
  },
  {
    "start": 177.16,
    "end": 178.46,
    "text": "可以搭别人的车"
  },
  {
    "start": 178.46,
    "end": 180.16,
    "text": "坐公共交通或步行"
  },
  {
    "start": 180.16,
    "end": 181.36,
    "text": "公交车司机"
  },
  {
    "start": 181.36,
    "end": 182.54,
    "text": "长途卡车司机"
  },
  {
    "start": 182.54,
    "end": 184.28,
    "text": "可以在休假一周时开始"
  },
  {
    "start": 184.28,
    "end": 187.02,
    "text": "交代完这些极其严格的边界"
  },
  {
    "start": 187.02,
    "end": 188.36,
    "text": "我们终于可以直面"
  },
  {
    "start": 188.36,
    "end": 190.52,
    "text": "那个困扰无数人的核心疑问了"
  },
  {
    "start": 190.52,
    "end": 192.08,
    "text": "就是到底为什么"
  },
  {
    "start": 192.08,
    "end": 194.24,
    "text": "有些人的失眠只是考前紧张"
  },
  {
    "start": 194.24,
    "end": 195.42,
    "text": "过几天就好了"
  },
  {
    "start": 195.42,
    "end": 196.68,
    "text": "而你的失眠"
  },
  {
    "start": 196.68,
    "end": 198.82,
    "text": "却变成了常年累月的折磨"
  },
  {
    "start": 198.82,
    "end": 200.76,
    "text": "其实为了弄清楚"
  },
  {
    "start": 200.76,
    "end": 201.82,
    "text": "这个背后的机制"
  },
  {
    "start": 201.82,
    "end": 204.66,
    "text": "书里讲了一个叫乔治的男人的故事"
  },
  {
    "start": 204.66,
    "end": 204.9,
    "text": "嗯"
  },
  {
    "start": 204.9,
    "end": 206.54,
    "text": "我觉得很多人听了"
  },
  {
    "start": 206.54,
    "end": 208.68,
    "text": "都会在乔治身上看到自己的影子"
  },
  {
    "start": 208.68,
    "end": 211.28,
    "text": "乔治原本是个睡眠极好的人"
  },
  {
    "start": 211.28,
    "end": 213.74,
    "text": "每天雷打不动能睡七个小时"
  },
  {
    "start": 213.74,
    "end": 215.12,
    "text": "白天精力充沛"
  },
  {
    "start": 215.12,
    "end": 218.18,
    "text": "但转折点发生在他第三个孩子出生后"
  },
  {
    "start": 218.18,
    "end": 220.0,
    "text": "那个婴儿患有疝气"
  },
  {
    "start": 220.0,
    "end": 221.86,
    "text": "夜里经常痛苦的哭闹"
  },
  {
    "start": 221.86,
    "end": 222.38,
    "text": "哎"
  },
  {
    "start": 222.38,
    "end": 225.14,
    "text": "当父母的都懂这种神经紧绷的感觉"
  },
  {
    "start": 225.14,
    "end": 225.64,
    "text": "对"
  },
  {
    "start": 225.64,
    "end": 226.62,
    "text": "作为父亲"
  },
  {
    "start": 226.62,
    "end": 229.2,
    "text": "乔治在那些个夜晚真的是被紧紧绷着"
  },
  {
    "start": 229.2,
    "end": 231.42,
    "text": "有一次被婴儿惊醒后"
  },
  {
    "start": 231.42,
    "end": 232.26,
    "text": "凌晨三点"
  },
  {
    "start": 232.26,
    "end": 233.98,
    "text": "他发现自己再也睡不着了"
  },
  {
    "start": 233.98,
    "end": 236.7,
    "text": "脑子开始不受控制的想工作上的事"
  },
  {
    "start": 236.7,
    "end": 238.98,
    "text": "其实到这一步都还很正常"
  },
  {
    "start": 238.98,
    "end": 241.02,
    "text": "家里有个生病哭闹的婴儿"
  },
  {
    "start": 241.02,
    "end": 242.82,
    "text": "谁都会睡不好对吧"
  },
  {
    "start": 242.82,
    "end": 244.78,
    "text": "但故事的关键在后面"
  },
  {
    "start": 244.78,
    "end": 246.8,
    "text": "六个月后宝宝睡好了"
  },
  {
    "start": 246.8,
    "end": 247.94,
    "text": "乔治没有"
  },
  {
    "start": 247.94,
    "end": 249.54,
    "text": "他周末补觉"
  },
  {
    "start": 249.54,
    "end": 250.96,
    "text": "咖啡越喝越多"
  },
  {
    "start": 250.96,
    "end": 252.16,
    "text": "该开车上班"
  },
  {
    "start": 252.16,
    "end": 253.08,
    "text": "不再骑车"
  },
  {
    "start": 253.08,
    "end": 254.5,
    "text": "还是睡不着"
  },
  {
    "start": 254.5,
    "end": 255.98,
    "text": "这就很奇怪了"
  },
  {
    "start": 255.98,
    "end": 257.86,
    "text": "警报明明已经解除了"
  },
  {
    "start": 257.86,
    "end": 259.54,
    "text": "他为什么还在失眠"
  },
  {
    "start": 259.54,
    "end": 260.98,
    "text": "为了解释这个"
  },
  {
    "start": 260.98,
    "end": 263.88,
    "text": "书里引入了一个叫三P模型的框架"
  },
  {
    "start": 263.88,
    "end": 265.66,
    "text": "专门拆解慢性失眠"
  },
  {
    "start": 265.66,
    "end": 268.94,
    "text": "这三个P分别代表三种因素"
  },
  {
    "start": 268.94,
    "end": 270.52,
    "text": "倾向性特征"
  },
  {
    "start": 270.52,
    "end": 272.94,
    "text": "是你所具有的东西"
  },
  {
    "start": 272.94,
    "end": 273.82,
    "text": "促生性事件"
  },
  {
    "start": 273.82,
    "end": 275.94,
    "text": "是生活给予你的东西"
  },
  {
    "start": 275.94,
    "end": 277.64,
    "text": "持久性因素"
  },
  {
    "start": 277.64,
    "end": 279.28,
    "text": "是你做的事情"
  },
  {
    "start": 279.28,
    "end": 281.04,
    "text": "也就是失眠之后"
  },
  {
    "start": 281.04,
    "end": 282.06,
    "text": "你想了什么"
  },
  {
    "start": 282.06,
    "end": 282.9,
    "text": "做了什么"
  },
  {
    "start": 282.9,
    "end": 283.76,
    "text": "哦"
  },
  {
    "start": 283.76,
    "end": 285.58,
    "text": "我们来对应到乔治身上"
  },
  {
    "start": 285.58,
    "end": 286.24,
    "text": "梳理一下"
  },
  {
    "start": 286.24,
    "end": 288.18,
    "text": "乔治本身可能是一个"
  },
  {
    "start": 288.18,
    "end": 290.0,
    "text": "遇到压力就容易神经紧绷的人"
  },
  {
    "start": 290.0,
    "end": 292.16,
    "text": "就是他本身具有的东西"
  },
  {
    "start": 292.16,
    "end": 293.6,
    "text": "也就是倾向性"
  },
  {
    "start": 293.6,
    "end": 293.78,
    "text": "嗯"
  },
  {
    "start": 293.78,
    "end": 295.78,
    "text": "对的"
  },
  {
    "start": 295.78,
    "end": 297.38,
    "text": "这是一个突发的外部危机"
  },
  {
    "start": 297.38,
    "end": 299.72,
    "text": "这是生活给予他的东西"
  },
  {
    "start": 299.72,
    "end": 300.84,
    "text": "这是促成性"
  },
  {
    "start": 300.84,
    "end": 302.5,
    "text": "这两个加起来"
  },
  {
    "start": 302.5,
    "end": 303.82,
    "text": "合情合理的导致了"
  },
  {
    "start": 303.82,
    "end": 305.5,
    "text": "他最初那几个月的失眠"
  },
  {
    "start": 305.5,
    "end": 308.0,
    "text": "但问题恰恰出在第三个因素上"
  },
  {
    "start": 308.0,
    "end": 309.54,
    "text": "危机消失后"
  },
  {
    "start": 309.54,
    "end": 311.12,
    "text": "乔治为了应对疲惫"
  },
  {
    "start": 311.12,
    "end": 313.4,
    "text": "周末拼命在床上躺着补觉"
  },
  {
    "start": 313.4,
    "end": 315.34,
    "text": "白天狂喝咖啡提神"
  },
  {
    "start": 315.34,
    "end": 318.38,
    "text": "这些就是他失眠后做的事情"
  },
  {
    "start": 318.38,
    "end": 320.36,
    "text": "也就是持久性因素"
  },
  {
    "start": 320.36,
    "end": 322.72,
    "text": "乔治为了自救而做的事情"
  },
  {
    "start": 322.72,
    "end": 325.34,
    "text": "现在恰恰成了问题的一部分"
  },
  {
    "start": 325.34,
    "end": 327.74,
    "text": "所以他其实是在帮倒忙"
  },
  {
    "start": 327.74,
    "end": 328.34,
    "text": "没错"
  },
  {
    "start": 328.34,
    "end": 329.76,
    "text": "你想啊"
  },
  {
    "start": 329.76,
    "end": 332.42,
    "text": "他周末早上强行补觉到十点"
  },
  {
    "start": 332.42,
    "end": 334.1,
    "text": "那周日晚上十点"
  },
  {
    "start": 334.1,
    "end": 335.56,
    "text": "他肯定毫无睡意"
  },
  {
    "start": 335.56,
    "end": 337.76,
    "text": "到了周一凌晨两三点"
  },
  {
    "start": 337.76,
    "end": 339.68,
    "text": "他仅有的一点睡意耗尽"
  },
  {
    "start": 339.68,
    "end": 341.18,
    "text": "生物钟开始错乱"
  },
  {
    "start": 341.18,
    "end": 343.16,
    "text": "失眠就此固化了"
  },
  {
    "start": 343.16,
    "end": 345.98,
    "text": "这就好比一辆汽车在冰面上打滑"
  },
  {
    "start": 345.98,
    "end": 347.82,
    "text": "本来是个突发事件"
  },
  {
    "start": 347.82,
    "end": 349.96,
    "text": "但驾驶员因为极度恐慌"
  },
  {
    "start": 349.96,
    "end": 351.04,
    "text": "猛打方向盘"
  },
  {
    "start": 351.04,
    "end": 352.32,
    "text": "试图过度纠正"
  },
  {
    "start": 352.32,
    "end": 354.86,
    "text": "结果反而让汽车彻底失控了"
  },
  {
    "start": 354.86,
    "end": 356.62,
    "text": "一直在原地打转"
  },
  {
    "start": 356.62,
    "end": 358.32,
    "text": "这个比喻很贴切"
  },
  {
    "start": 358.32,
    "end": 361.6,
    "text": "所以作者得出了一个极其重要的结论"
  },
  {
    "start": 361.6,
    "end": 364.16,
    "text": "真正的问题不是一开始"
  },
  {
    "start": 364.16,
    "end": 365.78,
    "text": "你为什么会失眠"
  },
  {
    "start": 365.78,
    "end": 369.14,
    "text": "而是为什么你一直失眠"
  },
  {
    "start": 369.14,
    "end": 371.22,
    "text": "也就是我们为了对抗失眠"
  },
  {
    "start": 371.22,
    "end": 372.76,
    "text": "做的每一次挣扎"
  },
  {
    "start": 372.76,
    "end": 375.4,
    "text": "其实都在给失眠这只怪兽喂食"
  },
  {
    "start": 375.4,
    "end": 376.6,
    "text": "完全正确"
  },
  {
    "start": 376.6,
    "end": 378.24,
    "text": "关于这种挣扎"
  },
  {
    "start": 378.24,
    "end": 380.24,
    "text": "书里用了两个绝妙的比喻"
  },
  {
    "start": 380.24,
    "end": 383.02,
    "text": "第一个是中国指套陷阱"
  },
  {
    "start": 383.02,
    "end": 385.14,
    "text": "就是那种竹编的管子玩具"
  },
  {
    "start": 385.14,
    "end": 387.06,
    "text": "你把食指插进两端"
  },
  {
    "start": 387.06,
    "end": 388.96,
    "text": "你越是往外用力拉扯"
  },
  {
    "start": 388.96,
    "end": 390.52,
    "text": "那个指管就收得越紧"
  },
  {
    "start": 390.52,
    "end": 392.38,
    "text": "把你套得死死的"
  },
  {
    "start": 392.38,
    "end": 393.3,
    "text": "想要解脱"
  },
  {
    "start": 393.3,
    "end": 395.22,
    "text": "反而是得把手指往里推"
  },
  {
    "start": 395.22,
    "end": 395.76,
    "text": "对"
  },
  {
    "start": 395.76,
    "end": 397.24,
    "text": "第二个比喻是"
  },
  {
    "start": 397.24,
    "end": 400.2,
    "text": "想象你在和一个巨大的失眠怪兽拔河"
  },
  {
    "start": 400.2,
    "end": 402.02,
    "text": "中间隔着一个无底洞"
  },
  {
    "start": 402.02,
    "end": 404.36,
    "text": "你越是用力往你这边拉"
  },
  {
    "start": 404.36,
    "end": 406.04,
    "text": "怪兽反抗的就越激烈"
  },
  {
    "start": 406.04,
    "end": 407.6,
    "text": "一步步把你拖向深渊"
  },
  {
    "start": 407.6,
    "end": 409.86,
    "text": "可是如果不拉绳子"
  },
  {
    "start": 409.86,
    "end": 412.38,
    "text": "难道就任由怪兽把我拽下去吗"
  },
  {
    "start": 412.38,
    "end": 414.32,
    "text": "这也太让人无力了吧"
  },
  {
    "start": 414.32,
    "end": 416.72,
    "text": "解决办法不是拉赢怪兽"
  },
  {
    "start": 416.72,
    "end": 418.76,
    "text": "而是放下那根绳子"
  },
  {
    "start": 418.76,
    "end": 421.84,
    "text": "这就是疗法中关于接纳的核心"
  },
  {
    "start": 421.84,
    "end": 423.26,
    "text": "那这里我要特别强调"
  },
  {
    "start": 423.26,
    "end": 425.52,
    "text": "接纳绝对不是摆烂"
  },
  {
    "start": 425.52,
    "end": 427.7,
    "text": "要求你接纳不睡觉"
  },
  {
    "start": 427.7,
    "end": 429.16,
    "text": "不等于让你放弃希望"
  },
  {
    "start": 429.16,
    "end": 431.5,
    "text": "也不是让你接纳一辈子睡不好"
  },
  {
    "start": 431.5,
    "end": 433.54,
    "text": "更不是不去做行为治疗"
  },
  {
    "start": 433.54,
    "end": 436.88,
    "text": "他们要求你愿意做两件事"
  },
  {
    "start": 436.88,
    "end": 439.44,
    "text": "愿意做出令人不舒服的行为改变"
  },
  {
    "start": 439.44,
    "end": 442.02,
    "text": "以及愿意某个晚上不睡"
  },
  {
    "start": 442.02,
    "end": 445.68,
    "text": "愿意做出令人不舒服的行为改变"
  },
  {
    "start": 445.68,
    "end": 448.6,
    "text": "既然我们知道自救行为成了问题"
  },
  {
    "start": 448.6,
    "end": 450.44,
    "text": "那我们具体该怎么改变"
  },
  {
    "start": 450.44,
    "end": 452.82,
    "text": "如果我现在半夜三点醒了"
  },
  {
    "start": 452.82,
    "end": 454.08,
    "text": "难道不该在床上"
  },
  {
    "start": 454.08,
    "end": 455.56,
    "text": "好好躺着闭目养神吗"
  },
  {
    "start": 455.56,
    "end": 457.62,
    "text": "这就到了第一步行为改变"
  },
  {
    "start": 457.62,
    "end": 459.14,
    "text": "叫做刺激控制"
  },
  {
    "start": 459.14,
    "end": 462.24,
    "text": "它的底层逻辑其实是条件反射"
  },
  {
    "start": 462.24,
    "end": 463.84,
    "text": "就像巴甫洛夫的狗"
  },
  {
    "start": 463.84,
    "end": 466.0,
    "text": "听到铃铛就流口水一样"
  },
  {
    "start": 466.0,
    "end": 467.16,
    "text": "对于睡眠好的人"
  },
  {
    "start": 467.16,
    "end": 470.12,
    "text": "床这个环境只和睡觉发生连接"
  },
  {
    "start": 470.12,
    "end": 471.3,
    "text": "头沾枕头"
  },
  {
    "start": 471.3,
    "end": 472.8,
    "text": "大脑就释放睡眠信号"
  },
  {
    "start": 472.8,
    "end": 475.52,
    "text": "但对于长期失眠的人来说"
  },
  {
    "start": 475.52,
    "end": 478.48,
    "text": "床已经变成了一个焦虑的审讯室了吧"
  },
  {
    "start": 478.48,
    "end": 479.88,
    "text": "太对了"
  },
  {
    "start": 479.88,
    "end": 483.6,
    "text": "大脑把床和翻来覆去计算时间"
  },
  {
    "start": 483.6,
    "end": 486.28,
    "text": "恐慌明天死死的绑定在一起了"
  },
  {
    "start": 486.28,
    "end": 487.42,
    "text": "哇一躺上床"
  },
  {
    "start": 487.42,
    "end": 489.44,
    "text": "释放的全是清醒的压力荷尔蒙"
  },
  {
    "start": 489.44,
    "end": 491.62,
    "text": "那怎么拆散这种联系"
  },
  {
    "start": 491.62,
    "end": 493.96,
    "text": "作者给出了极其严格的法则"
  },
  {
    "start": 493.96,
    "end": 497.0,
    "text": "床和卧室只用来睡觉和做爱"
  },
  {
    "start": 497.0,
    "end": 498.58,
    "text": "只在困的时候上床"
  },
  {
    "start": 498.58,
    "end": 500.34,
    "text": "半夜醒来超过20分钟"
  },
  {
    "start": 500.34,
    "end": 501.58,
    "text": "就离开卧室"
  },
  {
    "start": 501.58,
    "end": 504.14,
    "text": "做些枯燥的或令人放松的事情"
  },
  {
    "start": 504.14,
    "end": 505.78,
    "text": "困了再回床上"
  },
  {
    "start": 505.78,
    "end": 506.78,
    "text": "需要是重复"
  },
  {
    "start": 506.78,
    "end": 508.56,
    "text": "每天固定时间起床"
  },
  {
    "start": 508.56,
    "end": 509.9,
    "text": "白天不小睡"
  },
  {
    "start": 509.9,
    "end": 510.72,
    "text": "东东"
  },
  {
    "start": 510.72,
    "end": 512.86,
    "text": "半夜醒了还要离开床"
  },
  {
    "start": 512.86,
    "end": 515.2,
    "text": "这听起来简直太反人性了"
  },
  {
    "start": 515.2,
    "end": 517.08,
    "text": "而且半夜离开床"
  },
  {
    "start": 517.08,
    "end": 519.6,
    "text": "其实很容易让人忍不住去看表"
  },
  {
    "start": 519.6,
    "end": 520.9,
    "text": "一去看表"
  },
  {
    "start": 520.9,
    "end": 522.38,
    "text": "脑子里就开始疯狂计算"
  },
  {
    "start": 522.38,
    "end": 523.04,
    "text": "完了"
  },
  {
    "start": 523.04,
    "end": 524.04,
    "text": "现在三点半"
  },
  {
    "start": 524.04,
    "end": 525.66,
    "text": "我只剩三个小时能睡了"
  },
  {
    "start": 525.66,
    "end": 527.6,
    "text": "这就是为什么书里强调"
  },
  {
    "start": 527.6,
    "end": 529.62,
    "text": "判断有没有到20分钟"
  },
  {
    "start": 529.62,
    "end": 531.58,
    "text": "全凭你自己的主观感觉"
  },
  {
    "start": 531.58,
    "end": 533.2,
    "text": "绝对不要去看钟表"
  },
  {
    "start": 533.2,
    "end": 534.64,
    "text": "感觉躺得烦躁了"
  },
  {
    "start": 534.64,
    "end": 535.7,
    "text": "就果断起来"
  },
  {
    "start": 535.7,
    "end": 536.9,
    "text": "去昏暗的光线下"
  },
  {
    "start": 536.9,
    "end": 537.9,
    "text": "看看无聊的杂志"
  },
  {
    "start": 537.9,
    "end": 540.16,
    "text": "而且千万不要趁机工作"
  },
  {
    "start": 540.16,
    "end": 542.96,
    "text": "绝对不能让大脑尝到半夜清醒"
  },
  {
    "start": 542.96,
    "end": 544.34,
    "text": "可以高效工作的甜头"
  },
  {
    "start": 544.34,
    "end": 545.08,
    "text": "没错"
  },
  {
    "start": 545.08,
    "end": 546.54,
    "text": "在这七条规则里"
  },
  {
    "start": 546.54,
    "end": 548.32,
    "text": "有一条被视作铁律"
  },
  {
    "start": 548.32,
    "end": 549.26,
    "text": "我们常说"
  },
  {
    "start": 549.26,
    "end": 551.16,
    "text": "如果你只愿意做一件"
  },
  {
    "start": 551.16,
    "end": 552.24,
    "text": "有助于睡眠的事情"
  },
  {
    "start": 552.24,
    "end": 554.58,
    "text": "那就是每天在相同的时间起床"
  },
  {
    "start": 554.58,
    "end": 556.28,
    "text": "不管昨晚睡了多久"
  },
  {
    "start": 556.28,
    "end": 557.14,
    "text": "时间一到"
  },
  {
    "start": 557.14,
    "end": 558.3,
    "text": "必须下床"
  },
  {
    "start": 558.3,
    "end": 559.02,
    "text": "可是"
  },
  {
    "start": 559.02,
    "end": 561.32,
    "text": "如果我本来在床上"
  },
  {
    "start": 561.32,
    "end": 562.8,
    "text": "很多时候就是醒着的"
  },
  {
    "start": 562.8,
    "end": 565.12,
    "text": "而且我整体的真实睡眠时间"
  },
  {
    "start": 565.12,
    "end": 566.2,
    "text": "本身就非常短"
  },
  {
    "start": 566.2,
    "end": 568.34,
    "text": "仅仅离开床好像不够"
  },
  {
    "start": 568.34,
    "end": 571.28,
    "text": "接下来就是所谓的睡眠限制了"
  },
  {
    "start": 571.28,
    "end": 573.46,
    "text": "它的逻辑是睡眠驱动力"
  },
  {
    "start": 573.46,
    "end": 575.8,
    "text": "也就是大脑对睡眠的饥饿感"
  },
  {
    "start": 575.8,
    "end": 578.36,
    "text": "睡眠患者总是在床上躺太久"
  },
  {
    "start": 578.36,
    "end": 580.0,
    "text": "导致饥饿感被摊薄了"
  },
  {
    "start": 580.0,
    "end": 581.56,
    "text": "那具体怎么操作"
  },
  {
    "start": 581.56,
    "end": 582.76,
    "text": "规则很明确"
  },
  {
    "start": 582.76,
    "end": 584.42,
    "text": "睡眠限制的第一步"
  },
  {
    "start": 584.42,
    "end": 586.56,
    "text": "是用10到14天的睡眠日记"
  },
  {
    "start": 586.56,
    "end": 588.66,
    "text": "算出平均总睡眠时间"
  },
  {
    "start": 588.66,
    "end": 590.16,
    "text": "平均躺床时间"
  },
  {
    "start": 590.16,
    "end": 591.5,
    "text": "以及睡眠效率"
  },
  {
    "start": 591.5,
    "end": 593.1,
    "text": "也就是睡着的时间"
  },
  {
    "start": 593.1,
    "end": 594.7,
    "text": "占躺床时间的比例"
  },
  {
    "start": 594.7,
    "end": 596.12,
    "text": "书里的目标是"
  },
  {
    "start": 596.12,
    "end": 598.32,
    "text": "年轻人和成年人90%"
  },
  {
    "start": 598.32,
    "end": 599.78,
    "text": "老年人85%"
  },
  {
    "start": 599.78,
    "end": 601.74,
    "text": "然后把躺床时间"
  },
  {
    "start": 601.74,
    "end": 604.1,
    "text": "限制到和平均睡眠时间一致"
  },
  {
    "start": 604.1,
    "end": 605.88,
    "text": "但不少于五个小时"
  },
  {
    "start": 605.88,
    "end": 607.28,
    "text": "天哪"
  },
  {
    "start": 607.28,
    "end": 608.2,
    "text": "想象一下"
  },
  {
    "start": 608.2,
    "end": 609.38,
    "text": "如果你记录下来"
  },
  {
    "start": 609.38,
    "end": 610.6,
    "text": "平均只睡六小时"
  },
  {
    "start": 610.6,
    "end": 612.02,
    "text": "哪怕你之前习惯"
  },
  {
    "start": 612.02,
    "end": 613.44,
    "text": "躺九小时试图补觉"
  },
  {
    "start": 613.44,
    "end": 615.62,
    "text": "现在也只能躺六小时"
  },
  {
    "start": 615.62,
    "end": 616.38,
    "text": "不管多困"
  },
  {
    "start": 616.38,
    "end": 617.48,
    "text": "时间没到都不许上床"
  },
  {
    "start": 617.48,
    "end": 619.28,
    "text": "这太折磨人了"
  },
  {
    "start": 619.28,
    "end": 621.0,
    "text": "一开始确实痛苦"
  },
  {
    "start": 621.0,
    "end": 623.74,
    "text": "它本质上是轻度的睡眠剥夺"
  },
  {
    "start": 623.74,
    "end": 626.34,
    "text": "但它是为了把你稀薄的睡眠"
  },
  {
    "start": 626.34,
    "end": 628.8,
    "text": "压缩成高质量的整块睡眠"
  },
  {
    "start": 628.8,
    "end": 629.76,
    "text": "之后"
  },
  {
    "start": 629.76,
    "end": 630.68,
    "text": "再根据数据"
  },
  {
    "start": 630.68,
    "end": 631.26,
    "text": "微调"
  },
  {
    "start": 631.26,
    "end": 634.46,
    "text": "一周平均睡眠效率超过90%"
  },
  {
    "start": 634.46,
    "end": 635.9,
    "text": "老年人85%"
  },
  {
    "start": 635.9,
    "end": 638.12,
    "text": "躺床时间增加15分钟"
  },
  {
    "start": 638.12,
    "end": 639.8,
    "text": "低于85%"
  },
  {
    "start": 639.8,
    "end": 641.3,
    "text": "老年人80%"
  },
  {
    "start": 641.3,
    "end": 644.54,
    "text": "把躺床时间减到当前平均睡眠时间"
  },
  {
    "start": 644.54,
    "end": 646.26,
    "text": "但不少于五个小时"
  },
  {
    "start": 646.26,
    "end": 649.72,
    "text": "在85%到89%之间不变"
  },
  {
    "start": 649.72,
    "end": 651.16,
    "text": "熬了一个星期"
  },
  {
    "start": 651.16,
    "end": 653.0,
    "text": "才奖励15分钟的躺床时间"
  },
  {
    "start": 653.0,
    "end": 654.74,
    "text": "这步子也太小了吧"
  },
  {
    "start": 654.74,
    "end": 656.12,
    "text": "走得稳嘛"
  },
  {
    "start": 656.12,
    "end": 658.38,
    "text": "不过作者也诚实地承认"
  },
  {
    "start": 658.38,
    "end": 660.16,
    "text": "没有任何研究比较过"
  },
  {
    "start": 660.16,
    "end": 662.26,
    "text": "不同版本的睡眠限制疗法"
  },
  {
    "start": 662.26,
    "end": 664.84,
    "text": "其实就是临床上的经验总结"
  },
  {
    "start": 664.84,
    "end": 666.1,
    "text": "明白了"
  },
  {
    "start": 666.1,
    "end": 668.24,
    "text": "那我们平时经常听到的"
  },
  {
    "start": 668.24,
    "end": 669.56,
    "text": "那些常规建议呢"
  },
  {
    "start": 669.56,
    "end": 670.94,
    "text": "比如戒咖啡"
  },
  {
    "start": 670.94,
    "end": 671.64,
    "text": "不喝酒"
  },
  {
    "start": 671.64,
    "end": 672.16,
    "text": "遮光"
  },
  {
    "start": 672.16,
    "end": 673.12,
    "text": "换个好枕头"
  },
  {
    "start": 673.12,
    "end": 676.56,
    "text": "这些睡眠卫生建议排在什么位置"
  },
  {
    "start": 676.56,
    "end": 679.12,
    "text": "作者用了一个口腔卫生的比喻"
  },
  {
    "start": 679.12,
    "end": 681.62,
    "text": "每天刷牙能防止长新蛀牙"
  },
  {
    "start": 681.62,
    "end": 683.66,
    "text": "但如果你已经有个大牙洞了"
  },
  {
    "start": 683.66,
    "end": 686.36,
    "text": "牙医会说回家继续刷牙就能补好吗"
  },
  {
    "start": 686.36,
    "end": 687.66,
    "text": "显然不会"
  },
  {
    "start": 687.66,
    "end": 689.22,
    "text": "我都疼得睡不着了"
  },
  {
    "start": 689.22,
    "end": 690.34,
    "text": "我需要的是补牙"
  },
  {
    "start": 690.34,
    "end": 691.68,
    "text": "对啊"
  },
  {
    "start": 691.68,
    "end": 693.04,
    "text": "单独的睡眠卫生"
  },
  {
    "start": 693.04,
    "end": 695.36,
    "text": "不可能让你获得优质的睡眠"
  },
  {
    "start": 695.36,
    "end": 697.56,
    "text": "戒咖啡这些你可以做"
  },
  {
    "start": 697.56,
    "end": 699.04,
    "text": "但只能作为辅助"
  },
  {
    "start": 699.04,
    "end": 701.46,
    "text": "单靠它们治不好慢性失眠"
  },
  {
    "start": 701.46,
    "end": 703.64,
    "text": "既然说到辅助和干预"
  },
  {
    "start": 703.64,
    "end": 705.16,
    "text": "有个现实问题必须要问"
  },
  {
    "start": 705.16,
    "end": 707.5,
    "text": "对于那些已经在依靠褪黑素"
  },
  {
    "start": 707.5,
    "end": 709.96,
    "text": "或者处方安眠药维持睡眠的人"
  },
  {
    "start": 709.96,
    "end": 712.04,
    "text": "这套心理疗法意味着什么"
  },
  {
    "start": 712.04,
    "end": 713.86,
    "text": "凡是涉及用药"
  },
  {
    "start": 713.86,
    "end": 714.58,
    "text": "减药"
  },
  {
    "start": 714.58,
    "end": 716.22,
    "text": "书里和我们的态度一样"
  },
  {
    "start": 716.22,
    "end": 717.34,
    "text": "先问医生"
  },
  {
    "start": 717.34,
    "end": 719.08,
    "text": "个人的具体诊断"
  },
  {
    "start": 719.08,
    "end": 720.52,
    "text": "必须由医生决定"
  },
  {
    "start": 720.52,
    "end": 722.18,
    "text": "书里只解释了"
  },
  {
    "start": 722.18,
    "end": 723.62,
    "text": "阶段反应的可能性"
  },
  {
    "start": 723.62,
    "end": 725.38,
    "text": "如果你慢慢的脱离"
  },
  {
    "start": 725.38,
    "end": 726.28,
    "text": "睡眠辅助用品"
  },
  {
    "start": 726.28,
    "end": 727.52,
    "text": "逐渐减少剂量"
  },
  {
    "start": 727.52,
    "end": 729.84,
    "text": "就不太可能出现反弹性失眠"
  },
  {
    "start": 729.84,
    "end": 731.58,
    "text": "或令人不适的极端反应"
  },
  {
    "start": 731.58,
    "end": 734.34,
    "text": "这个慢慢有具体的标准吗"
  },
  {
    "start": 734.34,
    "end": 735.24,
    "text": "并没有"
  },
  {
    "start": 735.24,
    "end": 737.76,
    "text": "书里没有给出具体的减药日程"
  },
  {
    "start": 737.76,
    "end": 740.68,
    "text": "关于什么时候停药最合适"
  },
  {
    "start": 740.68,
    "end": 742.32,
    "text": "怎样逐渐减量"
  },
  {
    "start": 742.32,
    "end": 743.6,
    "text": "作者写的是"
  },
  {
    "start": 743.6,
    "end": 745.48,
    "text": "可以咨询专业人士"
  },
  {
    "start": 745.48,
    "end": 748.22,
    "text": "不过对于一边做行为疗法"
  },
  {
    "start": 748.22,
    "end": 749.06,
    "text": "一边减药"
  },
  {
    "start": 749.06,
    "end": 750.22,
    "text": "有个关键提示"
  },
  {
    "start": 750.22,
    "end": 753.38,
    "text": "需要避免同时改变药物剂量"
  },
  {
    "start": 753.38,
    "end": 754.4,
    "text": "和躺床时间"
  },
  {
    "start": 754.4,
    "end": 756.74,
    "text": "他们通常建议两种改变"
  },
  {
    "start": 756.74,
    "end": 757.72,
    "text": "间隔五天"
  },
  {
    "start": 757.72,
    "end": 758.76,
    "text": "并且明说"
  },
  {
    "start": 758.76,
    "end": 760.5,
    "text": "我们不了解相关数据"
  },
  {
    "start": 760.5,
    "end": 762.5,
    "text": "所以这个建议不是基于研究"
  },
  {
    "start": 762.5,
    "end": 764.3,
    "text": "这个很好理解"
  },
  {
    "start": 764.3,
    "end": 766.62,
    "text": "这两种疗法都依赖"
  },
  {
    "start": 766.62,
    "end": 768.38,
    "text": "让你持续睡的较少"
  },
  {
    "start": 768.38,
    "end": 770.64,
    "text": "来培养真实的睡眠欲望"
  },
  {
    "start": 770.64,
    "end": 772.6,
    "text": "所以作者不建议疗程中"
  },
  {
    "start": 772.6,
    "end": 773.84,
    "text": "为了能好好睡一晚"
  },
  {
    "start": 773.84,
    "end": 775.46,
    "text": "而偶尔吃一次药"
  },
  {
    "start": 775.46,
    "end": 776.66,
    "text": "一旦吃药"
  },
  {
    "start": 776.66,
    "end": 778.06,
    "text": "强行睡八小时"
  },
  {
    "start": 778.06,
    "end": 780.16,
    "text": "好不容易攒的睡眠驱动力"
  },
  {
    "start": 780.16,
    "end": 781.0,
    "text": "就全毁了"
  },
  {
    "start": 781.0,
    "end": 782.06,
    "text": "另外"
  },
  {
    "start": 782.06,
    "end": 784.24,
    "text": "关于针灸之类的替代疗法"
  },
  {
    "start": 784.24,
    "end": 785.18,
    "text": "书中没探讨"
  },
  {
    "start": 785.18,
    "end": 786.14,
    "text": "我们也不下结论"
  },
  {
    "start": 786.14,
    "end": 786.78,
    "text": "嗯"
  },
  {
    "start": 786.78,
    "end": 788.04,
    "text": "说完了行为和药物"
  },
  {
    "start": 788.04,
    "end": 789.02,
    "text": "我们得面对"
  },
  {
    "start": 789.02,
    "end": 790.34,
    "text": "失眠患者脑子里的"
  },
  {
    "start": 790.34,
    "end": 791.16,
    "text": "另一个大麻烦"
  },
  {
    "start": 791.16,
    "end": 793.0,
    "text": "停不下来的想法"
  },
  {
    "start": 793.0,
    "end": 794.84,
    "text": "这个太真实了"
  },
  {
    "start": 794.84,
    "end": 796.38,
    "text": "身体累得要命"
  },
  {
    "start": 796.38,
    "end": 798.08,
    "text": "脑子里却像有个播音员"
  },
  {
    "start": 798.08,
    "end": 799.28,
    "text": "在不停播忧虑"
  },
  {
    "start": 799.28,
    "end": 801.0,
    "text": "明天开会一定会搞砸"
  },
  {
    "start": 801.0,
    "end": 802.02,
    "text": "我会失去工作"
  },
  {
    "start": 802.02,
    "end": 803.82,
    "text": "这时候行为限制"
  },
  {
    "start": 803.82,
    "end": 805.0,
    "text": "好像帮不上忙了"
  },
  {
    "start": 805.0,
    "end": 805.68,
    "text": "是的"
  },
  {
    "start": 805.68,
    "end": 808.2,
    "text": "这时候就需要用到认知重构"
  },
  {
    "start": 808.2,
    "end": 809.6,
    "text": "但要澄清一点"
  },
  {
    "start": 809.6,
    "end": 811.0,
    "text": "这绝对不是教你"
  },
  {
    "start": 811.0,
    "end": 812.12,
    "text": "往好处想"
  },
  {
    "start": 812.12,
    "end": 814.68,
    "text": "就是我不用强行告诉自己"
  },
  {
    "start": 814.68,
    "end": 816.8,
    "text": "明天一定会是充满阳光的一天"
  },
  {
    "start": 816.8,
    "end": 817.54,
    "text": "没错"
  },
  {
    "start": 817.54,
    "end": 819.1,
    "text": "那种不现实的积极"
  },
  {
    "start": 819.1,
    "end": 820.34,
    "text": "只会加重焦虑"
  },
  {
    "start": 820.34,
    "end": 821.52,
    "text": "认知重构"
  },
  {
    "start": 821.52,
    "end": 823.48,
    "text": "是从消极变到现实"
  },
  {
    "start": 823.48,
    "end": 824.28,
    "text": "承认"
  },
  {
    "start": 824.28,
    "end": 825.08,
    "text": "现实就是"
  },
  {
    "start": 825.08,
    "end": 826.7,
    "text": "明天会很不舒服"
  },
  {
    "start": 826.7,
    "end": 827.46,
    "text": "但我死不了"
  },
  {
    "start": 827.46,
    "end": 828.94,
    "text": "如果我的担忧"
  },
  {
    "start": 828.94,
    "end": 830.3,
    "text": "是非常现实的呢"
  },
  {
    "start": 830.3,
    "end": 832.46,
    "text": "比如明天的重要采购清单"
  },
  {
    "start": 832.46,
    "end": 834.06,
    "text": "这种现实的担忧"
  },
  {
    "start": 834.06,
    "end": 835.18,
    "text": "作者的办法是"
  },
  {
    "start": 835.18,
    "end": 836.3,
    "text": "给他划定边界"
  },
  {
    "start": 836.3,
    "end": 838.74,
    "text": "一天选一到两个时间"
  },
  {
    "start": 838.74,
    "end": 840.46,
    "text": "每次10到30分钟"
  },
  {
    "start": 840.46,
    "end": 842.58,
    "text": "书里说开始设10分钟比较好"
  },
  {
    "start": 842.58,
    "end": 843.48,
    "text": "设定时器"
  },
  {
    "start": 843.48,
    "end": 844.66,
    "text": "在这10分钟里"
  },
  {
    "start": 844.66,
    "end": 845.96,
    "text": "我要想出解决办法吗"
  },
  {
    "start": 845.96,
    "end": 846.62,
    "text": "不"
  },
  {
    "start": 846.62,
    "end": 847.72,
    "text": "别去解决"
  },
  {
    "start": 847.72,
    "end": 849.96,
    "text": "在这个指定担忧时间里"
  },
  {
    "start": 849.96,
    "end": 850.76,
    "text": "唯一的任务"
  },
  {
    "start": 850.76,
    "end": 851.9,
    "text": "就是把忧虑想透彻"
  },
  {
    "start": 851.9,
    "end": 853.22,
    "text": "定时器一想"
  },
  {
    "start": 853.22,
    "end": 853.86,
    "text": "立刻停"
  },
  {
    "start": 853.86,
    "end": 855.52,
    "text": "其他时间如果冒着想法"
  },
  {
    "start": 855.52,
    "end": 856.9,
    "text": "就推迟到这段时间"
  },
  {
    "start": 856.9,
    "end": 858.26,
    "text": "把想法当成"
  },
  {
    "start": 858.26,
    "end": 859.88,
    "text": "电视屏幕下方的滚动字幕"
  },
  {
    "start": 859.88,
    "end": 860.86,
    "text": "哇"
  },
  {
    "start": 860.86,
    "end": 861.86,
    "text": "用刺激控制"
  },
  {
    "start": 861.86,
    "end": 863.4,
    "text": "把床和清醒剥离"
  },
  {
    "start": 863.4,
    "end": 864.86,
    "text": "用睡眠限制"
  },
  {
    "start": 864.86,
    "end": 866.04,
    "text": "挤出睡眠驱动力"
  },
  {
    "start": 866.04,
    "end": 867.68,
    "text": "再给担忧设定边界"
  },
  {
    "start": 867.68,
    "end": 869.3,
    "text": "逻辑非常闭环"
  },
  {
    "start": 869.3,
    "end": 871.24,
    "text": "但作为深度解析"
  },
  {
    "start": 871.24,
    "end": 873.7,
    "text": "外界和学术界怎么看"
  },
  {
    "start": 873.7,
    "end": 874.78,
    "text": "这真的有效吗"
  },
  {
    "start": 874.78,
    "end": 875.98,
    "text": "非常有效"
  },
  {
    "start": 875.98,
    "end": 877.1,
    "text": "而且地位很高"
  },
  {
    "start": 877.1,
    "end": 878.84,
    "text": "刺激控制由心理学家"
  },
  {
    "start": 878.84,
    "end": 880.5,
    "text": "布特津在1972年提出"
  },
  {
    "start": 880.5,
    "end": 882.48,
    "text": "睡眠限制由斯皮尔曼等人"
  },
  {
    "start": 882.48,
    "end": 883.88,
    "text": "在1987年确立"
  },
  {
    "start": 883.88,
    "end": 885.58,
    "text": "可以说历史悠久了"
  },
  {
    "start": 885.58,
    "end": 888.38,
    "text": "那主流指南的评价呢"
  },
  {
    "start": 888.38,
    "end": 890.16,
    "text": "美国内科医师学会"
  },
  {
    "start": 890.16,
    "end": 891.56,
    "text": "2016年的指南建议"
  },
  {
    "start": 891.56,
    "end": 893.06,
    "text": "成人慢性失眠"
  },
  {
    "start": 893.06,
    "end": 894.64,
    "text": "首先应接受CBTI"
  },
  {
    "start": 894.64,
    "end": 896.42,
    "text": "美国睡眠医学会的指南"
  },
  {
    "start": 896.42,
    "end": 897.66,
    "text": "也给了强推荐"
  },
  {
    "start": 897.68,
    "end": 898.44,
    "text": "并明确说"
  },
  {
    "start": 898.44,
    "end": 899.76,
    "text": "睡眠卫生教育"
  },
  {
    "start": 899.76,
    "end": 901.24,
    "text": "不应单独使用"
  },
  {
    "start": 901.24,
    "end": 902.38,
    "text": "这和书里的说法一致"
  },
  {
    "start": 902.38,
    "end": 904.18,
    "text": "那有没有什么"
  },
  {
    "start": 904.18,
    "end": 906.06,
    "text": "反方意见或者局限性"
  },
  {
    "start": 906.06,
    "end": 907.88,
    "text": "有个发现很值得玩味"
  },
  {
    "start": 907.88,
    "end": 909.28,
    "text": "指南和研究里说"
  },
  {
    "start": 909.28,
    "end": 910.94,
    "text": "一项汇萃分析发现"
  },
  {
    "start": 910.94,
    "end": 912.24,
    "text": "没有证据表明"
  },
  {
    "start": 912.24,
    "end": 914.28,
    "text": "CBTI能可靠地改善"
  },
  {
    "start": 914.28,
    "end": 915.36,
    "text": "睡眠监测仪器"
  },
  {
    "start": 915.36,
    "end": 917.08,
    "text": "测得的客观睡眠指标"
  },
  {
    "start": 917.08,
    "end": 918.12,
    "text": "慢着"
  },
  {
    "start": 918.12,
    "end": 919.3,
    "text": "费了这么大劲"
  },
  {
    "start": 919.3,
    "end": 920.5,
    "text": "仪器测出来"
  },
  {
    "start": 920.5,
    "end": 922.28,
    "text": "睡眠其实没实质性改变"
  },
  {
    "start": 922.28,
    "end": 923.84,
    "text": "我们可以推想一下"
  },
  {
    "start": 923.84,
    "end": 924.54,
    "text": "背后的深意"
  },
  {
    "start": 924.54,
    "end": 926.42,
    "text": "这就像给背痛患者"
  },
  {
    "start": 926.42,
    "end": 927.02,
    "text": "开止痛药"
  },
  {
    "start": 927.02,
    "end": 928.38,
    "text": "核磁共振拍出来"
  },
  {
    "start": 928.38,
    "end": 930.38,
    "text": "腰椎间盘可能还是突出的"
  },
  {
    "start": 930.38,
    "end": 931.54,
    "text": "但患者主观觉得"
  },
  {
    "start": 931.54,
    "end": 932.26,
    "text": "不痛了"
  },
  {
    "start": 932.26,
    "end": 933.16,
    "text": "能跑步了"
  },
  {
    "start": 933.16,
    "end": 934.16,
    "text": "这就是成功"
  },
  {
    "start": 934.16,
    "end": 936.16,
    "text": "患者觉得主观感觉"
  },
  {
    "start": 936.16,
    "end": 936.72,
    "text": "睡得好了"
  },
  {
    "start": 936.72,
    "end": 937.62,
    "text": "不痛苦了"
  },
  {
    "start": 937.62,
    "end": 938.52,
    "text": "就足够了"
  },
  {
    "start": 938.52,
    "end": 940.24,
    "text": "主观的痛苦消除了"
  },
  {
    "start": 940.24,
    "end": 941.72,
    "text": "就是巨大的胜利"
  },
  {
    "start": 941.72,
    "end": 943.3,
    "text": "还有别的局限吗"
  },
  {
    "start": 943.3,
    "end": 944.88,
    "text": "还有一项研究指出"
  },
  {
    "start": 944.88,
    "end": 946.42,
    "text": "没有治疗师参与的"
  },
  {
    "start": 946.42,
    "end": 947.86,
    "text": "全自动数字CBTI"
  },
  {
    "start": 947.86,
    "end": 948.68,
    "text": "虽然有效"
  },
  {
    "start": 948.68,
    "end": 950.1,
    "text": "效果通常弱于"
  },
  {
    "start": 950.1,
    "end": 952.42,
    "text": "有治疗师辅助的版本"
  },
  {
    "start": 952.42,
    "end": 953.82,
    "text": "这里得跟听众明确一下"
  },
  {
    "start": 953.82,
    "end": 955.7,
    "text": "这项研究比较的是"
  },
  {
    "start": 955.7,
    "end": 957.22,
    "text": "全自动数字版"
  },
  {
    "start": 957.22,
    "end": 958.94,
    "text": "不是我们讨论的纸质书"
  },
  {
    "start": 958.94,
    "end": 960.9,
    "text": "但把它套到这本书上"
  },
  {
    "start": 960.9,
    "end": 962.14,
    "text": "是我们的推想"
  },
  {
    "start": 962.14,
    "end": 963.44,
    "text": "自己摸索"
  },
  {
    "start": 963.44,
    "end": 964.86,
    "text": "放弃的概率肯定大"
  },
  {
    "start": 964.86,
    "end": 965.74,
    "text": "确实"
  },
  {
    "start": 965.74,
    "end": 967.84,
    "text": "所以作者在第十三章里"
  },
  {
    "start": 967.84,
    "end": 969.32,
    "text": "作者的建议是"
  },
  {
    "start": 969.32,
    "end": 971.54,
    "text": "现在执行六到八周后评估"
  },
  {
    "start": 971.54,
    "end": 972.82,
    "text": "检查自己"
  },
  {
    "start": 972.82,
    "end": 974.16,
    "text": "有没有严格执行"
  },
  {
    "start": 974.16,
    "end": 975.7,
    "text": "如果失去动力"
  },
  {
    "start": 975.7,
    "end": 976.82,
    "text": "感到被困住"
  },
  {
    "start": 976.82,
    "end": 977.72,
    "text": "他们建议"
  },
  {
    "start": 977.72,
    "end": 979.3,
    "text": "寻求专业人士的帮助"
  },
  {
    "start": 979.3,
    "end": 981.56,
    "text": "比如做整晚的睡眠测试"
  },
  {
    "start": 981.56,
    "end": 983.36,
    "text": "或找认知行为疗法"
  },
  {
    "start": 983.36,
    "end": 985.02,
    "text": "治疗失眠的从业者"
  },
  {
    "start": 985.02,
    "end": 986.94,
    "text": "所以它不是什么魔法"
  },
  {
    "start": 986.94,
    "end": 988.04,
    "text": "需要意志力"
  },
  {
    "start": 988.04,
    "end": 990.58,
    "text": "今天我们聊了乔治的故事"
  },
  {
    "start": 990.58,
    "end": 991.32,
    "text": "知道了"
  },
  {
    "start": 991.32,
    "end": 992.28,
    "text": "越努力"
  },
  {
    "start": 992.28,
    "end": 993.14,
    "text": "反而越清醒"
  },
  {
    "start": 993.14,
    "end": 995.0,
    "text": "我们学到了刺激控制"
  },
  {
    "start": 995.0,
    "end": 996.2,
    "text": "睡眠限制"
  },
  {
    "start": 996.2,
    "end": 998.2,
    "text": "还有给担忧设定边界"
  },
  {
    "start": 998.2,
    "end": 999.16,
    "text": "最后"
  },
  {
    "start": 999.16,
    "end": 1000.38,
    "text": "在书的后记里"
  },
  {
    "start": 1000.38,
    "end": 1001.86,
    "text": "有一句最核心的话"
  },
  {
    "start": 1001.86,
    "end": 1004.08,
    "text": "大脑知道如何睡觉"
  },
  {
    "start": 1004.08,
    "end": 1005.42,
    "text": "你需要做的事情"
  },
  {
    "start": 1005.42,
    "end": 1007.06,
    "text": "就是别碍它的事"
  },
  {
    "start": 1007.06,
    "end": 1008.24,
    "text": "别碍它的事"
  },
  {
    "start": 1008.24,
    "end": 1009.88,
    "text": "仔细想一想"
  },
  {
    "start": 1009.88,
    "end": 1011.6,
    "text": "我为睡好觉做的事里"
  },
  {
    "start": 1011.6,
    "end": 1013.66,
    "text": "哪些其实在碍大脑的事"
  },
  {
    "start": 1013.66,
    "end": 1015.5,
    "text": "希望今天的探讨"
  },
  {
    "start": 1015.5,
    "end": 1017.9,
    "text": "能帮你解开床和清醒的死结"
  },
  {
    "start": 1017.9,
    "end": 1019.48,
    "text": "祝你今晚好梦"
  }
]
