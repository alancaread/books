  {
    "start": 362.08,
    "end": 363.5,
    "text": "能提高你的抵抗力"
  },
  {
    "start": 363.5,
    "end": 364.96,
    "text": "我得打断一下"
  },
  {
    "start": 364.96,
    "end": 366.92,
    "text": "这个概念确实很吸引人"
  },
  {
    "start": 366.92,
    "end": 369.0,
    "text": "但我们必须立刻设定边界"
  },
  {
    "start": 369.0,
    "end": 369.72,
    "text": "怎么了"
