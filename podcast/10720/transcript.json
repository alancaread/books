  {
    "start": 369.72,
    "end": 370.9,
    "text": "请注意"
  },
  {
    "start": 370.9,
    "end": 373.82,
    "text": "态度免疫仅仅是一个心理学类比"
  },
  {
    "start": 373.82,
    "end": 376.7,
    "text": "绝对不能把它说成具有医学免疫功效"
