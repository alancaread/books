    "start": 613.24,
    "end": 615.9,
    "text": "运用书里的中心路径说服"
  },
  {
    "start": 615.9,
    "end": 617.34,
    "text": "保持批判性思考"
  },
  {
    "start": 617.34,
    "end": 618.78,
    "text": "是我们不被那些"
  },
  {
    "start": 618.78,
    "end": 620.88,
    "text": "外周线索带偏的最佳武器"
  },
  {
    "start": 620.88,
    "end": 621.92,
    "text": "确实如此"
  },
  {
    "start": 621.92,
    "end": 623.58,
    "text": "不过在节目结束前"
  },
  {
    "start": 623.58,
    "end": 624.82,
    "text": "因为我们讨论了很多"
  },
  {
    "start": 624.82,
    "end": 625.98,
    "text": "心理相关的效应"
  },
  {
    "start": 625.98,
    "end": 627.8,
    "text": "我需要加一个必要的提醒"
  },
  {
    "start": 627.8,
    "end": 628.02,
    "text": "好的"
  },
  {
    "start": 628.02,
    "end": 629.04,
    "text": "大家留意听"
  },
  {
    "start": 629.04,
    "end": 629.7,
    "text": "请注意"
  },
  {
    "start": 629.7,
    "end": 632.16,
    "text": "本节目不提供任何个人医疗"
  },
  {
    "start": 632.16,
    "end": 632.72,
    "text": "心理"
  },
  {
    "start": 632.72,
    "end": 633.32,
    "text": "投资"
  },
  {
    "start": 633.32,
    "end": 633.92,
    "text": "购房"
  },
  {
    "start": 633.92,
    "end": 634.88,
    "text": "或税务建议"
  },
  {
    "start": 634.88,
    "end": 636.9,
    "text": "如果您遇到心理相关症状"
  },
  {
    "start": 636.9,
    "end": 638.84,
    "text": "且严重或持续影响生活"
  },
  {
    "start": 638.84,
    "end": 641.0,
    "text": "请务必寻求专业人士帮助"
  },
  {
    "start": 641.0,
    "end": 643.52,
    "text": "身体和心理健康永远是第一位的"
  },
  {
    "start": 643.52,
    "end": 644.26,
    "text": "最后"
  },
  {
    "start": 644.26,
    "end": 645.76,
    "text": "我想给你留下一个思考题"
  },
  {
    "start": 645.76,
    "end": 647.98,
    "text": "也作为回查原文的小任务"
  },
  {
    "start": 647.98,
    "end": 648.2,
    "text": "哦"
  },
  {
    "start": 648.2,
    "end": 649.06,
    "text": "什么任务"
  },
  {
    "start": 649.06,
    "end": 649.58,
    "text": "回想一下"
  },
  {
    "start": 649.58,
    "end": 651.3,
    "text": "你最近在团队里"
  },
  {
    "start": 651.3,
    "end": 652.62,
    "text": "做出的一个妥协决定"
  },
  {
    "start": 652.62,
    "end": 655.78,
    "text": "你当时是受到了信息性影响"
  },
  {
    "start": 655.78,
    "end": 657.46,
    "text": "还是规范性影响呢"
  },
  {
    "start": 657.46,
    "end": 659.32,
    "text": "这是一个很好的自我审视"
  },
  {
    "start": 659.32,
    "end": 659.98,
    "text": "对吧"
  },
  {
    "start": 659.98,
    "end": 661.04,
    "text": "带着这个问题"
  },
  {
    "start": 661.04,
    "end": 662.7,
    "text": "去翻翻书里的模块9"
  },
  {
    "start": 662.7,
    "end": 664.4,
    "text": "看看你当时究竟陷入了"
  },
  {
    "start": 664.4,
    "end": 666.2,
    "text": "哪种群体效应的网里吧"
  },
  {
    "start": 666.2,
    "end": 668.44,
    "text": "我们下期深度探讨再见"
  },
  {
    "start": 668.44,
    "end": 669.2,
    "text": "再见"
  },
  {
    "start": 669.2,
    "end": 669.5,
    "text": "再见"
  }
]
