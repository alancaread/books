    "text": "绝对没有发生"
  },
  {
    "start": 508.4,
    "end": 509.9,
    "text": "这只是一个好去处"
  },
  {
    "start": 509.9,
    "end": 510.1,
    "text": "好"
  },
  {
    "start": 510.1,
    "end": 512.38,
    "text": "那如果连水都不是必须的呢"
