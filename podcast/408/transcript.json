  {
    "start": 497.54,
    "end": 500.32,
    "text": "这里是极佳的可取样环境"
  },
  {
    "start": 500.32,
    "end": 501.18,
    "text": "这是一回事"
  },
  {
    "start": 501.18,
    "end": 503.18,
    "text": "而生命已经被检出"
