  {
    "start": 534.26,
    "end": 535.68,
    "text": "可是书里明明提到了"
  },
  {
    "start": 535.68,
    "end": 537.28,
    "text": "泰坦上的化学异常现象了"
  },
  {
    "start": 537.28,
    "end": 538.72,
    "text": "比如表面的乙炔"
