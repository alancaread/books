    "start": 543.6,
    "end": 544.48,
    "text": "千万别跑骗"
  },
  {
    "start": 544.48,
    "end": 545.94,
    "text": "这些异常现象"
  },
  {
    "start": 545.94,
    "end": 548.5,
    "text": "目前只能说是待解释的化学问题"
  },
  {
    "start": 548.5,
    "end": 549.76,
    "text": "仅仅是化学问题"
