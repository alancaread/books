  {
    "start": 478.42,
    "end": 479.72,
    "text": "不是靠太阳晒"
  },
  {
    "start": 479.72,
    "end": 482.36,
    "text": "而是靠行星强大的引力拉扯"
  },
  {
    "start": 482.36,
    "end": 484.66,
    "text": "让卫星内部不断形变摩擦"
  },
  {
    "start": 484.66,
    "end": 486.06,
    "text": "产生了巨大的热量"
  },
  {
    "start": 486.06,
    "end": 487.78,
    "text": "也就是内部摩擦生热"
  },
  {
    "start": 487.78,
    "end": 489.18,
    "text": "给生命提供了能量"
  },
  {
    "start": 489.18,
    "end": 489.56,
    "text": "对"
  },
  {
    "start": 489.56,
    "end": 491.66,
    "text": "冰下海洋和羽状喷流"
  },
  {
    "start": 491.66,
    "end": 493.44,
    "text": "为生命提供了能量和环境"
  },
  {
    "start": 493.44,
    "end": 496.94,
    "text": "但是这里必须严正区分两层结论"
