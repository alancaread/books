  {
    "start": 607.02,
    "end": 608.18,
    "text": "确实"
  },
  {
    "start": 608.18,
    "end": 610.38,
    "text": "科学书籍经常带着时代的印记"
  },
  {
    "start": 610.38,
    "end": 612.06,
    "text": "不过面对系外行星"
  },
  {
    "start": 612.06,
    "end": 614.08,
    "text": "在逻辑上必须做拆解"
