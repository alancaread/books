  {
    "start": 463.14,
    "end": 464.6,
    "text": "这两个冰封的水世界了"
  },
  {
    "start": 464.6,
    "end": 466.04,
    "text": "我感叹一下啊"
  },
  {
    "start": 466.04,
    "end": 467.8,
    "text": "以前学传统的恒星宜居带"
