  {
    "start": 472.78,
    "end": 473.98,
    "text": "怎么打破局限"
  },
  {
    "start": 473.98,
    "end": 476.08,
    "text": "在后冰下面藏着液态海洋呢"
  },
  {
    "start": 476.08,
    "end": 478.42,
    "text": "这个驱动机制叫做潮汐加热"
