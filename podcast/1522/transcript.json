[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "决定一场大战胜负的"
  },
  {
    "start": 2.0,
    "end": 4.66,
    "text": "究竟是战场上的灵机决断"
  },
  {
    "start": 4.66,
    "end": 6.38,
    "text": "还是开战前的人口"
  },
  {
    "start": 6.38,
    "end": 7.02,
    "text": "财政"
  },
  {
    "start": 7.02,
    "end": 8.12,
    "text": "盟约与补给"
  },
  {
    "start": 8.12,
    "end": 9.5,
    "text": "这个问题"
  },
  {
    "start": 9.5,
    "end": 11.82,
    "text": "其实当我们翻开"
  },
  {
    "start": 11.82,
    "end": 13.96,
    "text": "富乐那套西洋世界军事史"
  },
  {
    "start": 13.96,
    "end": 16.1,
    "text": "就是那套全三卷的巨著的时候"
  },
  {
    "start": 16.1,
    "end": 17.66,
    "text": "答案就藏在那些"
  },
  {
    "start": 17.66,
    "end": 19.78,
    "text": "最不起眼的账单里了"
  },
  {
    "start": 19.78,
    "end": 20.16,
    "text": "对"
  },
  {
    "start": 20.16,
    "end": 21.58,
    "text": "很多人读军事史"
  },
  {
    "start": 21.58,
    "end": 23.2,
    "text": "目光总是被那些"
  },
  {
    "start": 23.2,
    "end": 25.32,
    "text": "名将的奇谋妙计"
  },
  {
    "start": 25.32,
    "end": 27.14,
    "text": "或者骑兵的冲锋"
  },
  {
    "start": 27.14,
    "end": 28.96,
    "text": "火炮的轰鸣给死死抓住"
  },
  {
    "start": 28.96,
    "end": 29.42,
    "text": "没错"
  },
  {
    "start": 29.42,
    "end": 31.34,
    "text": "但富乐真正厉害的地方"
  },
  {
    "start": 31.34,
    "end": 32.34,
    "text": "就是他把这些"
  },
  {
    "start": 32.34,
    "end": 34.3,
    "text": "非常戏剧性的瞬间"
  },
  {
    "start": 34.3,
    "end": 36.02,
    "text": "全部还原成了"
  },
  {
    "start": 36.02,
    "end": 37.98,
    "text": "冷冰冰的消耗战"
  },
  {
    "start": 37.98,
    "end": 38.96,
    "text": "而且分享一个"
  },
  {
    "start": 38.96,
    "end": 40.36,
    "text": "他非常接地气的观点"
  },
  {
    "start": 40.36,
    "end": 42.96,
    "text": "他说战争都是为肚子打的"
  },
  {
    "start": 42.96,
    "end": 44.1,
    "text": "不管是人的肚子"
  },
  {
    "start": 44.1,
    "end": 45.46,
    "text": "还是牲口的肚子"
  },
  {
    "start": 45.46,
    "end": 47.04,
    "text": "不管是人的肚子"
  },
  {
    "start": 47.04,
    "end": 48.46,
    "text": "还是牲口的肚子"
  },
  {
    "start": 48.46,
    "end": 50.04,
    "text": "这个说法太直白了"
  },
  {
    "start": 50.04,
    "end": 50.52,
    "text": "是的"
  },
  {
    "start": 50.52,
    "end": 51.72,
    "text": "所以为了把这种"
  },
  {
    "start": 51.72,
    "end": 54.4,
    "text": "消耗的底层逻辑讲透"
  },
  {
    "start": 54.4,
    "end": 55.82,
    "text": "他在全书一开篇"
  },
  {
    "start": 55.82,
    "end": 58.1,
    "text": "并没有直接去讲什么兵法"
  },
  {
    "start": 58.1,
    "end": 60.66,
    "text": "而是抛出了一个非常宏大的地基"
  },
  {
    "start": 60.66,
    "end": 64.1,
    "text": "也就是理解全书的核心框架"
  },
  {
    "start": 64.1,
    "end": 64.46,
    "text": "对吧"
  },
  {
    "start": 64.46,
    "end": 64.92,
    "text": "对"
  },
  {
    "start": 64.92,
    "end": 68.7,
    "text": "就是人类战争的三个地理时代"
  },
  {
    "start": 68.7,
    "end": 69.32,
    "text": "等一下"
  },
  {
    "start": 69.32,
    "end": 71.16,
    "text": "讲具体的战役之前"
  },
  {
    "start": 71.16,
    "end": 76.3,
    "text": "为什么要先拉大到一个抽象的地理时代去谈"
  },
  {
    "start": 76.3,
    "end": 77.76,
    "text": "因为地理环境"
  },
  {
    "start": 77.76,
    "end": 80.7,
    "text": "它直接决定了你能够调动的资源上限"
  },
  {
    "start": 80.7,
    "end": 81.86,
    "text": "你想啊"
  },
  {
    "start": 81.86,
    "end": 83.86,
    "text": "也就是你能把多少钱"
  },
  {
    "start": 83.86,
    "end": 86.04,
    "text": "多少人投送到多远的地方"
  },
  {
    "start": 86.04,
    "end": 86.96,
    "text": "有道理"
  },
  {
    "start": 86.96,
    "end": 89.06,
    "text": "福乐划分的这个第一阶段"
  },
  {
    "start": 89.06,
    "end": 91.42,
    "text": "是从远古到1571年"
  },
  {
    "start": 91.42,
    "end": 94.92,
    "text": "那时候是地中海和西南亚时代"
  },
  {
    "start": 94.92,
    "end": 96.1,
    "text": "那时候的动力"
  },
  {
    "start": 96.1,
    "end": 98.1,
    "text": "主要还是人力和风力吧"
  },
  {
    "start": 98.1,
    "end": 98.58,
    "text": "没错"
  },
  {
    "start": 98.58,
    "end": 100.34,
    "text": "所以资源的投射范围"
  },
  {
    "start": 100.34,
    "end": 103.68,
    "text": "就被死死锁在了内海和大陆的边缘"
  },
  {
    "start": 103.68,
    "end": 104.56,
    "text": "也就是说"
  },
  {
    "start": 104.56,
    "end": 106.86,
    "text": "受限于当时的那个运输技术"
  },
  {
    "start": 106.86,
    "end": 108.24,
    "text": "哪怕你有金山银山"
  },
  {
    "start": 108.24,
    "end": 111.16,
    "text": "你也无法进行那种夸大洋的远征"
  },
  {
    "start": 111.16,
    "end": 113.14,
    "text": "战争规模是有物理天花板的"
  },
  {
    "start": 113.14,
    "end": 114.06,
    "text": "确实是这样"
  },
  {
    "start": 114.06,
    "end": 116.12,
    "text": "然后紧接着就是第二阶段"
  },
  {
    "start": 116.12,
    "end": 117.78,
    "text": "大西洋边缘时代"
  },
  {
    "start": 117.78,
    "end": 120.48,
    "text": "这个阶段一直持续到1815年"
  },
  {
    "start": 120.48,
    "end": 123.82,
    "text": "也就是帆船技术和火药普及的那个时代"
  },
  {
    "start": 123.82,
    "end": 124.24,
    "text": "对"
  },
  {
    "start": 124.24,
    "end": 127.9,
    "text": "这让欧洲列强可以在大西洋两岸进行博弈了"
  },
  {
    "start": 127.9,
    "end": 130.68,
    "text": "然后到了第三个阶段"
  },
  {
    "start": 130.68,
    "end": 132.08,
    "text": "也就是因为工业"
  },
  {
    "start": 132.08,
    "end": 134.68,
    "text": "科学和运输的巨大进步"
  },
  {
    "start": 134.68,
    "end": 137.54,
    "text": "战争的舞台彻底粉碎了地理限制"
  },
  {
    "start": 137.54,
    "end": 139.26,
    "text": "变成了整个世界"
  },
  {
    "start": 139.26,
    "end": 139.68,
    "text": "对"
  },
  {
    "start": 139.68,
    "end": 140.76,
    "text": "整个世界"
  },
  {
    "start": 140.76,
    "end": 141.48,
    "text": "好"
  },
  {
    "start": 141.48,
    "end": 143.18,
    "text": "我们来拆解一下这个概念"
  },
  {
    "start": 143.18,
    "end": 144.76,
    "text": "如果按照这个逻辑"
  },
  {
    "start": 144.76,
    "end": 146.56,
    "text": "随着时代的引进"
  },
  {
    "start": 146.56,
    "end": 150.26,
    "text": "战争其实越来越不像是单纯的排兵布阵了"
  },
  {
    "start": 150.26,
    "end": 154.38,
    "text": "更像是一场复杂的国家级系统工程"
  },
  {
    "start": 154.38,
    "end": 155.14,
    "text": "没错"
  },
  {
    "start": 155.14,
    "end": 155.98,
    "text": "是这样的"
  },
  {
    "start": 155.98,
    "end": 157.76,
    "text": "但我看很多军事书"
  },
  {
    "start": 157.76,
    "end": 160.36,
    "text": "哪怕是涵盖了千年跨度的"
  },
  {
    "start": 160.36,
    "end": 163.32,
    "text": "也依然只是那种流水仗势的战况播报"
  },
  {
    "start": 163.32,
    "end": 164.68,
    "text": "富乐是怎么做到"
  },
  {
    "start": 164.68,
    "end": 168.4,
    "text": "就是把这么庞杂的政治经济背景全塞进去的"
  },
  {
    "start": 168.4,
    "end": 172.44,
    "text": "他的破局之法就在于一个结构上的巧思"
  },
  {
    "start": 172.44,
    "end": 174.78,
    "text": "他在各场惊星动魄的会战之间"
  },
  {
    "start": 174.78,
    "end": 177.1,
    "text": "专门穿插了大事迹"
  },
  {
    "start": 177.1,
    "end": 177.56,
    "text": "哦"
  },
  {
    "start": 177.56,
    "end": 177.92,
    "text": "对"
  },
  {
    "start": 177.92,
    "end": 178.72,
    "text": "那些大事迹"
  },
  {
    "start": 178.72,
    "end": 179.9,
    "text": "我读的时候感觉"
  },
  {
    "start": 179.9,
    "end": 182.24,
    "text": "这些大事迹并不像简单的流水仗"
  },
  {
    "start": 182.24,
    "end": 183.36,
    "text": "绝对不是"
  },
  {
    "start": 183.36,
    "end": 186.54,
    "text": "他们其实是专门用来交代战场之外的那些"
  },
  {
    "start": 186.54,
    "end": 188.68,
    "text": "比如说联盟的更迭啊"
  },
  {
    "start": 188.68,
    "end": 189.76,
    "text": "王朝的变化"
  },
  {
    "start": 189.76,
    "end": 192.32,
    "text": "还有最关键的金钱流向"
  },
  {
    "start": 192.32,
    "end": 192.98,
    "text": "也就是说"
  },
  {
    "start": 192.98,
    "end": 196.1,
    "text": "这些大事迹更像是在交代开战前"
  },
  {
    "start": 196.1,
    "end": 198.58,
    "text": "在幕后疯狂运转的那些齿轮"
  },
  {
    "start": 198.58,
    "end": 199.06,
    "text": "对"
  },
  {
    "start": 199.06,
    "end": 201.6,
    "text": "这也恰好回答了你开场的那个问题"
  },
  {
    "start": 201.6,
    "end": 204.08,
    "text": "当军队在战场上列阵的时候"
  },
  {
    "start": 204.08,
    "end": 205.82,
    "text": "决定胜负的那个齿轮"
  },
  {
    "start": 205.82,
    "end": 207.62,
    "text": "往往在开战前几个月"
  },
  {
    "start": 207.62,
    "end": 208.62,
    "text": "甚至几年前"
  },
  {
    "start": 208.62,
    "end": 211.32,
    "text": "就已经被蒙约和钱袋子给驱动了"
  },
  {
    "start": 211.32,
    "end": 213.08,
    "text": "既然说到了钱袋子"
  },
  {
    "start": 213.08,
    "end": 216.4,
    "text": "我们不妨把视线拉回到一个具体的历史现场"
  },
  {
    "start": 216.4,
    "end": 217.94,
    "text": "你想象一下啊"
  },
  {
    "start": 217.94,
    "end": 220.64,
    "text": "你此刻是18世纪法蜀"
  },
  {
    "start": 220.64,
    "end": 222.2,
    "text": "北美殖民地的总督"
  },
  {
    "start": 222.2,
    "end": 223.08,
    "text": "福德流"
  },
  {
    "start": 223.08,
    "end": 225.66,
    "text": "这是一个非常有画面感的人物"
  },
  {
    "start": 225.66,
    "end": 226.02,
    "text": "对吧"
  },
  {
    "start": 226.02,
    "end": 226.92,
    "text": "大帝当前"
  },
  {
    "start": 226.92,
    "end": 229.38,
    "text": "你需要立刻武装力量来保卫领土"
  },
  {
    "start": 229.38,
    "end": 231.06,
    "text": "结果你翻开账本一看"
  },
  {
    "start": 231.06,
    "end": 232.14,
    "text": "绝望的发现"
  },
  {
    "start": 232.14,
    "end": 233.58,
    "text": "作为最高长官"
  },
  {
    "start": 233.58,
    "end": 234.9,
    "text": "你每年的兴奋"
  },
  {
    "start": 234.9,
    "end": 237.22,
    "text": "竟然只有272磅"
  },
  {
    "start": 237.22,
    "end": 238.58,
    "text": "一仙令八便是"
  },
  {
    "start": 238.58,
    "end": 239.0,
    "text": "哇"
  },
  {
    "start": 239.0,
    "end": 242.16,
    "text": "这个数字真的是听着都觉得寒算"
  },
  {
    "start": 242.16,
    "end": 242.48,
    "text": "是啊"
  },
  {
    "start": 242.48,
    "end": 244.16,
    "text": "就靠这点可怜的预算"
  },
  {
    "start": 244.16,
    "end": 245.54,
    "text": "你还要供养一只"
  },
  {
    "start": 245.54,
    "end": 248.7,
    "text": "包括两个军事和25个士兵的私人卫队"
  },
  {
    "start": 248.7,
    "end": 250.32,
    "text": "这仗还没打"
  },
  {
    "start": 250.32,
    "end": 251.76,
    "text": "你在底层逻辑上"
  },
  {
    "start": 251.76,
    "end": 253.04,
    "text": "其实就已经输了"
  },
  {
    "start": 253.04,
    "end": 256.7,
    "text": "这就来到了决定北美命运的魁北克战役"
  },
  {
    "start": 256.7,
    "end": 257.24,
    "text": "没错"
  },
  {
    "start": 257.24,
    "end": 258.98,
    "text": "亚伯拉罕平原之战"
  },
  {
    "start": 258.98,
    "end": 260.64,
    "text": "大家常常感叹那个"
  },
  {
    "start": 260.64,
    "end": 262.46,
    "text": "进攻方的英国将领"
  },
  {
    "start": 262.46,
    "end": 263.94,
    "text": "乌尔夫突袭有多神勇"
  },
  {
    "start": 263.94,
    "end": 266.08,
    "text": "但翻开大实际的账本一看"
  },
  {
    "start": 266.08,
    "end": 268.8,
    "text": "这根本就是一场悬殊的降维打击"
  },
  {
    "start": 268.8,
    "end": 270.44,
    "text": "确实太悬殊了"
  },
  {
    "start": 270.44,
    "end": 271.76,
    "text": "当时加拿大那边"
  },
  {
    "start": 271.76,
    "end": 274.24,
    "text": "就是法国在美洲殖民地的人口"
  },
  {
    "start": 274.24,
    "end": 276.48,
    "text": "满打满算只有8万2千人"
  },
  {
    "start": 276.48,
    "end": 276.72,
    "text": "对"
  },
  {
    "start": 276.72,
    "end": 277.66,
    "text": "非常少"
  },
  {
    "start": 277.66,
    "end": 278.4,
    "text": "但你猜"
  },
  {
    "start": 278.4,
    "end": 280.58,
    "text": "英国在美洲殖民地的人口是多少"
  },
  {
    "start": 280.58,
    "end": 282.58,
    "text": "130万人"
  },
  {
    "start": 282.58,
    "end": 285.44,
    "text": "这就像一家只有8万多员工的初创公司"
  },
  {
    "start": 285.44,
    "end": 288.88,
    "text": "去对抗一家拥有一百多万员工的跨国巨头"
  },
  {
    "start": 288.88,
    "end": 290.34,
    "text": "这个类比非常精准"
  },
  {
    "start": 290.34,
    "end": 292.74,
    "text": "而且这种体量上的碾压"
  },
  {
    "start": 292.74,
    "end": 294.62,
    "text": "也体现在了主将的年龄上"
  },
  {
    "start": 294.62,
    "end": 297.46,
    "text": "英国那个将领乌尔夫当时才32岁"
  },
  {
    "start": 297.46,
    "end": 301.48,
    "text": "他手下的高级军官大多也都极度年轻"
  },
  {
    "start": 301.48,
    "end": 303.28,
    "text": "简直就是一场孩子们的会战"
  },
  {
    "start": 303.28,
    "end": 303.8,
    "text": "对"
  },
  {
    "start": 303.8,
    "end": 305.76,
    "text": "这群少壮派敢于冒险"
  },
  {
    "start": 305.76,
    "end": 307.56,
    "text": "底气不仅来自于年轻"
  },
  {
    "start": 307.56,
    "end": 311.12,
    "text": "更来自于英国在海上掏出的真正家底"
  },
  {
    "start": 311.12,
    "end": 313.24,
    "text": "那个海上的家底确实太厚了"
  },
  {
    "start": 313.24,
    "end": 314.66,
    "text": "170座帆船"
  },
  {
    "start": 314.66,
    "end": 316.7,
    "text": "配上了1万8千名海员"
  },
  {
    "start": 316.7,
    "end": 317.02,
    "text": "是的"
  },
  {
    "start": 317.02,
    "end": 318.9,
    "text": "这里令人着迷的是"
  },
  {
    "start": 318.9,
    "end": 321.16,
    "text": "法军主将蒙特卡尔姆"
  },
  {
    "start": 321.16,
    "end": 322.88,
    "text": "他其实非常清楚双方的差距"
  },
  {
    "start": 322.88,
    "end": 324.86,
    "text": "所以他采取了费边战略"
  },
  {
    "start": 324.86,
    "end": 326.98,
    "text": "也就是死守的拖延战术"
  },
  {
    "start": 326.98,
    "end": 327.32,
    "text": "对吧"
  },
  {
    "start": 327.32,
    "end": 327.84,
    "text": "没错"
  },
  {
    "start": 327.84,
    "end": 331.92,
    "text": "他这个算法是建立在一个看似无懈可击的假设上的"
  },
  {
    "start": 331.92,
    "end": 334.1,
    "text": "他在等秋季的风雾"
  },
  {
    "start": 334.1,
    "end": 335.78,
    "text": "他认定只要天气一变"
  },
  {
    "start": 335.78,
    "end": 339.34,
    "text": "英国那庞大的舰队为了避免触礁就必须得撤"
  },
  {
    "start": 339.34,
    "end": 341.2,
    "text": "这确实是个很现实的考量"
  },
  {
    "start": 341.2,
    "end": 343.24,
    "text": "毕竟大自然的威力摆在那"
  },
  {
    "start": 343.24,
    "end": 344.4,
    "text": "而且他更深信"
  },
  {
    "start": 344.4,
    "end": 348.58,
    "text": "英国舰队绝对不敢强度魁北克正南面的那道河流"
  },
  {
    "start": 348.58,
    "end": 349.96,
    "text": "在法国人的认知里"
  },
  {
    "start": 349.96,
    "end": 351.72,
    "text": "那是不可预约的天谦"
  },
  {
    "start": 351.72,
    "end": 355.14,
    "text": "但结果英国舰队直接打破了这个神话"
  },
  {
    "start": 355.14,
    "end": 355.34,
    "text": "对"
  },
  {
    "start": 355.34,
    "end": 358.98,
    "text": "他们应是完成了法国人认为绝对不可能的航行"
  },
  {
    "start": 358.98,
    "end": 361.18,
    "text": "把兵力投送到了眼皮底下"
  },
  {
    "start": 361.18,
    "end": 363.18,
    "text": "这招太狠了"
  },
  {
    "start": 363.18,
    "end": 365.46,
    "text": "蒙特卡尔姆压住的前提瞬间崩溃"
  },
  {
    "start": 365.46,
    "end": 370.22,
    "text": "这其实也给听众们留下了一个随时能带走的看战争的方法"
  },
  {
    "start": 370.22,
    "end": 373.5,
    "text": "也就是看战役先看四格清单"
  },
  {
    "start": 373.5,
    "end": 374.38,
    "text": "对"
  },
  {
    "start": 374.38,
    "end": 375.2,
    "text": "这个很重要"
  },
  {
    "start": 375.2,
    "end": 375.64,
    "text": "第一"
  },
  {
    "start": 375.64,
    "end": 376.92,
    "text": "看人数口径"
  },
  {
    "start": 376.92,
    "end": 377.56,
    "text": "第二"
  },
  {
    "start": 377.56,
    "end": 378.84,
    "text": "看谁在出钱"
  },
  {
    "start": 378.84,
    "end": 379.64,
    "text": "第三"
  },
  {
    "start": 379.64,
    "end": 381.24,
    "text": "看海陆的补给线"
  },
  {
    "start": 381.24,
    "end": 382.0,
    "text": "第四"
  },
  {
    "start": 382.0,
    "end": 383.08,
    "text": "也就是最关键的"
  },
  {
    "start": 383.08,
    "end": 386.02,
    "text": "看首方压住的核心前提是什么"
  },
  {
    "start": 386.02,
    "end": 387.28,
    "text": "前提一塌"
  },
  {
    "start": 387.28,
    "end": 388.5,
    "text": "防线就废了"
  },
  {
    "start": 388.5,
    "end": 390.22,
    "text": "总结的非常到位"
  },
  {
    "start": 390.22,
    "end": 394.24,
    "text": "那当我们带着这个四个分析法来到滑铁炉战役的时候"
  },
  {
    "start": 394.24,
    "end": 395.08,
    "text": "哦"
  },
  {
    "start": 395.08,
    "end": 395.76,
    "text": "滑铁炉"
  },
  {
    "start": 395.76,
    "end": 397.84,
    "text": "这里才是真正有意思的地方"
  },
  {
    "start": 397.84,
    "end": 399.02,
    "text": "一提到滑铁炉"
  },
  {
    "start": 399.02,
    "end": 400.76,
    "text": "就有个常见的八卦"
  },
  {
    "start": 400.76,
    "end": 401.08,
    "text": "是的"
  },
  {
    "start": 401.08,
    "end": 402.7,
    "text": "很多人都在问那个问题"
  },
  {
    "start": 402.7,
    "end": 403.08,
    "text": "对"
  },
  {
    "start": 403.08,
    "end": 403.94,
    "text": "大家都在猜"
  },
  {
    "start": 403.94,
    "end": 405.08,
    "text": "滑铁炉之外"
  },
  {
    "start": 405.08,
    "end": 407.7,
    "text": "是不是因为拿破仑已经变成了一个病人"
  },
  {
    "start": 407.7,
    "end": 411.02,
    "text": "或者说他丧失了年轻时的那种天才活力"
  },
  {
    "start": 411.02,
    "end": 413.44,
    "text": "富勒给出的结论非常明确"
  },
  {
    "start": 413.44,
    "end": 414.74,
    "text": "拿破仑没变"
  },
  {
    "start": 414.74,
    "end": 417.4,
    "text": "他这主帅的脑子和以前一样锐利"
  },
  {
    "start": 417.4,
    "end": 420.62,
    "text": "这场失败绝不是因为生理机能的衰退"
  },
  {
    "start": 420.62,
    "end": 421.7,
    "text": "那是因为什么"
  },
  {
    "start": 421.7,
    "end": 426.44,
    "text": "这是一场两位名将之间迟到了22年的交手"
  },
  {
    "start": 426.44,
    "end": 428.18,
    "text": "拿破仑失败的原因啊"
  },
  {
    "start": 428.18,
    "end": 429.36,
    "text": "得从两个层面看"
  },
  {
    "start": 429.36,
    "end": 431.84,
    "text": "首先是战场上的四个缺口"
  },
  {
    "start": 431.84,
    "end": 432.42,
    "text": "哦"
  },
  {
    "start": 432.42,
    "end": 433.66,
    "text": "哪四个缺口"
  },
  {
    "start": 433.66,
    "end": 437.86,
    "text": "拿破仑的那套大战术需要四个关键位置的人选来配合"
  },
  {
    "start": 437.86,
    "end": 440.86,
    "text": "但他失去了最核心的参谋长贝尔提亚"
  },
  {
    "start": 440.86,
    "end": 443.74,
    "text": "这就导致了非常恶劣的参谋工作"
  },
  {
    "start": 443.74,
    "end": 446.42,
    "text": "也就是说指挥系统出现乱马了"
  },
  {
    "start": 446.42,
    "end": 447.18,
    "text": "对"
  },
  {
    "start": 447.18,
    "end": 450.8,
    "text": "其次他拒绝使用欧洲最优秀的骑兵将领"
  },
  {
    "start": 450.8,
    "end": 451.76,
    "text": "谬拉"
  },
  {
    "start": 451.76,
    "end": 453.04,
    "text": "然后在关键任务上"
  },
  {
    "start": 453.04,
    "end": 455.0,
    "text": "他又用错了格鲁西和内衣"
  },
  {
    "start": 455.0,
    "end": 458.12,
    "text": "这简直是人事任命上的连环灾难啊"
  },
  {
    "start": 458.12,
    "end": 458.96,
    "text": "没错"
  },
  {
    "start": 458.96,
    "end": 463.0,
    "text": "这四个失误直接导致了微观操作的权限溃退"
  },
  {
    "start": 463.0,
    "end": 465.52,
    "text": "但除了这种用人失误"
  },
  {
    "start": 465.52,
    "end": 466.84,
    "text": "还有什么决定性因素"
  },
  {
    "start": 466.84,
    "end": 469.94,
    "text": "总不能光是几个人换了就全盘皆输吧"
  },
  {
    "start": 469.94,
    "end": 470.8,
    "text": "那当然"
  },
  {
    "start": 470.8,
    "end": 475.9,
    "text": "这就得看大事记里隐藏的那些政治与财政账单了"
  },
  {
    "start": 475.9,
    "end": 477.58,
    "text": "英国人又掏钱了"
  },
  {
    "start": 477.58,
    "end": 478.3,
    "text": "对吧"
  },
  {
    "start": 478.3,
    "end": 478.64,
    "text": "没错"
  },
  {
    "start": 478.64,
    "end": 481.66,
    "text": "英国人给了同盟国500温样棒的巨额捕捕捉"
  },
  {
    "start": 481.66,
    "end": 485.04,
    "text": "这就是在用真金白银买时间和数量优势"
  },
  {
    "start": 485.04,
    "end": 488.92,
    "text": "同盟军就是打算用绝对的数量优势去压碎拿破仑"
  },
  {
    "start": 488.92,
    "end": 491.02,
    "text": "你看那些兵力数字就很直观"
  },
  {
    "start": 491.02,
    "end": 493.58,
    "text": "惠灵顿手里有93000人"
  },
  {
    "start": 493.58,
    "end": 495.92,
    "text": "布里希尔那边是11万7000人"
  },
  {
    "start": 495.92,
    "end": 499.88,
    "text": "而拿破仑亲自指挥的北方军团只有12万4500人"
  },
  {
    "start": 499.88,
    "end": 501.06,
    "text": "根本没法打"
  },
  {
    "start": 501.06,
    "end": 502.24,
    "text": "而且啊"
  },
  {
    "start": 502.24,
    "end": 503.38,
    "text": "除了兵力碾压"
  },
  {
    "start": 503.38,
    "end": 506.0,
    "text": "同盟内部其实也是各怀鬼胎"
  },
  {
    "start": 506.0,
    "end": 508.18,
    "text": "充满了利益的裂缝"
  },
  {
    "start": 508.18,
    "end": 508.52,
    "text": "是啊"
  },
  {
    "start": 508.52,
    "end": 510.02,
    "text": "大时机里就提到"
  },
  {
    "start": 510.02,
    "end": 512.16,
    "text": "英国奥地利还有战败的法国"
  },
  {
    "start": 512.16,
    "end": 515.76,
    "text": "甚至因为沙皇对波兰的野心在私底下达成了密约"
  },
  {
    "start": 515.76,
    "end": 516.46,
    "text": "没错"
  },
  {
    "start": 516.46,
    "end": 520.06,
    "text": "他们随时准备集结45万人向俄国宣战呢"
  },
  {
    "start": 520.06,
    "end": 522.5,
    "text": "在打拿破仑的道德大旗下面"
  },
  {
    "start": 522.5,
    "end": 524.52,
    "text": "纯粹全是利益博弈"
  },
  {
    "start": 524.52,
    "end": 526.8,
    "text": "那么这一切到底意味着什么"
  },
  {
    "start": 526.8,
    "end": 528.4,
    "text": "当我们的时间线推移"
  },
  {
    "start": 528.4,
    "end": 530.18,
    "text": "战争进入了工业化时代"
  },
  {
    "start": 530.18,
    "end": 532.9,
    "text": "距离和资源的计算方式是不是完全变了"
  },
  {
    "start": 532.9,
    "end": 533.42,
    "text": "是的"
  },
  {
    "start": 533.42,
    "end": 536.48,
    "text": "这就进入了富勒所说的第三个地理时代"
  },
  {
    "start": 536.48,
    "end": 537.84,
    "text": "也就是全球舞台"
  },
  {
    "start": 537.84,
    "end": 539.02,
    "text": "在这方面啊"
  },
  {
    "start": 539.02,
    "end": 542.34,
    "text": "太平洋战场上的莱特湾海战就是个极端的例子"
  },
  {
    "start": 542.34,
    "end": 544.68,
    "text": "日本高层挑起这么大一场战争"
  },
  {
    "start": 544.68,
    "end": 547.08,
    "text": "他们当时的底层逻辑到底是什么"
  },
  {
    "start": 547.08,
    "end": 548.6,
    "text": "日本的战略误判"
  },
  {
    "start": 548.6,
    "end": 551.44,
    "text": "其实源于对自身历史经验的路径依赖"
  },
  {
    "start": 551.44,
    "end": 553.88,
    "text": "他们想在一场全球工业战里"
  },
  {
    "start": 553.88,
    "end": 557.8,
    "text": "去附和1894年和1904年的局部胜利经验"
  },
  {
    "start": 557.8,
    "end": 560.28,
    "text": "他们是想通过夺战有限的空间"
  },
  {
    "start": 560.28,
    "end": 562.4,
    "text": "来逼迫对手和谈对吧"
  },
  {
    "start": 562.4,
    "end": 562.58,
    "text": "对"
  },
  {
    "start": 562.58,
    "end": 564.48,
    "text": "但他们忽略了一个致命问题"
  },
  {
    "start": 564.48,
    "end": 566.6,
    "text": "就是美国巨大的工业势能"
  },
  {
    "start": 566.6,
    "end": 569.0,
    "text": "是足以克服那些空间障碍的"
  },
  {
    "start": 569.0,
    "end": 571.92,
    "text": "我们可以来算一笔海陆和油桶的算术题"
  },
  {
    "start": 571.92,
    "end": 573.76,
    "text": "在第三个地理时代"
  },
  {
    "start": 573.76,
    "end": 575.64,
    "text": "距离的账单有多惊人"
  },
  {
    "start": 575.64,
    "end": 576.52,
    "text": "极其惊人"
  },
  {
    "start": 576.52,
    "end": 578.46,
    "text": "从英美的两端出发到日本"
  },
  {
    "start": 578.46,
    "end": 580.0,
    "text": "差不多都是一万英里"
  },
  {
    "start": 580.0,
    "end": 581.2,
    "text": "为了维持战争"
  },
  {
    "start": 581.2,
    "end": 583.94,
    "text": "那条交通线全长达到了两万英里"
  },
  {
    "start": 583.94,
    "end": 586.0,
    "text": "在这么夸张的距离上"
  },
  {
    "start": 586.0,
    "end": 587.3,
    "text": "每一滴油背后"
  },
  {
    "start": 587.3,
    "end": 589.5,
    "text": "都是天文数字的物流成本"
  },
  {
    "start": 589.5,
    "end": 589.88,
    "text": "没错"
  },
  {
    "start": 589.88,
    "end": 592.08,
    "text": "但到了1944年的莱特湾"
  },
  {
    "start": 592.08,
    "end": 594.12,
    "text": "账本上的数字对日本来说"
  },
  {
    "start": 594.12,
    "end": 596.14,
    "text": "已经彻底绝望了"
  },
  {
    "start": 596.14,
    "end": 599.28,
    "text": "美国当时的舰队规模太庞大了"
  },
  {
    "start": 599.28,
    "end": 600.78,
    "text": "单单是第七舰队"
  },
  {
    "start": 600.78,
    "end": 603.2,
    "text": "就拥有738艘船只"
  },
  {
    "start": 603.2,
    "end": 603.86,
    "text": "对"
  },
  {
    "start": 603.86,
    "end": 604.96,
    "text": "相比之下"
  },
  {
    "start": 604.96,
    "end": 606.98,
    "text": "日本负责诱敌的小泽舰队"
  },
  {
    "start": 606.98,
    "end": 609.5,
    "text": "只剩下了可怜的52架战斗机"
  },
  {
    "start": 609.5,
    "end": 611.92,
    "text": "而且飞行员训练极差"
  },
  {
    "start": 611.92,
    "end": 614.84,
    "text": "接到的任务指令是全部牺牲"
  },
  {
    "start": 614.84,
    "end": 615.98,
    "text": "也就是说"
  },
  {
    "start": 615.98,
    "end": 618.2,
    "text": "这些飞机从起飞那一刻起"
  },
  {
    "start": 618.2,
    "end": 620.36,
    "text": "就没有被安排返航的油料"
  },
  {
    "start": 620.36,
    "end": 621.92,
    "text": "这已经不是战争了"
  },
  {
    "start": 621.92,
    "end": 623.46,
    "text": "这是绝望的自杀"
  },
  {
    "start": 623.46,
    "end": 624.2,
    "text": "是的"
  },
  {
    "start": 624.2,
    "end": 627.04,
    "text": "我记得日本丰田副武大将"
  },
  {
    "start": 627.04,
    "end": 629.22,
    "text": "在战后有一段非常坦白"
  },
  {
    "start": 629.22,
    "end": 630.58,
    "text": "也非常绝望的下"
  },
  {
    "start": 630.58,
    "end": 631.38,
    "text": "他说"
  },
  {
    "start": 631.38,
    "end": 633.9,
    "text": "如果不惜丧失菲律宾来保全舰队"
  },
  {
    "start": 633.9,
    "end": 636.48,
    "text": "那结果将毫无意义"
  },
  {
    "start": 636.48,
    "end": 637.44,
    "text": "为什么毫无意义"
  },
  {
    "start": 637.44,
    "end": 639.94,
    "text": "因为菲律宾那个地理节点一丢"
  },
  {
    "start": 639.94,
    "end": 642.4,
    "text": "南下的航线就被彻底切断了"
  },
  {
    "start": 642.4,
    "end": 644.0,
    "text": "舰队就算躲在港口里"
  },
  {
    "start": 644.0,
    "end": 645.54,
    "text": "连燃料都拿不到"
  },
  {
    "start": 645.54,
    "end": 646.4,
    "text": "所以这里"
  },
  {
    "start": 646.4,
    "end": 647.78,
    "text": "我们可以共同得出"
  },
  {
    "start": 647.78,
    "end": 650.14,
    "text": "现代海战的一个三张表模型"
  },
  {
    "start": 650.14,
    "end": 651.96,
    "text": "看懂一场现代海战"
  },
  {
    "start": 651.96,
    "end": 654.06,
    "text": "第一张表看舰队数字"
  },
  {
    "start": 654.06,
    "end": 656.34,
    "text": "第二张表看航路距离"
  },
  {
    "start": 656.34,
    "end": 659.24,
    "text": "第三张表看油和飞行员储备"
  },
  {
    "start": 659.24,
    "end": 660.08,
    "text": "没错"
  },
  {
    "start": 660.08,
    "end": 661.44,
    "text": "在莱特湾的时候"
  },
  {
    "start": 661.44,
    "end": 664.62,
    "text": "日本的第三张表已经完全空了"
  },
  {
    "start": 664.62,
    "end": 666.18,
    "text": "没有了油和人"
  },
  {
    "start": 666.18,
    "end": 668.2,
    "text": "前两张表的数字再大"
  },
  {
    "start": 668.2,
    "end": 670.5,
    "text": "也只不过是飘在海上的废铁而已"
  },
  {
    "start": 670.5,
    "end": 671.42,
    "text": "是啊"
  },
  {
    "start": 671.42,
    "end": 673.36,
    "text": "这就引出了一个重要的问题"
  },
  {
    "start": 673.36,
    "end": 675.56,
    "text": "既然战争如此残酷"
  },
  {
    "start": 675.56,
    "end": 677.06,
    "text": "消耗如此之大"
  },
  {
    "start": 677.06,
    "end": 678.54,
    "text": "他到底是为了什么"
  },
  {
    "start": 678.54,
    "end": 680.08,
    "text": "这是个终极问题"
  },
  {
    "start": 680.08,
    "end": 682.56,
    "text": "结合富乐在全书的结论"
  },
  {
    "start": 682.56,
    "end": 684.36,
    "text": "必须强调一种全局观"
  },
  {
    "start": 684.36,
    "end": 686.5,
    "text": "那就是政治高于军事"
  },
  {
    "start": 686.5,
    "end": 688.68,
    "text": "就像克莱克维斯说的"
  },
  {
    "start": 688.68,
    "end": 690.16,
    "text": "战争是国家政治"
  },
  {
    "start": 690.16,
    "end": 691.48,
    "text": "用其他手段的延续"
  },
  {
    "start": 691.48,
    "end": 692.62,
    "text": "也就是说"
  },
  {
    "start": 692.62,
    "end": 693.94,
    "text": "如果不顾一切的"
  },
  {
    "start": 693.94,
    "end": 695.72,
    "text": "去忙碌追求纯军事追悔"
  },
  {
    "start": 695.72,
    "end": 697.14,
    "text": "完全抛弃了"
  },
  {
    "start": 697.14,
    "end": 699.4,
    "text": "建立长期有力的安定秩序"
  },
  {
    "start": 699.4,
    "end": 700.48,
    "text": "这个政治目标"
  },
  {
    "start": 700.48,
    "end": 702.8,
    "text": "那最后必然会导致丧失和平"
  },
  {
    "start": 702.8,
    "end": 703.26,
    "text": "对"
  },
  {
    "start": 703.26,
    "end": 705.44,
    "text": "技术会不断的重塑战术"
  },
  {
    "start": 705.44,
    "end": 706.68,
    "text": "但生存空间"
  },
  {
    "start": 706.68,
    "end": 707.6,
    "text": "人口结构"
  },
  {
    "start": 707.6,
    "end": 708.72,
    "text": "还有经济体制"
  },
  {
    "start": 708.72,
    "end": 711.34,
    "text": "这些才是冲突最底层的驱动力"
  },
  {
    "start": 711.34,
    "end": 712.16,
    "text": "当工业"
  },
  {
    "start": 712.16,
    "end": 713.6,
    "text": "科学和运输"
  },
  {
    "start": 713.6,
    "end": 715.88,
    "text": "让整个世界变成同一个舞台"
  },
  {
    "start": 715.88,
    "end": 717.26,
    "text": "看懂一场战争"
  },
  {
    "start": 717.26,
    "end": 719.6,
    "text": "要先看战场之外的哪些条件"
  }
]
