[
  {
    "start": 0.0,
    "end": 2.48,
    "text": "面对同一种现代育种技术"
  },
  {
    "start": 2.48,
    "end": 3.48,
    "text": "农场主"
  },
  {
    "start": 3.48,
    "end": 5.88,
    "text": "普通消费者和各国政府"
  },
  {
    "start": 5.88,
    "end": 7.92,
    "text": "各自在算一笔怎样的账"
  },
  {
    "start": 7.92,
    "end": 9.84,
    "text": "顺着这个问题"
  },
  {
    "start": 9.84,
    "end": 11.94,
    "text": "今天正好为您引入"
  },
  {
    "start": 11.94,
    "end": 13.9,
    "text": "圆越的人造恐慌"
  },
  {
    "start": 13.9,
    "end": 15.98,
    "text": "转基因全球实地考察"
  },
  {
    "start": 15.98,
    "end": 18.36,
    "text": "这本书的切入点非常有意思"
  },
  {
    "start": 18.36,
    "end": 20.04,
    "text": "怎么个有意思"
  },
  {
    "start": 20.04,
    "end": 21.66,
    "text": "就是作者本人"
  },
  {
    "start": 21.66,
    "end": 24.4,
    "text": "他是拥有分子生物学专业背景的"
  },
  {
    "start": 24.4,
    "end": 26.28,
    "text": "同时他有以记者的视角"
  },
  {
    "start": 26.28,
    "end": 27.66,
    "text": "走访了全球多地"
  },
  {
    "start": 27.66,
    "end": 29.02,
    "text": "在他眼里"
  },
  {
    "start": 29.02,
    "end": 31.82,
    "text": "转基因并不带有任何神秘色彩"
  },
  {
    "start": 31.82,
    "end": 33.26,
    "text": "也不是什么怪物"
  },
  {
    "start": 33.26,
    "end": 35.2,
    "text": "所以他是把这项技术驱昧了"
  },
  {
    "start": 35.2,
    "end": 36.42,
    "text": "对完全驱昧"
  },
  {
    "start": 36.42,
    "end": 38.0,
    "text": "他将其还原为一种"
  },
  {
    "start": 38.0,
    "end": 40.14,
    "text": "普通的现代育种技术"
  },
  {
    "start": 40.14,
    "end": 42.46,
    "text": "作者的核心观点其实非常直白"
  },
  {
    "start": 42.46,
    "end": 43.94,
    "text": "就是评估这项技术"
  },
  {
    "start": 43.94,
    "end": 44.84,
    "text": "到底划不划算"
  },
  {
    "start": 44.84,
    "end": 47.44,
    "text": "必须进行综合的利弊权衡"
  },
  {
    "start": 47.44,
    "end": 49.96,
    "text": "也就是说咱们得算明白这笔账"
  },
  {
    "start": 49.96,
    "end": 50.26,
    "text": "没错"
  },
  {
    "start": 50.26,
    "end": 51.68,
    "text": "他向您展示了"
  },
  {
    "start": 51.68,
    "end": 54.16,
    "text": "现在全球各地的那些反转浪潮"
  },
  {
    "start": 54.16,
    "end": 55.78,
    "text": "往往是源于复杂的"
  },
  {
    "start": 55.78,
    "end": 57.22,
    "text": "政治经济利益博弈"
  },
  {
    "start": 57.22,
    "end": 59.6,
    "text": "还有随之而来的人造恐慌"
  },
  {
    "start": 59.6,
    "end": 62.78,
    "text": "所以今天咱们就像朋友聊天一样"
  },
  {
    "start": 62.78,
    "end": 65.32,
    "text": "带你进入书里的全球考察现场"
  },
  {
    "start": 65.32,
    "end": 66.4,
    "text": "太好了"
  },
  {
    "start": 66.4,
    "end": 68.62,
    "text": "不过在带大家环游世界之前"
  },
  {
    "start": 68.62,
    "end": 71.3,
    "text": "咱们得先理清这本书的全貌"
  },
  {
    "start": 71.3,
    "end": 74.18,
    "text": "这是一本跨年份的报道合集"
  },
  {
    "start": 74.18,
    "end": 75.84,
    "text": "全书大概分为八个部分"
  },
  {
    "start": 75.84,
    "end": 78.66,
    "text": "从最基础的分子生物学知识开始"
  },
  {
    "start": 78.66,
    "end": 81.48,
    "text": "一路带你去到美国的大农业现场"
  },
  {
    "start": 81.48,
    "end": 82.98,
    "text": "欧洲的政策争论"
  },
  {
    "start": 82.98,
    "end": 85.32,
    "text": "亚洲不同国家的农业样本"
  },
  {
    "start": 85.32,
    "end": 88.84,
    "text": "然后回到咱们中国本土的棉花和大豆产业"
  },
  {
    "start": 88.84,
    "end": 91.36,
    "text": "甚至最后还延伸到了动物身上"
  },
  {
    "start": 91.36,
    "end": 91.68,
    "text": "对吧"
  },
  {
    "start": 91.68,
    "end": 92.2,
    "text": "对的"
  },
  {
    "start": 92.2,
    "end": 94.28,
    "text": "还包括转基因动物的研发"
  },
  {
    "start": 94.28,
    "end": 96.4,
    "text": "以及媒体面对这些争议史"
  },
  {
    "start": 96.4,
    "end": 97.48,
    "text": "该怎么去报道"
  },
  {
    "start": 97.48,
    "end": 99.44,
    "text": "那咱们就先从第一步"
  },
  {
    "start": 99.44,
    "end": 101.44,
    "text": "也就是最基础的原理说起"
  },
  {
    "start": 101.44,
    "end": 104.08,
    "text": "我发现书里在判断转基因食品"
  },
  {
    "start": 104.08,
    "end": 104.98,
    "text": "安不安全的时候"
  },
  {
    "start": 104.98,
    "end": 106.94,
    "text": "有一个很特别的设定"
  },
  {
    "start": 106.94,
    "end": 108.2,
    "text": "什么设定"
  },
  {
    "start": 108.2,
    "end": 112.12,
    "text": "就是他特意把DNA和蛋白质分开来看待"
  },
  {
    "start": 112.12,
    "end": 113.18,
    "text": "你想啊"
  },
  {
    "start": 113.18,
    "end": 115.72,
    "text": "这两个明明都是构成生命的基础物质"
  },
  {
    "start": 115.72,
    "end": 118.68,
    "text": "为什么要这么大费周章的拆开来评价呢"
  },
  {
    "start": 118.68,
    "end": 121.22,
    "text": "因为从化学性质上来说"
  },
  {
    "start": 121.22,
    "end": 122.44,
    "text": "它俩完全不同"
  },
  {
    "start": 122.44,
    "end": 125.38,
    "text": "安全评价关注的重点也截然不同"
  },
  {
    "start": 125.38,
    "end": 127.98,
    "text": "不管你吃什么品种的农作物"
  },
  {
    "start": 127.98,
    "end": 130.6,
    "text": "里面其实都含有海量的DNA"
  },
  {
    "start": 130.6,
    "end": 131.32,
    "text": "对"
  },
  {
    "start": 131.32,
    "end": 133.24,
    "text": "吃苹果也有苹果的DNA嘛"
  },
  {
    "start": 133.24,
    "end": 133.64,
    "text": "没错"
  },
  {
    "start": 133.64,
    "end": 136.82,
    "text": "这些DNA一旦进入你人体的消化系统"
  },
  {
    "start": 136.82,
    "end": 138.92,
    "text": "在强酸和各种酶的作物下"
  },
  {
    "start": 138.92,
    "end": 141.94,
    "text": "都会被无差别的降解成最基础的"
  },
  {
    "start": 141.94,
    "end": 143.92,
    "text": "就是那种很基础的核甘酸"
  },
  {
    "start": 143.92,
    "end": 144.32,
    "text": "对"
  },
  {
    "start": 144.32,
    "end": 145.02,
    "text": "核甘酸"
  },
  {
    "start": 145.02,
    "end": 148.14,
    "text": "不管你原来植入的是哪段外源DNA"
  },
  {
    "start": 148.14,
    "end": 149.26,
    "text": "拆散了之后"
  },
  {
    "start": 149.26,
    "end": 150.26,
    "text": "对人体来说"
  },
  {
    "start": 150.26,
    "end": 153.16,
    "text": "它就是普普通通的有氧物质"
  },
  {
    "start": 153.16,
    "end": 154.82,
    "text": "主流科学共同体的故事是"
  },
  {
    "start": 154.82,
    "end": 158.1,
    "text": "你不能抛开具体产品去空谈安全"
  },
  {
    "start": 158.1,
    "end": 158.88,
    "text": "还是危险"
  },
  {
    "start": 158.88,
    "end": 161.56,
    "text": "世界卫生组织是不是也有一种说法"
  },
  {
    "start": 161.56,
    "end": 162.06,
    "text": "是的"
  },
  {
    "start": 162.06,
    "end": 163.84,
    "text": "世界卫生组织明确指出"
  },
  {
    "start": 163.84,
    "end": 166.16,
    "text": "应当逐按进行安全评价"
  },
  {
    "start": 166.16,
    "end": 169.18,
    "text": "要看具体产品对应什么证据"
  },
  {
    "start": 169.18,
    "end": 171.08,
    "text": "为了让你更好理解"
  },
  {
    "start": 171.08,
    "end": 172.72,
    "text": "我用个生活化的类比吧"
  },
  {
    "start": 172.72,
    "end": 176.18,
    "text": "这就好比我们要评价一栋大楼改造之后"
  },
  {
    "start": 176.18,
    "end": 176.8,
    "text": "安不安全"
  },
  {
    "start": 176.8,
    "end": 180.0,
    "text": "你不能只盯着开发商手里新增的那张图纸"
  },
  {
    "start": 180.0,
    "end": 180.48,
    "text": "对"
  },
  {
    "start": 180.48,
    "end": 181.58,
    "text": "图纸就是DNA"
  },
  {
    "start": 181.58,
    "end": 182.08,
    "text": "是啊"
  },
  {
    "start": 182.08,
    "end": 184.76,
    "text": "你看图纸怎么可能看出这楼会不会塌呢"
  },
  {
    "start": 184.76,
    "end": 188.96,
    "text": "你得看最后按这个图纸实际建出来的那堵新承重墙"
  },
  {
    "start": 188.96,
    "end": 191.22,
    "text": "它本身的物理性质稳不稳固"
  },
  {
    "start": 191.22,
    "end": 192.92,
    "text": "这个比喻非常准确"
  },
  {
    "start": 192.92,
    "end": 195.9,
    "text": "承重墙就相当于那个新合成的蛋白质"
  },
  {
    "start": 195.9,
    "end": 197.98,
    "text": "科学界真正严苛审查的"
  },
  {
    "start": 197.98,
    "end": 200.4,
    "text": "就是这堵墙会不会引发过敏"
  },
  {
    "start": 200.4,
    "end": 201.52,
    "text": "或者带来毒性"
  },
  {
    "start": 201.52,
    "end": 204.18,
    "text": "搞明白了图纸和承重墙的区别"
  },
  {
    "start": 204.18,
    "end": 206.72,
    "text": "咱们就可以从微观的实验室里抽出来了"
  },
  {
    "start": 206.72,
    "end": 207.18,
    "text": "对"
  },
  {
    "start": 207.18,
    "end": 209.26,
    "text": "咱们带你去看看真实的土地"
  },
  {
    "start": 209.26,
    "end": 211.32,
    "text": "咱们先去美国广袤的玉米袋"
  },
  {
    "start": 211.32,
    "end": 214.1,
    "text": "在那种眼望不到头的精英场景里"
  },
  {
    "start": 214.1,
    "end": 214.98,
    "text": "你会发现"
  },
  {
    "start": 214.98,
    "end": 216.26,
    "text": "土地规模"
  },
  {
    "start": 216.26,
    "end": 217.22,
    "text": "大型机械"
  },
  {
    "start": 217.22,
    "end": 217.9,
    "text": "种子"
  },
  {
    "start": 217.9,
    "end": 219.54,
    "text": "还有积极稀缺的劳动力"
  },
  {
    "start": 219.54,
    "end": 221.98,
    "text": "这几样东西是紧紧绑定在一起的"
  },
  {
    "start": 221.98,
    "end": 224.44,
    "text": "对于美国的大农场主来说"
  },
  {
    "start": 224.44,
    "end": 226.26,
    "text": "这真的是一笔纯粹的经济账"
  },
  {
    "start": 226.26,
    "end": 229.92,
    "text": "选了带有抗虫或者耐出草剂特性的种子"
  },
  {
    "start": 229.92,
    "end": 231.32,
    "text": "打药的次数就少了"
  },
  {
    "start": 231.32,
    "end": 234.12,
    "text": "机械燃料和人工成本自然也就降下来了"
  },
  {
    "start": 234.12,
    "end": 234.66,
    "text": "没错"
  },
  {
    "start": 234.66,
    "end": 237.46,
    "text": "这在高度工业化的农业系统里非常划算"
  },
  {
    "start": 237.46,
    "end": 240.26,
    "text": "但这里我就有个特别敏锐的观察了"
  },
  {
    "start": 240.26,
    "end": 241.54,
    "text": "也是书里的一个关键矛盾"
  },
  {
    "start": 242.24,
    "end": 243.16,
    "text": "你想啊"
  },
  {
    "start": 243.16,
    "end": 245.24,
    "text": "既然农场主觉得这么划算"
  },
  {
    "start": 245.24,
    "end": 248.6,
    "text": "为什么很多普通的消费者却根本不买账呢"
  },
  {
    "start": 248.6,
    "end": 251.32,
    "text": "因为好处没落到消费者头上呀"
  },
  {
    "start": 251.32,
    "end": 251.66,
    "text": "对"
  },
  {
    "start": 251.66,
    "end": 253.4,
    "text": "这项技术最大的好处"
  },
  {
    "start": 253.4,
    "end": 254.98,
    "text": "比如节约了劳动力成本"
  },
  {
    "start": 254.98,
    "end": 257.44,
    "text": "全被买种子的农场主拿走了"
  },
  {
    "start": 257.44,
    "end": 259.34,
    "text": "你作为一个普通消费者"
  },
  {
    "start": 259.34,
    "end": 260.9,
    "text": "在超市里买玉米的时候"
  },
  {
    "start": 260.9,
    "end": 262.38,
    "text": "价格没变便宜"
  },
  {
    "start": 262.38,
    "end": 264.2,
    "text": "玉米也没变得更好吃"
  },
  {
    "start": 264.2,
    "end": 266.86,
    "text": "你在餐桌上感受不到直接的收益"
  },
  {
    "start": 266.86,
    "end": 268.98,
    "text": "自然就会对未知产生排斥"
  },
  {
    "start": 268.98,
    "end": 271.36,
    "text": "这也是为什么书里专闻引入了"
  },
  {
    "start": 271.36,
    "end": 272.52,
    "text": "另一个视角的案例"
  },
  {
    "start": 272.52,
    "end": 273.96,
    "text": "也就是黄金水稻"
  },
  {
    "start": 273.96,
    "end": 274.4,
    "text": "哦"
  },
  {
    "start": 274.4,
    "end": 275.22,
    "text": "黄金水稻"
  },
  {
    "start": 275.22,
    "end": 276.4,
    "text": "这个很有名"
  },
  {
    "start": 276.4,
    "end": 276.64,
    "text": "对"
  },
  {
    "start": 276.64,
    "end": 279.66,
    "text": "虽然它带有当年尚未批准的时代背景"
  },
  {
    "start": 279.66,
    "end": 282.0,
    "text": "但它的逻辑完全是为了消费者"
  },
  {
    "start": 282.0,
    "end": 285.74,
    "text": "它是为了解决贫困地区儿童缺乏维生素A的问题"
  },
  {
    "start": 285.74,
    "end": 288.0,
    "text": "直接服务于弱势群体的"
  },
  {
    "start": 288.0,
    "end": 288.8,
    "text": "也就是说"
  },
  {
    "start": 288.8,
    "end": 290.34,
    "text": "它的目标客户变了"
  },
  {
    "start": 290.34,
    "end": 290.7,
    "text": "是的"
  },
  {
    "start": 290.7,
    "end": 292.02,
    "text": "而且你会发现"
  },
  {
    "start": 292.02,
    "end": 294.24,
    "text": "这种直接面向消费者的研发"
  },
  {
    "start": 294.24,
    "end": 296.4,
    "text": "往往不是靠大型种业巨头"
  },
  {
    "start": 296.4,
    "end": 300.42,
    "text": "而是展现了公共资金和慈善支持在里面的特殊意义"
  },
  {
    "start": 300.42,
    "end": 300.92,
    "text": "明白了"
  },
  {
    "start": 300.92,
    "end": 304.02,
    "text": "那既然美国农场主这笔账算得很明白"
  },
  {
    "start": 304.02,
    "end": 307.42,
    "text": "为什么这套技术到了欧洲反对的声音会那么大"
  },
  {
    "start": 307.42,
    "end": 309.76,
    "text": "欧洲难道不需要节约成本吗"
  },
  {
    "start": 309.76,
    "end": 312.34,
    "text": "欧洲的情况要复杂得多"
  },
  {
    "start": 312.34,
    "end": 314.7,
    "text": "你千万别把欧洲看成铁板一块"
  },
  {
    "start": 314.7,
    "end": 316.9,
    "text": "它们内部有着巨大的温差"
  },
  {
    "start": 316.9,
    "end": 317.68,
    "text": "比如呢"
  },
  {
    "start": 317.68,
    "end": 318.86,
    "text": "比如西班牙"
  },
  {
    "start": 318.86,
    "end": 323.1,
    "text": "因为它们国内的触目业对饲料有着非常庞大的实际需求"
  },
  {
    "start": 323.1,
    "end": 325.84,
    "text": "所以它们对这项技术的接纳度相对就比较高"
  },
  {
    "start": 325.84,
    "end": 327.7,
    "text": "也就是有硬性需求"
  },
  {
    "start": 327.7,
    "end": 329.0,
    "text": "那其他国家呢"
  },
  {
    "start": 329.0,
    "end": 330.9,
    "text": "但如果你到了法国"
  },
  {
    "start": 330.9,
    "end": 332.16,
    "text": "情况就完全不同了"
  },
  {
    "start": 332.16,
    "end": 336.42,
    "text": "法国受到那种传统农业理念和风土文化的深刻影响"
  },
  {
    "start": 336.42,
    "end": 338.08,
    "text": "再加上复杂的政治争议"
  },
  {
    "start": 338.08,
    "end": 341.08,
    "text": "它们对这种工业化标准的接纳度极低"
  },
  {
    "start": 341.08,
    "end": 344.88,
    "text": "听起来更像是一种文化上的抗拒"
  },
  {
    "start": 344.88,
    "end": 346.14,
    "text": "再加上选票的考量"
  },
  {
    "start": 346.14,
    "end": 346.76,
    "text": "没错"
  },
  {
    "start": 346.76,
    "end": 347.8,
    "text": "而英国呢"
  },
  {
    "start": 347.8,
    "end": 348.4,
    "text": "又不太一样"
  },
  {
    "start": 348.4,
    "end": 352.38,
    "text": "它们更侧重于依靠专业机构的研究来决定政策态度"
  },
  {
    "start": 352.38,
    "end": 357.22,
    "text": "所以你看欧洲各国的政治动机和经济利益根本不在一个频道上"
  },
  {
    "start": 357.22,
    "end": 357.92,
    "text": "行"
  },
  {
    "start": 357.92,
    "end": 360.08,
    "text": "离开欧美这些发达地区"
  },
  {
    "start": 360.08,
    "end": 361.18,
    "text": "咱们换个视角"
  },
  {
    "start": 361.18,
    "end": 362.54,
    "text": "带你看看亚洲"
  },
  {
    "start": 362.54,
    "end": 365.5,
    "text": "这里的农业可就没那么优雅了"
  },
  {
    "start": 365.5,
    "end": 365.72,
    "text": "对"
  },
  {
    "start": 365.72,
    "end": 366.64,
    "text": "在亚洲"
  },
  {
    "start": 366.64,
    "end": 370.0,
    "text": "农业往往直接关乎生存和最基本的发展"
  },
  {
    "start": 370.0,
    "end": 373.28,
    "text": "作者在亚洲走访的实地样本非常生动"
  },
  {
    "start": 373.28,
    "end": 374.8,
    "text": "书里提到菲律宾了吧"
  },
  {
    "start": 374.8,
    "end": 375.7,
    "text": "提到了"
  },
  {
    "start": 375.7,
    "end": 377.36,
    "text": "在菲律宾的玉米田里"
  },
  {
    "start": 377.36,
    "end": 380.0,
    "text": "你能同时看到极其分化的现象"
  },
  {
    "start": 380.0,
    "end": 382.7,
    "text": "一边是大农场主在使用新技术"
  },
  {
    "start": 382.7,
    "end": 383.68,
    "text": "另一边呢"
  },
  {
    "start": 383.68,
    "end": 386.3,
    "text": "是小农户在坚持有机农业实践"
  },
  {
    "start": 386.3,
    "end": 388.3,
    "text": "他们面对的主要困难是什么"
  },
  {
    "start": 388.3,
    "end": 389.88,
    "text": "是玉米明"
  },
  {
    "start": 389.88,
    "end": 391.86,
    "text": "这种害虫太可怕了"
  },
  {
    "start": 391.86,
    "end": 393.68,
    "text": "能把玉米杆里面全注空"
  },
  {
    "start": 393.68,
    "end": 394.8,
    "text": "为了制虫"
  },
  {
    "start": 394.8,
    "end": 396.5,
    "text": "种植成本大幅上升"
  },
  {
    "start": 396.5,
    "end": 398.36,
    "text": "这就是最现实的生存压力"
  },
  {
    "start": 398.36,
    "end": 400.44,
    "text": "印度的情况是不是也差不多"
  },
  {
    "start": 400.44,
    "end": 403.64,
    "text": "印度的棉花产业是一步浓缩的历史"
  },
  {
    "start": 403.64,
    "end": 405.42,
    "text": "从当年绿色革命"
  },
  {
    "start": 405.42,
    "end": 407.0,
    "text": "引入高产作物的辉煌"
  },
  {
    "start": 407.0,
    "end": 410.28,
    "text": "一直到后来害虫产生抗药性带来的困境"
  },
  {
    "start": 410.28,
    "end": 412.26,
    "text": "再到引入转基因棉花"
  },
  {
    "start": 412.26,
    "end": 414.68,
    "text": "这里面应该也有很多博弈吧"
  },
  {
    "start": 414.68,
    "end": 415.3,
    "text": "对"
  },
  {
    "start": 415.3,
    "end": 417.34,
    "text": "不仅仅是农民的收入起伏"
  },
  {
    "start": 417.34,
    "end": 419.44,
    "text": "还交织着公民社会的阻力"
  },
  {
    "start": 419.44,
    "end": 422.38,
    "text": "以及政府治理层面的反复博弈"
  },
  {
    "start": 422.38,
    "end": 423.5,
    "text": "说到抗虫这事"
  },
  {
    "start": 423.5,
    "end": 426.92,
    "text": "我注意到书里提到了一个非常反直觉"
  },
  {
    "start": 426.92,
    "end": 428.58,
    "text": "但也极其有意思的机制"
  },
  {
    "start": 428.58,
    "end": 430.76,
    "text": "叫做避难所安排"
  },
  {
    "start": 430.76,
    "end": 434.34,
    "text": "这个避难所确实是个管理学上的难题"
  },
  {
    "start": 434.34,
    "end": 435.76,
    "text": "咱们跟听众解释一下"
  },
  {
    "start": 435.76,
    "end": 438.18,
    "text": "因为抗虫技术不是万能的吗"
  },
  {
    "start": 438.18,
    "end": 440.88,
    "text": "如果害虫天天吃抗虫的作物"
  },
  {
    "start": 440.88,
    "end": 442.48,
    "text": "早晚会净化出抗药性"
  },
  {
    "start": 442.48,
    "end": 445.68,
    "text": "所以为了防止或者延缓这种情况"
  },
  {
    "start": 445.68,
    "end": 448.52,
    "text": "要求农民必须在田里留出一小块地"
  },
  {
    "start": 448.52,
    "end": 451.0,
    "text": "专门种不抗虫的普通品种"
  },
  {
    "start": 451.0,
    "end": 453.42,
    "text": "就是故意留一块地去喂虫子"
  },
  {
    "start": 453.42,
    "end": 454.32,
    "text": "对啊"
  },
  {
    "start": 454.32,
    "end": 456.4,
    "text": "这就意味着极高的管理成本"
  },
  {
    "start": 456.4,
    "end": 457.64,
    "text": "你想啊"
  },
  {
    "start": 457.64,
    "end": 459.58,
    "text": "农民花高价买了抗虫种子"
  },
  {
    "start": 459.58,
    "end": 462.46,
    "text": "凭什么要让他牺牲一小块地的产量去喂虫子"
  },
  {
    "start": 462.46,
    "end": 466.08,
    "text": "这等于是让农民承担眼前的个体成本"
  },
  {
    "start": 466.08,
    "end": 468.88,
    "text": "去换取整个农业生态的集体收益"
  },
  {
    "start": 468.88,
    "end": 469.76,
    "text": "没错"
  },
  {
    "start": 469.76,
    "end": 472.5,
    "text": "这就是个体与集体的利益冲突"
  },
  {
    "start": 472.5,
    "end": 473.46,
    "text": "要是监管不到位"
  },
  {
    "start": 473.46,
    "end": 476.38,
    "text": "大家都偷偷把地全种上抗虫品种"
  },
  {
    "start": 476.38,
    "end": 479.66,
    "text": "那这项技术的寿命很快又会被透支掉"
  },
  {
    "start": 479.66,
    "end": 481.96,
    "text": "所以这里面全是人性的考量"
  },
  {
    "start": 481.96,
    "end": 484.32,
    "text": "咱们聊完亚洲其他国家"
  },
  {
    "start": 484.32,
    "end": 485.98,
    "text": "赶紧拉回本土视角"
  },
  {
    "start": 485.98,
    "end": 488.46,
    "text": "聊聊咱们中国的棉花战争"
  },
  {
    "start": 488.46,
    "end": 490.92,
    "text": "这段历史非常惊心动魄啊"
  },
  {
    "start": 490.92,
    "end": 493.7,
    "text": "当年咱们的棉田面临棉林虫大爆发"
  },
  {
    "start": 493.7,
    "end": 495.7,
    "text": "几乎到了无药可救的地步"
  },
  {
    "start": 495.7,
    "end": 497.98,
    "text": "后来是靠着引入新技术"
  },
  {
    "start": 497.98,
    "end": 499.88,
    "text": "以及本土科研力量的崛起"
  },
  {
    "start": 499.88,
    "end": 501.16,
    "text": "才稳住了局面"
  },
  {
    "start": 501.16,
    "end": 503.02,
    "text": "同时书里也写到了"
  },
  {
    "start": 503.02,
    "end": 505.56,
    "text": "棉田和其他作物在争夺耕地"
  },
  {
    "start": 505.56,
    "end": 509.12,
    "text": "包括一些有机棉农的坚持和实践"
  },
  {
    "start": 509.12,
    "end": 509.46,
    "text": "是的"
  },
  {
    "start": 509.46,
    "end": 510.42,
    "text": "不过在这里"
  },
  {
    "start": 510.42,
    "end": 512.88,
    "text": "作者抛出了一个非常犀利的问题"
  },
  {
    "start": 512.88,
    "end": 513.66,
    "text": "什么问题"
  },
  {
    "start": 513.66,
    "end": 516.2,
    "text": "为什么中国没有孟山东"
  },
  {
    "start": 516.2,
    "end": 517.16,
    "text": "哇"
  },
  {
    "start": 517.16,
    "end": 518.16,
    "text": "这个问题很大"
  },
  {
    "start": 518.16,
    "end": 519.02,
    "text": "相当大"
  },
  {
    "start": 519.02,
    "end": 521.38,
    "text": "这其实是借着一家企业"
  },
  {
    "start": 521.38,
    "end": 523.34,
    "text": "把众业企业的研发能力"
  },
  {
    "start": 523.34,
    "end": 524.56,
    "text": "知识产权保护"
  },
  {
    "start": 524.56,
    "end": 526.22,
    "text": "科技部门的审批机制"
  },
  {
    "start": 526.22,
    "end": 528.66,
    "text": "一直到国家粮食安全的宏大命题"
  },
  {
    "start": 528.66,
    "end": 529.72,
    "text": "全给串起来了"
  },
  {
    "start": 529.72,
    "end": 530.68,
    "text": "确实"
  },
  {
    "start": 530.68,
    "end": 532.34,
    "text": "没有自己的核心种业"
  },
  {
    "start": 532.34,
    "end": 533.98,
    "text": "很多时候就会受之于人"
  },
  {
    "start": 533.98,
    "end": 536.6,
    "text": "这就不得不提到大豆贸易了"
  },
  {
    "start": 536.6,
    "end": 539.1,
    "text": "这里面就有很现实的产业背景"
  },
  {
    "start": 539.1,
    "end": 541.74,
    "text": "比如杂椒玉米在争夺有限的耕地"
  },
  {
    "start": 541.74,
    "end": 544.0,
    "text": "还有国内养殖业对豆粕"
  },
  {
    "start": 544.0,
    "end": 546.06,
    "text": "饲料那巨大无比的需求"
  },
  {
    "start": 546.06,
    "end": 546.5,
    "text": "对"
  },
  {
    "start": 546.5,
    "end": 549.02,
    "text": "甚至还有免耕法带来的各种困境"
  },
  {
    "start": 549.02,
    "end": 551.1,
    "text": "都在逼着产业去寻找出路"
  },
  {
    "start": 551.1,
    "end": 553.4,
    "text": "这里有四个非常关键的数字"
  },
  {
    "start": 553.4,
    "end": 554.06,
    "text": "你听好了"
  },
  {
    "start": 554.06,
    "end": 555.36,
    "text": "2013年"
  },
  {
    "start": 555.36,
    "end": 556.46,
    "text": "中国进口大豆"
  },
  {
    "start": 556.46,
    "end": 558.68,
    "text": "6340万吨"
  },
  {
    "start": 558.68,
    "end": 559.36,
    "text": "同年"
  },
  {
    "start": 559.36,
    "end": 562.12,
    "text": "本土大豆产量约1200万吨"
  },
  {
    "start": 562.12,
    "end": 564.1,
    "text": "不到进口量的20%"
  },
  {
    "start": 564.1,
    "end": 564.98,
    "text": "巨大的缺口"
  },
  {
    "start": 564.98,
    "end": 566.22,
    "text": "为了看清楚"
  },
  {
    "start": 566.22,
    "end": 567.78,
    "text": "这些大豆是从哪来的"
  },
  {
    "start": 567.78,
    "end": 570.18,
    "text": "作者直接把视野拓展到了南美洲"
  },
  {
    "start": 570.18,
    "end": 572.52,
    "text": "去实地考察了阿根廷和巴西"
  },
  {
    "start": 572.52,
    "end": 574.76,
    "text": "南美那边是一番什么景象"
  },
  {
    "start": 574.76,
    "end": 577.44,
    "text": "也是深深嵌在国际贸易里的"
  },
  {
    "start": 577.44,
    "end": 578.22,
    "text": "在阿根廷"
  },
  {
    "start": 578.22,
    "end": 580.76,
    "text": "你看到的是政府怎么收出口税"
  },
  {
    "start": 580.76,
    "end": 582.1,
    "text": "港口怎么运转"
  },
  {
    "start": 582.1,
    "end": 584.52,
    "text": "以及农场怎么拼命压缩成本"
  },
  {
    "start": 584.52,
    "end": 585.84,
    "text": "那巴西呢"
  },
  {
    "start": 585.84,
    "end": 588.0,
    "text": "巴西的经历更细句话"
  },
  {
    "start": 588.0,
    "end": 591.44,
    "text": "他们早年是为了适应本土地利去搞科研"
  },
  {
    "start": 591.44,
    "end": 595.2,
    "text": "结果因为周边国家种新技术太赚钱了"
  },
  {
    "start": 595.2,
    "end": 598.44,
    "text": "巴西农民竟然自己搞起了非法种植"
  },
  {
    "start": 598.44,
    "end": 600.68,
    "text": "偷偷把种子走私进来种"
  },
  {
    "start": 600.68,
    "end": 603.08,
    "text": "也就是民间倒逼官方了"
  },
  {
    "start": 603.08,
    "end": 603.56,
    "text": "对"
  },
  {
    "start": 603.56,
    "end": 605.2,
    "text": "这就向你证明了"
  },
  {
    "start": 605.2,
    "end": 606.58,
    "text": "一项技术的效益"
  },
  {
    "start": 606.58,
    "end": 609.2,
    "text": "它不是在真空的实验室里产生的"
  },
  {
    "start": 609.2,
    "end": 611.02,
    "text": "它完全是长在国际贸易"
  },
  {
    "start": 611.02,
    "end": 613.36,
    "text": "和当地耕作制度的泥土里的"
  },
  {
    "start": 613.36,
    "end": 614.24,
    "text": "哎呀"
  },
  {
    "start": 614.24,
    "end": 616.7,
    "text": "光是植物育种就已经这么复杂了"
  },
  {
    "start": 616.7,
    "end": 619.32,
    "text": "但书里其实还提到了更敏感的领域"
  },
  {
    "start": 619.32,
    "end": 619.7,
    "text": "对吧"
  },
  {
    "start": 619.7,
    "end": 620.22,
    "text": "对"
  },
  {
    "start": 620.22,
    "end": 623.12,
    "text": "从植物跨界到了转基因动物的时代"
  },
  {
    "start": 623.12,
    "end": 625.02,
    "text": "这争议可就大得多了"
  },
  {
    "start": 625.02,
    "end": 627.74,
    "text": "我记得书里讲到了加拿大的环保猪"
  },
  {
    "start": 627.74,
    "end": 628.34,
    "text": "是的"
  },
  {
    "start": 628.34,
    "end": 630.98,
    "text": "那种猪能减少粪便里的零污染"
  },
  {
    "start": 630.98,
    "end": 633.2,
    "text": "还有长得更快的三文鱼"
  },
  {
    "start": 633.2,
    "end": 634.56,
    "text": "你可以想象一下"
  },
  {
    "start": 634.56,
    "end": 636.54,
    "text": "动植物在细胞培养"
  },
  {
    "start": 636.54,
    "end": 638.12,
    "text": "繁育周期和成本上"
  },
  {
    "start": 638.12,
    "end": 639.64,
    "text": "差异有多么巨大"
  },
  {
    "start": 639.64,
    "end": 641.2,
    "text": "植物种在地里"
  },
  {
    "start": 641.2,
    "end": 641.88,
    "text": "它跑不了"
  },
  {
    "start": 641.88,
    "end": 644.96,
    "text": "但动物是长腿或者长尾巴的呀"
  },
  {
    "start": 644.96,
    "end": 646.16,
    "text": "就是这个问题"
  },
  {
    "start": 646.16,
    "end": 648.8,
    "text": "所以动物面临的审批要严格的多"
  },
  {
    "start": 648.8,
    "end": 650.02,
    "text": "比如那个三文鱼"
  },
  {
    "start": 650.02,
    "end": 652.5,
    "text": "为了防止它逃逸到野生环境里"
  },
  {
    "start": 652.5,
    "end": 655.6,
    "text": "监管要求极其严苛的饲养隔离审批"
  },
  {
    "start": 655.6,
    "end": 657.52,
    "text": "必须在封闭的水箱里养"
  },
  {
    "start": 657.52,
    "end": 658.0,
    "text": "对"
  },
  {
    "start": 658.0,
    "end": 660.12,
    "text": "书里还提到一个更有趣的"
  },
  {
    "start": 660.12,
    "end": 661.62,
    "text": "就是针对蚊子的实验"
  },
  {
    "start": 661.62,
    "end": 662.96,
    "text": "蚊子也能改"
  },
  {
    "start": 662.96,
    "end": 663.84,
    "text": "能啊"
  },
  {
    "start": 663.84,
    "end": 666.32,
    "text": "为了对付那些传播疾病的蚊子"
  },
  {
    "start": 666.32,
    "end": 667.96,
    "text": "科学家提出了一些方案"
  },
  {
    "start": 667.96,
    "end": 671.46,
    "text": "比如不断在野外补充经过改造的雄蚊"
  },
  {
    "start": 671.46,
    "end": 674.86,
    "text": "或者是直接去改变他们后代的性别比例"
  },
  {
    "start": 674.86,
    "end": 676.48,
    "text": "让种群自然崩溃"
  },
  {
    "start": 676.48,
    "end": 677.32,
    "text": "哇"
  },
  {
    "start": 677.32,
    "end": 679.32,
    "text": "这听起来简直像科幻电影"
  },
  {
    "start": 679.32,
    "end": 681.38,
    "text": "面对这么多庞杂"
  },
  {
    "start": 681.38,
    "end": 683.52,
    "text": "前沿又充满争议的信息"
  },
  {
    "start": 683.52,
    "end": 684.96,
    "text": "咱们普通人"
  },
  {
    "start": 684.96,
    "end": 686.04,
    "text": "甚至是媒体"
  },
  {
    "start": 686.04,
    "end": 688.38,
    "text": "到底该怎么去理解和报道呢"
  },
  {
    "start": 688.38,
    "end": 690.38,
    "text": "作者分享了他的媒体观"
  },
  {
    "start": 690.38,
    "end": 691.86,
    "text": "我觉得非常值得借鉴"
  },
  {
    "start": 691.86,
    "end": 692.66,
    "text": "他说"
  },
  {
    "start": 692.66,
    "end": 696.28,
    "text": "这本书是写给那些感兴趣的中间派的"
  },
  {
    "start": 696.28,
    "end": 697.82,
    "text": "什么叫中间派"
  },
  {
    "start": 697.82,
    "end": 699.92,
    "text": "就是那些不预设立场"
  },
  {
    "start": 699.92,
    "end": 701.78,
    "text": "愿意听科学证据的人"
  },
  {
    "start": 701.78,
    "end": 702.96,
    "text": "作者主张"
  },
  {
    "start": 702.96,
    "end": 704.92,
    "text": "当你面对这种新兴技术"
  },
  {
    "start": 704.92,
    "end": 706.84,
    "text": "无论是现在的AI时代"
  },
  {
    "start": 706.84,
    "end": 709.06,
    "text": "还是别的什么引发社会焦虑的技术时"
  },
  {
    "start": 709.06,
    "end": 710.82,
    "text": "你首先要做的"
  },
  {
    "start": 710.82,
    "end": 713.18,
    "text": "就是剥离掉情绪化的宣泄"
  },
  {
    "start": 713.18,
    "end": 714.44,
    "text": "先冷静下来"
  },
  {
    "start": 714.44,
    "end": 714.74,
    "text": "对"
  },
  {
    "start": 714.74,
    "end": 717.32,
    "text": "然后你要依靠科学共同体"
  },
  {
    "start": 717.32,
    "end": 718.6,
    "text": "去进行理性的评估"
  },
  {
    "start": 718.6,
    "end": 719.7,
    "text": "作为媒体"
  },
  {
    "start": 719.7,
    "end": 721.42,
    "text": "你必须如实的报道"
  },
  {
    "start": 721.42,
    "end": 722.72,
    "text": "这项技术有什么缺点"
  },
  {
    "start": 722.72,
    "end": 724.58,
    "text": "绝不能止报喜不报忧"
  },
  {
    "start": 724.58,
    "end": 725.72,
    "text": "最重要的是"
  },
  {
    "start": 725.72,
    "end": 728.06,
    "text": "要把技术放进整个农业大系统里"
  },
  {
    "start": 728.06,
    "end": 728.92,
    "text": "去进行比较"
  },
  {
    "start": 728.92,
    "end": 729.56,
    "text": "没错"
  },
  {
    "start": 729.56,
    "end": 731.4,
    "text": "你不能孤立的看它"
  },
  {
    "start": 731.4,
    "end": 732.16,
    "text": "同时"
  },
  {
    "start": 732.16,
    "end": 733.86,
    "text": "你还要学会一双慧眼"
  },
  {
    "start": 733.86,
    "end": 736.1,
    "text": "去识别那些行政禁令背后"
  },
  {
    "start": 736.1,
    "end": 737.8,
    "text": "到底是不是掺杂了"
  },
  {
    "start": 737.8,
    "end": 738.92,
    "text": "政治选举的算计"
  },
  {
    "start": 738.92,
    "end": 740.94,
    "text": "或者是贸易保护的私心"
  },
  {
    "start": 740.94,
    "end": 742.2,
    "text": "这确实是一种"
  },
  {
    "start": 742.2,
    "end": 743.7,
    "text": "非常健康的科学素养"
  },
  {
    "start": 743.7,
    "end": 745.56,
    "text": "讨论一项农业技术"
  },
  {
    "start": 745.56,
    "end": 746.6,
    "text": "是否划算是"
  },
  {
    "start": 746.6,
    "end": 748.7,
    "text": "为什么要把具体作物"
  },
  {
    "start": 748.7,
    "end": 750.56,
    "text": "种植地区和比较对象"
  }
]
