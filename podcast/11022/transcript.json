[
  {
    "start": 0.0,
    "end": 1.18,
    "text": "假设咱们现在啊"
  },
  {
    "start": 1.18,
    "end": 2.66,
    "text": "做一个时间旅行的实验"
  },
  {
    "start": 2.66,
    "end": 4.68,
    "text": "穿越回过去吗"
  },
  {
    "start": 4.68,
    "end": 5.08,
    "text": "对"
  },
  {
    "start": 5.08,
    "end": 6.58,
    "text": "你带着现在的记忆"
  },
  {
    "start": 6.58,
    "end": 8.76,
    "text": "直接穿越回1900年的大清"
  },
  {
    "start": 8.76,
    "end": 10.3,
    "text": "然后你跑到街上"
  },
  {
    "start": 10.3,
    "end": 10.92,
    "text": "大喊一声"
  },
  {
    "start": 10.92,
    "end": 12.0,
    "text": "我要学科学"
  },
  {
    "start": 12.0,
    "end": 13.84,
    "text": "或者跑去跟衙门里的人说"
  },
  {
    "start": 13.84,
    "end": 15.38,
    "text": "你们得做个预算"
  },
  {
    "start": 15.38,
    "end": 18.14,
    "text": "别人肯定会把你当成一个疯子"
  },
  {
    "start": 18.14,
    "end": 18.9,
    "text": "绝对的"
  },
  {
    "start": 18.9,
    "end": 20.08,
    "text": "为什么呢"
  },
  {
    "start": 20.08,
    "end": 21.38,
    "text": "因为在那个时候"
  },
  {
    "start": 21.38,
    "end": 22.56,
    "text": "这些词的意思"
  },
  {
    "start": 22.56,
    "end": 24.76,
    "text": "跟你今天在字典里查到的"
  },
  {
    "start": 24.76,
    "end": 26.0,
    "text": "或者说你脑子里"
  },
  {
    "start": 26.0,
    "end": 27.62,
    "text": "理所当然认为的那个定义"
  },
  {
    "start": 27.62,
    "end": 29.12,
    "text": "根本就不是一回事"
  },
  {
    "start": 29.12,
    "end": 29.86,
    "text": "确实"
  },
  {
    "start": 29.86,
    "end": 30.94,
    "text": "差得远了"
  },
  {
    "start": 30.94,
    "end": 32.78,
    "text": "我们很多时候啊"
  },
  {
    "start": 32.78,
    "end": 34.92,
    "text": "会以为历史是那种单向进步的"
  },
  {
    "start": 34.92,
    "end": 37.14,
    "text": "以为那些现代词汇或者制度"
  },
  {
    "start": 37.14,
    "end": 38.46,
    "text": "从诞生那一刻起"
  },
  {
    "start": 38.46,
    "end": 39.72,
    "text": "就长着今天这个样子"
  },
  {
    "start": 39.72,
    "end": 41.78,
    "text": "这是一种很常见的错觉"
  },
  {
    "start": 41.78,
    "end": 43.88,
    "text": "所以如果你直接拿着"
  },
  {
    "start": 43.88,
    "end": 45.12,
    "text": "今天的现代汉语字典"
  },
  {
    "start": 45.12,
    "end": 47.22,
    "text": "去硬套一百多年前的历史"
  },
  {
    "start": 47.22,
    "end": 49.98,
    "text": "你绝对会迷失在字词的幻影里"
  },
  {
    "start": 49.98,
    "end": 52.08,
    "text": "今天咱们就要带大家"
  },
  {
    "start": 52.08,
    "end": 54.74,
    "text": "深挖一堆晚清民国的历史文本"
  },
  {
    "start": 54.74,
    "end": 55.84,
    "text": "一起来看看"
  },
  {
    "start": 55.84,
    "end": 57.76,
    "text": "那些我们习以为常的概念"
  },
  {
    "start": 57.76,
    "end": 59.3,
    "text": "当年到底经历了"
  },
  {
    "start": 59.3,
    "end": 61.88,
    "text": "怎样痛苦的跨界和缝合"
  },
  {
    "start": 61.88,
    "end": 62.6,
    "text": "没错"
  },
  {
    "start": 62.6,
    "end": 64.28,
    "text": "咱们今天这次深挖"
  },
  {
    "start": 64.28,
    "end": 66.14,
    "text": "要探讨的核心材料是"
  },
  {
    "start": 66.14,
    "end": 69.66,
    "text": "近代中国的知识与制度转型"
  },
  {
    "start": 69.66,
    "end": 71.38,
    "text": "这个名字听起来"
  },
  {
    "start": 71.38,
    "end": 74.26,
    "text": "有点像那种很宏大的教材"
  },
  {
    "start": 74.26,
    "end": 76.0,
    "text": "对听名字非常宏大"
  },
  {
    "start": 76.0,
    "end": 77.78,
    "text": "很多人可能下意识的觉得"
  },
  {
    "start": 77.78,
    "end": 79.76,
    "text": "这就是一本从头到尾"
  },
  {
    "start": 79.76,
    "end": 81.1,
    "text": "由一两个人写完的"
  },
  {
    "start": 81.1,
    "end": 82.7,
    "text": "系统给你上课的通识"
  },
  {
    "start": 82.7,
    "end": 84.32,
    "text": "但其实根本不是这样"
  },
  {
    "start": 84.32,
    "end": 85.54,
    "text": "那是怎样的"
  },
  {
    "start": 85.54,
    "end": 87.8,
    "text": "它是课题组多位学者"
  },
  {
    "start": 87.8,
    "end": 89.88,
    "text": "分工撰写的一套八册的"
  },
  {
    "start": 89.88,
    "end": 90.78,
    "text": "专题论文集"
  },
  {
    "start": 90.78,
    "end": 92.86,
    "text": "是由桑兵和关晓红"
  },
  {
    "start": 92.86,
    "end": 94.2,
    "text": "两位学者主编的"
  },
  {
    "start": 94.2,
    "end": 96.1,
    "text": "就是说是大家分头做研究"
  },
  {
    "start": 96.1,
    "end": 97.24,
    "text": "然后拼合在一起的"
  },
  {
    "start": 97.24,
    "end": 97.62,
    "text": "对"
  },
  {
    "start": 97.62,
    "end": 99.36,
    "text": "而且它的结构非常有意思"
  },
  {
    "start": 99.36,
    "end": 101.44,
    "text": "它分为总说分说"
  },
  {
    "start": 101.44,
    "end": 103.22,
    "text": "还有具体的专题章"
  },
  {
    "start": 103.22,
    "end": 103.84,
    "text": "等一下"
  },
  {
    "start": 103.84,
    "end": 106.46,
    "text": "总说就是指前言那种吗"
  },
  {
    "start": 106.46,
    "end": 107.54,
    "text": "类似吧"
  },
  {
    "start": 107.54,
    "end": 109.84,
    "text": "主编在各册前面的总说里"
  },
  {
    "start": 109.84,
    "end": 110.78,
    "text": "其实提供的是"
  },
  {
    "start": 110.78,
    "end": 112.78,
    "text": "大家共同的问题意识"
  },
  {
    "start": 112.78,
    "end": 114.62,
    "text": "指明一个研究的大方向"
  },
  {
    "start": 114.62,
    "end": 115.48,
    "text": "定个调子"
  },
  {
    "start": 115.48,
    "end": 115.94,
    "text": "没错"
  },
  {
    "start": 115.94,
    "end": 117.52,
    "text": "但我们读的时候要注意"
  },
  {
    "start": 117.52,
    "end": 119.88,
    "text": "绝不能把这个总说"
  },
  {
    "start": 119.88,
    "end": 122.0,
    "text": "当成拔份已经完成的"
  },
  {
    "start": 122.0,
    "end": 122.88,
    "text": "独立证明"
  },
  {
    "start": 122.88,
    "end": 124.72,
    "text": "也不能把主编当成书中"
  },
  {
    "start": 124.72,
    "end": 125.98,
    "text": "每一个具体观点的"
  },
  {
    "start": 125.98,
    "end": 126.88,
    "text": "唯一输出者"
  },
  {
    "start": 126.88,
    "end": 127.42,
    "text": "明白"
  },
  {
    "start": 127.42,
    "end": 129.84,
    "text": "得看具体的作者是这么写的"
  },
  {
    "start": 129.84,
    "end": 130.24,
    "text": "对的"
  },
  {
    "start": 130.24,
    "end": 132.28,
    "text": "要想看清历史的真实细节"
  },
  {
    "start": 132.28,
    "end": 134.62,
    "text": "咱们必须钻进每一张的证文"
  },
  {
    "start": 134.62,
    "end": 136.66,
    "text": "跟着各个章节的具体作者"
  },
  {
    "start": 136.66,
    "end": 139.38,
    "text": "去浩如烟海的材料里找证据"
  },
  {
    "start": 139.38,
    "end": 139.62,
    "text": "好"
  },
  {
    "start": 139.62,
    "end": 141.4,
    "text": "那咱们就把它拆开来看看"
  },
  {
    "start": 141.4,
    "end": 144.02,
    "text": "既然是一群学者的各自生化"
  },
  {
    "start": 144.02,
    "end": 146.24,
    "text": "咱们今天就不做走马光花的概览了"
  },
  {
    "start": 146.24,
    "end": 148.68,
    "text": "材料里反复强调了一个核心方法"
  },
  {
    "start": 148.68,
    "end": 149.14,
    "text": "叫做"
  },
  {
    "start": 149.14,
    "end": 151.7,
    "text": "由下一时揭到上一时的"
  },
  {
    "start": 151.7,
    "end": 153.16,
    "text": "逆推顺讲法"
  },
  {
    "start": 153.16,
    "end": 155.2,
    "text": "这个词稍微有点拗口"
  },
  {
    "start": 155.2,
    "end": 155.92,
    "text": "是啊"
  },
  {
    "start": 155.92,
    "end": 156.7,
    "text": "听着有点晕"
  },
  {
    "start": 156.7,
    "end": 158.14,
    "text": "用大白话来说"
  },
  {
    "start": 158.14,
    "end": 159.36,
    "text": "这到底是个什么操作"
  },
  {
    "start": 159.36,
    "end": 160.44,
    "text": "其实就是说"
  },
  {
    "start": 160.44,
    "end": 162.8,
    "text": "我们要警惕当事后诸葛亮"
  },
  {
    "start": 162.8,
    "end": 163.3,
    "text": "哦"
  },
  {
    "start": 163.3,
    "end": 164.1,
    "text": "事后诸葛亮"
  },
  {
    "start": 164.1,
    "end": 164.44,
    "text": "对"
  },
  {
    "start": 164.44,
    "end": 166.2,
    "text": "我们总是习惯站在今天"
  },
  {
    "start": 166.2,
    "end": 167.88,
    "text": "用后来才形成的那些"
  },
  {
    "start": 167.88,
    "end": 169.84,
    "text": "集合概念去倒退历史"
  },
  {
    "start": 169.84,
    "end": 170.5,
    "text": "比如"
  },
  {
    "start": 170.5,
    "end": 171.66,
    "text": "大家今天肯定觉得"
  },
  {
    "start": 171.66,
    "end": 172.82,
    "text": "现代教育是好的"
  },
  {
    "start": 172.82,
    "end": 173.98,
    "text": "科举是坏的"
  },
  {
    "start": 173.98,
    "end": 174.32,
    "text": "对吧"
  },
  {
    "start": 174.32,
    "end": 175.48,
    "text": "那肯定是啊"
  },
  {
    "start": 175.48,
    "end": 176.62,
    "text": "历史书上都这么写"
  },
  {
    "start": 176.62,
    "end": 178.12,
    "text": "好的淘汰了坏的"
  },
  {
    "start": 178.12,
    "end": 178.56,
    "text": "这"
  },
  {
    "start": 178.56,
    "end": 179.72,
    "text": "就是问题所在"
  },
  {
    "start": 179.72,
    "end": 180.42,
    "text": "所谓"
  },
  {
    "start": 180.42,
    "end": 181.68,
    "text": "逆推顺讲"
  },
  {
    "start": 181.68,
    "end": 182.74,
    "text": "就是要求我们"
  },
  {
    "start": 182.74,
    "end": 184.3,
    "text": "抛弃这种后见之明"
  },
  {
    "start": 184.3,
    "end": 186.1,
    "text": "真正回到当时的语境"
  },
  {
    "start": 186.1,
    "end": 187.48,
    "text": "看看一个旧事物"
  },
  {
    "start": 187.48,
    "end": 188.18,
    "text": "退出的时候"
  },
  {
    "start": 188.18,
    "end": 189.84,
    "text": "现场到底发生了什么"
  },
  {
    "start": 189.84,
    "end": 190.76,
    "text": "明白了"
  },
  {
    "start": 190.76,
    "end": 191.68,
    "text": "那要理解"
  },
  {
    "start": 191.68,
    "end": 193.42,
    "text": "现代知识是怎么进来的"
  },
  {
    "start": 193.42,
    "end": 194.5,
    "text": "咱们首先得看看"
  },
  {
    "start": 194.5,
    "end": 195.48,
    "text": "旧的选拔体系"
  },
  {
    "start": 195.48,
    "end": 196.46,
    "text": "是怎么退出的"
  },
  {
    "start": 196.46,
    "end": 198.24,
    "text": "说到废除科举"
  },
  {
    "start": 198.24,
    "end": 199.94,
    "text": "大家脑子里通常浮现的"
  },
  {
    "start": 199.94,
    "end": 200.88,
    "text": "就是一出爽剧"
  },
  {
    "start": 200.88,
    "end": 202.1,
    "text": "什么样的爽剧"
  },
  {
    "start": 202.1,
    "end": 202.82,
    "text": "就是那种"
  },
  {
    "start": 202.82,
    "end": 204.56,
    "text": "腐朽落后的八股文"
  },
  {
    "start": 204.56,
    "end": 206.0,
    "text": "终于被先进的数理化"
  },
  {
    "start": 206.0,
    "end": 207.14,
    "text": "给无情淘汰了"
  },
  {
    "start": 207.14,
    "end": 208.94,
    "text": "这难道不是事实吗"
  },
  {
    "start": 208.94,
    "end": 211.38,
    "text": "这种简单化的叙事啊"
  },
  {
    "start": 211.38,
    "end": 212.62,
    "text": "往往会掩盖历史"
  },
  {
    "start": 212.62,
    "end": 213.64,
    "text": "真实的褶皱"
  },
  {
    "start": 213.64,
    "end": 214.44,
    "text": "怎么说"
  },
  {
    "start": 214.44,
    "end": 216.52,
    "text": "在材料第二册第一章里"
  },
  {
    "start": 216.52,
    "end": 218.76,
    "text": "作者探讨终结科举制的设计"
  },
  {
    "start": 218.76,
    "end": 219.26,
    "text": "是发现"
  },
  {
    "start": 219.26,
    "end": 220.88,
    "text": "传统的取士制度"
  },
  {
    "start": 220.88,
    "end": 222.0,
    "text": "承担的社会功能"
  },
  {
    "start": 222.0,
    "end": 223.52,
    "text": "那是极其庞杂的"
  },
  {
    "start": 223.52,
    "end": 224.36,
    "text": "庞杂"
  },
  {
    "start": 224.36,
    "end": 225.8,
    "text": "不仅仅是考试吗"
  },
  {
    "start": 225.8,
    "end": 227.32,
    "text": "绝对不仅仅是考试"
  },
  {
    "start": 227.32,
    "end": 228.84,
    "text": "它里面包含了国家"
  },
  {
    "start": 228.84,
    "end": 230.52,
    "text": "对基层的伦理教化"
  },
  {
    "start": 230.52,
    "end": 232.44,
    "text": "还有官员上任前的"
  },
  {
    "start": 232.44,
    "end": 233.94,
    "text": "职业准则预言"
  },
  {
    "start": 233.94,
    "end": 234.24,
    "text": "嗯"
  },
  {
    "start": 234.24,
    "end": 236.0,
    "text": "毕竟考的都是四书五经"
  },
  {
    "start": 236.0,
    "end": 237.46,
    "text": "确实有教化作用"
  },
  {
    "start": 237.46,
    "end": 238.9,
    "text": "还有最核心的一点"
  },
  {
    "start": 238.9,
    "end": 241.3,
    "text": "它是当时全社会阶层流动的"
  },
  {
    "start": 241.3,
    "end": 242.8,
    "text": "最主要导项"
  },
  {
    "start": 242.8,
    "end": 244.56,
    "text": "也就是普通人改变命运的"
  },
  {
    "start": 244.56,
    "end": 245.32,
    "text": "唯一通道"
  },
  {
    "start": 245.32,
    "end": 245.9,
    "text": "没错"
  },
  {
    "start": 245.9,
    "end": 247.18,
    "text": "而相比之下"
  },
  {
    "start": 247.18,
    "end": 249.0,
    "text": "当时清末引入的现代学堂"
  },
  {
    "start": 249.0,
    "end": 250.16,
    "text": "它的主要功能"
  },
  {
    "start": 250.16,
    "end": 251.72,
    "text": "其实被极大的收窄了"
  },
  {
    "start": 251.72,
    "end": 253.0,
    "text": "收窄了"
  },
  {
    "start": 253.0,
    "end": 254.04,
    "text": "你是说"
  },
  {
    "start": 254.04,
    "end": 255.98,
    "text": "现代学堂管的事情变少了"
  },
  {
    "start": 255.98,
    "end": 256.5,
    "text": "是的"
  },
  {
    "start": 256.5,
    "end": 258.28,
    "text": "早期引入的学堂"
  },
  {
    "start": 258.28,
    "end": 259.72,
    "text": "核心功能变成了"
  },
  {
    "start": 259.72,
    "end": 260.46,
    "text": "仅仅检验"
  },
  {
    "start": 260.46,
    "end": 262.04,
    "text": "非常具体的学习成效"
  },
  {
    "start": 262.04,
    "end": 264.24,
    "text": "就是看你这门课考了多少分"
  },
  {
    "start": 264.24,
    "end": 264.66,
    "text": "对"
  },
  {
    "start": 264.66,
    "end": 266.62,
    "text": "它切断了原来科举那种"
  },
  {
    "start": 266.62,
    "end": 267.62,
    "text": "包裹着伦理"
  },
  {
    "start": 267.62,
    "end": 268.22,
    "text": "做官"
  },
  {
    "start": 268.22,
    "end": 270.02,
    "text": "还有社会地位的综合网络"
  },
  {
    "start": 270.02,
    "end": 270.66,
    "text": "哇"
  },
  {
    "start": 270.66,
    "end": 271.8,
    "text": "这就好比"
  },
  {
    "start": 271.8,
    "end": 273.26,
    "text": "我想想啊"
  },
  {
    "start": 273.26,
    "end": 273.82,
    "text": "这就好比"
  },
  {
    "start": 273.82,
    "end": 275.1,
    "text": "你不能用一把"
  },
  {
    "start": 275.1,
    "end": 277.46,
    "text": "现代外科手术刀的锋利度"
  },
  {
    "start": 277.46,
    "end": 279.16,
    "text": "去衡量一把老式"
  },
  {
    "start": 279.16,
    "end": 280.52,
    "text": "瑞士军刀的好坏"
  },
  {
    "start": 280.52,
    "end": 281.78,
    "text": "这个比喻很贴切"
  },
  {
    "start": 281.78,
    "end": 284.2,
    "text": "手术刀确实在切割这一点上"
  },
  {
    "start": 284.2,
    "end": 284.96,
    "text": "做到了极致"
  },
  {
    "start": 284.96,
    "end": 287.52,
    "text": "就像现代学校传授知识很高效"
  },
  {
    "start": 287.52,
    "end": 290.2,
    "text": "但瑞士军刀的设计初衷"
  },
  {
    "start": 290.2,
    "end": 291.74,
    "text": "本来就是为了应对"
  },
  {
    "start": 291.74,
    "end": 293.6,
    "text": "各种复杂的野外生存需求"
  },
  {
    "start": 293.6,
    "end": 294.1,
    "text": "是的"
  },
  {
    "start": 294.1,
    "end": 295.3,
    "text": "它们的设计目的"
  },
  {
    "start": 295.3,
    "end": 296.62,
    "text": "根本就不在一个维度上"
  },
  {
    "start": 296.62,
    "end": 298.02,
    "text": "不过等一下啊"
  },
  {
    "start": 298.02,
    "end": 298.5,
    "text": "听到这里"
  },
  {
    "start": 298.5,
    "end": 299.7,
    "text": "很多人可能会有疑问"
  },
  {
    "start": 299.7,
    "end": 302.2,
    "text": "指出科举功能复杂"
  },
  {
    "start": 302.2,
    "end": 305.08,
    "text": "这难道是在暗示旧的科举制度"
  },
  {
    "start": 305.08,
    "end": 308.12,
    "text": "在整体上比现代教育更优越吗"
  },
  {
    "start": 308.12,
    "end": 309.84,
    "text": "或者在给旧制度招魂"
  },
  {
    "start": 309.84,
    "end": 312.46,
    "text": "这是一个非常关键的边界问题"
  },
  {
    "start": 312.46,
    "end": 313.44,
    "text": "咱们必须诚信"
  },
  {
    "start": 313.44,
    "end": 314.16,
    "text": "必须的"
  },
  {
    "start": 314.16,
    "end": 315.5,
    "text": "张杰的作者"
  },
  {
    "start": 315.5,
    "end": 317.64,
    "text": "质疑用单一的现代学校功能"
  },
  {
    "start": 317.64,
    "end": 318.76,
    "text": "去衡量旧制度"
  },
  {
    "start": 318.76,
    "end": 321.34,
    "text": "但这绝不等于要求恢复科举"
  },
  {
    "start": 321.34,
    "end": 324.66,
    "text": "也绝不等于否认旧制本身存在的"
  },
  {
    "start": 324.66,
    "end": 325.72,
    "text": "种种严重疾病"
  },
  {
    "start": 325.72,
    "end": 327.8,
    "text": "作者论证的真正重点是"
  },
  {
    "start": 327.8,
    "end": 331.92,
    "text": "我们必须仔细检查当时提出的废除调整"
  },
  {
    "start": 331.92,
    "end": 334.46,
    "text": "还有学堂衔接等不同方案的复杂性"
  },
  {
    "start": 334.46,
    "end": 336.6,
    "text": "所以不能简单粗暴的一刀切"
  },
  {
    "start": 336.6,
    "end": 337.04,
    "text": "对"
  },
  {
    "start": 337.04,
    "end": 339.6,
    "text": "其实这种新旧交替时的断裂感"
  },
  {
    "start": 339.6,
    "end": 340.9,
    "text": "在当时是全方位的"
  },
  {
    "start": 340.9,
    "end": 342.08,
    "text": "不仅仅是教育"
  },
  {
    "start": 342.08,
    "end": 343.48,
    "text": "如果你看法律系统"
  },
  {
    "start": 343.48,
    "end": 344.68,
    "text": "摩擦更加剧烈"
  },
  {
    "start": 344.68,
    "end": 345.74,
    "text": "法律系统"
  },
  {
    "start": 345.74,
    "end": 347.14,
    "text": "能具体举个例子吗"
  },
  {
    "start": 347.14,
    "end": 349.96,
    "text": "比如在第五册关于法治史的研究中"
  },
  {
    "start": 349.96,
    "end": 353.06,
    "text": "清季民初要引入西方的现代法律"
  },
  {
    "start": 353.06,
    "end": 356.52,
    "text": "当时的立法者在条文里特意界定了一个概念"
  },
  {
    "start": 356.52,
    "end": 358.14,
    "text": "叫尊亲属"
  },
  {
    "start": 358.14,
    "end": 359.88,
    "text": "尊亲属"
  },
  {
    "start": 359.88,
    "end": 362.16,
    "text": "这词听起来非常传统啊"
  },
  {
    "start": 362.16,
    "end": 363.92,
    "text": "像是家族祠堂里用的词"
  },
  {
    "start": 363.92,
    "end": 366.44,
    "text": "它跟西方法律怎么扯上关系了"
  },
  {
    "start": 366.44,
    "end": 368.32,
    "text": "这就是最痛苦的地方了"
  },
  {
    "start": 368.32,
    "end": 371.28,
    "text": "西方法律的底层逻辑是人人平等"
  },
  {
    "start": 371.28,
    "end": 371.88,
    "text": "对吧"
  },
  {
    "start": 371.88,
    "end": 372.06,
    "text": "对"
  },
  {
    "start": 372.06,
    "end": 374.08,
    "text": "谁打了谁按伤害程度定罪"
  },
  {
    "start": 374.08,
    "end": 378.42,
    "text": "但传统的中国社会是建立在儒家伦理基础上的"
  },
  {
    "start": 378.42,
    "end": 380.12,
    "text": "如果儿子打了父亲"
  },
  {
    "start": 380.12,
    "end": 382.1,
    "text": "那是十恶不赦的重罪"
  },
  {
    "start": 382.1,
    "end": 384.04,
    "text": "那要是父亲打了儿子呢"
  },
  {
    "start": 384.04,
    "end": 385.2,
    "text": "在传统观念里"
  },
  {
    "start": 385.2,
    "end": 386.78,
    "text": "那可能只是管教严厉"
  },
  {
    "start": 386.78,
    "end": 390.64,
    "text": "所以当西方那种要求权力平等的法律条文"
  },
  {
    "start": 390.64,
    "end": 392.52,
    "text": "撞上这种宗法伦理时"
  },
  {
    "start": 392.52,
    "end": 394.98,
    "text": "立法者根本不敢完全照搬"
  },
  {
    "start": 394.98,
    "end": 398.92,
    "text": "所以他们就硬生生的塞进去了尊亲属这种概念"
  },
  {
    "start": 398.92,
    "end": 399.46,
    "text": "没错"
  },
  {
    "start": 399.46,
    "end": 402.9,
    "text": "他们试图在现代条文和传统常理之间"
  },
  {
    "start": 402.9,
    "end": 403.96,
    "text": "找个平衡点"
  },
  {
    "start": 403.96,
    "end": 405.72,
    "text": "这不是一个简单的替换"
  },
  {
    "start": 405.72,
    "end": 408.84,
    "text": "而是一个极为痛苦的封合过程"
  },
  {
    "start": 408.84,
    "end": 409.12,
    "text": "哇"
  },
  {
    "start": 409.12,
    "end": 411.42,
    "text": "这里真的打破了很多人的一般认知"
  },
  {
    "start": 411.42,
    "end": 414.46,
    "text": "我们总以为翻译或者引进一个新东西"
  },
  {
    "start": 414.46,
    "end": 415.98,
    "text": "直接拿过来用就行了"
  },
  {
    "start": 415.98,
    "end": 417.22,
    "text": "哪有那么容易"
  },
  {
    "start": 417.22,
    "end": 419.06,
    "text": "这地方真的特别有意思"
  },
  {
    "start": 419.06,
    "end": 421.64,
    "text": "既然兴士学堂和兴法律"
  },
  {
    "start": 421.64,
    "end": 423.26,
    "text": "历经波折建立起来了"
  },
  {
    "start": 423.26,
    "end": 425.68,
    "text": "那学校里教的核心内容之一"
  },
  {
    "start": 425.68,
    "end": 427.66,
    "text": "毫无疑问就是科学了"
  },
  {
    "start": 427.66,
    "end": 428.02,
    "text": "嗯"
  },
  {
    "start": 428.02,
    "end": 428.98,
    "text": "理应如此"
  },
  {
    "start": 428.98,
    "end": 433.78,
    "text": "但是在一百多年前的黑白上写下的科学这两个字"
  },
  {
    "start": 433.78,
    "end": 437.06,
    "text": "真的是我们现在脑子里以为的那个自然科学吗"
  },
  {
    "start": 437.06,
    "end": 441.78,
    "text": "材料第八册和第三册提到了从格致到科学的演变"
  },
  {
    "start": 441.78,
    "end": 442.24,
    "text": "对"
  },
  {
    "start": 442.24,
    "end": 448.0,
    "text": "特别是1895年到1905年这十年间科学这个词到底是个什么意思"
  },
  {
    "start": 448.0,
    "end": 453.92,
    "text": "要理解这个词的变异就必须提到一个关键的中间技智"
  },
  {
    "start": 453.92,
    "end": 457.18,
    "text": "日本也就是当时所谓的东学"
  },
  {
    "start": 457.18,
    "end": 458.02,
    "text": "哦"
  },
  {
    "start": 458.02,
    "end": 460.96,
    "text": "很多西方概念是经过日本翻译的"
  },
  {
    "start": 460.96,
    "end": 461.6,
    "text": "没错"
  },
  {
    "start": 461.6,
    "end": 463.76,
    "text": "经过了日文汉字的转译"
  },
  {
    "start": 463.76,
    "end": 465.56,
    "text": "我们再把这些词搬过来"
  },
  {
    "start": 465.56,
    "end": 466.92,
    "text": "在这个过程中"
  },
  {
    "start": 466.92,
    "end": 470.14,
    "text": "新汉语词会发生了非常显著的意义变异"
  },
  {
    "start": 470.14,
    "end": 471.86,
    "text": "变异成什么样了"
  },
  {
    "start": 471.86,
    "end": 474.68,
    "text": "材料作者在结语里特别区分了"
  },
  {
    "start": 474.68,
    "end": 478.4,
    "text": "当时科学包含了几层截然不同的含义"
  },
  {
    "start": 478.4,
    "end": 482.08,
    "text": "有时候它只带自然科学技术的实证含义"
  },
  {
    "start": 482.08,
    "end": 483.26,
    "text": "这个跟今天差不多"
  },
  {
    "start": 483.26,
    "end": 483.94,
    "text": "对"
  },
  {
    "start": 483.94,
    "end": 488.18,
    "text": "但有时候它仅仅是指教育层面上的分科教学"
  },
  {
    "start": 488.18,
    "end": 490.34,
    "text": "也就是分门别类的教书"
  },
  {
    "start": 490.34,
    "end": 492.94,
    "text": "就是分成语文数学这样"
  },
  {
    "start": 492.94,
    "end": 493.48,
    "text": "是的"
  },
  {
    "start": 493.48,
    "end": 496.7,
    "text": "还有学术层面上的分科治学"
  },
  {
    "start": 496.7,
    "end": 499.92,
    "text": "更复杂的是在当时救亡图存的语境中"
  },
  {
    "start": 499.92,
    "end": 502.94,
    "text": "它还具有一种强烈的工具性色彩"
  },
  {
    "start": 502.94,
    "end": 504.12,
    "text": "当成了救国口号"
  },
  {
    "start": 504.12,
    "end": 504.68,
    "text": "对"
  },
  {
    "start": 504.68,
    "end": 507.4,
    "text": "把科学当成富国强兵的代名词"
  },
  {
    "start": 507.4,
    "end": 510.92,
    "text": "所以我们绝不能把当年的所有科学"
  },
  {
    "start": 510.92,
    "end": 513.28,
    "text": "直接等同于今天的自然科学"
  },
  {
    "start": 513.28,
    "end": 516.64,
    "text": "所以如果今天我们在晚清的报纸里看到"
  },
  {
    "start": 516.64,
    "end": 518.44,
    "text": "我们要提倡科学"
  },
  {
    "start": 518.44,
    "end": 521.66,
    "text": "直接等同于要多上物理化学课"
  },
  {
    "start": 521.66,
    "end": 523.0,
    "text": "那就完全错读了"
  },
  {
    "start": 523.0,
    "end": 524.14,
    "text": "完全正确"
  },
  {
    "start": 524.14,
    "end": 525.22,
    "text": "而且要注意"
  },
  {
    "start": 525.22,
    "end": 528.8,
    "text": "这份研究限定在1895年到1905年"
  },
  {
    "start": 528.8,
    "end": 530.42,
    "text": "这只是一个历史切片"
  },
  {
    "start": 530.42,
    "end": 532.92,
    "text": "不代表整个概念完整的历史"
  },
  {
    "start": 532.92,
    "end": 533.8,
    "text": "明白"
  },
  {
    "start": 533.8,
    "end": 537.32,
    "text": "这些词义的演变不仅停留在口头上"
  },
  {
    "start": 537.32,
    "end": 540.14,
    "text": "最终还变成了实实在在的学科建制"
  },
  {
    "start": 540.14,
    "end": 543.68,
    "text": "比如第六册第八章提到的国立广东大学"
  },
  {
    "start": 543.68,
    "end": 545.9,
    "text": "也就是后来的中山大学"
  },
  {
    "start": 545.9,
    "end": 546.56,
    "text": "对"
  },
  {
    "start": 546.56,
    "end": 548.68,
    "text": "1926年到1949年间"
  },
  {
    "start": 548.68,
    "end": 550.64,
    "text": "他们人文学科的设置"
  },
  {
    "start": 550.64,
    "end": 553.18,
    "text": "概念变成了具体的院系划分"
  },
  {
    "start": 553.18,
    "end": 555.68,
    "text": "不过说起概念的痛苦翻译"
  },
  {
    "start": 555.68,
    "end": 557.56,
    "text": "材料里还提到了严复"
  },
  {
    "start": 557.56,
    "end": 558.26,
    "text": "对"
  },
  {
    "start": 558.26,
    "end": 561.5,
    "text": "严复翻译英国学者约翰·密尔的著作"
  },
  {
    "start": 561.5,
    "end": 564.88,
    "text": "那本书英文直译应该叫论自由"
  },
  {
    "start": 564.88,
    "end": 565.54,
    "text": "对吧"
  },
  {
    "start": 565.54,
    "end": 566.12,
    "text": "是的"
  },
  {
    "start": 566.12,
    "end": 569.38,
    "text": "但严复把它翻译成了群己权界论"
  },
  {
    "start": 569.38,
    "end": 571.76,
    "text": "群己权界论"
  },
  {
    "start": 571.76,
    "end": 573.76,
    "text": "这听起来极其费劲啊"
  },
  {
    "start": 573.76,
    "end": 575.48,
    "text": "完全没有自由两个字通畅"
  },
  {
    "start": 575.48,
    "end": 577.16,
    "text": "他干嘛不直接用自由"
  },
  {
    "start": 577.16,
    "end": 580.2,
    "text": "因为在当时传统的汉语语境里"
  },
  {
    "start": 580.2,
    "end": 583.76,
    "text": "自由这个词带有一种负面色彩"
  },
  {
    "start": 583.76,
    "end": 586.22,
    "text": "类似于毫无顾忌放任自流"
  },
  {
    "start": 586.22,
    "end": 588.56,
    "text": "听着像是个贬义词"
  },
  {
    "start": 588.56,
    "end": 589.22,
    "text": "对"
  },
  {
    "start": 589.22,
    "end": 591.24,
    "text": "带有自私自利的暗示"
  },
  {
    "start": 591.24,
    "end": 592.62,
    "text": "严复很痛苦"
  },
  {
    "start": 592.62,
    "end": 594.22,
    "text": "他如果直接写自由"
  },
  {
    "start": 594.22,
    "end": 595.88,
    "text": "当时的读书人会觉得"
  },
  {
    "start": 595.88,
    "end": 598.48,
    "text": "这是一本教人学坏的书"
  },
  {
    "start": 598.48,
    "end": 600.54,
    "text": "教人自私自利的书"
  },
  {
    "start": 600.54,
    "end": 603.82,
    "text": "所以他硬生生造出了群己权界"
  },
  {
    "start": 603.82,
    "end": 606.54,
    "text": "也就是群体和个人权力的边界"
  },
  {
    "start": 606.54,
    "end": 609.22,
    "text": "这就是外来概念落地时"
  },
  {
    "start": 609.22,
    "end": 610.86,
    "text": "剧烈的文化重构"
  },
  {
    "start": 610.86,
    "end": 613.7,
    "text": "确实是个华洋变形的过程"
  },
  {
    "start": 613.7,
    "end": 615.26,
    "text": "不过咱们想一下啊"
  },
  {
    "start": 615.26,
    "end": 617.6,
    "text": "有了新学校新学科新概念"
  },
  {
    "start": 617.6,
    "end": 619.44,
    "text": "要把这些新制度运转起来"
  },
  {
    "start": 619.44,
    "end": 621.78,
    "text": "需要一个最基础的支撑"
  },
  {
    "start": 621.78,
    "end": 622.38,
    "text": "你是指"
  },
  {
    "start": 622.38,
    "end": 623.86,
    "text": "钱啊"
  },
  {
    "start": 623.86,
    "end": 624.44,
    "text": "对"
  },
  {
    "start": 624.44,
    "end": 625.16,
    "text": "钱"
  },
  {
    "start": 625.16,
    "end": 628.92,
    "text": "这就引出了制度史研究中最核心的问题"
  },
  {
    "start": 628.92,
    "end": 630.68,
    "text": "写在纸上的条文"
  },
  {
    "start": 630.68,
    "end": 632.84,
    "text": "在现实中真的能跑得通吗"
  },
  {
    "start": 632.84,
    "end": 634.92,
    "text": "咱们来看看第七册第三章"
  },
  {
    "start": 634.92,
    "end": 637.16,
    "text": "清季财政改行预算制"
  },
  {
    "start": 637.16,
    "end": 641.14,
    "text": "材料里梳理了一份非常具体的六年程序"
  },
  {
    "start": 641.14,
    "end": 645.4,
    "text": "也就是当时官员杨寿枏预定推行的一个预算计划"
  },
  {
    "start": 645.4,
    "end": 647.42,
    "text": "听起来非常现代化啊"
  },
  {
    "start": 647.42,
    "end": 648.44,
    "text": "第一年干什么"
  },
  {
    "start": 648.44,
    "end": 649.36,
    "text": "第二年干什么"
  },
  {
    "start": 649.36,
    "end": 652.14,
    "text": "清朝末年居然有这么清晰的进度表"
  },
  {
    "start": 652.14,
    "end": 652.66,
    "text": "是的"
  },
  {
    "start": 652.66,
    "end": 654.66,
    "text": "作者详细列出了这个规划"
  },
  {
    "start": 654.66,
    "end": 655.88,
    "text": "第一年调查"
  },
  {
    "start": 655.88,
    "end": 657.92,
    "text": "接着事办地方预算"
  },
  {
    "start": 657.92,
    "end": 659.66,
    "text": "然后推到全国预算"
  },
  {
    "start": 659.66,
    "end": 661.8,
    "text": "再到预算决算并行"
  },
  {
    "start": 661.8,
    "end": 664.02,
    "text": "还有会计与金库是吧"
  },
  {
    "start": 664.02,
    "end": 664.2,
    "text": "对"
  },
  {
    "start": 664.2,
    "end": 666.26,
    "text": "最后设立省财政司"
  },
  {
    "start": 666.26,
    "end": 668.16,
    "text": "看起来井井有条"
  },
  {
    "start": 668.16,
    "end": 670.64,
    "text": "简直就像现在的项目管理进度表"
  },
  {
    "start": 670.64,
    "end": 673.72,
    "text": "可是按照咱们对清末历史的常识"
  },
  {
    "start": 673.72,
    "end": 676.9,
    "text": "那时候国家都快内忧外患到几点了"
  },
  {
    "start": 676.9,
    "end": 680.12,
    "text": "下面的地方官难道会乖乖交出财政大权"
  },
  {
    "start": 680.12,
    "end": 681.42,
    "text": "照着进度表执行"
  },
  {
    "start": 681.42,
    "end": 682.94,
    "text": "这正是关键"
  },
  {
    "start": 682.94,
    "end": 685.96,
    "text": "我要特别极其严肃的提醒大家"
  },
  {
    "start": 685.96,
    "end": 688.42,
    "text": "材料里提到的这个六年程序"
  },
  {
    "start": 688.42,
    "end": 691.96,
    "text": "仅仅是杨寿枏当时呈报的一份预定步骤"
  },
  {
    "start": 691.96,
    "end": 693.62,
    "text": "就是计划书呗"
  },
  {
    "start": 693.62,
    "end": 693.84,
    "text": "对"
  },
  {
    "start": 693.84,
    "end": 697.44,
    "text": "绝对不是在那六年里已经落地完成的成绩单"
  },
  {
    "start": 697.44,
    "end": 700.4,
    "text": "那实际执行起来到底是个什么景象"
  },
  {
    "start": 700.4,
    "end": 703.2,
    "text": "正如该章在梳理了知识引戒"
  },
  {
    "start": 703.2,
    "end": 705.22,
    "text": "局部尝试和利益协调后"
  },
  {
    "start": 705.22,
    "end": 706.96,
    "text": "作者得出的结论是这样的"
  },
  {
    "start": 706.96,
    "end": 709.6,
    "text": "原话是计划相当周密"
  },
  {
    "start": 709.6,
    "end": 711.24,
    "text": "前景亦可预期"
  },
  {
    "start": 711.24,
    "end": 714.12,
    "text": "但推行过程却纠葛不断"
  },
  {
    "start": 714.12,
    "end": 715.26,
    "text": "难具成效"
  },
  {
    "start": 715.26,
    "end": 715.76,
    "text": "哎"
  },
  {
    "start": 715.76,
    "end": 718.26,
    "text": "推行过程纠葛不断"
  },
  {
    "start": 718.26,
    "end": 719.62,
    "text": "难具成效"
  },
  {
    "start": 719.62,
    "end": 721.62,
    "text": "具体的是怎么个纠葛法"
  },
  {
    "start": 721.62,
    "end": 724.1,
    "text": "该章结语解释了背后的原因"
  },
  {
    "start": 724.1,
    "end": 728.18,
    "text": "当时地方督抚手里握着厘金等各种地方税收"
  },
  {
    "start": 728.18,
    "end": 729.88,
    "text": "那是他们养兵的命根子"
  },
  {
    "start": 729.88,
    "end": 731.74,
    "text": "动了他们的钱袋子"
  },
  {
    "start": 731.74,
    "end": 732.26,
    "text": "是的"
  },
  {
    "start": 732.26,
    "end": 735.36,
    "text": "中央突然扔下了一张现代财务表格"
  },
  {
    "start": 735.36,
    "end": 737.78,
    "text": "说以后收支都要报上来审核"
  },
  {
    "start": 737.78,
    "end": 741.24,
    "text": "旧权力体系肯定会产生强烈的排异反应"
  },
  {
    "start": 741.24,
    "end": 742.1,
    "text": "确实"
  },
  {
    "start": 742.1,
    "end": 745.54,
    "text": "所以说财政技术在纸面上的设计"
  },
  {
    "start": 745.54,
    "end": 748.28,
    "text": "跟实际执行之间绝对不能画等号"
  },
  {
    "start": 748.28,
    "end": 749.14,
    "text": "没错"
  },
  {
    "start": 749.14,
    "end": 752.6,
    "text": "研究制度史绝不能只看漂亮的章程条文"
  },
  {
    "start": 752.6,
    "end": 755.48,
    "text": "这种纸面与现实的摩擦"
  },
  {
    "start": 755.48,
    "end": 757.82,
    "text": "不仅发生在国家的钱袋子上"
  },
  {
    "start": 757.82,
    "end": 760.78,
    "text": "连关乎普通人身体健康的医学领域"
  },
  {
    "start": 760.78,
    "end": 763.72,
    "text": "也面临着一场痛苦的重组"
  },
  {
    "start": 763.72,
    "end": 766.72,
    "text": "提到这个第一册关于国医的研究"
  },
  {
    "start": 766.72,
    "end": 769.1,
    "text": "咱们必须先跟听众说明一件事"
  },
  {
    "start": 769.1,
    "end": 770.08,
    "text": "这个很重要"
  },
  {
    "start": 770.08,
    "end": 772.78,
    "text": "今天咱们关于国医和卫生的讨论"
  },
  {
    "start": 772.78,
    "end": 774.78,
    "text": "纯粹是历史科普解读"
  },
  {
    "start": 774.78,
    "end": 776.82,
    "text": "绝对不构成任何诊疗建议"
  },
  {
    "start": 776.82,
    "end": 780.62,
    "text": "也不提供任何剂量疗程或者饮食处方"
  },
  {
    "start": 780.62,
    "end": 780.8,
    "text": "对"
  },
  {
    "start": 780.8,
    "end": 782.82,
    "text": "大家如果有个人健康问题"
  },
  {
    "start": 782.82,
    "end": 785.12,
    "text": "请务必去咨询专业的医生"
  },
  {
    "start": 785.12,
    "end": 788.1,
    "text": "我们今天看的是历史不是医书"
  },
  {
    "start": 788.1,
    "end": 788.38,
    "text": "好的"
  },
  {
    "start": 788.38,
    "end": 790.38,
    "text": "那这张探讨的是"
  },
  {
    "start": 790.38,
    "end": 793.88,
    "text": "近代中医在面临西方现代医学强势冲击时"
  },
  {
    "start": 793.88,
    "end": 796.74,
    "text": "如何在制度上进行转型与再造"
  },
  {
    "start": 796.74,
    "end": 797.48,
    "text": "哎"
  },
  {
    "start": 797.48,
    "end": 798.16,
    "text": "我很好奇"
  },
  {
    "start": 798.16,
    "end": 801.94,
    "text": "传统的坐堂大夫都是师父带徒弟单干的"
  },
  {
    "start": 801.94,
    "end": 805.68,
    "text": "他们怎么应对这种国家层面的制度冲击"
  },
  {
    "start": 805.98,
    "end": 809.9,
    "text": "这张讨论的就是医学的国家定位和组织关系"
  },
  {
    "start": 809.9,
    "end": 811.48,
    "text": "中医为了不被边缘化"
  },
  {
    "start": 811.48,
    "end": 814.4,
    "text": "开始模仿西医或者现代社团的模式"
  },
  {
    "start": 814.4,
    "end": 816.32,
    "text": "比如成立医学会"
  },
  {
    "start": 816.32,
    "end": 816.88,
    "text": "对"
  },
  {
    "start": 816.88,
    "end": 818.02,
    "text": "成立医学会"
  },
  {
    "start": 818.02,
    "end": 819.38,
    "text": "创办中医学校"
  },
  {
    "start": 819.38,
    "end": 821.22,
    "text": "甚至发行医学期刊"
  },
  {
    "start": 821.22,
    "end": 824.8,
    "text": "用这种方式去争取在国家行政中的合法地位"
  },
  {
    "start": 824.8,
    "end": 827.9,
    "text": "所以这完全是一场组织史层面上的转型"
  },
  {
    "start": 827.9,
    "end": 830.46,
    "text": "为了生存进行的组织重构"
  },
  {
    "start": 830.46,
    "end": 831.32,
    "text": "没错"
  },
  {
    "start": 831.32,
    "end": 833.2,
    "text": "所以我们必须明确一点"
  },
  {
    "start": 833.2,
    "end": 838.12,
    "text": "完全不能因为在历史档案里看到当时某些医学组织存续下来了"
  },
  {
    "start": 838.12,
    "end": 842.68,
    "text": "就反推或者证明某种疗法在临床上有效或无效"
  },
  {
    "start": 842.68,
    "end": 842.98,
    "text": "明白"
  },
  {
    "start": 842.98,
    "end": 847.38,
    "text": "组织的存活和科学上的临床证据完全是两码事"
  },
  {
    "start": 847.38,
    "end": 848.12,
    "text": "对的"
  },
  {
    "start": 848.12,
    "end": 852.64,
    "text": "就像第一册第六章讨论的广西省卫生行政的仿制与创新"
  },
  {
    "start": 852.64,
    "end": 855.54,
    "text": "那个1909年到1939年的案例"
  },
  {
    "start": 855.54,
    "end": 855.86,
    "text": "对"
  },
  {
    "start": 855.86,
    "end": 860.08,
    "text": "那也只是一个限定在特定时间段和地方的行政时间案例"
  },
  {
    "start": 860.08,
    "end": 861.98,
    "text": "你不能直接外推到全国"
  },
  {
    "start": 861.98,
    "end": 865.42,
    "text": "制度存续和临床证据是两个层面的问题"
  },
  {
    "start": 865.42,
    "end": 866.34,
    "text": "好"
  },
  {
    "start": 866.34,
    "end": 869.1,
    "text": "那咱们把今天聊的这些串起来"
  },
  {
    "start": 869.1,
    "end": 871.72,
    "text": "所以这一切对我们今天到底意味着什么"
  },
  {
    "start": 871.72,
    "end": 874.02,
    "text": "这是一个很好的总结点"
  },
  {
    "start": 874.02,
    "end": 876.3,
    "text": "咱们看了科举的断裂"
  },
  {
    "start": 876.3,
    "end": 878.34,
    "text": "科学词异的变形"
  },
  {
    "start": 878.34,
    "end": 880.0,
    "text": "预算制度的碰壁"
  },
  {
    "start": 880.0,
    "end": 882.02,
    "text": "还有国医的组织重构"
  },
  {
    "start": 882.02,
    "end": 884.58,
    "text": "听起来都是一百多年前的固执堆"
  },
  {
    "start": 884.58,
    "end": 887.12,
    "text": "但对今天处于AI时代的你来说"
  },
  {
    "start": 887.12,
    "end": 888.9,
    "text": "其实极其重要"
  },
  {
    "start": 888.9,
    "end": 889.54,
    "text": "是的"
  },
  {
    "start": 889.54,
    "end": 892.5,
    "text": "尤其是在面对海量结构化稳稳的时候"
  },
  {
    "start": 892.5,
    "end": 893.28,
    "text": "对啊"
  },
  {
    "start": 893.28,
    "end": 895.02,
    "text": "你现在只要输入一个词"
  },
  {
    "start": 895.02,
    "end": 898.18,
    "text": "算法模型就会给你一个干脆利落的定义"
  },
  {
    "start": 898.18,
    "end": 901.5,
    "text": "你非常容易被这种后摄分类给误导"
  },
  {
    "start": 901.5,
    "end": 904.44,
    "text": "以为世界一直都是这么精畏分明的"
  },
  {
    "start": 904.44,
    "end": 907.74,
    "text": "这套材料给我们最大的启示啊"
  },
  {
    "start": 907.74,
    "end": 910.6,
    "text": "其实就是回到历史现场的方法"
  },
  {
    "start": 910.6,
    "end": 913.22,
    "text": "去追溯概念与信息的原始生成语境"
  },
  {
    "start": 913.22,
    "end": 915.68,
    "text": "去看看那些最初的摩擦力"
  },
  {
    "start": 915.68,
    "end": 916.24,
    "text": "嗯"
  },
  {
    "start": 916.24,
    "end": 918.34,
    "text": "如果我们把眼光放远一点"
  },
  {
    "start": 918.34,
    "end": 920.0,
    "text": "今天讨论的这些案例"
  },
  {
    "start": 920.0,
    "end": 923.46,
    "text": "并不构成全中国所有时期的完整样本"
  },
  {
    "start": 923.46,
    "end": 924.4,
    "text": "要具体问题"
  },
  {
    "start": 924.4,
    "end": 925.22,
    "text": "具体分析"
  },
  {
    "start": 925.22,
    "end": 925.8,
    "text": "没错"
  },
  {
    "start": 925.8,
    "end": 927.38,
    "text": "如果基层档案显示"
  },
  {
    "start": 927.38,
    "end": 930.28,
    "text": "某些章程在特定地方确实稳定执行了"
  },
  {
    "start": 930.28,
    "end": 931.46,
    "text": "我们就得修正"
  },
  {
    "start": 931.46,
    "end": 933.48,
    "text": "只有条文没有落实的概括"
  },
  {
    "start": 933.48,
    "end": 935.62,
    "text": "永远要先核对词意"
  },
  {
    "start": 935.62,
    "end": 936.96,
    "text": "再看制度设计"
  },
  {
    "start": 936.96,
    "end": 938.34,
    "text": "最后问实际执行"
  },
  {
    "start": 938.34,
    "end": 941.18,
    "text": "在咱们这一期对谈的最后啊"
  },
  {
    "start": 941.18,
    "end": 945.3,
    "text": "结合今天材料里讲到的科学群己权界"
  },
  {
    "start": 945.3,
    "end": 946.96,
    "text": "这些词在近代的奇变"
  },
  {
    "start": 946.96,
    "end": 948.86,
    "text": "我们想给你留一个思考题"
  },
  {
    "start": 948.86,
    "end": 949.8,
    "text": "是的"
  },
  {
    "start": 949.8,
    "end": 951.1,
    "text": "你不妨想一想"
  },
  {
    "start": 951.1,
    "end": 953.18,
    "text": "在你今天习以为常的"
  },
  {
    "start": 953.18,
    "end": 955.28,
    "text": "坚信不移的那些现代概念中"
  },
  {
    "start": 955.28,
    "end": 956.4,
    "text": "有没有哪一个"
  },
  {
    "start": 956.4,
    "end": 958.62,
    "text": "其实也仅仅是某个历史阶段"
  },
  {
    "start": 958.62,
    "end": 961.12,
    "text": "为了应急或者某种特定目的"
  },
  {
    "start": 961.12,
    "end": 964.14,
    "text": "而翻译拼凑出来的暂时的幻影"
  },
  {
    "start": 964.14,
    "end": 967.8,
    "text": "如果把它放回它诞生的那个乱糟糟的语境里"
  },
  {
    "start": 967.8,
    "end": 970.2,
    "text": "你对它的理解会发生怎样的改变"
  },
  {
    "start": 970.2,
    "end": 972.16,
    "text": "这非常值得你去琢磨琢磨"
  },
  {
    "start": 972.16,
    "end": 973.28,
    "text": "感谢你的收听"
  },
  {
    "start": 973.28,
    "end": 974.22,
    "text": "我们下次见"
  },
  {
    "start": 974.22,
    "end": 974.94,
    "text": "下次见"
  }
]
