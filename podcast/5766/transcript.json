  {
    "start": 588.56,
    "end": 592.88,
    "text": "预期年增长率为15%的价值企业股票"
  },
  {
    "start": 592.88,
    "end": 594.72,
    "text": "每股初始投资20元"
  },
  {
    "start": 594.72,
    "end": 596.4,
    "text": "然后长期持有"
  },
  {
    "start": 596.4,
    "end": 597.96,
    "text": "听起来是不是很完美"
