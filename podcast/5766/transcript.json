  {
    "start": 555.7,
    "end": 558.1,
    "text": "用负面清单挑出了好公司"
  },
  {
    "start": 558.1,
    "end": 560.48,
    "text": "用商业思维审视了现金流"
  },
  {
    "start": 560.48,
    "end": 562.86,
    "text": "也耐心的等到了安全边际"
  },
  {
    "start": 562.86,
    "end": 563.82,
    "text": "最后买入"
  },
  {
    "start": 563.82,
    "end": 566.84,
    "text": "接下来是不是只要做到慢"
  },
  {
    "start": 566.84,
    "end": 567.8,
    "text": "耐心持有"
  },
  {
    "start": 567.8,
    "end": 569.72,
    "text": "就等着复利滚雪球了"
  },
  {
    "start": 569.72,
    "end": 571.3,
    "text": "这个地方啊"
  },
  {
    "start": 571.3,
    "end": 572.62,
    "text": "我们要特别小心"
  },
  {
    "start": 572.62,
    "end": 575.44,
    "text": "书里为了说明长期持有的威力"
  },
  {
    "start": 575.44,
    "end": 577.26,
    "text": "其实做了一个具体的推演"
  },
  {
    "start": 577.26,
    "end": 580.66,
    "text": "我把这组设定的原话给大家念一下啊"
  },
  {
    "start": 580.66,
    "end": 582.86,
    "text": "按照这三个关键点"
  },
  {
    "start": 582.86,
    "end": 584.66,
    "text": "我们做一个假设"
  },
  {
    "start": 584.66,
    "end": 588.56,
    "text": "以20倍市盈率买入每股收益为1元"
