[
  {
    "start": 0.0,
    "end": 1.48,
    "text": "一个有目部落联盟"
  },
  {
    "start": 1.48,
    "end": 3.54,
    "text": "怎样聚合成庞大帝国"
  },
  {
    "start": 3.54,
    "end": 5.34,
    "text": "又为何在后代手中"
  },
  {
    "start": 5.34,
    "end": 6.06,
    "text": "走向分裂"
  },
  {
    "start": 6.06,
    "end": 8.18,
    "text": "试想这样一个画面"
  },
  {
    "start": 8.18,
    "end": 10.7,
    "text": "一个刚刚吃过败仗的军阀"
  },
  {
    "start": 10.7,
    "end": 12.58,
    "text": "被强敌一路追击"
  },
  {
    "start": 12.58,
    "end": 14.42,
    "text": "逃到一条泥泞的河边"
  },
  {
    "start": 14.42,
    "end": 15.56,
    "text": "他身边"
  },
  {
    "start": 15.56,
    "end": 17.86,
    "text": "当时只剩下寥寥几个追随者"
  },
  {
    "start": 17.86,
    "end": 20.4,
    "text": "大家甚至连干净的水源都找不到"
  },
  {
    "start": 20.4,
    "end": 22.92,
    "text": "只能捧起那种浑浊的泥水"
  },
  {
    "start": 22.92,
    "end": 23.78,
    "text": "一迎而尽"
  },
  {
    "start": 23.78,
    "end": 25.42,
    "text": "发誓同生共死"
  },
  {
    "start": 25.42,
    "end": 28.1,
    "text": "就是著名的班珠尼河盟士"
  },
  {
    "start": 28.1,
    "end": 29.1,
    "text": "对 没错"
  },
  {
    "start": 29.1,
    "end": 30.66,
    "text": "但多年以后"
  },
  {
    "start": 30.66,
    "end": 32.56,
    "text": "正是这群喝泥水的人"
  },
  {
    "start": 32.56,
    "end": 33.84,
    "text": "还有他们的子孙"
  },
  {
    "start": 33.84,
    "end": 36.74,
    "text": "彻底重写了半个地球的行政版图"
  },
  {
    "start": 36.74,
    "end": 38.98,
    "text": "今天您和咱们一起翻开的"
  },
  {
    "start": 38.98,
    "end": 41.24,
    "text": "是邹晋的蒙古历史拼图"
  },
  {
    "start": 41.24,
    "end": 43.24,
    "text": "这本书挺奇特的"
  },
  {
    "start": 43.24,
    "end": 45.94,
    "text": "它没有搞那种流水账一样的编年史"
  },
  {
    "start": 45.94,
    "end": 47.96,
    "text": "而是把极其宏大的历史"
  },
  {
    "start": 47.96,
    "end": 50.88,
    "text": "切分成了105个核心关键词碎片"
  },
  {
    "start": 50.88,
    "end": 53.08,
    "text": "也就是说咱们不需要硬肯"
  },
  {
    "start": 53.08,
    "end": 54.94,
    "text": "完全可以像玩拼图一样"
  },
  {
    "start": 54.94,
    "end": 57.08,
    "text": "把这个横跨欧亚的帝国全貌"
  },
  {
    "start": 57.08,
    "end": 58.4,
    "text": "给一块块拼出来"
  },
  {
    "start": 58.4,
    "end": 60.86,
    "text": "是的 特别适合在海量信息时代"
  },
  {
    "start": 60.86,
    "end": 63.34,
    "text": "帮你快速建构起完整的知识体系"
  },
  {
    "start": 63.34,
    "end": 65.64,
    "text": "这里特别令人着迷的一点就是"
  },
  {
    "start": 65.64,
    "end": 67.76,
    "text": "在帝国真正成型之前"
  },
  {
    "start": 67.76,
    "end": 69.78,
    "text": "那个大草原上其实是农耕"
  },
  {
    "start": 69.78,
    "end": 72.18,
    "text": "跟油木碰撞的一个大尺度框架"
  },
  {
    "start": 72.18,
    "end": 74.92,
    "text": "咱们得先帮自己进行一次大脑降级"
  },
  {
    "start": 74.92,
    "end": 77.88,
    "text": "抛弃掉现代人习以为常的那些思维定势"
  },
  {
    "start": 77.88,
    "end": 79.06,
    "text": "大脑降级"
  },
  {
    "start": 79.06,
    "end": 81.72,
    "text": "也就是说当时完全没有国家机器吧"
  },
  {
    "start": 81.72,
    "end": 83.66,
    "text": "毫无疑问 完全没有"
  },
  {
    "start": 83.66,
    "end": 85.98,
    "text": "那时候广袤的北方草原上"
  },
  {
    "start": 85.98,
    "end": 88.28,
    "text": "根本不存在任何类似于官僚体系"
  },
  {
    "start": 88.28,
    "end": 90.2,
    "text": "或者法院系统的东西"
  },
  {
    "start": 90.2,
    "end": 92.78,
    "text": "当时维系人与人之间关系的是一套"
  },
  {
    "start": 92.78,
    "end": 93.66,
    "text": "怎么说呢"
  },
  {
    "start": 93.66,
    "end": 95.54,
    "text": "完全围绕生存本能"
  },
  {
    "start": 95.54,
    "end": 96.94,
    "text": "演化出来的底层逻辑"
  },
  {
    "start": 96.94,
    "end": 99.78,
    "text": "靠的是一种叫约孙的习惯法"
  },
  {
    "start": 99.78,
    "end": 100.66,
    "text": "约孙"
  },
  {
    "start": 100.66,
    "end": 104.48,
    "text": "这算是一种不成文的草原规矩吗"
  },
  {
    "start": 104.48,
    "end": 104.82,
    "text": "没错"
  },
  {
    "start": 104.82,
    "end": 108.12,
    "text": "它更像是在极端环境下的生存指导手册"
  },
  {
    "start": 108.12,
    "end": 109.6,
    "text": "比如冬天打猎"
  },
  {
    "start": 109.6,
    "end": 110.6,
    "text": "怎么分配猎物"
  },
  {
    "start": 110.6,
    "end": 111.88,
    "text": "春天的草场"
  },
  {
    "start": 111.88,
    "end": 112.78,
    "text": "怎么划定边界"
  },
  {
    "start": 112.78,
    "end": 114.34,
    "text": "都有明确的默契"
  },
  {
    "start": 114.34,
    "end": 115.38,
    "text": "除了约孙"
  },
  {
    "start": 115.38,
    "end": 117.68,
    "text": "还有决定谁当首领的护理台大会"
  },
  {
    "start": 117.68,
    "end": 118.3,
    "text": "哦"
  },
  {
    "start": 118.3,
    "end": 120.14,
    "text": "大家围着篝火开会那种"
  },
  {
    "start": 120.14,
    "end": 120.48,
    "text": "对"
  },
  {
    "start": 120.48,
    "end": 122.28,
    "text": "各大士族的贵族们"
  },
  {
    "start": 122.28,
    "end": 123.94,
    "text": "用马鞭或者弯刀来投票"
  },
  {
    "start": 123.94,
    "end": 127.1,
    "text": "这其实是一种非常原始的军事民主制"
  },
  {
    "start": 127.1,
    "end": 128.2,
    "text": "除此之外"
  },
  {
    "start": 128.2,
    "end": 129.4,
    "text": "还包括一种"
  },
  {
    "start": 129.4,
    "end": 131.38,
    "text": "让现代人觉得挺不可思议的习俗"
  },
  {
    "start": 131.38,
    "end": 132.74,
    "text": "就是收继婚"
  },
  {
    "start": 132.74,
    "end": 133.3,
    "text": "哦"
  },
  {
    "start": 133.3,
    "end": 134.08,
    "text": "等等啊"
  },
  {
    "start": 134.08,
    "end": 135.06,
    "text": "这个我听说过"
  },
  {
    "start": 135.06,
    "end": 136.8,
    "text": "就是父亲死后"
  },
  {
    "start": 136.8,
    "end": 139.02,
    "text": "儿子要娶出了亲生母亲之外的"
  },
  {
    "start": 139.02,
    "end": 139.86,
    "text": "其他树木"
  },
  {
    "start": 139.86,
    "end": 141.18,
    "text": "或者嫂子这种"
  },
  {
    "start": 141.18,
    "end": 142.04,
    "text": "是的"
  },
  {
    "start": 142.04,
    "end": 142.72,
    "text": "就是这个"
  },
  {
    "start": 142.72,
    "end": 143.44,
    "text": "呃"
  },
  {
    "start": 143.44,
    "end": 145.1,
    "text": "这个听起来确实有点违背"
  },
  {
    "start": 145.1,
    "end": 146.66,
    "text": "人类普遍的伦理常识了"
  },
  {
    "start": 146.66,
    "end": 148.38,
    "text": "为什么要保留这种"
  },
  {
    "start": 148.38,
    "end": 148.94,
    "text": "呃"
  },
  {
    "start": 148.94,
    "end": 151.04,
    "text": "听起来极其反直觉的习俗"
  },
  {
    "start": 151.04,
    "end": 153.68,
    "text": "难道仅仅是因为当时不够文明吗"
  },
  {
    "start": 153.68,
    "end": 156.7,
    "text": "这就是咱们容易陷入的视角误区了"
  },
  {
    "start": 156.7,
    "end": 161.42,
    "text": "如果你把它放在随时可能冻死或者饿死的自然环境下探"
  },
  {
    "start": 161.42,
    "end": 163.42,
    "text": "这其实是一种呃"
  },
  {
    "start": 163.42,
    "end": 164.42,
    "text": "极其冷酷"
  },
  {
    "start": 164.42,
    "end": 166.36,
    "text": "但又极其理性的止损机制"
  },
  {
    "start": 166.36,
    "end": 167.98,
    "text": "止损机制"
  },
  {
    "start": 167.98,
    "end": 168.48,
    "text": "哎"
  },
  {
    "start": 168.48,
    "end": 169.56,
    "text": "怎么个止损法"
  },
  {
    "start": 169.56,
    "end": 170.82,
    "text": "你想啊"
  },
  {
    "start": 170.82,
    "end": 175.22,
    "text": "在那种随时可能遭遇暴风雪袭击或者是仇家劫掠的环境里"
  },
  {
    "start": 175.22,
    "end": 179.1,
    "text": "一个失去丈夫的妇女如果带着孩子离开部落去流浪"
  },
  {
    "start": 179.1,
    "end": 181.48,
    "text": "生存概率几乎为零"
  },
  {
    "start": 181.48,
    "end": 182.06,
    "text": "确实"
  },
  {
    "start": 182.06,
    "end": 183.0,
    "text": "基本活不下去"
  },
  {
    "start": 183.0,
    "end": 186.62,
    "text": "所以收纪婚从根本上是为了把人口"
  },
  {
    "start": 186.62,
    "end": 187.16,
    "text": "牲畜"
  },
  {
    "start": 187.16,
    "end": 187.7,
    "text": "财产"
  },
  {
    "start": 187.7,
    "end": 191.06,
    "text": "乃至宝贵的劳动力死死的捆绑在这个部落内部"
  },
  {
    "start": 191.06,
    "end": 194.32,
    "text": "就是不让任何一丝生存资源流逝到外部"
  },
  {
    "start": 194.32,
    "end": 194.98,
    "text": "哇"
  },
  {
    "start": 194.98,
    "end": 196.66,
    "text": "这不是什么正式"
  },
  {
    "start": 196.66,
    "end": 199.86,
    "text": "这完全是生物学意义上的求生本能啊"
  },
  {
    "start": 199.86,
    "end": 201.04,
    "text": "完全正确"
  },
  {
    "start": 201.04,
    "end": 201.78,
    "text": "好"
  },
  {
    "start": 201.78,
    "end": 203.58,
    "text": "那咱们来拆解一下啊"
  },
  {
    "start": 203.58,
    "end": 208.3,
    "text": "当时的草原呃就像是一个极度内卷各自为战的初创企业圈"
  },
  {
    "start": 208.3,
    "end": 210.56,
    "text": "大家都在疯狂抢夺资源"
  },
  {
    "start": 210.56,
    "end": 211.66,
    "text": "那么问题来了"
  },
  {
    "start": 211.66,
    "end": 216.48,
    "text": "他们究竟是怎么从这种松散的部落联盟变成一个统一战线的"
  },
  {
    "start": 216.48,
    "end": 218.28,
    "text": "我看书里的描述"
  },
  {
    "start": 218.28,
    "end": 221.54,
    "text": "总觉得不仅仅是因为成吉思汗战术高明"
  },
  {
    "start": 221.54,
    "end": 223.28,
    "text": "或者特别能打仗这么简单吧"
  },
  {
    "start": 223.28,
    "end": 225.04,
    "text": "很多人都有这个误解"
  },
  {
    "start": 225.04,
    "end": 227.4,
    "text": "觉得统一草原纯靠拳头硬"
  },
  {
    "start": 227.4,
    "end": 230.62,
    "text": "但如果我们把它放到更大的宏观背景下看"
  },
  {
    "start": 230.62,
    "end": 234.84,
    "text": "你会发现统一的真正密码其实是国家制度"
  },
  {
    "start": 234.84,
    "end": 236.12,
    "text": "国家制度"
  },
  {
    "start": 236.12,
    "end": 237.84,
    "text": "当时不还是刚结盟吗"
  },
  {
    "start": 237.84,
    "end": 241.26,
    "text": "咱们回到前面提到的班珠尼河盟事"
  },
  {
    "start": 241.26,
    "end": 244.0,
    "text": "当时跟着成吉思汗逃难的那些人"
  },
  {
    "start": 244.0,
    "end": 245.62,
    "text": "其实分属不同的士族"
  },
  {
    "start": 245.62,
    "end": 246.98,
    "text": "甚至信仰都不一样"
  },
  {
    "start": 246.98,
    "end": 249.56,
    "text": "成吉思汗敏锐的意识到一个致命问题"
  },
  {
    "start": 249.56,
    "end": 251.7,
    "text": "只要原有的血缘纽带还在"
  },
  {
    "start": 251.7,
    "end": 255.36,
    "text": "这支队伍迟早会因为各自家族的利益冲突再次散火"
  },
  {
    "start": 255.36,
    "end": 257.82,
    "text": "毕竟大家还是各怀鬼胎嘛"
  },
  {
    "start": 257.82,
    "end": 258.14,
    "text": "对"
  },
  {
    "start": 258.14,
    "end": 261.22,
    "text": "于是他推出了一套颠覆性的底层机制"
  },
  {
    "start": 261.22,
    "end": 262.72,
    "text": "也就是千户制"
  },
  {
    "start": 262.72,
    "end": 264.78,
    "text": "千户制我有点概念"
  },
  {
    "start": 264.78,
    "end": 266.96,
    "text": "不就是把军队按人数编组吗"
  },
  {
    "start": 266.96,
    "end": 271.04,
    "text": "这种操作在古代军事史上不是挺常见的吗"
  },
  {
    "start": 271.04,
    "end": 272.42,
    "text": "表面上看是这样"
  },
  {
    "start": 272.42,
    "end": 275.5,
    "text": "但千户制的核心根本不在于兵力计算"
  },
  {
    "start": 275.5,
    "end": 277.14,
    "text": "而在于物理粉碎"
  },
  {
    "start": 277.14,
    "end": 278.66,
    "text": "物理粉碎"
  },
  {
    "start": 278.66,
    "end": 279.12,
    "text": "对"
  },
  {
    "start": 279.12,
    "end": 280.16,
    "text": "你想象一下"
  },
  {
    "start": 280.16,
    "end": 282.64,
    "text": "你手里有一大堆形状各异的拼图块"
  },
  {
    "start": 282.64,
    "end": 285.3,
    "text": "代表着草原上大大小小的古老士族"
  },
  {
    "start": 285.3,
    "end": 288.64,
    "text": "成吉思汗的做法不是勉强把它们缝补在一起"
  },
  {
    "start": 288.64,
    "end": 292.48,
    "text": "而是直接把这些拼图块全部扔进高温火炉里"
  },
  {
    "start": 292.48,
    "end": 293.16,
    "text": "哇"
  },
  {
    "start": 293.16,
    "end": 294.78,
    "text": "直接融化掉"
  },
  {
    "start": 294.78,
    "end": 295.24,
    "text": "没错"
  },
  {
    "start": 295.24,
    "end": 296.66,
    "text": "融化成液体"
  },
  {
    "start": 296.66,
    "end": 299.66,
    "text": "然后再重新倒进一个完全统一"
  },
  {
    "start": 299.66,
    "end": 301.8,
    "text": "毫无差别的军事模具里"
  },
  {
    "start": 301.8,
    "end": 302.2,
    "text": "哦"
  },
  {
    "start": 302.2,
    "end": 303.48,
    "text": "我彻底明白了"
  },
  {
    "start": 303.48,
    "end": 304.6,
    "text": "这就意味着"
  },
  {
    "start": 304.6,
    "end": 307.12,
    "text": "你原本是某个特定古老家族的人"
  },
  {
    "start": 307.12,
    "end": 309.92,
    "text": "你从小听着自己家族的图腾故事长大"
  },
  {
    "start": 309.92,
    "end": 313.58,
    "text": "但现在你的旧身份被强制抹除了"
  },
  {
    "start": 313.58,
    "end": 314.34,
    "text": "非常精准"
  },
  {
    "start": 314.34,
    "end": 315.86,
    "text": "你被随机打散"
  },
  {
    "start": 315.86,
    "end": 317.3,
    "text": "分派给一个新的长官"
  },
  {
    "start": 317.3,
    "end": 319.16,
    "text": "你只属于这个特定的单位"
  },
  {
    "start": 319.16,
    "end": 320.42,
    "text": "你的顶头上司"
  },
  {
    "start": 320.42,
    "end": 323.12,
    "text": "昨天可能还是另一个仇家部落的人"
  },
  {
    "start": 323.12,
    "end": 324.74,
    "text": "这招太绝了"
  },
  {
    "start": 324.74,
    "end": 327.26,
    "text": "通过这种极其霸道的强行重组"
  },
  {
    "start": 327.26,
    "end": 331.02,
    "text": "成吉思汗切断了所有人对原有血缘贵族的效忠"
  },
  {
    "start": 331.02,
    "end": 331.38,
    "text": "没错"
  },
  {
    "start": 331.38,
    "end": 333.3,
    "text": "你不再属于任何士族"
  },
  {
    "start": 333.3,
    "end": 336.92,
    "text": "你只属于大蒙古国这台机器上的一个零件"
  },
  {
    "start": 336.92,
    "end": 339.7,
    "text": "再加上当时颁布的大诈萨法典"
  },
  {
    "start": 339.7,
    "end": 342.7,
    "text": "用极其严酷的刑罚来维持新秩序"
  },
  {
    "start": 342.7,
    "end": 344.96,
    "text": "谁敢违抗跨血缘的军令"
  },
  {
    "start": 344.96,
    "end": 345.92,
    "text": "直接处死"
  },
  {
    "start": 345.92,
    "end": 348.34,
    "text": "这等于是把一个松散的血缘社会"
  },
  {
    "start": 348.34,
    "end": 349.68,
    "text": "硬生生砸碎"
  },
  {
    "start": 349.68,
    "end": 353.38,
    "text": "重塑成了一个高度集权的军事国家实体"
  },
  {
    "start": 353.38,
    "end": 357.18,
    "text": "也就是一台无比庞大且精密咬合的绞肉机"
  },
  {
    "start": 357.18,
    "end": 359.6,
    "text": "那只要这台机器开始运转"
  },
  {
    "start": 359.6,
    "end": 362.0,
    "text": "它的能量肯定要向外喷发"
  },
  {
    "start": 362.0,
    "end": 363.5,
    "text": "去寻找新的资源"
  },
  {
    "start": 363.5,
    "end": 365.14,
    "text": "但有意思的是"
  },
  {
    "start": 365.14,
    "end": 368.52,
    "text": "这股能量第一次真正溢出大草原"
  },
  {
    "start": 368.52,
    "end": 370.24,
    "text": "冲向中亚文明的时候"
  },
  {
    "start": 370.24,
    "end": 373.78,
    "text": "起因却充满了一种诡异的外交戏剧感"
  },
  {
    "start": 373.78,
    "end": 375.06,
    "text": "确实非常戏剧化"
  },
  {
    "start": 375.06,
    "end": 377.32,
    "text": "书里详细记录了成吉思汗"
  },
  {
    "start": 377.32,
    "end": 380.84,
    "text": "当时给花辣子魔沙王磨合墨写的一封国书"
  },
  {
    "start": 380.84,
    "end": 383.06,
    "text": "里面有一句极具深意的话"
  },
  {
    "start": 383.06,
    "end": 383.8,
    "text": "他说"
  },
  {
    "start": 383.8,
    "end": 386.76,
    "text": "我对于你就像对待我的爱子一样"
  },
  {
    "start": 386.76,
    "end": 389.08,
    "text": "你觉得这是一份国书"
  },
  {
    "start": 389.08,
    "end": 390.44,
    "text": "还是一只挑战书"
  },
  {
    "start": 390.44,
    "end": 392.94,
    "text": "到底是谁先扔下的白手套"
  },
  {
    "start": 392.94,
    "end": 396.68,
    "text": "如果站在当时中亚的地缘政治情境里去解读"
  },
  {
    "start": 396.68,
    "end": 398.94,
    "text": "这句话堪称火辣味十足"
  },
  {
    "start": 398.94,
    "end": 401.46,
    "text": "简直是在对方的雷区里跳舞"
  },
  {
    "start": 401.46,
    "end": 403.08,
    "text": "但这里我想跟你抬个盖"
  },
  {
    "start": 403.08,
    "end": 406.3,
    "text": "当时成吉思汗的战略重心还在东方"
  },
  {
    "start": 406.3,
    "end": 409.56,
    "text": "他其实是想跟西边的花辣子魔开通商路的"
  },
  {
    "start": 409.56,
    "end": 412.52,
    "text": "有没有可能他真的只是在示好"
  },
  {
    "start": 412.52,
    "end": 414.56,
    "text": "因为在游牧文化里"
  },
  {
    "start": 414.56,
    "end": 416.06,
    "text": "认对方当干儿子"
  },
  {
    "start": 416.06,
    "end": 418.02,
    "text": "也许就是一种拉近关系"
  },
  {
    "start": 418.02,
    "end": 420.18,
    "text": "结为同盟的粗犷表达呢"
  },
  {
    "start": 420.18,
    "end": 421.38,
    "text": "这个切入点很好"
  },
  {
    "start": 421.38,
    "end": 423.6,
    "text": "但这里产生致命冲突的"
  },
  {
    "start": 423.6,
    "end": 427.52,
    "text": "恰恰是双方对世界秩序的认知完全错位"
  },
  {
    "start": 427.52,
    "end": 428.6,
    "text": "怎么个错位法"
  },
  {
    "start": 428.6,
    "end": 431.52,
    "text": "问题的关键不在于成吉思汗心里怎么想"
  },
  {
    "start": 431.52,
    "end": 434.18,
    "text": "而在于摩和墨挺完会有什么反应"
  },
  {
    "start": 434.18,
    "end": 436.62,
    "text": "花辣子魔当时正处于国力的巅峰"
  },
  {
    "start": 436.62,
    "end": 440.84,
    "text": "摩和墨自认为是整个伊斯兰世界无可争议的霸主"
  },
  {
    "start": 440.84,
    "end": 444.28,
    "text": "现在一个穿着羊皮尔的东方君主写信过来"
  },
  {
    "start": 444.28,
    "end": 447.4,
    "text": "自理行间透着一种居高临下的宗主国口吻"
  },
  {
    "start": 447.4,
    "end": 450.06,
    "text": "所以在平等的外交原则上"
  },
  {
    "start": 450.06,
    "end": 451.8,
    "text": "这就是赤裸裸的羞辱"
  },
  {
    "start": 451.8,
    "end": 452.44,
    "text": "没错"
  },
  {
    "start": 452.44,
    "end": 455.48,
    "text": "对方肯定觉得受到了极大的冒犯"
  },
  {
    "start": 455.48,
    "end": 457.42,
    "text": "这就不难理解随后发生的那场"
  },
  {
    "start": 457.42,
    "end": 459.94,
    "text": "改变历史进程的俄达腊惨案了"
  },
  {
    "start": 459.94,
    "end": 462.1,
    "text": "当时成吉思汗派去了一支"
  },
  {
    "start": 462.1,
    "end": 465.26,
    "text": "由450名回回商人组成的庞大商队"
  },
  {
    "start": 465.26,
    "end": 467.64,
    "text": "带着500头骆驼的珍贵货物"
  },
  {
    "start": 467.64,
    "end": 469.1,
    "text": "去进行边境贸易"
  },
  {
    "start": 469.1,
    "end": 471.48,
    "text": "这是一次极具诚意的商业试探"
  },
  {
    "start": 471.48,
    "end": 473.26,
    "text": "结果到了边界城市俄达腊"
  },
  {
    "start": 473.26,
    "end": 476.08,
    "text": "当地的守将直接把他们全抓了"
  },
  {
    "start": 476.08,
    "end": 478.74,
    "text": "强行诬陷他们是刺探情报的间谍"
  },
  {
    "start": 478.74,
    "end": 481.0,
    "text": "最后摩赫默居然头脑发热"
  },
  {
    "start": 481.0,
    "end": 483.24,
    "text": "批准将这些商人全数砍头"
  },
  {
    "start": 483.24,
    "end": 484.58,
    "text": "还把财产都吞了"
  },
  {
    "start": 484.58,
    "end": 487.22,
    "text": "这还不是最极端的"
  },
  {
    "start": 487.22,
    "end": 489.76,
    "text": "成吉思汗后来试图压住怒火"
  },
  {
    "start": 489.76,
    "end": 493.14,
    "text": "派专门的使者去华拉兹摩首都讨谣说法"
  },
  {
    "start": 493.14,
    "end": 495.24,
    "text": "结果摩赫默做出了一个"
  },
  {
    "start": 495.24,
    "end": 497.22,
    "text": "完全切断后路的举动"
  },
  {
    "start": 497.22,
    "end": 498.36,
    "text": "他干了什么"
  },
  {
    "start": 498.36,
    "end": 501.26,
    "text": "他直接下令杀掉了正使"
  },
  {
    "start": 501.26,
    "end": 504.34,
    "text": "并且把富士的胡子和头发全部剃了个精光"
  },
  {
    "start": 504.34,
    "end": 506.56,
    "text": "作为莫大的羞辱赶回了草原"
  },
  {
    "start": 506.56,
    "end": 507.38,
    "text": "哇"
  },
  {
    "start": 507.38,
    "end": 509.68,
    "text": "在古代的外交礼仪礼"
  },
  {
    "start": 509.68,
    "end": 511.36,
    "text": "剃光使臣的毛发"
  },
  {
    "start": 511.36,
    "end": 515.1,
    "text": "简直就是直接对着整个草原部落贴脸山巴掌了"
  },
  {
    "start": 515.1,
    "end": 516.54,
    "text": "彻底撕破脸了"
  },
  {
    "start": 516.54,
    "end": 518.96,
    "text": "在草原约孙的规矩里"
  },
  {
    "start": 518.96,
    "end": 520.74,
    "text": "使者是神圣不可侵犯的"
  },
  {
    "start": 521.3,
    "end": 522.86,
    "text": "成吉思汗得到消息后"
  },
  {
    "start": 522.86,
    "end": 523.86,
    "text": "没有狂怒"
  },
  {
    "start": 523.86,
    "end": 526.3,
    "text": "他只是默默地爬上一座圣山"
  },
  {
    "start": 526.3,
    "end": 527.4,
    "text": "脱下帽子"
  },
  {
    "start": 527.4,
    "end": 528.42,
    "text": "祈祷了多天"
  },
  {
    "start": 528.42,
    "end": 530.58,
    "text": "暴风雨前的宁静"
  },
  {
    "start": 530.58,
    "end": 530.82,
    "text": "对"
  },
  {
    "start": 530.82,
    "end": 534.04,
    "text": "最后他给华拉字母回了一句极其冰冷的话"
  },
  {
    "start": 534.04,
    "end": 536.22,
    "text": "是你选择了战争"
  },
  {
    "start": 536.22,
    "end": 538.8,
    "text": "唯有长生天知道我们二者如何结局"
  },
  {
    "start": 538.8,
    "end": 543.24,
    "text": "这就是帝国对外扩张的最典型宣战逻辑"
  },
  {
    "start": 543.24,
    "end": 545.5,
    "text": "把发动毁灭性战争的责任"
  },
  {
    "start": 545.5,
    "end": 547.58,
    "text": "完美地推给破坏契约的对方"
  },
  {
    "start": 547.58,
    "end": 549.5,
    "text": "那随之而来的"
  },
  {
    "start": 549.5,
    "end": 552.28,
    "text": "就是让人窒息的城防攻坚战了"
  },
  {
    "start": 552.28,
    "end": 555.36,
    "text": "像撒马尔干和玉龙劫翅这样繁华的城市"
  },
  {
    "start": 555.36,
    "end": 557.98,
    "text": "面临的完全是降维打击"
  },
  {
    "start": 557.98,
    "end": 561.24,
    "text": "但我注意到书里记录了一个非常反直觉的细节"
  },
  {
    "start": 561.24,
    "end": 562.94,
    "text": "关于工程的"
  },
  {
    "start": 562.94,
    "end": 563.6,
    "text": "对"
  },
  {
    "start": 563.6,
    "end": 566.26,
    "text": "我们印象里的游牧铁骑攻陷城市"
  },
  {
    "start": 566.26,
    "end": 568.44,
    "text": "通常是伴随着无差别的摧毁"
  },
  {
    "start": 568.44,
    "end": 568.96,
    "text": "对吧"
  },
  {
    "start": 568.96,
    "end": 570.82,
    "text": "这是大众认知里的刻板印象"
  },
  {
    "start": 570.82,
    "end": 573.78,
    "text": "觉得他们对文明成果毫无兴趣"
  },
  {
    "start": 573.78,
    "end": 574.7,
    "text": "但事实是"
  },
  {
    "start": 574.7,
    "end": 576.24,
    "text": "每当城池被攻陷"
  },
  {
    "start": 576.24,
    "end": 577.84,
    "text": "蒙古军队会在混乱中"
  },
  {
    "start": 577.84,
    "end": 580.54,
    "text": "立刻展开一项极其冷静的甄别公布"
  },
  {
    "start": 580.54,
    "end": 582.26,
    "text": "他们会把城里的工匠"
  },
  {
    "start": 582.26,
    "end": 582.92,
    "text": "济士"
  },
  {
    "start": 582.92,
    "end": 583.72,
    "text": "甚至医生"
  },
  {
    "start": 583.72,
    "end": 584.82,
    "text": "单独挑出来"
  },
  {
    "start": 584.82,
    "end": 585.62,
    "text": "免于屠杀"
  },
  {
    "start": 585.62,
    "end": 586.78,
    "text": "然后全部带走"
  },
  {
    "start": 586.78,
    "end": 587.66,
    "text": "哦"
  },
  {
    "start": 587.66,
    "end": 590.66,
    "text": "因为这些军队的统帅们极度务实"
  },
  {
    "start": 590.66,
    "end": 592.9,
    "text": "也就是前线还在流血拼杀"
  },
  {
    "start": 592.9,
    "end": 596.24,
    "text": "后方就已经开始成建制的掠夺工程师队伍了"
  },
  {
    "start": 596.24,
    "end": 597.14,
    "text": "必然的"
  },
  {
    "start": 597.14,
    "end": 598.54,
    "text": "单纯的清戏兵"
  },
  {
    "start": 598.54,
    "end": 600.9,
    "text": "面对坚固的石头城墙和护城河"
  },
  {
    "start": 600.9,
    "end": 602.3,
    "text": "是无能为力的"
  },
  {
    "start": 602.3,
    "end": 604.8,
    "text": "他们需要懂制造工程器械的木匠"
  },
  {
    "start": 604.8,
    "end": 605.72,
    "text": "需要铁匠"
  },
  {
    "start": 605.72,
    "end": 606.5,
    "text": "需要衣食"
  },
  {
    "start": 606.5,
    "end": 608.84,
    "text": "这种对技术人才的渴求"
  },
  {
    "start": 608.84,
    "end": 611.62,
    "text": "其实反映了统治集团思想的转变"
  },
  {
    "start": 611.62,
    "end": 614.4,
    "text": "他们开始意识到一个极其棘手的问题"
  },
  {
    "start": 614.4,
    "end": 615.5,
    "text": "什么问题"
  },
  {
    "start": 615.5,
    "end": 620.22,
    "text": "就是占领了一片拥有海量农业人口"
  },
  {
    "start": 620.22,
    "end": 622.7,
    "text": "复杂水利工程和税收系统的土地时"
  },
  {
    "start": 622.7,
    "end": 625.88,
    "text": "你总不能把农田全毁了用来放马吧"
  },
  {
    "start": 625.88,
    "end": 628.14,
    "text": "要想持续榨取财富"
  },
  {
    "start": 628.14,
    "end": 630.4,
    "text": "就必须建立文官系统搞后勤"
  },
  {
    "start": 630.4,
    "end": 633.84,
    "text": "这就预示了接下来帝国在治理转型期"
  },
  {
    "start": 633.84,
    "end": 635.12,
    "text": "必然面临的阵痛"
  },
  {
    "start": 635.12,
    "end": 636.78,
    "text": "聊到转型阵痛啊"
  },
  {
    "start": 636.78,
    "end": 638.8,
    "text": "也就是建立元朝之后的治理方式"
  },
  {
    "start": 638.8,
    "end": 640.5,
    "text": "咱们得来打个假了"
  },
  {
    "start": 640.5,
    "end": 642.38,
    "text": "最有意思的地方来了"
  },
  {
    "start": 642.38,
    "end": 643.7,
    "text": "你一定听过"
  },
  {
    "start": 643.7,
    "end": 645.6,
    "text": "久如石盖这个说法吧"
  },
  {
    "start": 645.6,
    "end": 647.42,
    "text": "就是读书人被踩在脚底"
  },
  {
    "start": 647.42,
    "end": 649.46,
    "text": "这匹乞丐高一点点"
  },
  {
    "start": 649.46,
    "end": 651.52,
    "text": "这个说法确实深入人心"
  },
  {
    "start": 651.52,
    "end": 653.18,
    "text": "我以前也深信不疑"
  },
  {
    "start": 653.18,
    "end": 655.24,
    "text": "但这本蒙古历史拼图"
  },
  {
    "start": 655.24,
    "end": 657.06,
    "text": "实打实的去查了出数"
  },
  {
    "start": 657.06,
    "end": 657.84,
    "text": "结果"
  },
  {
    "start": 657.84,
    "end": 659.42,
    "text": "欠持让人惊掉下巴"
  },
  {
    "start": 659.42,
    "end": 662.24,
    "text": "它根本不是元朝官方颁布的法律条文"
  },
  {
    "start": 662.24,
    "end": 665.84,
    "text": "而是源自南宋移民郑思校和谢方德的文章"
  },
  {
    "start": 665.84,
    "end": 666.66,
    "text": "没错"
  },
  {
    "start": 666.66,
    "end": 669.94,
    "text": "这两位是有着强烈亡国之痛的知识分子"
  },
  {
    "start": 669.94,
    "end": 671.84,
    "text": "谢方德写这种话的时候"
  },
  {
    "start": 671.84,
    "end": 674.4,
    "text": "更像是一个文化人在极度绝望下"
  },
  {
    "start": 674.4,
    "end": 676.86,
    "text": "带着强烈戏谑色彩的黑色幽默"
  },
  {
    "start": 676.86,
    "end": 678.8,
    "text": "这就像今天有人自嘲"
  },
  {
    "start": 678.8,
    "end": 679.92,
    "text": "打工人不如狗"
  },
  {
    "start": 680.56,
    "end": 683.12,
    "text": "要是几百年后被当成法定历史"
  },
  {
    "start": 683.12,
    "end": 684.48,
    "text": "那可就闹笑话了"
  },
  {
    "start": 684.48,
    "end": 686.24,
    "text": "这个类比非常生动"
  },
  {
    "start": 686.24,
    "end": 689.92,
    "text": "如果你去查阅元朝真正的硬核制度文本"
  },
  {
    "start": 689.92,
    "end": 692.38,
    "text": "也就是用来管理人口的诸色户籍"
  },
  {
    "start": 692.38,
    "end": 695.04,
    "text": "会发现官方根本没有颁布过"
  },
  {
    "start": 695.04,
    "end": 697.62,
    "text": "把人划分为明确职业贵贱的条文"
  },
  {
    "start": 697.62,
    "end": 698.46,
    "text": "相反"
  },
  {
    "start": 698.46,
    "end": 700.64,
    "text": "如果你被编入了如户"
  },
  {
    "start": 700.64,
    "end": 702.54,
    "text": "其实是享有特权的"
  },
  {
    "start": 702.54,
    "end": 704.96,
    "text": "比如免除沉重的差役"
  },
  {
    "start": 704.96,
    "end": 705.7,
    "text": "对"
  },
  {
    "start": 705.7,
    "end": 707.6,
    "text": "还能免除部分丁税"
  },
  {
    "start": 707.6,
    "end": 707.92,
    "text": "等等"
  },
  {
    "start": 707.92,
    "end": 709.52,
    "text": "这就出现逻辑矛盾了"
  },
  {
    "start": 709.52,
    "end": 711.84,
    "text": "既然官方给了免税福利"
  },
  {
    "start": 711.84,
    "end": 712.92,
    "text": "那读书人"
  },
  {
    "start": 712.92,
    "end": 715.2,
    "text": "为什么还要发出那种惨痛的哀鸣"
  },
  {
    "start": 715.2,
    "end": 717.78,
    "text": "这就引出了一个至关重要的问题"
  },
  {
    "start": 717.78,
    "end": 719.9,
    "text": "读书人的真正痛苦"
  },
  {
    "start": 719.9,
    "end": 721.8,
    "text": "其实不在于社会名誉受损"
  },
  {
    "start": 721.8,
    "end": 724.7,
    "text": "而在于他们通向权力中心的唯一桥梁"
  },
  {
    "start": 724.7,
    "end": 726.02,
    "text": "被彻底炸毁了"
  },
  {
    "start": 726.02,
    "end": 727.88,
    "text": "也就是科举迟迟不开"
  },
  {
    "start": 727.88,
    "end": 728.28,
    "text": "对"
  },
  {
    "start": 728.28,
    "end": 730.7,
    "text": "你就算读了一肚子四书五经"
  },
  {
    "start": 730.7,
    "end": 732.32,
    "text": "连个县令都当不上"
  },
  {
    "start": 732.32,
    "end": 735.84,
    "text": "因为元朝统治者找到了一套完全不同的办法"
  },
  {
    "start": 735.84,
    "end": 736.62,
    "text": "来控制帝国"
  },
  {
    "start": 736.62,
    "end": 738.88,
    "text": "他们不需要文人来分权"
  },
  {
    "start": 738.88,
    "end": 740.36,
    "text": "那他们用什么办法"
  },
  {
    "start": 740.36,
    "end": 744.02,
    "text": "他们设计了一个打鲁花痴制度"
  },
  {
    "start": 744.02,
    "end": 746.44,
    "text": "你可以把它理解为最终裁决监工"
  },
  {
    "start": 746.44,
    "end": 749.14,
    "text": "不管地方上具体是谁在处理政务"
  },
  {
    "start": 749.14,
    "end": 750.44,
    "text": "负责签字盖章"
  },
  {
    "start": 750.44,
    "end": 752.76,
    "text": "掌握最高军权和监察权的那个岗位"
  },
  {
    "start": 752.76,
    "end": 754.66,
    "text": "必须由蒙古人来担任"
  },
  {
    "start": 754.66,
    "end": 756.2,
    "text": "绝对的卡脖子"
  },
  {
    "start": 756.2,
    "end": 759.12,
    "text": "这就好比是一个双钥匙系统"
  },
  {
    "start": 759.12,
    "end": 760.8,
    "text": "汉族官僚在底下做事"
  },
  {
    "start": 760.8,
    "end": 762.8,
    "text": "但启动机器的钥匙"
  },
  {
    "start": 762.8,
    "end": 764.98,
    "text": "死死攥在那个蒙古监工手里"
  },
  {
    "start": 764.98,
    "end": 765.56,
    "text": "没错"
  },
  {
    "start": 765.56,
    "end": 768.38,
    "text": "这道混合体系设计的极其精妙"
  },
  {
    "start": 768.38,
    "end": 769.3,
    "text": "榨取了财富"
  },
  {
    "start": 769.3,
    "end": 770.6,
    "text": "又保证了武力威慑"
  },
  {
    "start": 770.6,
    "end": 772.46,
    "text": "那这样一个庞然大物"
  },
  {
    "start": 772.46,
    "end": 774.58,
    "text": "最后是怎么轰然崩盘的呢"
  },
  {
    "start": 774.58,
    "end": 776.86,
    "text": "最大的致命伤"
  },
  {
    "start": 776.86,
    "end": 778.64,
    "text": "在于他内部从一开始"
  },
  {
    "start": 778.64,
    "end": 781.08,
    "text": "就缺乏一套清晰的交接班系统"
  },
  {
    "start": 781.08,
    "end": 784.28,
    "text": "这种隐患最终像定时炸弹一样撕裂了帝国"
  },
  {
    "start": 784.28,
    "end": 785.78,
    "text": "这种撕裂的伏笔"
  },
  {
    "start": 785.78,
    "end": 787.36,
    "text": "其实早就埋下了"
  },
  {
    "start": 787.36,
    "end": 788.74,
    "text": "出征花蜡子摸前"
  },
  {
    "start": 788.74,
    "end": 791.74,
    "text": "耶穗夫人抛出了一个极其危险的灵魂拷问"
  },
  {
    "start": 791.74,
    "end": 793.16,
    "text": "他问成吉思汗"
  },
  {
    "start": 793.16,
    "end": 795.32,
    "text": "如果您不在了"
  },
  {
    "start": 795.32,
    "end": 796.86,
    "text": "这江山该交给谁"
  },
  {
    "start": 796.86,
    "end": 799.1,
    "text": "这个问题在当时如同晴天霹雳"
  },
  {
    "start": 799.1,
    "end": 801.88,
    "text": "成吉思汗一生都在战场上厮杀"
  },
  {
    "start": 801.88,
    "end": 805.96,
    "text": "从来没认真想过最高权力该怎么平稳过渡"
  },
  {
    "start": 805.96,
    "end": 808.16,
    "text": "结果在随后的胡理台大会上"
  },
  {
    "start": 808.16,
    "end": 810.46,
    "text": "树斥和茶和台为了计政权"
  },
  {
    "start": 810.46,
    "end": 812.0,
    "text": "直接爆发了激烈的口角"
  },
  {
    "start": 812.0,
    "end": 814.04,
    "text": "甚至当场扭打起来"
  },
  {
    "start": 814.04,
    "end": 814.88,
    "text": "最后为了平衡"
  },
  {
    "start": 814.88,
    "end": 817.16,
    "text": "只好妥协由窝阔台继位"
  },
  {
    "start": 817.16,
    "end": 819.84,
    "text": "书里揭示了一个让人震惊的细节"
  },
  {
    "start": 819.84,
    "end": 823.22,
    "text": "成吉思汗当时定下了一个绝对的死规矩"
  },
  {
    "start": 823.22,
    "end": 825.42,
    "text": "只要窝阔台家族还有男丁"
  },
  {
    "start": 825.42,
    "end": 826.5,
    "text": "哪怕是个废柴"
  },
  {
    "start": 826.5,
    "end": 828.78,
    "text": "大汉的位置也必须由他来做"
  },
  {
    "start": 828.78,
    "end": 830.96,
    "text": "但后来权力不是转移到了"
  },
  {
    "start": 830.96,
    "end": 832.66,
    "text": "拖雷一系的蒙格手中吗"
  },
  {
    "start": 832.66,
    "end": 833.1,
    "text": "对"
  },
  {
    "start": 833.1,
    "end": 835.42,
    "text": "蒙格上位后为了合法性"
  },
  {
    "start": 835.42,
    "end": 838.42,
    "text": "他做了一件彻底摧毁帝国信任根基的事"
  },
  {
    "start": 838.42,
    "end": 841.28,
    "text": "他指使使官在蒙古密室里"
  },
  {
    "start": 841.28,
    "end": 844.38,
    "text": "悄悄改写了成吉思汗当年的那句遗言"
  },
  {
    "start": 844.38,
    "end": 844.72,
    "text": "哇"
  },
  {
    "start": 844.72,
    "end": 846.62,
    "text": "在历史档案上造假"
  },
  {
    "start": 846.62,
    "end": 849.12,
    "text": "但这为什么会导致整个帝国崩溃呢"
  },
  {
    "start": 849.12,
    "end": 850.36,
    "text": "你别忘了"
  },
  {
    "start": 850.36,
    "end": 852.8,
    "text": "这是个脱胎于游牧部落的共通体"
  },
  {
    "start": 852.8,
    "end": 856.08,
    "text": "维席他的唯一纽带就是口耳相传的契约"
  },
  {
    "start": 856.08,
    "end": 859.44,
    "text": "当蒙格连成吉思汗最神圣的遗言都能篡改"
  },
  {
    "start": 859.44,
    "end": 863.26,
    "text": "这相当于撕毁了整个社会的底层智能合约"
  },
  {
    "start": 863.26,
    "end": 865.62,
    "text": "也就是连老祖宗的铁律都作废了"
  },
  {
    "start": 865.62,
    "end": 867.64,
    "text": "远方的汉国凭声还听你的"
  },
  {
    "start": 867.64,
    "end": 868.22,
    "text": "没错"
  },
  {
    "start": 868.22,
    "end": 870.1,
    "text": "信任彻底破产了"
  },
  {
    "start": 870.1,
    "end": 873.02,
    "text": "这就导致了后来长达四十余年的战争"
  },
  {
    "start": 873.02,
    "end": 875.54,
    "text": "书里把帝国走向解体的关键节点"
  },
  {
    "start": 875.54,
    "end": 878.18,
    "text": "定位在了1269年的那场塔拉斯大会"
  },
  {
    "start": 878.18,
    "end": 878.82,
    "text": "是的"
  },
  {
    "start": 878.82,
    "end": 881.82,
    "text": "那是一场完全绕开中央大汉的分赃大会"
  },
  {
    "start": 881.82,
    "end": 883.82,
    "text": "几大宗王自己坐在一起"
  },
  {
    "start": 883.82,
    "end": 886.52,
    "text": "把广袤的中亚领土直接挂分了"
  },
  {
    "start": 886.52,
    "end": 887.64,
    "text": "也就是说"
  },
  {
    "start": 887.64,
    "end": 890.02,
    "text": "统一的政令再也无法跨越草原"
  },
  {
    "start": 890.02,
    "end": 892.86,
    "text": "那些汉国实质上变成了各自为政的国家"
  },
  {
    "start": 892.86,
    "end": 895.82,
    "text": "当初靠着一杯泥水凝聚起来的共同体"
  },
  {
    "start": 895.82,
    "end": 897.52,
    "text": "彻底碎裂成了散沙"
  },
  {
    "start": 897.52,
    "end": 898.44,
    "text": "令人唏嘘"
  },
  {
    "start": 898.44,
    "end": 900.46,
    "text": "从泥泥河畔的生死相托"
  },
  {
    "start": 900.46,
    "end": 902.48,
    "text": "到横跨亚欧的无敌军团"
  },
  {
    "start": 902.48,
    "end": 905.1,
    "text": "再到最终因为猜疑而四分五裂"
  },
  {
    "start": 905.1,
    "end": 907.7,
    "text": "回看那些被强行重构的士族"
  },
  {
    "start": 907.7,
    "end": 909.1,
    "text": "被保留的工匠"
  },
  {
    "start": 909.1,
    "end": 910.62,
    "text": "被监视的农工帝国"
  },
  {
    "start": 910.62,
    "end": 912.66,
    "text": "还有那句被篡改的遗言"
  },
  {
    "start": 912.66,
    "end": 915.5,
    "text": "维系庞大汉国存续的核心"
  },
  {
    "start": 915.5,
    "end": 917.48,
    "text": "究竟是草原军事优势"
  },
  {
    "start": 917.48,
    "end": 919.02,
    "text": "还是治理制度的转型"
  }
]
