[
  {
    "start": 0.0,
    "end": 2.02,
    "text": "研究纯粹物理规律的学者"
  },
  {
    "start": 2.02,
    "end": 3.62,
    "text": "转入投资界后"
  },
  {
    "start": 3.62,
    "end": 5.72,
    "text": "为什么发现金融市场"
  },
  {
    "start": 5.72,
    "end": 7.34,
    "text": "无法套用自然法则"
  },
  {
    "start": 7.34,
    "end": 10.12,
    "text": "这个问题其实特别直击灵魂"
  },
  {
    "start": 10.12,
    "end": 10.6,
    "text": "对"
  },
  {
    "start": 10.6,
    "end": 11.64,
    "text": "你想想看"
  },
  {
    "start": 11.64,
    "end": 13.18,
    "text": "其实咱们今天的生活"
  },
  {
    "start": 13.18,
    "end": 14.46,
    "text": "怎么说呢"
  },
  {
    "start": 14.46,
    "end": 15.56,
    "text": "是一种极度依赖"
  },
  {
    "start": 15.56,
    "end": 17.48,
    "text": "各种算法和数据的状态"
  },
  {
    "start": 17.48,
    "end": 17.8,
    "text": "没错"
  },
  {
    "start": 17.8,
    "end": 19.94,
    "text": "不管是流媒体的推送"
  },
  {
    "start": 19.94,
    "end": 21.62,
    "text": "还是你手机里的导航"
  },
  {
    "start": 21.62,
    "end": 21.98,
    "text": "对吧"
  },
  {
    "start": 21.98,
    "end": 23.26,
    "text": "甚至是你账户里"
  },
  {
    "start": 23.26,
    "end": 24.98,
    "text": "那些理财产品的自动调仓"
  },
  {
    "start": 24.98,
    "end": 26.7,
    "text": "你潜意识里"
  },
  {
    "start": 26.7,
    "end": 28.14,
    "text": "其实都假设了一件事"
  },
  {
    "start": 28.14,
    "end": 29.58,
    "text": "只要代码写的对"
  },
  {
    "start": 29.58,
    "end": 31.38,
    "text": "只要数学公式够精妙"
  },
  {
    "start": 31.38,
    "end": 32.84,
    "text": "它就能算出最优解"
  },
  {
    "start": 32.84,
    "end": 34.12,
    "text": "甚至很多人觉得"
  },
  {
    "start": 34.12,
    "end": 35.62,
    "text": "模型能预测未来"
  },
  {
    "start": 35.62,
    "end": 35.96,
    "text": "是的"
  },
  {
    "start": 35.96,
    "end": 38.36,
    "text": "但是当你手握一个"
  },
  {
    "start": 38.36,
    "end": 40.76,
    "text": "在黑板上堪称完美的数学公式"
  },
  {
    "start": 40.76,
    "end": 42.9,
    "text": "满怀信心的一头撞上"
  },
  {
    "start": 42.9,
    "end": 43.76,
    "text": "极其复杂"
  },
  {
    "start": 43.76,
    "end": 45.64,
    "text": "极度非理性的人性"
  },
  {
    "start": 45.64,
    "end": 47.94,
    "text": "还有充满恐慌和贪婪的"
  },
  {
    "start": 47.94,
    "end": 48.84,
    "text": "现实市场时"
  },
  {
    "start": 48.84,
    "end": 50.44,
    "text": "到底会发生什么"
  },
  {
    "start": 50.44,
    "end": 53.22,
    "text": "那绝对是个大型的幻灭现场了"
  },
  {
    "start": 53.22,
    "end": 54.12,
    "text": "确实"
  },
  {
    "start": 54.12,
    "end": 56.38,
    "text": "所以今天我们就来聊聊"
  },
  {
    "start": 56.38,
    "end": 58.36,
    "text": "伊曼纽尔·德曼的这段回忆录"
  },
  {
    "start": 58.36,
    "end": 59.76,
    "text": "宽客人生"
  },
  {
    "start": 59.76,
    "end": 62.04,
    "text": "这不是那种干巴巴的教材"
  },
  {
    "start": 62.04,
    "end": 63.84,
    "text": "他讲的是一位物理学家"
  },
  {
    "start": 63.84,
    "end": 66.66,
    "text": "转型为华尔街第一代量化分析师"
  },
  {
    "start": 66.66,
    "end": 68.64,
    "text": "也就是宽客的职业往事"
  },
  {
    "start": 68.64,
    "end": 71.22,
    "text": "这其实是一个关于人类认知边界"
  },
  {
    "start": 71.22,
    "end": 73.28,
    "text": "被狠狠敲打的绝佳案例"
  },
  {
    "start": 73.28,
    "end": 74.06,
    "text": "你想"
  },
  {
    "start": 74.06,
    "end": 76.4,
    "text": "物理学家的思维底色是什么"
  },
  {
    "start": 76.4,
    "end": 78.02,
    "text": "是仰望星空"
  },
  {
    "start": 78.02,
    "end": 78.66,
    "text": "对吧"
  },
  {
    "start": 78.66,
    "end": 80.32,
    "text": "探寻宇宙真理那种"
  },
  {
    "start": 80.32,
    "end": 80.8,
    "text": "没错"
  },
  {
    "start": 80.8,
    "end": 82.76,
    "text": "如果一个公式在地球上成立"
  },
  {
    "start": 82.76,
    "end": 84.86,
    "text": "那它在半人马座也必须成立"
  },
  {
    "start": 84.86,
    "end": 86.28,
    "text": "这是他们最骄傲的地方"
  },
  {
    "start": 86.28,
    "end": 87.84,
    "text": "但金融市场呢"
  },
  {
    "start": 87.84,
    "end": 89.28,
    "text": "根本不是什么星空"
  },
  {
    "start": 89.28,
    "end": 90.74,
    "text": "它是由无数个贪婪"
  },
  {
    "start": 90.74,
    "end": 91.96,
    "text": "恐惧的普通人"
  },
  {
    "start": 91.96,
    "end": 93.8,
    "text": "用真金白银堆出来的"
  },
  {
    "start": 93.8,
    "end": 94.76,
    "text": "就是个泥潭"
  },
  {
    "start": 94.76,
    "end": 95.16,
    "text": "对"
  },
  {
    "start": 95.16,
    "end": 96.6,
    "text": "所以德曼的经历"
  },
  {
    "start": 96.6,
    "end": 98.22,
    "text": "就是从象牙塔的云端"
  },
  {
    "start": 98.22,
    "end": 99.88,
    "text": "一步步踩进现实泥潭"
  },
  {
    "start": 99.88,
    "end": 101.86,
    "text": "并学会生存的过程"
  },
  {
    "start": 101.86,
    "end": 103.44,
    "text": "那咱们就来拆解一下它的起点"
  },
  {
    "start": 103.44,
    "end": 105.3,
    "text": "看看这种反差到底有多大"
  },
  {
    "start": 105.3,
    "end": 107.56,
    "text": "那是在1966年的秋天"
  },
  {
    "start": 107.56,
    "end": 110.22,
    "text": "德曼从南非满怀憧憬的来到了纽约"
  },
  {
    "start": 110.22,
    "end": 111.44,
    "text": "进了哥伦比亚大学"
  },
  {
    "start": 111.44,
    "end": 112.78,
    "text": "共读物理学博士"
  },
  {
    "start": 112.78,
    "end": 112.98,
    "text": "对"
  },
  {
    "start": 112.98,
    "end": 114.18,
    "text": "你可以想象一下"
  },
  {
    "start": 114.18,
    "end": 116.32,
    "text": "一个绝顶聪明的年轻人"
  },
  {
    "start": 116.32,
    "end": 118.46,
    "text": "一头扎进理论物理的深海"
  },
  {
    "start": 118.46,
    "end": 119.76,
    "text": "在那之后"
  },
  {
    "start": 119.76,
    "end": 122.8,
    "text": "他经历了非常漫长的七年研究生训练"
  },
  {
    "start": 122.8,
    "end": 125.32,
    "text": "极其严苛的学术高压"
  },
  {
    "start": 125.32,
    "end": 125.82,
    "text": "是的"
  },
  {
    "start": 125.82,
    "end": 128.16,
    "text": "接着他又在牛津大学"
  },
  {
    "start": 128.16,
    "end": 130.0,
    "text": "洛克菲勒大学做博士后"
  },
  {
    "start": 130.0,
    "end": 130.84,
    "text": "不断漂泊"
  },
  {
    "start": 130.84,
    "end": 132.56,
    "text": "这听起来真的是一条"
  },
  {
    "start": 132.56,
    "end": 134.54,
    "text": "非常典型的精英学术之路"
  },
  {
    "start": 134.54,
    "end": 136.02,
    "text": "表面上光鲜"
  },
  {
    "start": 136.02,
    "end": 138.48,
    "text": "但那里其实极其折磨人"
  },
  {
    "start": 138.48,
    "end": 140.64,
    "text": "因为理论物理学的日常"
  },
  {
    "start": 140.64,
    "end": 142.38,
    "text": "根本不像电影里演的那样"
  },
  {
    "start": 142.38,
    "end": 144.44,
    "text": "每天都有改变世界的伟大发现"
  },
  {
    "start": 144.44,
    "end": 146.48,
    "text": "很难有那种明显的进度条"
  },
  {
    "start": 146.48,
    "end": 146.92,
    "text": "对吧"
  },
  {
    "start": 146.92,
    "end": 147.3,
    "text": "没错"
  },
  {
    "start": 147.3,
    "end": 149.92,
    "text": "很多时候面对的是无尽的挫败"
  },
  {
    "start": 149.92,
    "end": 151.76,
    "text": "可能常年累月"
  },
  {
    "start": 151.76,
    "end": 153.54,
    "text": "死盯着黑板上的死胡同"
  },
  {
    "start": 153.54,
    "end": 156.16,
    "text": "去推到毫无头绪的方程"
  },
  {
    "start": 156.16,
    "end": 157.28,
    "text": "但最要命的"
  },
  {
    "start": 157.28,
    "end": 159.28,
    "text": "还不是这种智力上的折磨"
  },
  {
    "start": 159.28,
    "end": 161.7,
    "text": "现实生存出问题了"
  },
  {
    "start": 161.7,
    "end": 162.02,
    "text": "对"
  },
  {
    "start": 162.02,
    "end": 163.24,
    "text": "到了20世纪"
  },
  {
    "start": 163.24,
    "end": 165.0,
    "text": "特别是随后的70年代"
  },
  {
    "start": 165.0,
    "end": 167.56,
    "text": "理论物理的传统学术就业市场"
  },
  {
    "start": 167.56,
    "end": 168.8,
    "text": "在急剧收缩"
  },
  {
    "start": 168.8,
    "end": 169.9,
    "text": "也就是说"
  },
  {
    "start": 169.9,
    "end": 170.78,
    "text": "没工作了"
  },
  {
    "start": 170.78,
    "end": 171.96,
    "text": "断崖式下跌"
  },
  {
    "start": 171.96,
    "end": 173.56,
    "text": "很多顶前研究者"
  },
  {
    "start": 173.56,
    "end": 174.4,
    "text": "面临一个死局"
  },
  {
    "start": 174.4,
    "end": 176.0,
    "text": "你研究做得再好"
  },
  {
    "start": 176.0,
    "end": 177.1,
    "text": "哪怕你是天才"
  },
  {
    "start": 177.1,
    "end": 178.3,
    "text": "大学里就是"
  },
  {
    "start": 178.3,
    "end": 179.64,
    "text": "腾不出一个教职给你"
  },
  {
    "start": 179.64,
    "end": 180.3,
    "text": "天哪"
  },
  {
    "start": 180.3,
    "end": 181.7,
    "text": "这个反差太惨烈了"
  },
  {
    "start": 181.7,
    "end": 182.56,
    "text": "这就好像"
  },
  {
    "start": 182.56,
    "end": 184.78,
    "text": "你为了参加奥运会马拉松"
  },
  {
    "start": 184.78,
    "end": 186.0,
    "text": "苦练了许多年"
  },
  {
    "start": 186.0,
    "end": 187.22,
    "text": "到了赛场才发现"
  },
  {
    "start": 187.22,
    "end": 188.14,
    "text": "跑道被拆了"
  },
  {
    "start": 188.14,
    "end": 190.2,
    "text": "这个比喻太精准了"
  },
  {
    "start": 190.2,
    "end": 191.82,
    "text": "那对于一个从小习惯了"
  },
  {
    "start": 191.82,
    "end": 194.0,
    "text": "探寻宇宙绝对真理的人来说"
  },
  {
    "start": 194.0,
    "end": 195.78,
    "text": "这种被迫的转向"
  },
  {
    "start": 195.78,
    "end": 196.8,
    "text": "有多痛苦"
  },
  {
    "start": 196.8,
    "end": 197.4,
    "text": "怎么说呢"
  },
  {
    "start": 197.4,
    "end": 199.42,
    "text": "信仰崩塌级别的痛苦"
  },
  {
    "start": 199.42,
    "end": 201.48,
    "text": "这里其实揭穿了一个真相"
  },
  {
    "start": 201.48,
    "end": 203.36,
    "text": "单靠聪明和热情"
  },
  {
    "start": 203.36,
    "end": 205.04,
    "text": "在现实的职业约束面前"
  },
  {
    "start": 205.04,
    "end": 206.06,
    "text": "是非常脆弱的"
  },
  {
    "start": 206.06,
    "end": 207.4,
    "text": "毕竟人得吃饭"
  },
  {
    "start": 207.4,
    "end": 207.7,
    "text": "是的"
  },
  {
    "start": 207.7,
    "end": 210.18,
    "text": "年轻学者往往有种隧道实验"
  },
  {
    "start": 210.18,
    "end": 211.08,
    "text": "把纯学术"
  },
  {
    "start": 211.08,
    "end": 212.72,
    "text": "看作唯一高尚的路"
  },
  {
    "start": 212.72,
    "end": 214.7,
    "text": "但现实的饥饿感"
  },
  {
    "start": 214.7,
    "end": 215.4,
    "text": "不讲道理"
  },
  {
    "start": 215.4,
    "end": 217.4,
    "text": "逼着他们去寻找新的出口"
  },
  {
    "start": 217.4,
    "end": 218.76,
    "text": "所以德曼也没有拿着"
  },
  {
    "start": 218.76,
    "end": 219.54,
    "text": "物理系的文凭"
  },
  {
    "start": 219.54,
    "end": 220.72,
    "text": "直接空降华尔街"
  },
  {
    "start": 220.72,
    "end": 221.06,
    "text": "对吧"
  },
  {
    "start": 221.06,
    "end": 223.4,
    "text": "他中间去了一个缓冲地带"
  },
  {
    "start": 223.4,
    "end": 223.7,
    "text": "没错"
  },
  {
    "start": 223.7,
    "end": 224.94,
    "text": "他先去了那个"
  },
  {
    "start": 224.94,
    "end": 227.44,
    "text": "贝尔实验室的商业分析系统中心"
  },
  {
    "start": 227.44,
    "end": 229.6,
    "text": "在那里他接触到了软件设计"
  },
  {
    "start": 229.6,
    "end": 230.62,
    "text": "而且书里说"
  },
  {
    "start": 230.62,
    "end": 232.94,
    "text": "他发现把逻辑转化为代码"
  },
  {
    "start": 232.94,
    "end": 233.76,
    "text": "其实很有趣"
  },
  {
    "start": 233.76,
    "end": 235.88,
    "text": "因为总是有程序要写"
  },
  {
    "start": 235.88,
    "end": 238.62,
    "text": "这是他工程化思维觉醒的关键事情"
  },
  {
    "start": 238.62,
    "end": 239.72,
    "text": "但是等等"
  },
  {
    "start": 239.72,
    "end": 241.54,
    "text": "这里真的特别有意思"
  },
  {
    "start": 241.54,
    "end": 244.6,
    "text": "一个探究绝对真理的物理学家"
  },
  {
    "start": 244.6,
    "end": 246.1,
    "text": "脑子里都是量子力学"
  },
  {
    "start": 246.1,
    "end": 248.7,
    "text": "居然在写世俗的商业代码中"
  },
  {
    "start": 248.7,
    "end": 249.5,
    "text": "找到了快感"
  },
  {
    "start": 249.5,
    "end": 251.06,
    "text": "听起来反差极大"
  },
  {
    "start": 251.06,
    "end": 251.44,
    "text": "对吧"
  },
  {
    "start": 251.44,
    "end": 254.24,
    "text": "但如果我们从认知成长的大图景来看"
  },
  {
    "start": 254.24,
    "end": 255.24,
    "text": "这就说得通了"
  },
  {
    "start": 255.24,
    "end": 257.54,
    "text": "专业训练能不能成功迁移"
  },
  {
    "start": 257.54,
    "end": 258.8,
    "text": "取决于心理欲"
  },
  {
    "start": 258.8,
    "end": 260.3,
    "text": "有没有具体的现实问题"
  },
  {
    "start": 260.3,
    "end": 262.0,
    "text": "让你的知识发挥作用"
  },
  {
    "start": 262.0,
    "end": 262.32,
    "text": "哦"
  },
  {
    "start": 262.32,
    "end": 264.48,
    "text": "就是屠龙之计得找到龙"
  },
  {
    "start": 264.48,
    "end": 264.84,
    "text": "没错"
  },
  {
    "start": 264.84,
    "end": 266.26,
    "text": "在软件工程里"
  },
  {
    "start": 266.26,
    "end": 268.04,
    "text": "你写下一行正确的代码"
  },
  {
    "start": 268.04,
    "end": 270.34,
    "text": "系统立刻给你一个跑通的反馈"
  },
  {
    "start": 270.34,
    "end": 271.98,
    "text": "物理学赋予它的那种"
  },
  {
    "start": 271.98,
    "end": 273.98,
    "text": "拆解复杂事物的逻辑建模能力"
  },
  {
    "start": 273.98,
    "end": 275.86,
    "text": "在代码里找到了落脚点"
  },
  {
    "start": 275.86,
    "end": 278.74,
    "text": "虽然贝尔实验室那种大机构的组织层级"
  },
  {
    "start": 278.74,
    "end": 279.94,
    "text": "也会让他觉得舒服"
  },
  {
    "start": 279.94,
    "end": 281.7,
    "text": "肯定会有官僚气息"
  },
  {
    "start": 281.7,
    "end": 283.46,
    "text": "但正是这段实操经历"
  },
  {
    "start": 283.46,
    "end": 284.86,
    "text": "为他后来在金融界"
  },
  {
    "start": 284.86,
    "end": 286.7,
    "text": "把那些复杂的金融直觉"
  },
  {
    "start": 286.7,
    "end": 288.28,
    "text": "封装成模块化软件"
  },
  {
    "start": 288.28,
    "end": 289.68,
    "text": "打下了基础"
  },
  {
    "start": 289.68,
    "end": 290.3,
    "text": "明白了"
  },
  {
    "start": 290.3,
    "end": 291.78,
    "text": "带着这种工程能力"
  },
  {
    "start": 291.78,
    "end": 293.0,
    "text": "到了1985年"
  },
  {
    "start": 293.0,
    "end": 294.66,
    "text": "德曼正式踏入华尔街"
  },
  {
    "start": 294.66,
    "end": 296.54,
    "text": "进了高盛的金融策略小组"
  },
  {
    "start": 296.54,
    "end": 297.08,
    "text": "对"
  },
  {
    "start": 297.08,
    "end": 299.32,
    "text": "开始接触期权和数量金融"
  },
  {
    "start": 299.32,
    "end": 301.5,
    "text": "也就是咱们说的金融工程"
  },
  {
    "start": 301.5,
    "end": 302.92,
    "text": "那他的日常工作节奏"
  },
  {
    "start": 302.92,
    "end": 304.12,
    "text": "岂不是完全变了"
  },
  {
    "start": 304.12,
    "end": 305.18,
    "text": "翻天覆地"
  },
  {
    "start": 305.18,
    "end": 306.98,
    "text": "不再是盯着黑板发呆"
  },
  {
    "start": 306.98,
    "end": 308.36,
    "text": "而是每天写程序"
  },
  {
    "start": 308.36,
    "end": 309.5,
    "text": "设计交易界面"
  },
  {
    "start": 309.5,
    "end": 311.0,
    "text": "实时计算征券价值"
  },
  {
    "start": 311.0,
    "end": 312.14,
    "text": "但是听到这里"
  },
  {
    "start": 312.14,
    "end": 313.16,
    "text": "我必须要替听众"
  },
  {
    "start": 313.16,
    "end": 314.22,
    "text": "问一个尖锐的问题"
  },
  {
    "start": 314.22,
    "end": 315.68,
    "text": "物理学的数学"
  },
  {
    "start": 315.68,
    "end": 316.76,
    "text": "是为了解释自然"
  },
  {
    "start": 316.76,
    "end": 318.32,
    "text": "那华尔街的数学呢"
  },
  {
    "start": 318.32,
    "end": 319.3,
    "text": "难道只是为了"
  },
  {
    "start": 319.3,
    "end": 320.2,
    "text": "给一个金融产品"
  },
  {
    "start": 320.2,
    "end": 321.18,
    "text": "贴上价格标签吗"
  },
  {
    "start": 321.18,
    "end": 322.84,
    "text": "这两者的本质区别"
  },
  {
    "start": 322.84,
    "end": 323.5,
    "text": "到底是什么"
  },
  {
    "start": 323.5,
    "end": 325.24,
    "text": "这个问题特别核心"
  },
  {
    "start": 325.24,
    "end": 326.82,
    "text": "本质区别就在于"
  },
  {
    "start": 326.82,
    "end": 328.12,
    "text": "他们面对的裁判"
  },
  {
    "start": 328.12,
    "end": 328.94,
    "text": "完全不同"
  },
  {
    "start": 328.94,
    "end": 329.78,
    "text": "怎么讲"
  },
  {
    "start": 329.78,
    "end": 331.3,
    "text": "物理学模型的裁判"
  },
  {
    "start": 331.3,
    "end": 332.78,
    "text": "是客观的自然规律"
  },
  {
    "start": 332.78,
    "end": 333.34,
    "text": "万有引力"
  },
  {
    "start": 333.34,
    "end": 334.58,
    "text": "不管你信不信都在那"
  },
  {
    "start": 334.58,
    "end": 336.42,
    "text": "但华尔街的数学"
  },
  {
    "start": 336.42,
    "end": 337.82,
    "text": "既提供计算框架"
  },
  {
    "start": 337.82,
    "end": 339.7,
    "text": "也必须接受市场报价"
  },
  {
    "start": 339.7,
    "end": 341.62,
    "text": "和实际用途的残酷检验"
  },
  {
    "start": 341.62,
    "end": 343.3,
    "text": "也就是市场说了算"
  },
  {
    "start": 343.3,
    "end": 343.86,
    "text": "对"
  },
  {
    "start": 343.86,
    "end": 345.42,
    "text": "定价工具的价值"
  },
  {
    "start": 345.42,
    "end": 346.5,
    "text": "完全取决于"
  },
  {
    "start": 346.5,
    "end": 347.76,
    "text": "它能解决什么具体问题"
  },
  {
    "start": 347.76,
    "end": 349.02,
    "text": "以及它的成立条件"
  },
  {
    "start": 349.02,
    "end": 350.18,
    "text": "华尔街不在乎"
  },
  {
    "start": 350.18,
    "end": 350.68,
    "text": "你的公式"
  },
  {
    "start": 350.68,
    "end": 352.3,
    "text": "是不是像诗一样优雅"
  },
  {
    "start": 352.3,
    "end": 353.1,
    "text": "只在乎"
  },
  {
    "start": 353.1,
    "end": 354.84,
    "text": "他能不能帮交易员赚钱"
  },
  {
    "start": 354.84,
    "end": 356.04,
    "text": "或者避开爆仓"
  },
  {
    "start": 356.04,
    "end": 357.06,
    "text": "哇"
  },
  {
    "start": 357.06,
    "end": 359.48,
    "text": "这听起来完全不是一群天才"
  },
  {
    "start": 359.48,
    "end": 360.96,
    "text": "在黑板前写公式"
  },
  {
    "start": 360.96,
    "end": 362.24,
    "text": "而更像是在一个"
  },
  {
    "start": 362.24,
    "end": 364.44,
    "text": "充满利益博弈的庞大机器里"
  },
  {
    "start": 364.44,
    "end": 366.0,
    "text": "拼命找自己的位置"
  },
  {
    "start": 366.0,
    "end": 367.74,
    "text": "就是丛林法则"
  },
  {
    "start": 367.74,
    "end": 369.78,
    "text": "这就引发了宽客和交易员"
  },
  {
    "start": 369.78,
    "end": 371.86,
    "text": "这两种文化的激烈碰撞"
  },
  {
    "start": 371.86,
    "end": 373.18,
    "text": "互相看不顺眼"
  },
  {
    "start": 373.18,
    "end": 373.82,
    "text": "肯定"
  },
  {
    "start": 373.82,
    "end": 375.22,
    "text": "理论模型"
  },
  {
    "start": 375.22,
    "end": 377.34,
    "text": "数值实现和交易用途之间"
  },
  {
    "start": 377.34,
    "end": 378.22,
    "text": "互相拉扯"
  },
  {
    "start": 378.22,
    "end": 379.38,
    "text": "物理学家觉得"
  },
  {
    "start": 379.38,
    "end": 381.54,
    "text": "交易员像全凭直觉的赌徒"
  },
  {
    "start": 381.54,
    "end": 384.84,
    "text": "交易员估计觉得宽客都是书呆子"
  },
  {
    "start": 384.84,
    "end": 385.08,
    "text": "对"
  },
  {
    "start": 385.08,
    "end": 388.0,
    "text": "而且华尔街的报酬逻辑极其现实"
  },
  {
    "start": 388.0,
    "end": 390.06,
    "text": "按直接的交易收入论英雄"
  },
  {
    "start": 390.06,
    "end": 391.84,
    "text": "宽客作为研发人员"
  },
  {
    "start": 391.84,
    "end": 394.54,
    "text": "你的贡献很难像交易员那样精准伎俩"
  },
  {
    "start": 394.54,
    "end": 396.88,
    "text": "和蛮分钱就很容易出矛盾"
  },
  {
    "start": 396.88,
    "end": 397.16,
    "text": "是的"
  },
  {
    "start": 397.16,
    "end": 399.96,
    "text": "所以德曼期间在所罗门兄弟公司呢"
  },
  {
    "start": 399.96,
    "end": 401.8,
    "text": "就经历了这种文化失配"
  },
  {
    "start": 401.8,
    "end": 402.96,
    "text": "甚至遭遇裁员"
  },
  {
    "start": 402.96,
    "end": 404.74,
    "text": "之后才有重返高手"
  },
  {
    "start": 404.74,
    "end": 405.72,
    "text": "所以说"
  },
  {
    "start": 405.72,
    "end": 408.86,
    "text": "金融模型从来都不是在真空中运行的"
  },
  {
    "start": 408.86,
    "end": 409.48,
    "text": "没错"
  },
  {
    "start": 409.48,
    "end": 414.66,
    "text": "市场是由交易者各种制度和极大的不确定性共同构成的"
  },
  {
    "start": 414.66,
    "end": 419.82,
    "text": "这也暗示了纯粹的数学模型必然会与复杂的人类行为发生摩擦"
  },
  {
    "start": 419.82,
    "end": 421.06,
    "text": "说到摩擦"
  },
  {
    "start": 421.06,
    "end": 423.36,
    "text": "书里最让我大开眼界的一幕"
  },
  {
    "start": 423.36,
    "end": 426.46,
    "text": "也就是第十四章重点描写的暗中笑者"
  },
  {
    "start": 426.46,
    "end": 430.26,
    "text": "这就是理论撞上现实时最惨烈的车祸现场吧"
  },
  {
    "start": 430.26,
    "end": 431.16,
    "text": "哈哈对"
  },
  {
    "start": 431.16,
    "end": 433.74,
    "text": "金融界管这叫波动率微笑"
  },
  {
    "start": 433.74,
    "end": 435.84,
    "text": "给大家简单解释一下"
  },
  {
    "start": 435.84,
    "end": 437.86,
    "text": "原本那套完美的模型"
  },
  {
    "start": 437.86,
    "end": 439.68,
    "text": "有个雷打不动的假设"
  },
  {
    "start": 439.68,
    "end": 442.64,
    "text": "就是市场的波动是一个恒定的常数"
  },
  {
    "start": 442.64,
    "end": 445.38,
    "text": "画出来应该是一条水平的直线"
  },
  {
    "start": 445.38,
    "end": 446.22,
    "text": "但现实中"
  },
  {
    "start": 446.22,
    "end": 449.58,
    "text": "德曼和同事一拉结去观察市场实际报价时"
  },
  {
    "start": 449.58,
    "end": 450.94,
    "text": "发现根本不是直线"
  },
  {
    "start": 450.94,
    "end": 454.18,
    "text": "是一条两端高高翘起的弧线"
  },
  {
    "start": 454.18,
    "end": 456.08,
    "text": "像个在暗中诡异微笑的人"
  },
  {
    "start": 456.08,
    "end": 459.8,
    "text": "也就是说市场报价和完美的数学模型假设"
  },
  {
    "start": 459.8,
    "end": 461.46,
    "text": "出现了严重的撕裂"
  },
  {
    "start": 461.46,
    "end": 461.84,
    "text": "没错"
  },
  {
    "start": 461.84,
    "end": 463.72,
    "text": "那我就有个疑问了"
  },
  {
    "start": 463.72,
    "end": 466.16,
    "text": "当市场报价和模型打架的时候"
  },
  {
    "start": 466.16,
    "end": 467.56,
    "text": "物理学家的直觉"
  },
  {
    "start": 467.56,
    "end": 469.6,
    "text": "不是应该觉得数据错了吗"
  },
  {
    "start": 469.6,
    "end": 472.74,
    "text": "如果在实验室里观测偏离了多少个标准差"
  },
  {
    "start": 472.74,
    "end": 474.48,
    "text": "他们肯定觉得是仪器坏了"
  },
  {
    "start": 474.48,
    "end": 474.76,
    "text": "对吧"
  },
  {
    "start": 474.76,
    "end": 477.84,
    "text": "为什么在这里他们必须妥协去修正模型"
  },
  {
    "start": 477.84,
    "end": 480.52,
    "text": "这就揭示了自然科学和社会科学"
  },
  {
    "start": 480.52,
    "end": 482.26,
    "text": "那道无法跨越的鸿沟了"
  },
  {
    "start": 482.26,
    "end": 483.88,
    "text": "物理有绝对规律"
  },
  {
    "start": 483.88,
    "end": 486.32,
    "text": "所以偏离的观测可能是错的"
  },
  {
    "start": 486.32,
    "end": 488.4,
    "text": "但金融市场没有绝对规律"
  },
  {
    "start": 488.4,
    "end": 490.4,
    "text": "因为价格是人交易出来的"
  },
  {
    "start": 490.4,
    "end": 490.98,
    "text": "对呀"
  },
  {
    "start": 490.98,
    "end": 492.7,
    "text": "如果报价不符合模型"
  },
  {
    "start": 492.7,
    "end": 494.48,
    "text": "错的只能是你的模型"
  },
  {
    "start": 494.48,
    "end": 496.34,
    "text": "市场永远是对的"
  },
  {
    "start": 496.34,
    "end": 498.16,
    "text": "那他们怎么解决这个崩溃局面的"
  },
  {
    "start": 498.16,
    "end": 501.32,
    "text": "德卖用了一种物理学里的现象学方法"
  },
  {
    "start": 501.32,
    "end": 503.16,
    "text": "他们开发了局部波动率方法"
  },
  {
    "start": 503.16,
    "end": 505.46,
    "text": "这个校准过程极其困难"
  },
  {
    "start": 505.46,
    "end": 507.74,
    "text": "就是硬生生把完美的公式掰弯"
  },
  {
    "start": 507.74,
    "end": 509.84,
    "text": "去贴合乱七八糟的现实数据"
  },
  {
    "start": 509.84,
    "end": 510.38,
    "text": "对"
  },
  {
    "start": 510.38,
    "end": 512.54,
    "text": "不强求底层的绝对真理了"
  },
  {
    "start": 512.54,
    "end": 514.44,
    "text": "而是从观察到的现象出发"
  },
  {
    "start": 514.44,
    "end": 516.94,
    "text": "建立局部的实用的经验规则"
  },
  {
    "start": 516.94,
    "end": 518.38,
    "text": "只要今天能用"
  },
  {
    "start": 518.38,
    "end": 519.44,
    "text": "就是好模型"
  },
  {
    "start": 519.44,
    "end": 521.54,
    "text": "从追求终极真理"
  },
  {
    "start": 521.54,
    "end": 524.02,
    "text": "到愿意俯下身建立不完美的规则"
  },
  {
    "start": 524.02,
    "end": 526.5,
    "text": "这真是个痛苦的思想蜕变"
  },
  {
    "start": 526.5,
    "end": 528.78,
    "text": "后来到了2003年的7月"
  },
  {
    "start": 528.78,
    "end": 530.52,
    "text": "他重返哥伦比亚大学"
  },
  {
    "start": 530.52,
    "end": 531.78,
    "text": "担任金融工程教授"
  },
  {
    "start": 531.78,
    "end": 533.64,
    "text": "算是画了个完整的缘"
  },
  {
    "start": 533.64,
    "end": 535.8,
    "text": "从求学到工业界"
  },
  {
    "start": 535.8,
    "end": 536.82,
    "text": "再到华尔界"
  },
  {
    "start": 536.82,
    "end": 538.08,
    "text": "最后重返校园"
  },
  {
    "start": 538.08,
    "end": 540.4,
    "text": "他得出了一个最终的领悟"
  },
  {
    "start": 540.4,
    "end": 541.22,
    "text": "什么领悟"
  },
  {
    "start": 541.22,
    "end": 544.4,
    "text": "物理学模型探寻的是客观自然规律"
  },
  {
    "start": 544.4,
    "end": 545.86,
    "text": "而金融模型"
  },
  {
    "start": 545.86,
    "end": 548.52,
    "text": "只是对人类心理与市场行为的"
  },
  {
    "start": 548.52,
    "end": 550.64,
    "text": "近似思想实验"
  },
  {
    "start": 550.64,
    "end": 552.38,
    "text": "哦 模型只是模型"
  },
  {
    "start": 552.38,
    "end": 554.1,
    "text": "对 并不是实情本身"
  },
  {
    "start": 554.1,
    "end": 555.16,
    "text": "其实我觉得"
  },
  {
    "start": 555.16,
    "end": 558.08,
    "text": "今天我们面对AI和各种算法工具时"
  },
  {
    "start": 558.08,
    "end": 559.58,
    "text": "也特别需要这种清醒"
  },
  {
    "start": 559.58,
    "end": 560.6,
    "text": "太需要了"
  },
  {
    "start": 560.6,
    "end": 563.7,
    "text": "我们应该把AI视为辅助思考的思想实验"
  },
  {
    "start": 563.7,
    "end": 566.02,
    "text": "时刻去检验它的局限性"
  },
  {
    "start": 566.02,
    "end": 567.22,
    "text": "而不是奉若神明"
  },
  {
    "start": 567.22,
    "end": 568.78,
    "text": "就像判断一个模型"
  },
  {
    "start": 568.78,
    "end": 570.68,
    "text": "得先问它解决什么问题"
  },
  {
    "start": 570.68,
    "end": 571.84,
    "text": "依赖什么假设"
  },
  {
    "start": 571.84,
    "end": 573.1,
    "text": "什么条件下使用"
  },
  {
    "start": 573.1,
    "end": 575.32,
    "text": "对 不能因为外表复杂"
  },
  {
    "start": 575.32,
