[
  {
    "start": 0.0,
    "end": 2.38,
    "text": "带着书本按图索记去远行"
  },
  {
    "start": 2.38,
    "end": 5.18,
    "text": "为什么往往会遇到完全意料之外的现实"
  },
  {
    "start": 5.18,
    "end": 7.76,
    "text": "你想象一下这样一个画面"
  },
  {
    "start": 7.76,
    "end": 10.72,
    "text": "就是你飞了成千上万公里"
  },
  {
    "start": 10.72,
    "end": 11.58,
    "text": "到了伦敦"
  },
  {
    "start": 11.58,
    "end": 13.86,
    "text": "满心欢喜的走进一家餐馆"
  },
  {
    "start": 13.86,
    "end": 15.2,
    "text": "按照手里那本"
  },
  {
    "start": 15.2,
    "end": 16.76,
    "text": "奉为闺孽的指南"
  },
  {
    "start": 16.76,
    "end": 17.7,
    "text": "点了一道"
  },
  {
    "start": 17.7,
    "end": 21.5,
    "text": "你以为是当地特色炸羊肠的料理"
  },
  {
    "start": 21.5,
    "end": 22.76,
    "text": "听起来还挺期待的"
  },
  {
    "start": 22.76,
    "end": 22.98,
    "text": "对"
  },
  {
    "start": 22.98,
    "end": 24.24,
    "text": "结果你一边叫"
  },
  {
    "start": 24.24,
    "end": 26.08,
    "text": "一边觉得口感异常诡异"
  },
  {
    "start": 26.08,
    "end": 28.38,
    "text": "最后找来试着反复确认"
  },
  {
    "start": 28.38,
    "end": 30.98,
    "text": "才发现自己吃下去的根本不是肠子"
  },
  {
    "start": 30.98,
    "end": 31.98,
    "text": "而是羊狗丸"
  },
  {
    "start": 31.98,
    "end": 33.12,
    "text": "天哪"
  },
  {
    "start": 33.12,
    "end": 34.46,
    "text": "这反差也太大了"
  },
  {
    "start": 34.46,
    "end": 35.38,
    "text": "是吧"
  },
  {
    "start": 35.38,
    "end": 36.52,
    "text": "而这一切"
  },
  {
    "start": 36.52,
    "end": 38.32,
    "text": "仅仅是因为那本指南上"
  },
  {
    "start": 38.32,
    "end": 39.54,
    "text": "拼错了一个单词"
  },
  {
    "start": 39.54,
    "end": 42.46,
    "text": "这就是我们今天要深入探讨的"
  },
  {
    "start": 42.46,
    "end": 45.1,
    "text": "当我们试图用前人写下的文字"
  },
  {
    "start": 45.1,
    "end": 46.64,
    "text": "去框定现实时"
  },
  {
    "start": 46.64,
    "end": 48.22,
    "text": "那种荒诞"
  },
  {
    "start": 48.22,
    "end": 48.74,
    "text": "危险"
  },
  {
    "start": 48.74,
    "end": 50.72,
    "text": "有迷人的错位感"
  },
  {
    "start": 50.72,
    "end": 51.88,
    "text": "确实"
  },
  {
    "start": 51.88,
    "end": 53.38,
    "text": "这个吃错东西的例子"
  },
  {
    "start": 53.38,
    "end": 55.82,
    "text": "简直是旅行中最鲜活的一个隐喻了"
  },
  {
    "start": 55.82,
    "end": 57.42,
    "text": "其实当我们翻开"
  },
  {
    "start": 57.42,
    "end": 59.42,
    "text": "张洪志的旅行与读书时"
  },
  {
    "start": 59.42,
    "end": 61.96,
    "text": "这种文字与现实之间的巨大张力"
  },
  {
    "start": 61.96,
    "end": 63.58,
    "text": "可以说是贯穿始终的"
  },
  {
    "start": 63.58,
    "end": 64.38,
    "text": "嗯嗯"
  },
  {
    "start": 64.38,
    "end": 66.04,
    "text": "这里真正令人着迷的"
  },
  {
    "start": 66.04,
    "end": 68.98,
    "text": "是他提出了一个非常深刻的核心洞察"
  },
  {
    "start": 68.98,
    "end": 69.96,
    "text": "就是说"
  },
  {
    "start": 69.96,
    "end": 71.6,
    "text": "我们每个人的出生时空"
  },
  {
    "start": 71.6,
    "end": 74.1,
    "text": "在降临那一刻就已经被彻底锁定了"
  },
  {
    "start": 74.1,
    "end": 76.04,
    "text": "你只能生活在这个时代"
  },
  {
    "start": 76.04,
    "end": 77.36,
    "text": "这个具体的坐标上"
  },
  {
    "start": 77.36,
    "end": 77.96,
    "text": "对"
  },
  {
    "start": 77.96,
    "end": 78.84,
    "text": "没法选嘛"
  },
  {
    "start": 78.84,
    "end": 79.62,
    "text": "没错"
  },
  {
    "start": 79.62,
    "end": 82.26,
    "text": "所以对于一个充满好奇心的人来说"
  },
  {
    "start": 82.26,
    "end": 84.28,
    "text": "单一的人生总让人觉得不够"
  },
  {
    "start": 84.28,
    "end": 85.42,
    "text": "甚至是匮乏的"
  },
  {
    "start": 85.42,
    "end": 88.7,
    "text": "但是如果把阅读和旅行结合起来"
  },
  {
    "start": 88.7,
    "end": 89.52,
    "text": "我们就能"
  },
  {
    "start": 89.52,
    "end": 90.42,
    "text": "怎么说呢"
  },
  {
    "start": 90.42,
    "end": 92.62,
    "text": "暂时的化身为另一种生活"
  },
  {
    "start": 92.62,
    "end": 94.2,
    "text": "从而拥有不止一个人生"
  },
  {
    "start": 94.2,
    "end": 97.66,
    "text": "这就像是拿到了一把解开时空枷锁的钥匙"
  },
  {
    "start": 97.66,
    "end": 99.18,
    "text": "哎呀"
  },
  {
    "start": 99.18,
    "end": 101.16,
    "text": "这把要事的诱惑力确实很大"
  },
  {
    "start": 101.16,
    "end": 103.74,
    "text": "但这就让我特别好奇了"
  },
  {
    "start": 103.74,
    "end": 105.16,
    "text": "对于他来说"
  },
  {
    "start": 105.16,
    "end": 107.38,
    "text": "一场旅行到底是怎么开始的"
  },
  {
    "start": 107.38,
    "end": 108.92,
    "text": "你想想看啊"
  },
  {
    "start": 108.92,
    "end": 111.56,
    "text": "现在的我们是怎么决定去哪里旅行的"
  },
  {
    "start": 111.56,
    "end": 114.16,
    "text": "大概率是晚上躺在床上刷手机"
  },
  {
    "start": 114.16,
    "end": 116.34,
    "text": "看到一个够读精美的短视频"
  },
  {
    "start": 116.34,
    "end": 116.56,
    "text": "对"
  },
  {
    "start": 116.56,
    "end": 117.96,
    "text": "或者别人发的美图"
  },
  {
    "start": 117.96,
    "end": 118.56,
    "text": "是的"
  },
  {
    "start": 118.56,
    "end": 121.44,
    "text": "或者一篇图文并茂的打卡攻略"
  },
  {
    "start": 121.44,
    "end": 123.64,
    "text": "然后脑子一热就决定订机票了"
  },
  {
    "start": 123.64,
    "end": 125.6,
    "text": "我们现在的旅行"
  },
  {
    "start": 125.6,
    "end": 128.12,
    "text": "往往是为了去验证那个视频里的风景"
  },
  {
    "start": 128.12,
    "end": 130.32,
    "text": "是不是真的存在"
  },
  {
    "start": 130.32,
    "end": 131.02,
    "text": "但它不一样"
  },
  {
    "start": 131.02,
    "end": 133.92,
    "text": "它的出发点往往是因为一本书"
  },
  {
    "start": 133.92,
    "end": 134.36,
    "text": "没错"
  },
  {
    "start": 134.36,
    "end": 136.76,
    "text": "书本成了最强大的动机"
  },
  {
    "start": 136.76,
    "end": 139.2,
    "text": "它里边有一个特别有画面感的细节"
  },
  {
    "start": 139.2,
    "end": 142.96,
    "text": "就是在非洲津巴布围那一侧的维多利亚瀑布旅馆里"
  },
  {
    "start": 142.96,
    "end": 144.66,
    "text": "他独自坐在酒吧中"
  },
  {
    "start": 144.66,
    "end": 147.86,
    "text": "特意点了一杯名叫我推测的鸡尾酒"
  },
  {
    "start": 147.86,
    "end": 149.3,
    "text": "我推测"
  },
  {
    "start": 149.3,
    "end": 151.14,
    "text": "这名字挺怪的"
  },
  {
    "start": 151.14,
    "end": 151.32,
    "text": "对"
  },
  {
    "start": 151.32,
    "end": 153.06,
    "text": "这个名字可不是随便起的"
  },
  {
    "start": 153.06,
    "end": 156.1,
    "text": "他其实是在致敬当年探险家斯坦利"
  },
  {
    "start": 156.1,
    "end": 158.34,
    "text": "就是斯坦利在非洲丛林深处"
  },
  {
    "start": 158.34,
    "end": 159.76,
    "text": "历经千辛万苦"
  },
  {
    "start": 159.76,
    "end": 162.06,
    "text": "终于找到失踪已久的李文斯顿时"
  },
  {
    "start": 162.06,
    "end": 164.28,
    "text": "试探性的问出的那句历史名言"
  },
  {
    "start": 164.28,
    "end": 165.68,
    "text": "李文斯顿一声"
  },
  {
    "start": 165.68,
    "end": 167.18,
    "text": "我推测"
  },
  {
    "start": 167.18,
    "end": 167.7,
    "text": "哦"
  },
  {
    "start": 167.7,
    "end": 169.1,
    "text": "原来是这样"
  },
  {
    "start": 169.1,
    "end": 169.6,
    "text": "是的"
  },
  {
    "start": 169.6,
    "end": 172.34,
    "text": "作者正是因为读了李文斯顿的探险故事"
  },
  {
    "start": 172.34,
    "end": 175.06,
    "text": "才被一路牵引到了那个具体的地理坐标"
  },
  {
    "start": 175.06,
    "end": 176.2,
    "text": "坐在那里"
  },
  {
    "start": 176.2,
    "end": 177.12,
    "text": "喝下那杯酒"
  },
  {
    "start": 177.12,
    "end": 180.82,
    "text": "其实就是在和历史文本进行一次跨越时空的干杯"
  },
  {
    "start": 180.82,
    "end": 181.56,
    "text": "哇"
  },
  {
    "start": 181.56,
    "end": 182.84,
    "text": "很有仪式感"
  },
  {
    "start": 182.84,
    "end": 183.9,
    "text": "但是等等"
  },
  {
    "start": 183.9,
    "end": 185.34,
    "text": "这里有一个逻辑"
  },
  {
    "start": 185.34,
    "end": 186.72,
    "text": "我会觉得有点矛盾哈"
  },
  {
    "start": 186.72,
    "end": 189.28,
    "text": "如果完全照着书去旅行"
  },
  {
    "start": 189.28,
    "end": 193.26,
    "text": "这难道不就成了抄别人的行程表吗"
  },
  {
    "start": 193.26,
    "end": 194.14,
    "text": "怎么说"
  },
  {
    "start": 194.14,
    "end": 195.36,
    "text": "你想啊"
  },
  {
    "start": 195.36,
    "end": 197.66,
    "text": "现在的年轻人跟着网上的攻略走"
  },
  {
    "start": 197.66,
    "end": 200.62,
    "text": "经常被批评说失去了旅行的意义"
  },
  {
    "start": 200.62,
    "end": 202.58,
    "text": "那跟着几百年前的探险家"
  },
  {
    "start": 202.58,
    "end": 204.3,
    "text": "或者几十年前的作家走"
  },
  {
    "start": 204.3,
    "end": 208.34,
    "text": "本质上不也是把别人的邮寄当成了自己的打卡清单吗"
  },
  {
    "start": 208.34,
    "end": 209.24,
    "text": "这有什么区别"
  },
  {
    "start": 209.24,
    "end": 211.38,
    "text": "你的这个质疑非常关键"
  },
  {
    "start": 211.38,
    "end": 213.42,
    "text": "这也是很多人容易误解的地方"
  },
  {
    "start": 213.42,
    "end": 215.52,
    "text": "如果把书当成说明书"
  },
  {
    "start": 215.52,
    "end": 217.26,
    "text": "那确实是高级一点的打卡"
  },
  {
    "start": 217.26,
    "end": 220.1,
    "text": "但这恰恰是作者最恐惧的事情"
  },
  {
    "start": 220.1,
    "end": 220.82,
    "text": "哦"
  },
  {
    "start": 220.82,
    "end": 221.94,
    "text": "他很怕这个"
  },
  {
    "start": 221.94,
    "end": 222.62,
    "text": "对"
  },
  {
    "start": 222.62,
    "end": 225.66,
    "text": "他极其反感那种既定的观光行程"
  },
  {
    "start": 225.66,
    "end": 226.56,
    "text": "我们要知道"
  },
  {
    "start": 226.56,
    "end": 228.86,
    "text": "这位作者在出版行业磨爬滚打"
  },
  {
    "start": 228.86,
    "end": 229.98,
    "text": "当过总编辑"
  },
  {
    "start": 229.98,
    "end": 230.82,
    "text": "做过总经理"
  },
  {
    "start": 230.82,
    "end": 231.92,
    "text": "甚至监制过电影"
  },
  {
    "start": 231.92,
    "end": 236.12,
    "text": "他算是一个大半辈子拥有过几百张名片的跨界行家了"
  },
  {
    "start": 236.12,
    "end": 238.02,
    "text": "履历非常厚重"
  },
  {
    "start": 238.02,
    "end": 238.58,
    "text": "没错"
  },
  {
    "start": 238.58,
    "end": 242.18,
    "text": "所以当这样一个人决定写一本关于旅行的书时"
  },
  {
    "start": 242.18,
    "end": 245.68,
    "text": "他在成书阶段做了一个常人难以想象的决绝动作"
  },
  {
    "start": 245.68,
    "end": 248.6,
    "text": "就是在大刀阔斧的编辑过程中"
  },
  {
    "start": 248.6,
    "end": 251.14,
    "text": "他狠狠删去了三分之一的篇幅"
  },
  {
    "start": 251.14,
    "end": 253.18,
    "text": "最后只留下二十万字"
  },
  {
    "start": 253.18,
    "end": 254.86,
    "text": "肯定要这么大体量"
  },
  {
    "start": 254.86,
    "end": 257.04,
    "text": "那他删掉的到底是什么呀"
  },
  {
    "start": 257.04,
    "end": 259.38,
    "text": "他拿掉了所有的论述文章"
  },
  {
    "start": 259.38,
    "end": 262.68,
    "text": "完全剥离了任何实用的路线指导"
  },
  {
    "start": 262.68,
    "end": 263.14,
    "text": "也就是说"
  },
  {
    "start": 263.14,
    "end": 266.96,
    "text": "你根本不可能拿着这本书当作攻略去照毛画虎"
  },
  {
    "start": 266.96,
    "end": 267.96,
    "text": "明白了"
  },
  {
    "start": 267.96,
    "end": 269.74,
    "text": "他真正想做的"
  },
  {
    "start": 269.74,
    "end": 272.24,
    "text": "是卸下所谓的家乡之壳"
  },
  {
    "start": 272.24,
    "end": 273.64,
    "text": "履历对他来说"
  },
  {
    "start": 273.64,
    "end": 277.02,
    "text": "不是把家里的生活习惯平移到另一个风景里"
  },
  {
    "start": 277.02,
    "end": 278.92,
    "text": "而是剥离掉日常生活中"
  },
  {
    "start": 278.92,
    "end": 280.24,
    "text": "那些固有的身份"
  },
  {
    "start": 280.24,
    "end": 281.5,
    "text": "头衔和偏见"
  },
  {
    "start": 281.5,
    "end": 283.18,
    "text": "带着纯粹的好奇心"
  },
  {
    "start": 283.18,
    "end": 285.7,
    "text": "去想象并体验他者的生活"
  },
  {
    "start": 285.7,
    "end": 287.14,
    "text": "我懂了"
  },
  {
    "start": 287.14,
    "end": 290.52,
    "text": "这其实有点像演员的那种体验派表演法"
  },
  {
    "start": 290.52,
    "end": 290.86,
    "text": "对吧"
  },
  {
    "start": 290.86,
    "end": 294.02,
    "text": "就是你不能只是穿上一套异国情调的戏服"
  },
  {
    "start": 294.02,
    "end": 297.74,
    "text": "你得在心里上彻底忘记自己的老家的默认设置"
  },
  {
    "start": 297.74,
    "end": 301.56,
    "text": "才能真正相信并融入你走进去的那个新现实"
  },
  {
    "start": 301.56,
    "end": 302.42,
    "text": "没错"
  },
  {
    "start": 302.42,
    "end": 304.3,
    "text": "形容的非常贴切"
  },
  {
    "start": 304.3,
    "end": 306.88,
    "text": "那有了这种近乎纯粹的动机"
  },
  {
    "start": 306.88,
    "end": 308.78,
    "text": "真正出发后会发生什么呢"
  },
  {
    "start": 308.78,
    "end": 312.56,
    "text": "让我们把场景直接拉到意大利的佛罗伦萨中央市场"
  },
  {
    "start": 312.56,
    "end": 313.72,
    "text": "开始不久"
  },
  {
    "start": 313.72,
    "end": 316.46,
    "text": "一家名叫奈波奈的三明治摊前"
  },
  {
    "start": 316.46,
    "end": 318.8,
    "text": "已经挤满了鸡肠碌碌的时刻"
  },
  {
    "start": 318.8,
    "end": 320.44,
    "text": "他一路挤进去"
  },
  {
    "start": 320.44,
    "end": 322.72,
    "text": "直到能看清收银员眼白的地方"
  },
  {
    "start": 322.72,
    "end": 323.84,
    "text": "递过去一张大钞"
  },
  {
    "start": 323.84,
    "end": 325.16,
    "text": "画面感很强了"
  },
  {
    "start": 325.16,
    "end": 325.8,
    "text": "对"
  },
  {
    "start": 325.8,
    "end": 328.64,
    "text": "然后用自认为非常标准的意大利文"
  },
  {
    "start": 328.64,
    "end": 330.76,
    "text": "点名要了炖牛肠面包"
  },
  {
    "start": 330.76,
    "end": 331.94,
    "text": "煮牛肉面包"
  },
  {
    "start": 331.94,
    "end": 333.64,
    "text": "还配了基安地红酒"
  },
  {
    "start": 333.64,
    "end": 335.98,
    "text": "当时他手里紧紧攥着的"
  },
  {
    "start": 335.98,
    "end": 338.84,
    "text": "是一本美国旅行与美食记者写的"
  },
  {
    "start": 338.84,
    "end": 340.7,
    "text": "佛罗伦萨贪吃鬼指南"
  },
  {
    "start": 340.7,
    "end": 343.86,
    "text": "拿着外文指南在异国他乡点菜"
  },
  {
    "start": 343.86,
    "end": 345.28,
    "text": "这不仅需要勇气"
  },
  {
    "start": 345.28,
    "end": 347.48,
    "text": "还充满了一种确信的仪式感"
  },
  {
    "start": 347.48,
    "end": 349.4,
    "text": "他当时吃的津津有味"
  },
  {
    "start": 349.4,
    "end": 352.3,
    "text": "觉得自己完全融入了当地的美食秘境"
  },
  {
    "start": 352.3,
    "end": 354.48,
    "text": "仿佛掌握了某种不传之秘"
  },
  {
    "start": 354.48,
    "end": 355.56,
    "text": "对呀"
  },
  {
    "start": 355.56,
    "end": 356.98,
    "text": "那种感觉一定特别棒"
  },
  {
    "start": 356.98,
    "end": 359.22,
    "text": "觉得自己是个懂行的老涛了"
  },
  {
    "start": 359.22,
    "end": 360.28,
    "text": "结果呢"
  },
  {
    "start": 360.28,
    "end": 361.58,
    "text": "回家以后"
  },
  {
    "start": 361.58,
    "end": 362.82,
    "text": "他上网一插百科"
  },
  {
    "start": 362.82,
    "end": 364.56,
    "text": "瞬间傻眼了"
  },
  {
    "start": 364.56,
    "end": 366.3,
    "text": "发现真相了是吧"
  },
  {
    "start": 366.3,
    "end": 366.72,
    "text": "是的"
  },
  {
    "start": 366.72,
    "end": 370.42,
    "text": "原来因为书里的英文单词写错了"
  },
  {
    "start": 370.42,
    "end": 373.86,
    "text": "他一路奉为闺孽的所谓独特牛肠"
  },
  {
    "start": 373.86,
    "end": 375.74,
    "text": "根本不是什么罕见部位"
  },
  {
    "start": 375.74,
    "end": 376.84,
    "text": "其实就是牛肺"
  },
  {
    "start": 376.84,
    "end": 380.54,
    "text": "也就是佛罗伦萨满大街都有的牛肚三明治"
  },
  {
    "start": 380.54,
    "end": 383.94,
    "text": "这其实又印证了我们前面提到的那个"
  },
  {
    "start": 383.94,
    "end": 385.36,
    "text": "吃羊稿丸的笑话"
  },
  {
    "start": 385.36,
    "end": 388.82,
    "text": "文字在传递的过程中不仅会失真"
  },
  {
    "start": 388.82,
    "end": 392.08,
    "text": "还会给我们的感官加上一层厚厚的滤镜"
  },
  {
    "start": 392.08,
    "end": 394.0,
    "text": "这个细节啊"
  },
  {
    "start": 394.0,
    "end": 396.64,
    "text": "其实引出了一个非常核心且深刻的思辨"
  },
  {
    "start": 396.64,
    "end": 399.66,
    "text": "就是书写者究竟是忠于真实"
  },
  {
    "start": 399.66,
    "end": 401.04,
    "text": "还是在制造真实"
  },
  {
    "start": 401.04,
    "end": 403.1,
    "text": "我们在旅途中体验到的美味"
  },
  {
    "start": 403.1,
    "end": 405.1,
    "text": "到底是因为食物本身好吃"
  },
  {
    "start": 405.1,
    "end": 408.26,
    "text": "还是因为那本权威指南告诉我们它好吃"
  },
  {
    "start": 408.26,
    "end": 411.28,
    "text": "这是一个直击灵魂的问题啊"
  },
  {
    "start": 411.28,
    "end": 414.52,
    "text": "确实 不过尽管指南上的文字会出错"
  },
  {
    "start": 414.52,
    "end": 417.32,
    "text": "甚至会让你吃下完全意料之外的食物"
  },
  {
    "start": 417.32,
    "end": 422.02,
    "text": "但不可否认的是书本依然是一把极其有效的社交钥匙"
  },
  {
    "start": 422.02,
    "end": 424.32,
    "text": "没错 当书本兑现的时候"
  },
  {
    "start": 424.32,
    "end": 426.74,
    "text": "那种感觉简直像魔法一样"
  },
  {
    "start": 426.74,
    "end": 429.32,
    "text": "比如那本指南还推荐了一家叫"
  },
  {
    "start": 429.32,
    "end": 431.74,
    "text": "Tratoria Mario的小餐厅"
  },
  {
    "start": 431.74,
    "end": 434.0,
    "text": "指南里把它写得神乎气神"
  },
  {
    "start": 434.0,
    "end": 436.16,
    "text": "说虽然被很多书推荐过"
  },
  {
    "start": 436.16,
    "end": 438.56,
    "text": "但每天依然挤满了当地人"
  },
  {
    "start": 438.56,
    "end": 439.86,
    "text": "营业时间极短"
  },
  {
    "start": 439.86,
    "end": 440.98,
    "text": "而且不接受预定"
  },
  {
    "start": 440.98,
    "end": 443.26,
    "text": "对 当他赶到那里的时候"
  },
  {
    "start": 443.26,
    "end": 445.66,
    "text": "现实完全印证了文本的描写"
  },
  {
    "start": 445.66,
    "end": 447.28,
    "text": "门口排着长队"
  },
  {
    "start": 447.28,
    "end": 448.88,
    "text": "里面坐无虚席"
  },
  {
    "start": 448.88,
    "end": 451.88,
    "text": "按理说这种餐厅对游客是很冷淡的"
  },
  {
    "start": 451.88,
    "end": 454.56,
    "text": "但正是因为有了书本的指引和背书"
  },
  {
    "start": 454.56,
    "end": 456.12,
    "text": "他不仅没有被拒绝"
  },
  {
    "start": 456.12,
    "end": 458.9,
    "text": "反而体验到了一种奇妙的融入感"
  },
  {
    "start": 458.9,
    "end": 460.5,
    "text": "他们是怎么做的"
  },
  {
    "start": 460.5,
    "end": 462.82,
    "text": "女侍者特意为他们控除一张大桌"
  },
  {
    "start": 462.82,
    "end": 465.0,
    "text": "周围的食客甚至鼓起掌来"
  },
  {
    "start": 465.0,
    "end": 467.44,
    "text": "庆贺他们幸运的得到了座位"
  },
  {
    "start": 467.44,
    "end": 469.72,
    "text": "还有当地人热情的拉着他的衣服"
  },
  {
    "start": 469.72,
    "end": 473.04,
    "text": "叮嘱他绝对不能错过某道招牌意大利面"
  },
  {
    "start": 473.04,
    "end": 474.46,
    "text": "太温馨了"
  },
  {
    "start": 474.46,
    "end": 475.74,
    "text": "是的 在那一刻"
  },
  {
    "start": 475.74,
    "end": 479.32,
    "text": "书本确实替他推开了一国生活的一扇门"
  },
  {
    "start": 479.32,
    "end": 482.34,
    "text": "让他短暂的成为了那群热情食客中的一员"
  },
  {
    "start": 482.34,
    "end": 484.1,
    "text": "这种验证成功的快感"
  },
  {
    "start": 484.1,
    "end": 485.96,
    "text": "真的是很容易让人上瘾的"
  },
  {
    "start": 485.96,
    "end": 489.1,
    "text": "但这会不会也带来一种危险啊"
  },
  {
    "start": 489.1,
    "end": 491.42,
    "text": "就是如果文字写的非常有文采"
  },
  {
    "start": 491.42,
    "end": 492.68,
    "text": "像那本指南一样"
  },
  {
    "start": 492.68,
    "end": 494.7,
    "text": "把在三明治滩前挤来挤去"
  },
  {
    "start": 494.7,
    "end": 496.54,
    "text": "比做一场冲撞式运动"
  },
  {
    "start": 496.54,
    "end": 498.78,
    "text": "我们是不是就更容易失去警惕"
  },
  {
    "start": 498.78,
    "end": 501.08,
    "text": "对文字产生盲目的崇拜"
  },
  {
    "start": 501.08,
    "end": 502.32,
    "text": "绝对会"
  },
  {
    "start": 502.32,
    "end": 504.32,
    "text": "这是一个非常严肃的警示"
  },
  {
    "start": 504.32,
    "end": 506.6,
    "text": "文字写的越有诗意"
  },
  {
    "start": 506.6,
    "end": 507.5,
    "text": "越有文采"
  },
  {
    "start": 507.5,
    "end": 510.5,
    "text": "它在现实中可能设下的陷阱就越深"
  },
  {
    "start": 510.5,
    "end": 513.04,
    "text": "我们在现实中的查证就越要紧"
  },
  {
    "start": 513.04,
    "end": 515.58,
    "text": "大自然可不懂什么文学修辞"
  },
  {
    "start": 515.58,
    "end": 519.04,
    "text": "书中其实提到了一个代价十分惨痛的例子"
  },
  {
    "start": 519.04,
    "end": 519.82,
    "text": "哦"
  },
  {
    "start": 519.82,
    "end": 520.68,
    "text": "什么例子"
  },
  {
    "start": 520.68,
    "end": 522.84,
    "text": "它曾被另一本指南中"
  },
  {
    "start": 522.84,
    "end": 527.2,
    "text": "关于少女风临近山丘与西谷的优美描写所吸引"
  },
  {
    "start": 527.2,
    "end": 528.6,
    "text": "带着家人去登山"
  },
  {
    "start": 528.6,
    "end": 531.14,
    "text": "临近山丘与西谷"
  },
  {
    "start": 531.14,
    "end": 535.18,
    "text": "这听起来就像是可以穿着休闲鞋去郊游的风景画嘛"
  },
  {
    "start": 535.18,
    "end": 536.12,
    "text": "没错"
  },
  {
    "start": 536.12,
    "end": 538.8,
    "text": "正是这种轻描淡写误导了他"
  },
  {
    "start": 538.8,
    "end": 541.34,
    "text": "原本预估非常轻松的徒步"
  },
  {
    "start": 541.34,
    "end": 546.32,
    "text": "结果因为指南没有如实反映地形的险恶和气候的瞬息万变"
  },
  {
    "start": 546.32,
    "end": 548.5,
    "text": "他们足足走了好几个小时"
  },
  {
    "start": 548.5,
    "end": 550.18,
    "text": "天哪"
  },
  {
    "start": 550.18,
    "end": 552.2,
    "text": "最后竟然被困在了兵闭之前"
  },
  {
    "start": 552.2,
    "end": 555.0,
    "text": "连最后一班下山的缆车都错过了"
  },
  {
    "start": 555.0,
    "end": 557.56,
    "text": "这种文字制造的浪漫幻觉"
  },
  {
    "start": 557.56,
    "end": 560.0,
    "text": "一旦在严酷的自然面前破灭"
  },
  {
    "start": 560.0,
    "end": 561.72,
    "text": "后果是不堪设想的"
  },
  {
    "start": 561.72,
    "end": 563.36,
    "text": "太吓人了"
  },
  {
    "start": 563.36,
    "end": 566.66,
    "text": "所以书本不仅在地理上会给出偏差的指引"
  },
  {
    "start": 566.66,
    "end": 568.2,
    "text": "在人与人的交往中"
  },
  {
    "start": 568.2,
    "end": 571.48,
    "text": "他同样无法预判你会在旅途中遇到怎样的高手"
  },
  {
    "start": 571.48,
    "end": 576.44,
    "text": "这就让我相信书中在印度德里一家地毯店里的奇遇了"
  },
  {
    "start": 576.44,
    "end": 578.22,
    "text": "那个卖地毯的商人"
  },
  {
    "start": 578.22,
    "end": 579.64,
    "text": "这段非常精彩"
  },
  {
    "start": 579.64,
    "end": 580.34,
    "text": "对"
  },
  {
    "start": 580.34,
    "end": 584.12,
    "text": "对面坐着一位续着山羊湖的克什米尔商人"
  },
  {
    "start": 584.12,
    "end": 585.24,
    "text": "名叫库马"
  },
  {
    "start": 585.24,
    "end": 588.68,
    "text": "地上摊开了七八张精美的地毯"
  },
  {
    "start": 588.68,
    "end": 592.84,
    "text": "坐着看中了一张蚕丝与羊绒混之的克什米尔地毯"
  },
  {
    "start": 592.84,
    "end": 594.14,
    "text": "非常惊艳"
  },
  {
    "start": 594.14,
    "end": 597.92,
    "text": "但店家开出的价格是两千七百五十美元"
  },
  {
    "start": 597.92,
    "end": 599.84,
    "text": "价格不菲呀"
  },
  {
    "start": 599.84,
    "end": 600.46,
    "text": "是啊"
  },
  {
    "start": 600.46,
    "end": 601.88,
    "text": "他本能地叹了口气"
  },
  {
    "start": 601.88,
    "end": 603.62,
    "text": "抱怨说太贵了"
  },
  {
    "start": 603.62,
    "end": 605.96,
    "text": "这时候换作一般的商人"
  },
  {
    "start": 605.96,
    "end": 608.4,
    "text": "可能就要开始推销或者假装降价了"
  },
  {
    "start": 608.4,
    "end": 610.14,
    "text": "但库马做了什么"
  },
  {
    "start": 610.14,
    "end": 611.46,
    "text": "他没有急着推销"
  },
  {
    "start": 611.46,
    "end": 612.9,
    "text": "而是闭上眼睛"
  },
  {
    "start": 612.9,
    "end": 617.24,
    "text": "用古波斯文朗诵了一首家乡古诗人奥马开演的诗"
  },
  {
    "start": 617.24,
    "end": 619.24,
    "text": "虽然听不懂波斯文"
  },
  {
    "start": 619.24,
    "end": 621.54,
    "text": "但那种韵律和商人的神态"
  },
  {
    "start": 621.54,
    "end": 624.44,
    "text": "瞬间改变了整个空间的氛围"
  },
  {
    "start": 624.44,
    "end": 625.84,
    "text": "接着库马睁开眼翻译说"
  },
  {
    "start": 625.84,
    "end": 627.16,
    "text": "人生短促"
  },
  {
    "start": 627.16,
    "end": 630.5,
    "text": "低谈也只占有一小段人世间的时间"
  },
  {
    "start": 630.5,
    "end": 633.0,
    "text": "这句话简直像一颗子弹"
  },
  {
    "start": 633.0,
    "end": 635.14,
    "text": "彻底击中了作者的软肋"
  },
  {
    "start": 635.14,
    "end": 636.32,
    "text": "坦白说"
  },
  {
    "start": 636.32,
    "end": 637.7,
    "text": "我读到这里的时候"
  },
  {
    "start": 637.7,
    "end": 639.24,
    "text": "真的是忍不住想打断一下"
  },
  {
    "start": 639.24,
    "end": 641.04,
    "text": "如果是我坐在那"
  },
  {
    "start": 641.04,
    "end": 642.1,
    "text": "我可能会觉得"
  },
  {
    "start": 642.1,
    "end": 644.04,
    "text": "这就是个精心设计的商业骗局"
  },
  {
    "start": 644.04,
    "end": 645.74,
    "text": "我们在旅游景点"
  },
  {
    "start": 645.74,
    "end": 648.34,
    "text": "遇到这种兜售高价纪念品的商人"
  },
  {
    "start": 648.34,
    "end": 650.5,
    "text": "第一反应肯定是互助钱包"
  },
  {
    "start": 650.5,
    "end": 652.32,
    "text": "我们为什么要把这种"
  },
  {
    "start": 652.32,
    "end": 654.54,
    "text": "在一国他乡被商家套路"
  },
  {
    "start": 654.54,
    "end": 656.02,
    "text": "甚至被宰了一刀的经历"
  },
  {
    "start": 656.02,
    "end": 658.28,
    "text": "浪漫化成一种文化体验呢"
  },
  {
    "start": 658.28,
    "end": 660.46,
    "text": "你的这个反问非常犀利"
  },
  {
    "start": 660.46,
    "end": 663.32,
    "text": "这确实是一场精妙的商业围猎"
  },
  {
    "start": 663.32,
    "end": 664.98,
    "text": "但我们必须去拆解"
  },
  {
    "start": 664.98,
    "end": 666.86,
    "text": "这个商人为什么能成功"
  },
  {
    "start": 666.86,
    "end": 668.32,
    "text": "这不仅仅是推销"
  },
  {
    "start": 668.32,
    "end": 670.36,
    "text": "这是一种文化威慑"
  },
  {
    "start": 670.36,
    "end": 671.7,
    "text": "文化威慑"
  },
  {
    "start": 671.7,
    "end": 672.26,
    "text": "对"
  },
  {
    "start": 672.26,
    "end": 673.84,
    "text": "在这个特定的场景里"
  },
  {
    "start": 673.84,
    "end": 675.12,
    "text": "旅行者内心深处"
  },
  {
    "start": 675.12,
    "end": 676.52,
    "text": "其实非常渴望获得一种"
  },
  {
    "start": 676.52,
    "end": 678.78,
    "text": "真实而高雅的一国体验"
  },
  {
    "start": 678.78,
    "end": 681.0,
    "text": "商人精准地捕捉到了这种心理"
  },
  {
    "start": 681.0,
    "end": 682.62,
    "text": "用诗歌将这场交易"
  },
  {
    "start": 682.62,
    "end": 684.36,
    "text": "从庸俗的讨价还价"
  },
  {
    "start": 684.36,
    "end": 686.24,
    "text": "拉升到了探讨生命短暂"
  },
  {
    "start": 686.24,
    "end": 688.02,
    "text": "与艺术永恒的哲学高度"
  },
  {
    "start": 688.02,
    "end": 690.16,
    "text": "他把浪漫当成了武器"
  },
  {
    "start": 690.16,
    "end": 691.74,
    "text": "难怪作者会觉得"
  },
  {
    "start": 691.74,
    "end": 693.44,
    "text": "在这个时候开口杀架"
  },
  {
    "start": 693.44,
    "end": 695.8,
    "text": "简直就是打破失忆的庸人俗语"
  },
  {
    "start": 695.8,
    "end": 698.46,
    "text": "这其实是一种心理上的自残行贿"
  },
  {
    "start": 698.46,
    "end": 700.2,
    "text": "紧接着就是一套"
  },
  {
    "start": 700.2,
    "end": 702.44,
    "text": "令人眼花缭乱的价格连环套"
  },
  {
    "start": 702.44,
    "end": 704.68,
    "text": "库马极其优雅地说"
  },
  {
    "start": 704.68,
    "end": 706.94,
    "text": "会试着免去一些负担"
  },
  {
    "start": 706.94,
    "end": 709.9,
    "text": "然后在计算器上打出了2160"
  },
  {
    "start": 709.9,
    "end": 711.48,
    "text": "先给点甜头"
  },
  {
    "start": 711.48,
    "end": 711.94,
    "text": "对"
  },
  {
    "start": 711.94,
    "end": 712.88,
    "text": "但这还没完"
  },
  {
    "start": 712.88,
    "end": 714.02,
    "text": "库马开始加码"
  },
  {
    "start": 714.02,
    "end": 716.68,
    "text": "如果连纯羊绒的那张一起买"
  },
  {
    "start": 716.68,
    "end": 718.6,
    "text": "总共只要2720"
  },
  {
    "start": 718.6,
    "end": 721.66,
    "text": "要是再加一张带有满洲图案的"
  },
  {
    "start": 721.66,
    "end": 723.52,
    "text": "总价是2510"
  },
  {
    "start": 723.52,
    "end": 726.24,
    "text": "要知道最后加进来的那张"
  },
  {
    "start": 726.24,
    "end": 728.04,
    "text": "原本标价690元"
  },
  {
    "start": 728.04,
    "end": 730.42,
    "text": "现在直接被降到了350元"
  },
  {
    "start": 730.42,
    "end": 732.36,
    "text": "这些阶梯式的报价"
  },
  {
    "start": 732.36,
    "end": 735.38,
    "text": "在数字上制造出一种巨大的获得感"
  },
  {
    "start": 735.38,
    "end": 737.74,
    "text": "完全掌控了顾客的心理预期"
  },
  {
    "start": 737.74,
    "end": 740.92,
    "text": "但他明明知道自己根本用不到这么多地毯"
  },
  {
    "start": 740.92,
    "end": 744.02,
    "text": "最后还是在诗意的裹挟下买单了"
  },
  {
    "start": 744.02,
    "end": 745.96,
    "text": "这里真正有价值的"
  },
  {
    "start": 745.96,
    "end": 748.32,
    "text": "并不是这笔买卖到底亏了多少钱"
  },
  {
    "start": 748.32,
    "end": 749.38,
    "text": "那是什么"
  },
  {
    "start": 749.38,
    "end": 753.02,
    "text": "而是事后那种文化相逢时的喜悦"
  },
  {
    "start": 753.02,
    "end": 754.74,
    "text": "与随之而来的自嘲"
  },
  {
    "start": 754.74,
    "end": 758.92,
    "text": "尤其是当他后来去查阅那首诗的各种翻译版本时"
  },
  {
    "start": 758.92,
    "end": 760.66,
    "text": "那种自嘲达到了顶峰"
  },
  {
    "start": 760.66,
    "end": 763.04,
    "text": "他发现无论是英文翻译"
  },
  {
    "start": 763.04,
    "end": 765.32,
    "text": "还是中文里的七言绝句一本"
  },
  {
    "start": 765.32,
    "end": 768.52,
    "text": "其实都无法完全忠实于波斯玉原文"
  },
  {
    "start": 768.52,
    "end": 771.7,
    "text": "所有的翻译都在试图重构一种美感"
  },
  {
    "start": 771.7,
    "end": 773.94,
    "text": "但往往偏离了最初的真实"
  },
  {
    "start": 773.94,
    "end": 777.04,
    "text": "这正好印证了书中那句精准的感叹"
  },
  {
    "start": 777.04,
    "end": 778.82,
    "text": "事事常常如此"
  },
  {
    "start": 778.82,
    "end": 781.08,
    "text": "真实与美丽难以两全"
  },
  {
    "start": 781.08,
    "end": 782.74,
    "text": "在跨文化的碰撞中"
  },
  {
    "start": 782.74,
    "end": 785.18,
    "text": "我们常常为了追求那种美的体验"
  },
  {
    "start": 785.18,
    "end": 787.58,
    "text": "而甘愿在真实性上做出妥协"
  },
  {
    "start": 787.58,
    "end": 789.84,
    "text": "商人贩卖的不只是地毯"
  },
  {
    "start": 789.84,
    "end": 791.62,
    "text": "更是那个美妙的幻觉"
  },
  {
    "start": 791.62,
    "end": 793.34,
    "text": "而旅行者买单的"
  },
  {
    "start": 793.34,
    "end": 796.04,
    "text": "也是自己对于异国情调的浪漫想象"
  },
  {
    "start": 796.04,
    "end": 799.52,
    "text": "可是旅途当然不可能总是这种"
  },
  {
    "start": 799.52,
    "end": 801.6,
    "text": "充满失忆和自嘲的浪漫周旋"
  },
  {
    "start": 801.6,
    "end": 803.88,
    "text": "当旅行脱离了书本的滤镜"
  },
  {
    "start": 803.88,
    "end": 807.14,
    "text": "现实的颗粒感往往会变得异常粗糙"
  },
  {
    "start": 807.14,
    "end": 808.82,
    "text": "甚至充满残酷的危机"
  },
  {
    "start": 808.82,
    "end": 811.82,
    "text": "比如在极地滨海中滑独木舟"
  },
  {
    "start": 811.82,
    "end": 814.76,
    "text": "原文以为是一场洗涤心灵的探险"
  },
  {
    "start": 814.76,
    "end": 816.9,
    "text": "结果却遭遇了帆船"
  },
  {
    "start": 816.9,
    "end": 818.62,
    "text": "滨海里帆船太危险了"
  },
  {
    "start": 818.62,
    "end": 819.34,
    "text": "对啊"
  },
  {
    "start": 819.34,
    "end": 821.08,
    "text": "在冰冷刺悟的海水里"
  },
  {
    "start": 821.08,
    "end": 824.04,
    "text": "那一刻面临的是纯粹的生存恐惧"
  },
  {
    "start": 824.04,
    "end": 825.82,
    "text": "不过很有意思的是"
  },
  {
    "start": 825.82,
    "end": 827.22,
    "text": "当危机解除后"
  },
  {
    "start": 827.22,
    "end": 828.94,
    "text": "这段经历在他的叙述中"
  },
  {
    "start": 828.94,
    "end": 831.4,
    "text": "却转化成了自我解嘲的玩笑"
  },
  {
    "start": 831.4,
    "end": 832.76,
    "text": "幽默啊"
  },
  {
    "start": 832.76,
    "end": 835.64,
    "text": "往往是人类在面对无法掌控的自然伪力时"
  },
  {
    "start": 835.64,
    "end": 837.8,
    "text": "唯一能拿得起的心灵盾牌"
  },
  {
    "start": 837.8,
    "end": 839.28,
    "text": "这种心态的转换"
  },
  {
    "start": 839.28,
    "end": 841.5,
    "text": "本身就是履行赋予人的韧性"
  },
  {
    "start": 841.5,
    "end": 842.58,
    "text": "不过啊"
  },
  {
    "start": 842.58,
    "end": 843.76,
    "text": "更深层次的张力"
  },
  {
    "start": 843.76,
    "end": 845.82,
    "text": "体现在博斯瓦那的泥地上"
  },
  {
    "start": 845.82,
    "end": 847.66,
    "text": "他去看野生动物那次"
  },
  {
    "start": 847.66,
    "end": 850.18,
    "text": "对他跟随着当地的追踪者"
  },
  {
    "start": 850.18,
    "end": 852.58,
    "text": "去寻找怀着三个月身孕的母狮"
  },
  {
    "start": 852.58,
    "end": 855.0,
    "text": "我们需要仔细剖析这个场景"
  },
  {
    "start": 855.0,
    "end": 855.76,
    "text": "作为游客"
  },
  {
    "start": 855.76,
    "end": 857.68,
    "text": "我们坐在安全的越野车里"
  },
  {
    "start": 857.68,
    "end": 859.1,
    "text": "拿着长焦镜头"
  },
  {
    "start": 859.1,
    "end": 861.84,
    "text": "满心期待的想要捕捉野生动物的踪迹"
  },
  {
    "start": 861.84,
    "end": 865.04,
    "text": "这其实是一种居高临下的观赏欲"
  },
  {
    "start": 865.04,
    "end": 869.26,
    "text": "就像是我们走进了别人正在搏命的动作片片场"
  },
  {
    "start": 869.26,
    "end": 870.76,
    "text": "手里却还拿着爆米花"
  },
  {
    "start": 870.76,
    "end": 872.78,
    "text": "这个比喻太绝了"
  },
  {
    "start": 872.78,
    "end": 877.02,
    "text": "当你真的面对那只为了生存而疲于奔命的母狮时"
  },
  {
    "start": 877.02,
    "end": 878.94,
    "text": "那种猎奇的欲望"
  },
  {
    "start": 878.94,
    "end": 881.96,
    "text": "与动物在严酷自然中真实的生存处境"
  },
  {
    "start": 881.96,
    "end": 884.02,
    "text": "极其突兀的并置在这一起"
  },
  {
    "start": 884.02,
    "end": 886.3,
    "text": "你不再是一个轻松的旁观者"
  },
  {
    "start": 886.3,
    "end": 888.28,
    "text": "你会突然感受到生命的沉重"
  },
  {
    "start": 888.28,
    "end": 890.6,
    "text": "旅行在这里变成了一面"
  },
  {
    "start": 890.6,
    "end": 892.72,
    "text": "照出人类自身傲慢的镜子"
  },
  {
    "start": 892.72,
    "end": 893.74,
    "text": "确实"
  },
  {
    "start": 893.74,
    "end": 895.84,
    "text": "而这种身份的错位和碰撞"
  },
  {
    "start": 895.84,
    "end": 897.7,
    "text": "在印度阿格拉的旅馆里"
  },
  {
    "start": 897.7,
    "end": 899.64,
    "text": "则走向了另一种荒诞的戏剧化"
  },
  {
    "start": 899.64,
    "end": 903.0,
    "text": "仅仅是因为错过了一场承诺好的烹饪示范"
  },
  {
    "start": 903.0,
    "end": 905.08,
    "text": "他在大厅里嚼针的发了火"
  },
  {
    "start": 905.08,
    "end": 908.16,
    "text": "结果旅馆副总裁竟然误以为他是同行"
  },
  {
    "start": 908.16,
    "end": 911.74,
    "text": "以为他是某个跨国餐饮或酒店业的高管来暗访"
  },
  {
    "start": 911.74,
    "end": 913.92,
    "text": "这误会可答了"
  },
  {
    "start": 913.92,
    "end": 915.24,
    "text": "更好笑的是"
  },
  {
    "start": 915.24,
    "end": 917.16,
    "text": "当被问到是不是同行时"
  },
  {
    "start": 917.16,
    "end": 920.08,
    "text": "他回答自己是做图书出版的"
  },
  {
    "start": 920.08,
    "end": 921.26,
    "text": "这算是半个事实嘛"
  },
  {
    "start": 921.26,
    "end": 922.28,
    "text": "毕竟他曾经是"
  },
  {
    "start": 922.28,
    "end": 924.02,
    "text": "但副总裁根本不信"
  },
  {
    "start": 924.02,
    "end": 925.48,
    "text": "依然对他恭敬有加"
  },
  {
    "start": 925.48,
    "end": 928.64,
    "text": "甚至亲自带他巡视了一遍整个酒店的厨房"
  },
  {
    "start": 928.64,
    "end": 931.78,
    "text": "这种因为误解而获得的特殊待遇"
  },
  {
    "start": 931.78,
    "end": 935.34,
    "text": "让人看到了异国旅行中那种荒诞的偶然性"
  },
  {
    "start": 935.34,
    "end": 936.78,
    "text": "别人眼里的你"
  },
  {
    "start": 936.78,
    "end": 939.22,
    "text": "往往是你自己都无法控制的投射"
  },
  {
    "start": 939.22,
    "end": 943.06,
    "text": "但如果说这些偶然只是旅途中的小差距"
  },
  {
    "start": 943.06,
    "end": 945.94,
    "text": "那么接下来作者面对的灾难后的现实"
  },
  {
    "start": 945.94,
    "end": 948.16,
    "text": "则带来了真正的心灵撞击"
  },
  {
    "start": 948.16,
    "end": 950.8,
    "text": "这确实是书里最沉重的部分了"
  },
  {
    "start": 950.8,
    "end": 951.7,
    "text": "是的"
  },
  {
    "start": 951.7,
    "end": 954.84,
    "text": "第一个追问发生在巴厘岛爆炸案之后"
  },
  {
    "start": 954.84,
    "end": 957.04,
    "text": "当时新闻标题上赫然写着"
  },
  {
    "start": 957.04,
    "end": 960.24,
    "text": "多起恐怖爆炸和遇百人死亡"
  },
  {
    "start": 960.24,
    "end": 961.48,
    "text": "面对已经定好的行程"
  },
  {
    "start": 961.48,
    "end": 963.06,
    "text": "他陷入了深刻的犹豫"
  },
  {
    "start": 963.06,
    "end": 964.48,
    "text": "换作大部分人"
  },
  {
    "start": 964.48,
    "end": 966.02,
    "text": "第一反应肯定是保命要紧"
  },
  {
    "start": 966.02,
    "end": 967.4,
    "text": "直接取消行程对吧"
  },
  {
    "start": 967.4,
    "end": 968.7,
    "text": "但他还是去了"
  },
  {
    "start": 968.7,
    "end": 971.14,
    "text": "当他坐上那班空荡荡的飞机时"
  },
  {
    "start": 971.14,
    "end": 973.84,
    "text": "身边全是交集返乡的当地富人"
  },
  {
    "start": 973.84,
    "end": 977.1,
    "text": "那种气氛已经完全没有了度假的轻松感"
  },
  {
    "start": 977.1,
    "end": 978.38,
    "text": "最扎心的是"
  },
  {
    "start": 978.38,
    "end": 980.32,
    "text": "接机司机对他说的那句话"
  },
  {
    "start": 980.32,
    "end": 983.06,
    "text": "死的更多是巴厘岛人呀"
  },
  {
    "start": 983.06,
    "end": 985.54,
    "text": "这句话真的有着万军之力"
  },
  {
    "start": 985.54,
    "end": 987.38,
    "text": "他瞬间击碎了观光客"
  },
  {
    "start": 987.38,
    "end": 989.08,
    "text": "那层置身室外的保护罩"
  },
  {
    "start": 989.08,
    "end": 992.54,
    "text": "我们常常觉得灾难破坏了我们的假期"
  },
  {
    "start": 992.54,
    "end": 995.22,
    "text": "却忘了那其实是别人破碎的生活"
  },
  {
    "start": 995.22,
    "end": 997.2,
    "text": "当旅官经理无奈的表示"
  },
  {
    "start": 997.2,
    "end": 999.7,
    "text": "之前住在那里的法国杜蜜月夫妇"
  },
  {
    "start": 999.7,
    "end": 1000.52,
    "text": "因为走不了"
  },
  {
    "start": 1000.52,
    "end": 1002.28,
    "text": "还站着他预定的房间时"
  },
  {
    "start": 1002.28,
    "end": 1004.34,
    "text": "他本能的想要抱怨"
  },
  {
    "start": 1004.34,
    "end": 1005.78,
    "text": "但同伴拉了邋遢的袖子"
  },
  {
    "start": 1005.78,
    "end": 1007.44,
    "text": "他把刻薄话吞了回去"
  },
  {
    "start": 1007.44,
    "end": 1008.72,
    "text": "是一种隐忍"
  },
  {
    "start": 1008.72,
    "end": 1010.14,
    "text": "对这种隐忍"
  },
  {
    "start": 1010.14,
    "end": 1013.08,
    "text": "因为他真切的撞击了他人的苦难"
  },
  {
    "start": 1013.08,
    "end": 1014.8,
    "text": "另一次痛苦的犹豫"
  },
  {
    "start": 1014.8,
    "end": 1017.28,
    "text": "是在日本东北大地震之后半年多"
  },
  {
    "start": 1017.28,
    "end": 1020.38,
    "text": "他想回去看看当地的一家国民休旭村"
  },
  {
    "start": 1020.38,
    "end": 1022.66,
    "text": "但他陷入了巨大的道德纠结"
  },
  {
    "start": 1022.66,
    "end": 1024.64,
    "text": "就是到底去是不去"
  },
  {
    "start": 1024.64,
    "end": 1025.6,
    "text": "一方面"
  },
  {
    "start": 1025.6,
    "end": 1027.74,
    "text": "如果当地人已经开始冲洗经济"
  },
  {
    "start": 1027.74,
    "end": 1029.46,
    "text": "外来观光客的到来"
  },
  {
    "start": 1029.46,
    "end": 1032.04,
    "text": "确实能够提振士气带来收入"
  },
  {
    "start": 1032.04,
    "end": 1033.22,
    "text": "嗯理性的角度"
  },
  {
    "start": 1033.22,
    "end": 1034.36,
    "text": "但另一方面"
  },
  {
    "start": 1034.36,
    "end": 1036.06,
    "text": "如果居民依然深陷在"
  },
  {
    "start": 1036.06,
    "end": 1038.68,
    "text": "失去亲人的伤痛和废墟的重建中"
  },
  {
    "start": 1038.68,
    "end": 1040.5,
    "text": "游客贸然闯进去"
  },
  {
    "start": 1040.5,
    "end": 1042.44,
    "text": "是不是就成了一种残忍的"
  },
  {
    "start": 1042.44,
    "end": 1044.14,
    "text": "旁观他人之痛苦"
  },
  {
    "start": 1044.14,
    "end": 1046.08,
    "text": "连他的日本游人都觉得"
  },
  {
    "start": 1046.08,
    "end": 1047.14,
    "text": "这事很微妙"
  },
  {
    "start": 1047.14,
    "end": 1047.92,
    "text": "不知可否"
  },
  {
    "start": 1047.92,
    "end": 1051.16,
    "text": "这就是旅行中最深刻的伦理困境了"
  },
  {
    "start": 1051.16,
    "end": 1052.76,
    "text": "这也是作者在书中"
  },
  {
    "start": 1052.76,
    "end": 1054.2,
    "text": "试图解答的核心问题"
  },
  {
    "start": 1054.2,
    "end": 1055.7,
    "text": "很多人喜欢说"
  },
  {
    "start": 1055.7,
    "end": 1057.6,
    "text": "反走过必留下痕迹"
  },
  {
    "start": 1057.6,
    "end": 1058.9,
    "text": "往往把它理解为"
  },
  {
    "start": 1058.9,
    "end": 1060.4,
    "text": "在某个景点的柱子上"
  },
  {
    "start": 1060.4,
    "end": 1061.4,
    "text": "刻下自己的名字"
  },
  {
    "start": 1061.4,
    "end": 1063.46,
    "text": "或者在地图上插上一面小旗子"
  },
  {
    "start": 1063.46,
    "end": 1064.82,
    "text": "到此一游吗"
  },
  {
    "start": 1064.82,
    "end": 1065.18,
    "text": "对"
  },
  {
    "start": 1065.18,
    "end": 1067.3,
    "text": "但他重新定义了这句话"
  },
  {
    "start": 1067.3,
    "end": 1069.3,
    "text": "所谓的留下痕迹"
  },
  {
    "start": 1069.3,
    "end": 1071.08,
    "text": "是说这些你走过的地方"
  },
  {
    "start": 1071.08,
    "end": 1072.5,
    "text": "那些你遇到过的"
  },
  {
    "start": 1072.5,
    "end": 1073.68,
    "text": "正在努力生存的"
  },
  {
    "start": 1073.68,
    "end": 1075.22,
    "text": "异乡人的真实生活"
  },
  {
    "start": 1075.22,
    "end": 1076.8,
    "text": "那些苦难与坚韧"
  },
  {
    "start": 1076.8,
    "end": 1078.32,
    "text": "会在你的生命里"
  },
  {
    "start": 1078.32,
    "end": 1079.54,
    "text": "在你的灵魂上"
  },
  {
    "start": 1079.54,
    "end": 1081.66,
    "text": "留下不可摸去的痕迹"
  },
  {
    "start": 1081.66,
    "end": 1083.66,
    "text": "是你被这个世界改变了"
  },
  {
    "start": 1083.66,
    "end": 1085.18,
    "text": "而不是你改变了风景"
  },
  {
    "start": 1085.18,
    "end": 1087.5,
    "text": "这种由内而外的改变"
  },
  {
    "start": 1087.5,
    "end": 1088.28,
    "text": "太震撼了"
  },
  {
    "start": 1088.28,
    "end": 1088.82,
    "text": "但是"
  },
  {
    "start": 1088.82,
    "end": 1091.14,
    "text": "这就引出了一个终极问题"
  },
  {
    "start": 1091.14,
    "end": 1093.36,
    "text": "随着人类的脚步越走越远"
  },
  {
    "start": 1093.36,
    "end": 1095.5,
    "text": "当现实的地理探索"
  },
  {
    "start": 1095.5,
    "end": 1096.24,
    "text": "面临穷尽"
  },
  {
    "start": 1096.24,
    "end": 1097.62,
    "text": "世界上再也没有"
  },
  {
    "start": 1097.62,
    "end": 1098.54,
    "text": "你没去过"
  },
  {
    "start": 1098.54,
    "end": 1099.84,
    "text": "没见过的角落时"
  },
  {
    "start": 1099.84,
    "end": 1101.5,
    "text": "旅行者还能去哪"
  },
  {
    "start": 1101.5,
    "end": 1103.02,
    "text": "在这个时候"
  },
  {
    "start": 1103.02,
    "end": 1104.12,
    "text": "作者非常精妙地"
  },
  {
    "start": 1104.12,
    "end": 1106.2,
    "text": "将视角从现实的地理"
  },
  {
    "start": 1106.2,
    "end": 1108.74,
    "text": "拉升到了虚构的地质学"
  },
  {
    "start": 1108.74,
    "end": 1111.06,
    "text": "他提到了凡尔纳的科幻小说"
  },
  {
    "start": 1111.06,
    "end": 1112.68,
    "text": "当我们的双脚"
  },
  {
    "start": 1112.68,
    "end": 1114.64,
    "text": "因为各种现实条件的限制"
  },
  {
    "start": 1114.64,
    "end": 1116.8,
    "text": "无法抵达更远的远方时"
  },
  {
    "start": 1116.8,
    "end": 1119.54,
    "text": "阅读依然能带我们展开"
  },
  {
    "start": 1119.54,
    "end": 1121.5,
    "text": "无尽的想象的旅行"
  },
  {
    "start": 1121.5,
    "end": 1123.0,
    "text": "在脑海中旅行"
  },
  {
    "start": 1123.0,
    "end": 1123.46,
    "text": "没错"
  },
  {
    "start": 1123.46,
    "end": 1125.12,
    "text": "在虚构的时空里"
  },
  {
    "start": 1125.12,
    "end": 1126.9,
    "text": "我们依然可以去拓宽"
  },
  {
    "start": 1126.9,
    "end": 1128.0,
    "text": "对另一种文明"
  },
  {
    "start": 1128.0,
    "end": 1130.32,
    "text": "另一种生命形态的认知边界"
  },
  {
    "start": 1130.32,
    "end": 1132.7,
    "text": "这个概念放到今天"
  },
  {
    "start": 1132.7,
    "end": 1135.9,
    "text": "我觉得有着无比现实的指导意义"
  },
  {
    "start": 1135.9,
    "end": 1136.54,
    "text": "你看我们现在"
  },
  {
    "start": 1136.54,
    "end": 1138.66,
    "text": "每天面对着海量的信息流"
  },
  {
    "start": 1138.66,
    "end": 1140.52,
    "text": "高清的虚拟现实图像"
  },
  {
    "start": 1140.52,
    "end": 1142.22,
    "text": "我们很容易产生一种"
  },
  {
    "start": 1142.22,
    "end": 1144.02,
    "text": "全知全能的错觉"
  },
  {
    "start": 1144.02,
    "end": 1146.0,
    "text": "觉得我只要坐在沙发上"
  },
  {
    "start": 1146.0,
    "end": 1146.92,
    "text": "画一画屏幕"
  },
  {
    "start": 1146.92,
    "end": 1148.24,
    "text": "看一看全景地图"
  },
  {
    "start": 1148.24,
    "end": 1150.36,
    "text": "就已经游历了整个世界"
  },
  {
    "start": 1150.36,
    "end": 1151.64,
    "text": "就已经看透了"
  },
  {
    "start": 1151.64,
    "end": 1152.98,
    "text": "所有的风土人情"
  },
  {
    "start": 1152.98,
    "end": 1154.92,
    "text": "既然网上什么都有"
  },
  {
    "start": 1154.92,
    "end": 1156.14,
    "text": "我们为什么还要"
  },
  {
    "start": 1156.14,
    "end": 1157.98,
    "text": "大费周章的出门"
  },
  {
    "start": 1157.98,
    "end": 1159.52,
    "text": "这恰恰是这本书"
  },
  {
    "start": 1159.52,
    "end": 1161.78,
    "text": "在这个被数字虚拟包裹的时代"
  },
  {
    "start": 1161.78,
    "end": 1163.8,
    "text": "给予我们最宝贵的启示"
  },
  {
    "start": 1163.8,
    "end": 1166.12,
    "text": "屏幕里的世界再高清"
  },
  {
    "start": 1166.12,
    "end": 1167.7,
    "text": "那也是别人咀嚼过"
  },
  {
    "start": 1167.7,
    "end": 1168.92,
    "text": "剪辑过的现实"
  },
  {
    "start": 1168.92,
    "end": 1170.26,
    "text": "带上一本书"
  },
  {
    "start": 1170.26,
    "end": 1172.1,
    "text": "去亲自经历文本"
  },
  {
    "start": 1172.1,
    "end": 1173.76,
    "text": "用你自己的身体"
  },
  {
    "start": 1173.76,
    "end": 1175.72,
    "text": "去丈量那些崎岖的现实"
  },
  {
    "start": 1175.72,
    "end": 1177.22,
    "text": "去实地"
  },
  {
    "start": 1177.22,
    "end": 1178.32,
    "text": "去肉身的"
  },
  {
    "start": 1178.32,
    "end": 1179.76,
    "text": "与复杂的异文化"
  },
  {
    "start": 1179.76,
    "end": 1181.9,
    "text": "相互纠缠碰撞"
  },
  {
    "start": 1181.9,
    "end": 1183.96,
    "text": "这种在真实世界里流汗"
  },
  {
    "start": 1183.96,
    "end": 1184.66,
    "text": "受动"
  },
  {
    "start": 1184.66,
    "end": 1185.18,
    "text": "受骗"
  },
  {
    "start": 1185.18,
    "end": 1185.92,
    "text": "惊喜"
  },
  {
    "start": 1185.92,
    "end": 1187.2,
    "text": "产生道德负罪感"
  },
  {
    "start": 1187.2,
    "end": 1188.92,
    "text": "乃至自嘲的真实生命体验"
  },
  {
    "start": 1188.92,
    "end": 1190.66,
    "text": "是任何先进的虚拟技术"
  },
  {
    "start": 1190.66,
    "end": 1192.3,
    "text": "都永远无法取代的"
  },
  {
    "start": 1192.3,
    "end": 1194.92,
    "text": "因为只有真实的触碰"
  },
  {
    "start": 1194.92,
    "end": 1196.74,
    "text": "才能带来真实的痛感"
  },
  {
    "start": 1196.74,
    "end": 1197.52,
    "text": "与觉醒"
  },
  {
    "start": 1197.52,
    "end": 1200.3,
    "text": "旅途中最难忘的收获"
  },
  {
    "start": 1200.3,
    "end": 1202.1,
    "text": "究竟是印证了书本"
  },
  {
    "start": 1202.1,
    "end": 1203.94,
    "text": "还是撞见了未知"
  }
]
