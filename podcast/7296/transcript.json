  {
    "start": 598.58,
    "end": 599.48,
    "text": "已经不够了"
  },
  {
    "start": 599.48,
    "end": 601.8,
    "text": "必须赋予情绪价值"
  },
  {
    "start": 601.8,
    "end": 602.16,
    "text": "没错"
  },
  {
    "start": 602.16,
    "end": 604.22,
    "text": "讲个引人入胜的品牌故事"
  },
  {
    "start": 604.22,
    "end": 605.84,
    "text": "这就需要双管齐下"
  },
  {
    "start": 605.84,
    "end": 607.38,
    "text": "先用种子战略"
  },
  {
    "start": 607.38,
    "end": 608.88,
    "text": "吸引年轻创意人才"
  },
  {
    "start": 608.88,
    "end": 609.64,
    "text": "然后呢"
  },
  {
    "start": 609.64,
    "end": 612.2,
    "text": "然后利用他们制造的文化共鸣"
  },
  {
    "start": 612.2,
    "end": 613.96,
    "text": "去实施收获战略"
  },
  {
    "start": 613.96,
    "end": 617.1,
    "text": "吸引市场上无处安放的庞大财富来买单"
  },
  {
    "start": 617.1,
    "end": 618.38,
    "text": "聊到这儿"
  },
  {
    "start": 618.38,
    "end": 620.62,
    "text": "不管是熬过周期还是追赶趋势"
  },
  {
    "start": 620.62,
    "end": 623.76,
    "text": "这财富创造的终极目的到底是什么呢"
  },
  {
    "start": 623.76,
    "end": 625.86,
    "text": "咱们借用心理学家塞利格曼"
  },
  {
    "start": 625.86,
    "end": 626.88,
    "text": "对幸福的分类"
  },
  {
    "start": 626.88,
    "end": 629.34,
    "text": "他分为了有浅入深的几个层次"
  },
  {
    "start": 629.34,
    "end": 630.5,
    "text": "愉快的生活"
  },
  {
    "start": 630.5,
    "end": 631.68,
    "text": "忙碌的生活"
  },
  {
    "start": 631.68,
    "end": 634.04,
    "text": "最高境界是有意义的生活"
  },
  {
    "start": 634.04,
    "end": 635.7,
    "text": "所以经历这些震荡"
  },
  {
    "start": 635.7,
    "end": 637.8,
    "text": "是为了更高层次的幸福"
  },
  {
    "start": 637.8,
    "end": 638.36,
    "text": "对"
  },
  {
    "start": 638.36,
    "end": 640.44,
    "text": "全球社会整体正在走向"
  },
  {
    "start": 640.44,
    "end": 643.74,
    "text": "更自由去中心化和更幸福的形态"
  },
  {
    "start": 643.74,
    "end": 645.18,
    "text": "不过最后我得提醒你"
  },
  {
    "start": 645.18,
    "end": 646.5,
    "text": "要保持独立思考"
  },
  {
    "start": 646.5,
    "end": 647.5,
    "text": "别迷信预测"
  },
  {
    "start": 647.5,
    "end": 648.44,
    "text": "怎么说"
  },
  {
    "start": 648.44,
    "end": 650.56,
    "text": "书里的预测也有矛盾"
  },
  {
    "start": 650.56,
    "end": 651.48,
    "text": "非常明显"
  },
  {
    "start": 651.48,
    "end": 653.02,
    "text": "比如第十九章里写"
  },
  {
    "start": 653.02,
    "end": 655.54,
    "text": "未来全球主要的房地产崩溃周期"
  },
  {
    "start": 655.54,
    "end": 656.84,
    "text": "将会发生两次"
  },
  {
    "start": 656.84,
    "end": 658.06,
    "text": "听着很确切"
  },
  {
    "start": 658.06,
    "end": 659.66,
    "text": "但你在附录里看"
  },
  {
    "start": 659.66,
    "end": 661.18,
    "text": "跨度突然变成了"
  },
  {
    "start": 661.18,
    "end": 661.94,
    "text": "一到三次"
  },
  {
    "start": 661.94,
    "end": 663.64,
    "text": "这就是说"
  },
  {
    "start": 663.64,
    "end": 665.98,
    "text": "咱们得吸收宏观长远思维"
  },
  {
    "start": 665.98,
    "end": 668.48,
    "text": "但绝对不能当成精确的日历预报"
  },
  {
    "start": 668.48,
    "end": 669.54,
    "text": "去科州求见了"
  },
  {
    "start": 669.54,
    "end": 670.68,
    "text": "完全正确"
  },
  {
    "start": 670.68,
    "end": 673.76,
    "text": "当短期周期波动和长期技术趋势"
  },
  {
    "start": 673.76,
    "end": 674.56,
    "text": "叠在一起时"
  },
  {
    "start": 674.56,
    "end": 677.24,
    "text": "人们最容易把哪两件事混为一谈"
  }
]
