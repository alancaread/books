[
  {
    "start": 0.0,
    "end": 1.08,
    "text": "立下大功的人"
  },
  {
    "start": 1.08,
    "end": 3.3,
    "text": "为什么最后落得被杀"
  },
  {
    "start": 3.3,
    "end": 4.82,
    "text": "当你听到这个问题"
  },
  {
    "start": 4.82,
    "end": 6.16,
    "text": "脑子里可能会浮现出"
  },
  {
    "start": 6.16,
    "end": 7.46,
    "text": "无数个历史人物的名字"
  },
  {
    "start": 7.46,
    "end": 8.12,
    "text": "太多了"
  },
  {
    "start": 8.12,
    "end": 9.0,
    "text": "历史上这种事"
  },
  {
    "start": 9.0,
    "end": 9.32,
    "text": "对"
  },
  {
    "start": 9.32,
    "end": 10.84,
    "text": "但是如果我们要在这份"
  },
  {
    "start": 10.84,
    "end": 12.02,
    "text": "长长的名单里"
  },
  {
    "start": 12.02,
    "end": 14.1,
    "text": "挑出一个最让人觉得可惜"
  },
  {
    "start": 14.1,
    "end": 16.14,
    "text": "同时也最充满矛盾感的人"
  },
  {
    "start": 16.14,
    "end": 18.04,
    "text": "那绝对绕不开两个字"
  },
  {
    "start": 18.04,
    "end": 18.6,
    "text": "韩信"
  },
  {
    "start": 18.6,
    "end": 21.22,
    "text": "今天我们要借着江郎写的这本"
  },
  {
    "start": 21.22,
    "end": 22.86,
    "text": "千古一战神韩信"
  },
  {
    "start": 22.86,
    "end": 24.98,
    "text": "来彻底拆解这个历史谜题"
  },
  {
    "start": 24.98,
    "end": 26.62,
    "text": "我们不光是重温历史"
  },
  {
    "start": 26.62,
    "end": 27.84,
    "text": "更是要弄清楚"
  },
  {
    "start": 27.84,
    "end": 29.02,
    "text": "一个在战场上"
  },
  {
    "start": 29.02,
    "end": 31.06,
    "text": "简直像神明一样的战略天才"
  },
  {
    "start": 31.06,
    "end": 33.74,
    "text": "为什么会在人性和权力的博弈里"
  },
  {
    "start": 33.74,
    "end": 35.0,
    "text": "表现得那么盲目"
  },
  {
    "start": 35.0,
    "end": 36.8,
    "text": "这是一个极度迷人"
  },
  {
    "start": 36.8,
    "end": 38.54,
    "text": "但也极其残忍的切入点"
  },
  {
    "start": 38.54,
    "end": 40.26,
    "text": "当我们翻开江郎这本书"
  },
  {
    "start": 40.26,
    "end": 41.18,
    "text": "你会发现"
  },
  {
    "start": 41.18,
    "end": 42.54,
    "text": "作者并没有把韩信"
  },
  {
    "start": 42.54,
    "end": 44.0,
    "text": "高高的供在神坛上"
  },
  {
    "start": 44.0,
    "end": 44.56,
    "text": "没有滤镜"
  },
  {
    "start": 44.56,
    "end": 45.08,
    "text": "没滤镜"
  },
  {
    "start": 45.08,
    "end": 47.46,
    "text": "他其实是把这当作一部"
  },
  {
    "start": 47.46,
    "end": 48.42,
    "text": "怎么说呢"
  },
  {
    "start": 48.42,
    "end": 51.44,
    "text": "写给平凡人的草根励志书"
  },
  {
    "start": 51.44,
    "end": 53.34,
    "text": "这也是一场带着文学色彩的"
  },
  {
    "start": 53.34,
    "end": 55.72,
    "text": "关于人性局限和权力法则的"
  },
  {
    "start": 55.72,
    "end": 56.8,
    "text": "深度沙盘推演"
  },
  {
    "start": 56.8,
    "end": 60.52,
    "text": "我们得先抛开韩信后来那些光芒万丈的头衔"
  },
  {
    "start": 60.52,
    "end": 62.52,
    "text": "回到一切的起点"
  },
  {
    "start": 62.52,
    "end": 64.34,
    "text": "也就是回到他一无所有的时候"
  },
  {
    "start": 64.34,
    "end": 64.6,
    "text": "对"
  },
  {
    "start": 64.6,
    "end": 67.48,
    "text": "去看看那个连饭都吃不饱的年轻人"
  },
  {
    "start": 67.48,
    "end": 69.7,
    "text": "到底是怎么迈出破局第一步的"
  },
  {
    "start": 69.7,
    "end": 70.12,
    "text": "没错"
  },
  {
    "start": 70.12,
    "end": 71.42,
    "text": "既然是草根"
  },
  {
    "start": 71.42,
    "end": 72.48,
    "text": "我们就不得不提"
  },
  {
    "start": 72.48,
    "end": 74.54,
    "text": "你可能早就耳熟能详的那个开场"
  },
  {
    "start": 74.54,
    "end": 76.76,
    "text": "就是怀音街头的胯下之乳"
  },
  {
    "start": 76.76,
    "end": 77.66,
    "text": "太经典了"
  },
  {
    "start": 77.66,
    "end": 78.9,
    "text": "通常我们理解这段"
  },
  {
    "start": 78.9,
    "end": 81.28,
    "text": "往往把它看作是个单纯的受辱时刻"
  },
  {
    "start": 81.28,
    "end": 81.56,
    "text": "对吧"
  },
  {
    "start": 81.56,
    "end": 83.26,
    "text": "就是为了活命不得不低头"
  },
  {
    "start": 83.26,
    "end": 84.0,
    "text": "但是"
  },
  {
    "start": 84.0,
    "end": 87.08,
    "text": "当我看书里对这个场景的动作拆解时"
  },
  {
    "start": 87.08,
    "end": 87.64,
    "text": "哇"
  },
  {
    "start": 87.64,
    "end": 89.46,
    "text": "那简直是一场惊心动魄的心理战"
  },
  {
    "start": 89.46,
    "end": 89.8,
    "text": "是的"
  },
  {
    "start": 89.8,
    "end": 90.54,
    "text": "你想象一下"
  },
  {
    "start": 90.54,
    "end": 92.1,
    "text": "那个尘土飞扬的街头"
  },
  {
    "start": 92.1,
    "end": 94.34,
    "text": "恶少拦住了穷困潦倒的韩信"
  },
  {
    "start": 94.34,
    "end": 95.28,
    "text": "挑衅他说"
  },
  {
    "start": 95.28,
    "end": 96.82,
    "text": "要么你拔剑刺我"
  },
  {
    "start": 96.82,
    "end": 98.62,
    "text": "要么你就从我胯下爬过去"
  },
  {
    "start": 98.62,
    "end": 100.78,
    "text": "在这个生死一瞬的关头"
  },
  {
    "start": 100.78,
    "end": 103.32,
    "text": "作者捕捉到了一个极度震撼的细节"
  },
  {
    "start": 103.32,
    "end": 104.62,
    "text": "书里的韩信"
  },
  {
    "start": 104.62,
    "end": 105.48,
    "text": "他的右手"
  },
  {
    "start": 105.48,
    "end": 107.94,
    "text": "其实已经死死握住剑柄了"
  },
  {
    "start": 107.94,
    "end": 109.14,
    "text": "肾上腺素飙升了"
  },
  {
    "start": 109.14,
    "end": 109.38,
    "text": "是的"
  },
  {
    "start": 109.38,
    "end": 110.36,
    "text": "对对对"
  },
  {
    "start": 110.36,
    "end": 112.12,
    "text": "从生物学本能来说"
  },
  {
    "start": 112.12,
    "end": 113.98,
    "text": "面对这种强烈的挑衅"
  },
  {
    "start": 113.98,
    "end": 115.16,
    "text": "人的第一反应"
  },
  {
    "start": 115.16,
    "end": 117.14,
    "text": "绝对是拔剑反击"
  },
  {
    "start": 117.14,
    "end": 117.68,
    "text": "但韩信"
  },
  {
    "start": 117.68,
    "end": 120.16,
    "text": "他硬生生的把这股本能压制住了"
  },
  {
    "start": 120.16,
    "end": 122.62,
    "text": "而且他做了一个特别违背直觉的动作"
  },
  {
    "start": 122.62,
    "end": 123.7,
    "text": "他没拔剑"
  },
  {
    "start": 123.7,
    "end": 124.36,
    "text": "他没有"
  },
  {
    "start": 124.36,
    "end": 125.76,
    "text": "他不仅没拔剑"
  },
  {
    "start": 125.76,
    "end": 128.34,
    "text": "他还特意把背上的剑取了下来"
  },
  {
    "start": 128.34,
    "end": 129.22,
    "text": "认认真真的"
  },
  {
    "start": 129.22,
    "end": 131.34,
    "text": "找了一块干净的地面放好"
  },
  {
    "start": 131.34,
    "end": 133.1,
    "text": "然后才双膝着底爬过去的"
  },
  {
    "start": 133.1,
    "end": 133.5,
    "text": "哇"
  },
  {
    "start": 133.5,
    "end": 136.5,
    "text": "这个放下剑的动作简直绝了"
  },
  {
    "start": 136.5,
    "end": 139.18,
    "text": "作者在书里给的那句心理推测"
  },
  {
    "start": 139.18,
    "end": 140.32,
    "text": "真的是直接人心"
  },
  {
    "start": 140.32,
    "end": 140.78,
    "text": "就是"
  },
  {
    "start": 140.78,
    "end": 143.72,
    "text": "他可以从恶哨胯下爬过去"
  },
  {
    "start": 143.72,
    "end": 145.1,
    "text": "但剑不可以"
  },
  {
    "start": 145.1,
    "end": 145.86,
    "text": "没错"
  },
  {
    "start": 145.86,
    "end": 147.98,
    "text": "你想想这个画面的张力"
  },
  {
    "start": 147.98,
    "end": 149.1,
    "text": "这就好比"
  },
  {
    "start": 149.1,
    "end": 150.76,
    "text": "你现在正要去参加一个"
  },
  {
    "start": 150.76,
    "end": 151.74,
    "text": "决定你命运的"
  },
  {
    "start": 151.74,
    "end": 153.64,
    "text": "千万级项目的最终竞标"
  },
  {
    "start": 153.64,
    "end": 154.96,
    "text": "结果在地铁口"
  },
  {
    "start": 154.96,
    "end": 157.54,
    "text": "被一个中国人死死拽住领子辱骂"
  },
  {
    "start": 157.54,
    "end": 159.1,
    "text": "太耽误事了"
  },
  {
    "start": 159.1,
    "end": 159.7,
    "text": "对啊"
  },
  {
    "start": 159.7,
    "end": 161.22,
    "text": "如果你当时脑子一热"
  },
  {
    "start": 161.22,
    "end": 162.5,
    "text": "跟他大大出手"
  },
  {
    "start": 162.5,
    "end": 164.34,
    "text": "你可能保全了眼前的面子"
  },
  {
    "start": 164.34,
    "end": 166.58,
    "text": "但你搭进去的是那身昂贵的西装"
  },
  {
    "start": 166.58,
    "end": 167.92,
    "text": "是你宝贵的时间"
  },
  {
    "start": 167.92,
    "end": 170.26,
    "text": "甚至可能是你一生的前途"
  },
  {
    "start": 170.26,
    "end": 173.72,
    "text": "这就是一个极其罕见的高阶情绪价值管理"
  },
  {
    "start": 173.72,
    "end": 175.26,
    "text": "我们平时老说"
  },
  {
    "start": 175.26,
    "end": 177.0,
    "text": "一时冲动的小忍"
  },
  {
    "start": 177.0,
    "end": 178.38,
    "text": "那是被动屈服"
  },
  {
    "start": 178.38,
    "end": 183.18,
    "text": "但韩信这是胸怀远大目标的大忍"
  },
  {
    "start": 183.18,
    "end": 184.36,
    "text": "剑是他的尊严"
  },
  {
    "start": 184.36,
    "end": 186.92,
    "text": "是他未来建功立业的图腾"
  },
  {
    "start": 186.92,
    "end": 190.48,
    "text": "他把个人的肉身和他的终极目标完全剥离开了"
  },
  {
    "start": 190.48,
    "end": 192.7,
    "text": "也就是肉体可以受辱"
  },
  {
    "start": 192.7,
    "end": 194.14,
    "text": "但目标不能被玷污"
  },
  {
    "start": 194.14,
    "end": 194.54,
    "text": "对"
  },
  {
    "start": 194.54,
    "end": 196.02,
    "text": "保全有用之身"
  },
  {
    "start": 196.02,
    "end": 199.5,
    "text": "为了那个只有他自己能看见的宏大未来去蓄力"
  },
  {
    "start": 199.5,
    "end": 202.52,
    "text": "这是他走向历史舞台中央的基础"
  },
  {
    "start": 202.52,
    "end": 204.28,
    "text": "可是他走向舞台的过程"
  },
  {
    "start": 204.28,
    "end": 205.84,
    "text": "其实不是一飞冲天的"
  },
  {
    "start": 205.84,
    "end": 207.88,
    "text": "反而是充满了现实的泥泞"
  },
  {
    "start": 207.88,
    "end": 210.52,
    "text": "这就引出我特别想探讨的一个问题"
  },
  {
    "start": 210.52,
    "end": 213.16,
    "text": "就是一个在当时到处蹭犯"
  },
  {
    "start": 213.16,
    "end": 217.04,
    "text": "甚至被起义军领袖向良当面评价为庸人尔"
  },
  {
    "start": 217.04,
    "end": 218.38,
    "text": "也就是个平庸之辈的人"
  },
  {
    "start": 218.38,
    "end": 220.42,
    "text": "他到底是怎么拿到兵权的"
  },
  {
    "start": 220.42,
    "end": 222.68,
    "text": "作者在梳理这条轨迹的时候"
  },
  {
    "start": 222.68,
    "end": 224.34,
    "text": "给出的动机特别实在"
  },
  {
    "start": 224.34,
    "end": 227.44,
    "text": "甚至实在的有点打破滤镜"
  },
  {
    "start": 227.44,
    "end": 229.08,
    "text": "有多实在"
  },
  {
    "start": 229.08,
    "end": 231.02,
    "text": "韩信最早投奔向良"
  },
  {
    "start": 231.02,
    "end": 233.8,
    "text": "根本不是带着什么救国救民的宏大抱负"
  },
  {
    "start": 233.8,
    "end": 235.66,
    "text": "原因极度接地气"
  },
  {
    "start": 235.66,
    "end": 238.26,
    "text": "就是他身无分文快饿死了"
  },
  {
    "start": 238.26,
    "end": 240.74,
    "text": "而向良的几万人马正好路过"
  },
  {
    "start": 240.74,
    "end": 242.48,
    "text": "跟着大部队有饭吃"
  },
  {
    "start": 242.48,
    "end": 244.6,
    "text": "对于当时的韩信来说"
  },
  {
    "start": 244.6,
    "end": 245.66,
    "text": "跟着军队走"
  },
  {
    "start": 245.66,
    "end": 246.52,
    "text": "免了路费"
  },
  {
    "start": 246.52,
    "end": 248.42,
    "text": "还能在火头军里混口饭吃"
  },
  {
    "start": 248.42,
    "end": 251.82,
    "text": "他在军中最初就是一个毫无存在感的大头兵"
  },
  {
    "start": 251.82,
    "end": 253.38,
    "text": "纯粹是为了生存"
  },
  {
    "start": 253.38,
    "end": 255.2,
    "text": "那后来向良战死"
  },
  {
    "start": 255.2,
    "end": 258.36,
    "text": "他就顺理成长成了项羽帐下的知己郎"
  },
  {
    "start": 258.36,
    "end": 260.46,
    "text": "也就是个给老板站岗的卫兵"
  },
  {
    "start": 260.46,
    "end": 261.9,
    "text": "这个时候"
  },
  {
    "start": 261.9,
    "end": 264.1,
    "text": "他其实有机会近距离观察"
  },
  {
    "start": 264.1,
    "end": 265.96,
    "text": "当时天下最强势的领导者"
  },
  {
    "start": 265.96,
    "end": 266.98,
    "text": "也就是项羽了"
  },
  {
    "start": 266.98,
    "end": 267.48,
    "text": "没错"
  },
  {
    "start": 267.48,
    "end": 270.6,
    "text": "这恰恰是他命运发生决定性转折的关键"
  },
  {
    "start": 270.6,
    "end": 273.8,
    "text": "作者兼用史实加入了韩信视角的推演"
  },
  {
    "start": 273.8,
    "end": 276.82,
    "text": "韩信天天亲眼看着项羽怎么打仗"
  },
  {
    "start": 276.82,
    "end": 278.86,
    "text": "也看着项羽屠戮咸阳"
  },
  {
    "start": 278.86,
    "end": 279.94,
    "text": "烧毁秦宫时"
  },
  {
    "start": 279.94,
    "end": 281.6,
    "text": "还有坑杀投降的秦军"
  },
  {
    "start": 281.6,
    "end": 282.04,
    "text": "对"
  },
  {
    "start": 282.04,
    "end": 283.08,
    "text": "在韩信看来"
  },
  {
    "start": 283.08,
    "end": 286.1,
    "text": "这种靠极其残暴的手段建立起来的威慑力"
  },
  {
    "start": 286.1,
    "end": 287.54,
    "text": "其实非常脆弱"
  },
  {
    "start": 287.54,
    "end": 289.98,
    "text": "因为恐惧只能维持一时的服从"
  },
  {
    "start": 289.98,
    "end": 291.52,
    "text": "买不到长久的忠诚"
  },
  {
    "start": 291.52,
    "end": 292.52,
    "text": "非常准确"
  },
  {
    "start": 292.52,
    "end": 293.86,
    "text": "所以在这本书里"
  },
  {
    "start": 293.86,
    "end": 297.9,
    "text": "作者借韩信之口对项羽做了一个极度犀利的评价"
  },
  {
    "start": 297.9,
    "end": 300.74,
    "text": "说项羽的人词是小而假"
  },
  {
    "start": 300.74,
    "end": 301.72,
    "text": "不足成大事"
  },
  {
    "start": 301.72,
    "end": 304.44,
    "text": "他彻底看透了项羽在战略上的短视"
  },
  {
    "start": 304.44,
    "end": 306.16,
    "text": "对这个老板绝望了"
  },
  {
    "start": 306.16,
    "end": 309.0,
    "text": "所以他做出了那个改变历史的选择"
  },
  {
    "start": 309.0,
    "end": 309.54,
    "text": "跳槽"
  },
  {
    "start": 309.54,
    "end": 312.46,
    "text": "转头去投奔了当时处于绝对烈士的刘邦"
  },
  {
    "start": 312.46,
    "end": 316.6,
    "text": "接下来就到了整本书里最让我拍案叫绝的一段"
  },
  {
    "start": 316.6,
    "end": 317.48,
    "text": "面试那段"
  },
  {
    "start": 317.48,
    "end": 317.92,
    "text": "对"
  },
  {
    "start": 317.92,
    "end": 320.1,
    "text": "韩信跟刘邦的那场经典面试"
  },
  {
    "start": 320.1,
    "end": 323.06,
    "text": "这简直就是一趟满分的向上管理教科书"
  },
  {
    "start": 323.06,
    "end": 326.6,
    "text": "韩信拿到了萧和跟夏侯英的利剑"
  },
  {
    "start": 326.6,
    "end": 328.18,
    "text": "终于站到刘邦面前了"
  },
  {
    "start": 328.18,
    "end": 329.78,
    "text": "结果他开口第一件事"
  },
  {
    "start": 329.78,
    "end": 331.66,
    "text": "不是吹自己战术有多牛"
  },
  {
    "start": 331.66,
    "end": 333.74,
    "text": "而是盯着刘邦反问了一句"
  },
  {
    "start": 333.74,
    "end": 335.74,
    "text": "大王何如项羽"
  },
  {
    "start": 335.74,
    "end": 338.06,
    "text": "这是一个极其危险的开唱白"
  },
  {
    "start": 338.06,
    "end": 338.94,
    "text": "也就是问"
  },
  {
    "start": 338.94,
    "end": 341.52,
    "text": "您觉得您比得上项羽吗"
  },
  {
    "start": 341.52,
    "end": 342.46,
    "text": "你想啊"
  },
  {
    "start": 342.46,
    "end": 344.2,
    "text": "在一个等级森严的体系里"
  },
  {
    "start": 344.2,
    "end": 346.3,
    "text": "一个刚提拔上来的无名小卒"
  },
  {
    "start": 346.3,
    "end": 347.6,
    "text": "面对最高领导"
  },
  {
    "start": 347.6,
    "end": 348.28,
    "text": "不表忠心"
  },
  {
    "start": 348.28,
    "end": 351.02,
    "text": "反而抛出一个极度刺耳的灵魂拷问"
  },
  {
    "start": 351.02,
    "end": 352.38,
    "text": "当时的空气"
  },
  {
    "start": 352.38,
    "end": 353.62,
    "text": "估计都凝固了"
  },
  {
    "start": 353.62,
    "end": 355.7,
    "text": "我们可以把这场景放慢"
  },
  {
    "start": 355.7,
    "end": 357.6,
    "text": "韩信其实是在做一场"
  },
  {
    "start": 357.6,
    "end": 359.02,
    "text": "极度危险的心理测试"
  },
  {
    "start": 359.02,
    "end": 361.32,
    "text": "但凡刘邦是个爱面子的人"
  },
  {
    "start": 361.32,
    "end": 363.18,
    "text": "韩信当场就得掉脑袋"
  },
  {
    "start": 363.18,
    "end": 364.14,
    "text": "绝对的"
  },
  {
    "start": 364.14,
    "end": 365.74,
    "text": "但刘邦反应是什么"
  },
  {
    "start": 365.74,
    "end": 367.52,
    "text": "他沉默了一会儿"
  },
  {
    "start": 367.52,
    "end": 368.42,
    "text": "坦诚的承认"
  },
  {
    "start": 368.42,
    "end": 370.08,
    "text": "我确实不如笑语"
  },
  {
    "start": 370.08,
    "end": 371.7,
    "text": "刘邦的这份坦诚"
  },
  {
    "start": 371.7,
    "end": 373.76,
    "text": "恰恰给了韩信发力的指点"
  },
  {
    "start": 373.76,
    "end": 374.72,
    "text": "韩信一听"
  },
  {
    "start": 374.72,
    "end": 377.02,
    "text": "立刻借题发挥向刘邦道喜"
  },
  {
    "start": 377.02,
    "end": 377.98,
    "text": "说大王"
  },
  {
    "start": 377.98,
    "end": 379.3,
    "text": "你有自知之明"
  },
  {
    "start": 379.3,
    "end": 381.12,
    "text": "这就是您能赢的起点"
  },
  {
    "start": 381.12,
    "end": 383.52,
    "text": "这就是韩信最可怕的地方"
  },
  {
    "start": 383.52,
    "end": 385.98,
    "text": "你仔细琢磨他的沟通逻辑"
  },
  {
    "start": 385.98,
    "end": 387.06,
    "text": "他登台之初"
  },
  {
    "start": 387.06,
    "end": 388.12,
    "text": "不仅会打仗"
  },
  {
    "start": 388.12,
    "end": 389.56,
    "text": "还极其懂得揣摩"
  },
  {
    "start": 389.56,
    "end": 390.62,
    "text": "降帅的心理预期"
  },
  {
    "start": 390.62,
    "end": 391.94,
    "text": "先打压"
  },
  {
    "start": 391.94,
    "end": 392.94,
    "text": "再拉升"
  },
  {
    "start": 392.94,
    "end": 393.44,
    "text": "对"
  },
  {
    "start": 393.44,
    "end": 395.1,
    "text": "先用一个尖锐的问题"
  },
  {
    "start": 395.1,
    "end": 396.38,
    "text": "逼老板面对现实"
  },
  {
    "start": 396.38,
    "end": 397.68,
    "text": "承认对手强大"
  },
  {
    "start": 397.68,
    "end": 399.04,
    "text": "降低防御心理"
  },
  {
    "start": 399.04,
    "end": 400.82,
    "text": "等老板防线一放开"
  },
  {
    "start": 400.82,
    "end": 402.16,
    "text": "他再顺理成章"
  },
  {
    "start": 402.16,
    "end": 403.98,
    "text": "抛出自己绝境翻盘的方案"
  },
  {
    "start": 403.98,
    "end": 405.72,
    "text": "这种向上管理的能力"
  },
  {
    "start": 405.72,
    "end": 407.22,
    "text": "跟他打仗一样精妙"
  },
  {
    "start": 407.22,
    "end": 408.34,
    "text": "确实是这样"
  },
  {
    "start": 408.34,
    "end": 410.48,
    "text": "而且当他真正拿到兵权"
  },
  {
    "start": 410.48,
    "end": 412.12,
    "text": "开始展现军事才华时"
  },
  {
    "start": 412.12,
    "end": 414.34,
    "text": "他的思维方式就更让人惊叹了"
  },
  {
    "start": 414.34,
    "end": 415.8,
    "text": "这就把我们带入了"
  },
  {
    "start": 415.8,
    "end": 417.76,
    "text": "他的第一个军事高光时刻"
  },
  {
    "start": 417.76,
    "end": 419.54,
    "text": "与天险的博弈"
  },
  {
    "start": 419.54,
    "end": 420.0,
    "text": "对"
  },
  {
    "start": 420.0,
    "end": 421.96,
    "text": "著名的暗渡陈仓"
  },
  {
    "start": 421.96,
    "end": 423.54,
    "text": "这段太景点了"
  },
  {
    "start": 423.54,
    "end": 426.14,
    "text": "我们还原一下刘邦当时的困境"
  },
  {
    "start": 426.14,
    "end": 427.98,
    "text": "退入汉中的时候"
  },
  {
    "start": 427.98,
    "end": 429.1,
    "text": "为了防备追兵"
  },
  {
    "start": 429.1,
    "end": 431.32,
    "text": "也为了向项羽表态自己不争天下"
  },
  {
    "start": 431.32,
    "end": 433.68,
    "text": "外出的战道已经全被烧了"
  },
  {
    "start": 433.68,
    "end": 435.56,
    "text": "死死困在盆地里了"
  },
  {
    "start": 435.56,
    "end": 436.28,
    "text": "对啊"
  },
  {
    "start": 436.28,
    "end": 437.06,
    "text": "想打出去"
  },
  {
    "start": 437.06,
    "end": 439.3,
    "text": "刘邦问新上任的大将军怎么办"
  },
  {
    "start": 439.3,
    "end": 442.54,
    "text": "韩信给的计策居然是修战道"
  },
  {
    "start": 442.54,
    "end": 443.36,
    "text": "书里写"
  },
  {
    "start": 443.36,
    "end": 446.12,
    "text": "刘邦听完差点气得当场骂出声来"
  },
  {
    "start": 446.12,
    "end": 448.24,
    "text": "这在物理上根本不现实啊"
  },
  {
    "start": 448.24,
    "end": 449.52,
    "text": "烧了的战道重新修"
  },
  {
    "start": 449.52,
    "end": 451.0,
    "text": "胡年马月才能修完"
  },
  {
    "start": 451.0,
    "end": 452.98,
    "text": "但这正是作者眼中"
  },
  {
    "start": 452.98,
    "end": 454.34,
    "text": "韩信兵法精妙的地方"
  },
  {
    "start": 454.34,
    "end": 456.18,
    "text": "大张旗鼓去修战道"
  },
  {
    "start": 456.18,
    "end": 458.14,
    "text": "完全就是个吸引眼球的幌子"
  },
  {
    "start": 458.14,
    "end": 461.22,
    "text": "韩信的目的是要把敌将张寒的注意力"
  },
  {
    "start": 461.22,
    "end": 462.22,
    "text": "全部吸过去"
  },
  {
    "start": 462.22,
    "end": 464.5,
    "text": "每天无数士兵敲敲敲打打"
  },
  {
    "start": 464.5,
    "end": 465.64,
    "text": "声势特别大"
  },
  {
    "start": 465.64,
    "end": 466.1,
    "text": "对"
  },
  {
    "start": 466.1,
    "end": 468.18,
    "text": "而汉军真正要走的"
  },
  {
    "start": 468.18,
    "end": 469.3,
    "text": "是城仓道"
  },
  {
    "start": 469.3,
    "end": 470.38,
    "text": "也就是故道"
  },
  {
    "start": 470.38,
    "end": 473.86,
    "text": "这条路比原本的路线足足多出四百里"
  },
  {
    "start": 473.86,
    "end": 475.24,
    "text": "而且极其难走"
  },
  {
    "start": 475.24,
    "end": 476.04,
    "text": "等等"
  },
  {
    "start": 476.04,
    "end": 478.16,
    "text": "我得挑战一下这个逻辑了"
  },
  {
    "start": 478.16,
    "end": 480.02,
    "text": "从军事常识来看"
  },
  {
    "start": 480.02,
    "end": 482.22,
    "text": "这听起来简直是个极大的冒险"
  },
  {
    "start": 482.22,
    "end": 483.8,
    "text": "你带着几万大军"
  },
  {
    "start": 483.8,
    "end": 485.28,
    "text": "在山里多绕那么远"
  },
  {
    "start": 485.28,
    "end": 487.34,
    "text": "后勤补给是灾难不说"
  },
  {
    "start": 487.34,
    "end": 489.28,
    "text": "万一敌军在城仓有防备呢"
  },
  {
    "start": 489.28,
    "end": 491.16,
    "text": "在那种峡谷里被堵住"
  },
  {
    "start": 491.16,
    "end": 493.64,
    "text": "不就是让士兵排队送死吗"
  },
  {
    "start": 493.64,
    "end": 495.44,
    "text": "问得非常好"
  },
  {
    "start": 495.44,
    "end": 497.48,
    "text": "这也是很多现代军事学者"
  },
  {
    "start": 497.48,
    "end": 499.2,
    "text": "复盘时强烈的质疑"
  },
  {
    "start": 499.2,
    "end": 500.58,
    "text": "作者江郎在书里"
  },
  {
    "start": 500.58,
    "end": 501.84,
    "text": "很明确地指出了这点"
  },
  {
    "start": 501.84,
    "end": 504.46,
    "text": "韩信不是有上帝视角的神"
  },
  {
    "start": 504.46,
    "end": 505.78,
    "text": "他这次行动"
  },
  {
    "start": 505.78,
    "end": 507.66,
    "text": "带有极大的赌博成分"
  },
  {
    "start": 507.66,
    "end": 509.08,
    "text": "赌命啊"
  },
  {
    "start": 509.08,
    "end": 510.74,
    "text": "如果敌军重兵驻守"
  },
  {
    "start": 510.74,
    "end": 512.32,
    "text": "韩信必死无疑"
  },
  {
    "start": 512.32,
    "end": 514.1,
    "text": "那他到底在堵什么"
  },
  {
    "start": 514.1,
    "end": 516.06,
    "text": "凭什么赶下这么大的桌"
  },
  {
    "start": 516.06,
    "end": 518.66,
    "text": "他堵的就是人性的盲曲"
  },
  {
    "start": 518.66,
    "end": 521.26,
    "text": "这就引出书里的一个核心论断"
  },
  {
    "start": 521.26,
    "end": 523.06,
    "text": "韩信真正的敌人"
  },
  {
    "start": 523.06,
    "end": 524.44,
    "text": "不仅是对面的敌军"
  },
  {
    "start": 524.44,
    "end": 525.62,
    "text": "更是秦岭"
  },
  {
    "start": 525.62,
    "end": 527.22,
    "text": "黄河和太行山"
  },
  {
    "start": 527.22,
    "end": 528.88,
    "text": "这些常人眼里的天险"
  },
  {
    "start": 528.88,
    "end": 531.54,
    "text": "他打破了硬碰硬的思维"
  },
  {
    "start": 531.54,
    "end": 531.88,
    "text": "没错"
  },
  {
    "start": 531.88,
    "end": 534.18,
    "text": "他极其善于借力打力"
  },
  {
    "start": 534.18,
    "end": 536.1,
    "text": "他知道张寒的注意力"
  },
  {
    "start": 536.1,
    "end": 537.6,
    "text": "一定会被休战道牵制"
  },
  {
    "start": 537.6,
    "end": 539.74,
    "text": "所以他利用天险做掩护"
  },
  {
    "start": 539.74,
    "end": 542.6,
    "text": "这就是韩信最可怕的杠杆思维"
  },
  {
    "start": 542.6,
    "end": 544.62,
    "text": "用一个微小的表面动作"
  },
  {
    "start": 544.62,
    "end": 546.9,
    "text": "去撬动敌人全局防线崩溃"
  },
  {
    "start": 546.9,
    "end": 549.36,
    "text": "也就是他不仅跟人打仗"
  },
  {
    "start": 549.36,
    "end": 551.14,
    "text": "他还在操控对方的认知"
  },
  {
    "start": 551.14,
    "end": 552.98,
    "text": "这种双重利用"
  },
  {
    "start": 552.98,
    "end": 555.02,
    "text": "后来顺着他的征战轨迹"
  },
  {
    "start": 555.02,
    "end": 557.06,
    "text": "你看他渡黄河的那场围操"
  },
  {
    "start": 557.06,
    "end": 558.88,
    "text": "简直把物理学和心理学"
  },
  {
    "start": 558.88,
    "end": 560.2,
    "text": "结合到了极致"
  },
  {
    "start": 560.2,
    "end": 560.52,
    "text": "是的"
  },
  {
    "start": 560.52,
    "end": 562.22,
    "text": "那是在对阵卫军的时候"
  },
  {
    "start": 562.22,
    "end": 564.68,
    "text": "韩信在黄河西岸大造战船"
  },
  {
    "start": 564.68,
    "end": 566.66,
    "text": "摆出一副要强度的架势"
  },
  {
    "start": 566.66,
    "end": 568.78,
    "text": "把卫军主力死死盯在对岸"
  },
  {
    "start": 568.78,
    "end": 571.04,
    "text": "但实际上他暗中下令"
  },
  {
    "start": 571.04,
    "end": 573.18,
    "text": "用无数的木筏扣上陶罐"
  },
  {
    "start": 573.18,
    "end": 575.6,
    "text": "也就是书里说的木鹰阀"
  },
  {
    "start": 575.6,
    "end": 576.18,
    "text": "嗯"
  },
  {
    "start": 576.18,
    "end": 577.44,
    "text": "木鹰阀"
  },
  {
    "start": 577.44,
    "end": 580.14,
    "text": "悄悄从另一处水流平缓的地方"
  },
  {
    "start": 580.14,
    "end": 581.5,
    "text": "浮水过河"
  },
  {
    "start": 581.5,
    "end": 583.52,
    "text": "你得给大家稍微解释一下"
  },
  {
    "start": 583.52,
    "end": 584.48,
    "text": "这个物理机制"
  },
  {
    "start": 584.48,
    "end": 586.5,
    "text": "陶罐扣在木筏上"
  },
  {
    "start": 586.5,
    "end": 588.5,
    "text": "为什么不直接造船"
  },
  {
    "start": 588.5,
    "end": 590.14,
    "text": "造战船太耗时间了"
  },
  {
    "start": 590.14,
    "end": 591.44,
    "text": "你想象一下"
  },
  {
    "start": 591.44,
    "end": 594.56,
    "text": "把几百个巨大的空心陶罐倒扣过来"
  },
  {
    "start": 594.56,
    "end": 596.62,
    "text": "用粗绳子绑在木架子上"
  },
  {
    "start": 596.62,
    "end": 599.3,
    "text": "罐子里的空气会产生巨大的浮力"
  },
  {
    "start": 599.3,
    "end": 602.84,
    "text": "这种零食木筏的优势在于取材极容易"
  },
  {
    "start": 602.84,
    "end": 604.7,
    "text": "老百姓家里到处都是头罐"
  },
  {
    "start": 604.7,
    "end": 606.66,
    "text": "而且组装速度极快"
  },
  {
    "start": 606.66,
    "end": 609.28,
    "text": "打了一个完美的时间差"
  },
  {
    "start": 609.28,
    "end": 609.9,
    "text": "对"
  },
  {
    "start": 609.9,
    "end": 611.52,
    "text": "信息差加时间差"
  },
  {
    "start": 611.52,
    "end": 613.46,
    "text": "这不仅是声东击西"
  },
  {
    "start": 613.46,
    "end": 614.88,
    "text": "这简直是降维打击"
  },
  {
    "start": 614.88,
    "end": 617.18,
    "text": "而且这种对心理的操控"
  },
  {
    "start": 617.18,
    "end": 619.06,
    "text": "在接下来的井心口之战里"
  },
  {
    "start": 619.06,
    "end": 619.9,
    "text": "打倒了巅峰"
  },
  {
    "start": 619.9,
    "end": 622.22,
    "text": "我们把场景拉到太行山"
  },
  {
    "start": 622.22,
    "end": 624.98,
    "text": "当时韩信面对的是一支号称"
  },
  {
    "start": 624.98,
    "end": 627.32,
    "text": "有十万甚至二十万之中的敌军"
  },
  {
    "start": 627.32,
    "end": 628.4,
    "text": "绝对碾压"
  },
  {
    "start": 628.4,
    "end": 630.72,
    "text": "但韩信手里捏着的是什么"
  },
  {
    "start": 630.72,
    "end": 631.94,
    "text": "都是性兵"
  },
  {
    "start": 631.94,
    "end": 634.82,
    "text": "结果他就选择了最违背场里的"
  },
  {
    "start": 634.82,
    "end": 635.72,
    "text": "背水列阵"
  },
  {
    "start": 635.72,
    "end": 637.5,
    "text": "把军队摆在河边"
  },
  {
    "start": 637.5,
    "end": 638.92,
    "text": "彻底断绝退路"
  },
  {
    "start": 638.92,
    "end": 640.86,
    "text": "在正统兵法上这是找死"
  },
  {
    "start": 640.86,
    "end": 641.84,
    "text": "没错"
  },
  {
    "start": 641.84,
    "end": 644.52,
    "text": "这就像马戏团走钢丝的演员"
  },
  {
    "start": 644.52,
    "end": 646.8,
    "text": "如果你告诉他下面有安全网"
  },
  {
    "start": 646.8,
    "end": 647.82,
    "text": "他可能还会分心"
  },
  {
    "start": 647.82,
    "end": 649.92,
    "text": "但如果你当面把网撤走"
  },
  {
    "start": 649.92,
    "end": 651.68,
    "text": "告诉他掉下去就粉身碎骨"
  },
  {
    "start": 651.68,
    "end": 653.36,
    "text": "他的注意力会瞬间"
  },
  {
    "start": 653.36,
    "end": 654.78,
    "text": "达到非人的高度击重"
  },
  {
    "start": 654.78,
    "end": 657.16,
    "text": "因为大脑底层的恐惧机制"
  },
  {
    "start": 657.16,
    "end": 658.0,
    "text": "接管了身体"
  },
  {
    "start": 658.0,
    "end": 659.82,
    "text": "失败不再是选项"
  },
  {
    "start": 659.82,
    "end": 662.18,
    "text": "韩信这难道不是强行"
  },
  {
    "start": 662.18,
    "end": 663.28,
    "text": "把新兵扔进火坑"
  },
  {
    "start": 663.28,
    "end": 664.42,
    "text": "炸去潜能吗"
  },
  {
    "start": 664.42,
    "end": 666.44,
    "text": "你那比喻极其精准"
  },
  {
    "start": 666.44,
    "end": 668.56,
    "text": "作者结合原书做了深度剖析"
  },
  {
    "start": 668.56,
    "end": 669.84,
    "text": "这其实是一堂"
  },
  {
    "start": 669.84,
    "end": 671.72,
    "text": "极其残酷的军事心理课"
  },
  {
    "start": 671.72,
    "end": 672.88,
    "text": "新兵嘛"
  },
  {
    "start": 672.88,
    "end": 674.64,
    "text": "皆非善战必死之徒"
  },
  {
    "start": 674.64,
    "end": 676.36,
    "text": "只有限制死地"
  },
  {
    "start": 676.36,
    "end": 677.74,
    "text": "才能激发求生本能"
  },
  {
    "start": 677.74,
    "end": 680.0,
    "text": "但如果光是背水一战"
  },
  {
    "start": 680.0,
    "end": 681.0,
    "text": "也就是个莽夫"
  },
  {
    "start": 681.0,
    "end": 683.28,
    "text": "对面号也把你号死了"
  },
  {
    "start": 683.28,
    "end": 685.56,
    "text": "这正是作者想澄清的最大误区"
  },
  {
    "start": 685.56,
    "end": 686.8,
    "text": "书里强调"
  },
  {
    "start": 686.8,
    "end": 688.34,
    "text": "背水战只是个诱饵"
  },
  {
    "start": 688.34,
    "end": 690.88,
    "text": "背后配合了一整个系统"
  },
  {
    "start": 690.88,
    "end": 692.14,
    "text": "连环机"
  },
  {
    "start": 692.14,
    "end": 694.88,
    "text": "他提前派了两千名清旗兵"
  },
  {
    "start": 694.88,
    "end": 696.7,
    "text": "带红旗在山里暗中蹲守"
  },
  {
    "start": 696.7,
    "end": 698.4,
    "text": "他又算转了敌方将领"
  },
  {
    "start": 698.4,
    "end": 699.44,
    "text": "不听劝告的傲慢"
  },
  {
    "start": 699.44,
    "end": 701.4,
    "text": "再加上探子混入敌营"
  },
  {
    "start": 701.4,
    "end": 703.6,
    "text": "缺了任何一环都是死局"
  },
  {
    "start": 703.6,
    "end": 706.76,
    "text": "把心理战情报战融合的完美无暇"
  },
  {
    "start": 706.76,
    "end": 709.02,
    "text": "听到这儿真的觉得脊背发凉"
  },
  {
    "start": 709.02,
    "end": 711.06,
    "text": "凭借这些神威曹"
  },
  {
    "start": 711.06,
    "end": 712.74,
    "text": "韩信一路高歌猛进"
  },
  {
    "start": 712.74,
    "end": 714.36,
    "text": "迎来了军事巅峰"
  },
  {
    "start": 714.36,
    "end": 715.36,
    "text": "改下之位"
  },
  {
    "start": 715.36,
    "end": 716.4,
    "text": "逼死了项羽"
  },
  {
    "start": 716.4,
    "end": 717.52,
    "text": "但谁能想到"
  },
  {
    "start": 717.52,
    "end": 719.66,
    "text": "这竟然也是他命运转折的开始"
  },
  {
    "start": 719.66,
    "end": 721.24,
    "text": "权力的转移"
  },
  {
    "start": 721.24,
    "end": 722.14,
    "text": "开始了"
  },
  {
    "start": 722.14,
    "end": 724.5,
    "text": "很多人说韩信是功高震主"
  },
  {
    "start": 724.5,
    "end": 726.14,
    "text": "但这太抽象了"
  },
  {
    "start": 726.14,
    "end": 728.48,
    "text": "书里给了一套极清晰的权力逻辑"
  },
  {
    "start": 728.48,
    "end": 729.7,
    "text": "看懂权力斗争"
  },
  {
    "start": 729.7,
    "end": 731.2,
    "text": "只需盯住三个动作"
  },
  {
    "start": 731.2,
    "end": 732.12,
    "text": "谁授权"
  },
  {
    "start": 732.12,
    "end": 732.88,
    "text": "谁调兵"
  },
  {
    "start": 732.88,
    "end": 733.68,
    "text": "谁留守"
  },
  {
    "start": 733.68,
    "end": 735.28,
    "text": "作者列举的细节"
  },
  {
    "start": 735.28,
    "end": 736.38,
    "text": "刀刀见血"
  },
  {
    "start": 736.38,
    "end": 738.66,
    "text": "授权是助谈败将"
  },
  {
    "start": 738.66,
    "end": 739.84,
    "text": "刘邦在宣告"
  },
  {
    "start": 739.84,
    "end": 742.16,
    "text": "权力的源头在我这儿"
  },
  {
    "start": 742.16,
    "end": 742.7,
    "text": "调兵是"
  },
  {
    "start": 742.7,
    "end": 744.0,
    "text": "韩信一打胜仗"
  },
  {
    "start": 744.0,
    "end": 746.7,
    "text": "刘邦就屡次派人抽走他的精兵"
  },
  {
    "start": 746.7,
    "end": 748.32,
    "text": "物理打断他建立敌系"
  },
  {
    "start": 748.32,
    "end": 748.8,
    "text": "对"
  },
  {
    "start": 748.8,
    "end": 750.2,
    "text": "留守则是"
  },
  {
    "start": 750.2,
    "end": 751.8,
    "text": "刘邦带主力出击"
  },
  {
    "start": 751.8,
    "end": 753.56,
    "text": "刻意把韩信留在关中"
  },
  {
    "start": 753.56,
    "end": 756.7,
    "text": "绝不让他沾染最核心的决策圈子"
  },
  {
    "start": 756.7,
    "end": 757.24,
    "text": "听到这儿"
  },
  {
    "start": 757.24,
    "end": 760.16,
    "text": "我想到书里一个特别刺痛现实的比喻"
  },
  {
    "start": 760.16,
    "end": 761.04,
    "text": "在刘邦眼里"
  },
  {
    "start": 761.04,
    "end": 763.46,
    "text": "韩信始终是个拿工资的打工仔"
  },
  {
    "start": 763.46,
    "end": 765.48,
    "text": "而萧和张良那些老兄弟"
  },
  {
    "start": 765.48,
    "end": 767.0,
    "text": "才是能分红的股东"
  },
  {
    "start": 767.0,
    "end": 768.6,
    "text": "刘邦依赖他打仗"
  },
  {
    "start": 768.6,
    "end": 770.04,
    "text": "但也时刻限制他"
  },
  {
    "start": 770.04,
    "end": 772.16,
    "text": "一个打工仔如果看不清定位"
  },
  {
    "start": 772.16,
    "end": 773.3,
    "text": "想搞独立山头"
  },
  {
    "start": 773.3,
    "end": 775.42,
    "text": "大股东肯定要下死手的"
  },
  {
    "start": 775.42,
    "end": 778.46,
    "text": "这就引向了最后长乐宫的悲剧"
  },
  {
    "start": 778.46,
    "end": 780.68,
    "text": "这涉及到书中序言的定调"
  },
  {
    "start": 780.68,
    "end": 782.66,
    "text": "致命的木桶效应"
  },
  {
    "start": 782.66,
    "end": 784.22,
    "text": "决定你活多久的"
  },
  {
    "start": 784.22,
    "end": 785.2,
    "text": "不是最长的版"
  },
  {
    "start": 785.2,
    "end": 786.28,
    "text": "而是最短的版"
  },
  {
    "start": 786.28,
    "end": 787.28,
    "text": "完全正确"
  },
  {
    "start": 787.28,
    "end": 789.44,
    "text": "韩信有极长的军事版"
  },
  {
    "start": 789.44,
    "end": 791.8,
    "text": "唯独有一块极短的政治短版"
  },
  {
    "start": 791.8,
    "end": 793.08,
    "text": "他不会做人"
  },
  {
    "start": 793.08,
    "end": 794.2,
    "text": "世财傲武"
  },
  {
    "start": 794.2,
    "end": 795.52,
    "text": "有多夸张"
  },
  {
    "start": 795.52,
    "end": 797.06,
    "text": "书里举了个例子"
  },
  {
    "start": 797.06,
    "end": 799.12,
    "text": "韩信被贬后去拜访梵快"
  },
  {
    "start": 799.12,
    "end": 800.84,
    "text": "梵快极其恭敬"
  },
  {
    "start": 800.84,
    "end": 802.02,
    "text": "自称臣子"
  },
  {
    "start": 802.02,
    "end": 803.4,
    "text": "结果韩信出门"
  },
  {
    "start": 803.4,
    "end": 805.18,
    "text": "竟然当面亲笔的感叹"
  },
  {
    "start": 805.18,
    "end": 808.2,
    "text": "自己沦落到和梵快这种土狗被威武"
  },
  {
    "start": 808.2,
    "end": 809.44,
    "text": "我的天"
  },
  {
    "start": 809.44,
    "end": 811.6,
    "text": "把何欣同僚全得罪了"
  },
  {
    "start": 811.6,
    "end": 814.36,
    "text": "这是毫无政治情商的情绪宣泄"
  },
  {
    "start": 814.36,
    "end": 816.82,
    "text": "这种性格短版加上极高威望"
  },
  {
    "start": 816.82,
    "end": 817.84,
    "text": "就是死局"
  },
  {
    "start": 817.84,
    "end": 820.76,
    "text": "所以作者用了明朝的汤和来对比"
  },
  {
    "start": 820.76,
    "end": 822.98,
    "text": "汤和及时交出兵权"
  },
  {
    "start": 822.98,
    "end": 823.94,
    "text": "躲过猜忌"
  },
  {
    "start": 823.94,
    "end": 826.02,
    "text": "而韩信不懂这个潜规则"
  },
  {
    "start": 826.02,
    "end": 827.5,
    "text": "卧虎之策"
  },
  {
    "start": 827.5,
    "end": 828.88,
    "text": "谁睡其寒"
  },
  {
    "start": 828.88,
    "end": 831.28,
    "text": "刘邦可以和任何人共富贵"
  },
  {
    "start": 831.28,
    "end": 833.68,
    "text": "绝对不可以和韩信共富贵"
  },
  {
    "start": 833.68,
    "end": 835.52,
    "text": "黄泉的定点清除"
  },
  {
    "start": 835.52,
    "end": 837.86,
    "text": "成了韩信悲剧的最终解释"
  },
  {
    "start": 837.86,
    "end": 840.44,
    "text": "刘邦究竟在这件事里有多大责任"
  },
  {
    "start": 840.44,
    "end": 842.18,
    "text": "这些推测靠什么职承"
  }
]
