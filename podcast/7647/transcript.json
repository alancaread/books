[
  {
    "start": 0.0,
    "end": 1.94,
    "text": "人的变化来自年龄"
  },
  {
    "start": 1.94,
    "end": 3.02,
    "text": "生活环境"
  },
  {
    "start": 3.02,
    "end": 4.24,
    "text": "还是所处时代"
  },
  {
    "start": 4.24,
    "end": 5.86,
    "text": "这个问题"
  },
  {
    "start": 5.86,
    "end": 8.24,
    "text": "其实直接就把我们带到了"
  },
  {
    "start": 8.24,
    "end": 10.18,
    "text": "就是发展心理学套装"
  },
  {
    "start": 10.18,
    "end": 12.14,
    "text": "第十版这套书的最深处了"
  },
  {
    "start": 12.14,
    "end": 12.56,
    "text": "没错"
  },
  {
    "start": 12.56,
    "end": 14.48,
    "text": "就是戴安娜帕帕拉"
  },
  {
    "start": 14.48,
    "end": 15.62,
    "text": "萨利奥尔兹"
  },
  {
    "start": 15.62,
    "end": 17.76,
    "text": "还有那个路斯菲尔德曼"
  },
  {
    "start": 17.76,
    "end": 19.08,
    "text": "他们一起写的这套巨著"
  },
  {
    "start": 19.08,
    "end": 19.7,
    "text": "对"
  },
  {
    "start": 19.7,
    "end": 21.16,
    "text": "这套书真的"
  },
  {
    "start": 21.16,
    "end": 22.04,
    "text": "怎么说呢"
  },
  {
    "start": 22.04,
    "end": 23.0,
    "text": "完全颠覆了"
  },
  {
    "start": 23.0,
    "end": 26.06,
    "text": "大家平时对成长的固有看法"
  },
  {
    "start": 26.06,
    "end": 26.5,
    "text": "确实"
  },
  {
    "start": 26.5,
    "end": 29.32,
    "text": "就是平时一提到成长"
  },
  {
    "start": 29.32,
    "end": 30.74,
    "text": "你脑子里可能想到的"
  },
  {
    "start": 30.74,
    "end": 32.32,
    "text": "都是什么婴儿学部"
  },
  {
    "start": 32.32,
    "end": 34.22,
    "text": "或者小朋友背起书包"
  },
  {
    "start": 34.22,
    "end": 34.74,
    "text": "这种画面"
  },
  {
    "start": 34.74,
    "end": 35.04,
    "text": "对吧"
  },
  {
    "start": 35.04,
    "end": 35.42,
    "text": "对"
  },
  {
    "start": 35.42,
    "end": 36.88,
    "text": "很温馨的常规画面"
  },
  {
    "start": 36.88,
    "end": 38.74,
    "text": "但书里其实用了一个"
  },
  {
    "start": 38.74,
    "end": 41.56,
    "text": "特别震撼的真实历史来开场的"
  },
  {
    "start": 41.56,
    "end": 43.6,
    "text": "就在1800年的时候"
  },
  {
    "start": 43.6,
    "end": 46.08,
    "text": "就在法国阿威龙省的"
  },
  {
    "start": 46.08,
    "end": 46.96,
    "text": "那个乡村郊外"
  },
  {
    "start": 46.96,
    "end": 48.04,
    "text": "突然出现了一个"
  },
  {
    "start": 48.04,
    "end": 49.2,
    "text": "光着身子的小男孩"
  },
  {
    "start": 49.2,
    "end": 50.7,
    "text": "这听起来有点"
  },
  {
    "start": 50.7,
    "end": 51.7,
    "text": "有点吓人"
  },
  {
    "start": 51.7,
    "end": 52.26,
    "text": "是啊"
  },
  {
    "start": 52.26,
    "end": 54.78,
    "text": "他当时大概12岁"
  },
  {
    "start": 54.78,
    "end": 56.62,
    "text": "身高才仅仅136厘米"
  },
  {
    "start": 56.62,
    "end": 57.58,
    "text": "天哪"
  },
  {
    "start": 57.58,
    "end": 58.4,
    "text": "这么还小"
  },
  {
    "start": 58.4,
    "end": 58.76,
    "text": "对"
  },
  {
    "start": 58.76,
    "end": 60.84,
    "text": "而且他完全就像野兽一样"
  },
  {
    "start": 60.84,
    "end": 62.02,
    "text": "四肢着地跑"
  },
  {
    "start": 62.02,
    "end": 62.68,
    "text": "去爬树"
  },
  {
    "start": 62.68,
    "end": 63.36,
    "text": "就是靠"
  },
  {
    "start": 63.36,
    "end": 64.72,
    "text": "嚼那个橡树果实"
  },
  {
    "start": 64.72,
    "end": 65.98,
    "text": "还有树根活着的"
  },
  {
    "start": 65.98,
    "end": 68.32,
    "text": "也就是完全脱离人类社会了"
  },
  {
    "start": 68.32,
    "end": 68.78,
    "text": "没错"
  },
  {
    "start": 68.78,
    "end": 70.6,
    "text": "他根本不懂人类语言"
  },
  {
    "start": 70.6,
    "end": 71.04,
    "text": "甚至"
  },
  {
    "start": 71.04,
    "end": 72.1,
    "text": "对冷热"
  },
  {
    "start": 72.1,
    "end": 73.56,
    "text": "疼痛都没什么反应"
  },
  {
    "start": 73.56,
    "end": 74.94,
    "text": "那后来就没人管他吗"
  },
  {
    "start": 74.94,
    "end": 75.78,
    "text": "后来有个叫"
  },
  {
    "start": 75.78,
    "end": 76.74,
    "text": "伊塔德的医生"
  },
  {
    "start": 76.74,
    "end": 77.48,
    "text": "把他带回家了"
  },
  {
    "start": 77.48,
    "end": 78.5,
    "text": "这个年轻医生"
  },
  {
    "start": 78.5,
    "end": 79.8,
    "text": "当时26岁"
  },
  {
    "start": 79.8,
    "end": 81.2,
    "text": "真的特别有热情"
  },
  {
    "start": 81.2,
    "end": 82.12,
    "text": "倾注心血"
  },
  {
    "start": 82.12,
    "end": 83.44,
    "text": "教了他整整五年"
  },
  {
    "start": 83.44,
    "end": 84.9,
    "text": "教了这么久"
  },
  {
    "start": 84.9,
    "end": 86.44,
    "text": "那学会说话了吗"
  },
  {
    "start": 86.44,
    "end": 89.48,
    "text": "其实只学会了任一点点东西的名字"
  },
  {
    "start": 89.48,
    "end": 90.86,
    "text": "或者能表达像"
  },
  {
    "start": 90.86,
    "end": 91.54,
    "text": "骄傲"
  },
  {
    "start": 91.54,
    "end": 92.34,
    "text": "羞愧"
  },
  {
    "start": 92.34,
    "end": 93.34,
    "text": "这种复杂情绪"
  },
  {
    "start": 93.34,
    "end": 94.1,
    "text": "但就是"
  },
  {
    "start": 94.1,
    "end": 96.04,
    "text": "一直没法流利交谈"
  },
  {
    "start": 96.04,
    "end": 97.46,
    "text": "最后他在40岁那年"
  },
  {
    "start": 97.46,
    "end": 98.56,
    "text": "默默理事了"
  },
  {
    "start": 98.56,
    "end": 100.66,
    "text": "这个威科特的故事"
  },
  {
    "start": 100.66,
    "end": 102.02,
    "text": "被放在书的最开头"
  },
  {
    "start": 102.02,
    "end": 103.26,
    "text": "真的是把那个"
  },
  {
    "start": 103.26,
    "end": 105.8,
    "text": "学科里最残酷的核心悬念"
  },
  {
    "start": 105.8,
    "end": 107.04,
    "text": "直接摆在台面上了"
  },
  {
    "start": 107.04,
    "end": 107.72,
    "text": "怎么说"
  },
  {
    "start": 107.72,
    "end": 109.48,
    "text": "就是人的特质"
  },
  {
    "start": 109.48,
    "end": 112.12,
    "text": "到底是受限于天生的基因程序"
  },
  {
    "start": 112.12,
    "end": 114.54,
    "text": "还是完全靠后天环境塑造的"
  },
  {
    "start": 114.54,
    "end": 114.84,
    "text": "对"
  },
  {
    "start": 114.84,
    "end": 116.24,
    "text": "还有更关键的"
  },
  {
    "start": 116.24,
    "end": 119.32,
    "text": "如果错过了成长的某个特定关键期"
  },
  {
    "start": 119.32,
    "end": 121.54,
    "text": "后来的干预还补得回来吗"
  },
  {
    "start": 121.54,
    "end": 125.34,
    "text": "这对渴望看清生命底层逻辑的听众来说"
  },
  {
    "start": 125.34,
    "end": 127.58,
    "text": "真的是没法回避的终极难题"
  },
  {
    "start": 127.58,
    "end": 128.36,
    "text": "是啊"
  },
  {
    "start": 128.36,
    "end": 131.46,
    "text": "当我们看到男孩最后也没补足早年的遗憾"
  },
  {
    "start": 131.46,
    "end": 133.76,
    "text": "大家肯定会产生某种宿命感"
  },
  {
    "start": 133.76,
    "end": 134.62,
    "text": "不过"
  },
  {
    "start": 134.62,
    "end": 137.64,
    "text": "这也刚好引出了书里的核心视角"
  },
  {
    "start": 137.64,
    "end": 137.86,
    "text": "好吧"
  },
  {
    "start": 137.86,
    "end": 139.04,
    "text": "让我们来拆解一下"
  },
  {
    "start": 139.04,
    "end": 143.5,
    "text": "就是发展绝对不是在童年阶段就画上句号的"
  },
  {
    "start": 143.5,
    "end": 144.12,
    "text": "嗯"
  },
  {
    "start": 144.12,
    "end": 146.06,
    "text": "它是一生的漫长演变"
  },
  {
    "start": 146.06,
    "end": 146.9,
    "text": "没错"
  },
  {
    "start": 146.9,
    "end": 148.04,
    "text": "书里强调"
  },
  {
    "start": 148.04,
    "end": 149.18,
    "text": "人的生理"
  },
  {
    "start": 149.18,
    "end": 149.88,
    "text": "认知"
  },
  {
    "start": 149.88,
    "end": 151.08,
    "text": "还有心理社会"
  },
  {
    "start": 151.08,
    "end": 153.78,
    "text": "这三个核心领域是紧紧缠绕"
  },
  {
    "start": 153.78,
    "end": 154.88,
    "text": "互相推动的"
  },
  {
    "start": 154.88,
    "end": 155.52,
    "text": "对"
  },
  {
    "start": 155.52,
    "end": 157.48,
    "text": "他们绝对不是孤立运作的"
  },
  {
    "start": 157.48,
    "end": 158.3,
    "text": "你想啊"
  },
  {
    "start": 158.3,
    "end": 159.5,
    "text": "身体机能衰退了"
  },
  {
    "start": 159.5,
    "end": 161.74,
    "text": "脑子的敏锐度是不是也会跟着受影响"
  },
  {
    "start": 161.74,
    "end": 162.44,
    "text": "是啊"
  },
  {
    "start": 162.44,
    "end": 163.14,
    "text": "反过来"
  },
  {
    "start": 163.14,
    "end": 165.36,
    "text": "要是你身处的情绪状态好"
  },
  {
    "start": 165.36,
    "end": 166.5,
    "text": "社交网络丰富"
  },
  {
    "start": 166.5,
    "end": 168.98,
    "text": "你的免疫系统也会被重塑"
  },
  {
    "start": 169.04,
    "end": 170.06,
    "text": "确实如此"
  },
  {
    "start": 170.06,
    "end": 172.08,
    "text": "其实书里也特别澄清了"
  },
  {
    "start": 172.08,
    "end": 174.8,
    "text": "我们平时习惯给人划分的那些年龄段"
  },
  {
    "start": 174.8,
    "end": 177.42,
    "text": "只是为了组织浩如烟海的知识"
  },
  {
    "start": 177.42,
    "end": 179.2,
    "text": "而设立的一种社会建构"
  },
  {
    "start": 179.2,
    "end": 181.12,
    "text": "社会建构"
  },
  {
    "start": 181.12,
    "end": 184.12,
    "text": "就是人为设定的辅助框架呗"
  },
  {
    "start": 184.12,
    "end": 184.44,
    "text": "没错"
  },
  {
    "start": 184.44,
    "end": 186.94,
    "text": "它绝对不是衡量个人价值的及格线"
  },
  {
    "start": 186.94,
    "end": 189.74,
    "text": "根本没有任何客观的生物学标准能说"
  },
  {
    "start": 189.74,
    "end": 192.6,
    "text": "人在哪个瞬间突然就变成了成年人"
  },
  {
    "start": 192.6,
    "end": 195.28,
    "text": "或者在哪个早晨忽然步入暮年"
  },
  {
    "start": 195.28,
    "end": 197.36,
    "text": "这就很有意思了"
  },
  {
    "start": 197.36,
    "end": 201.3,
    "text": "因为这正好点出了我们常犯的一个致命错误"
  },
  {
    "start": 201.3,
    "end": 204.24,
    "text": "正在通行路上或者边做家务边听节目的你"
  },
  {
    "start": 204.24,
    "end": 205.8,
    "text": "可能也会有这种体会"
  },
  {
    "start": 205.8,
    "end": 209.8,
    "text": "就是把人生当成了一个带有严苛节点的进度条"
  },
  {
    "start": 209.8,
    "end": 211.02,
    "text": "太对了"
  },
  {
    "start": 211.02,
    "end": 212.94,
    "text": "经常有这种莫名其妙的焦虑"
  },
  {
    "start": 212.94,
    "end": 213.76,
    "text": "对吧"
  },
  {
    "start": 213.76,
    "end": 217.42,
    "text": "总觉得到了特定岁数就应该完成事业晋升"
  },
  {
    "start": 217.42,
    "end": 218.42,
    "text": "或者结婚生子"
  },
  {
    "start": 218.42,
    "end": 219.66,
    "text": "如果没有达标"
  },
  {
    "start": 219.66,
    "end": 221.98,
    "text": "就陷入深深的自我怀疑"
  },
  {
    "start": 221.98,
    "end": 225.14,
    "text": "其实只有抛开这些被社会强加的刻板期望"
  },
  {
    "start": 225.14,
    "end": 226.9,
    "text": "你才能看清真实的轨迹"
  },
  {
    "start": 226.9,
    "end": 228.48,
    "text": "不按常理出牌"
  },
  {
    "start": 228.48,
    "end": 230.24,
    "text": "才是生命的常态"
  },
  {
    "start": 230.24,
    "end": 232.4,
    "text": "那既然年龄阶段不能死板对待"
  },
  {
    "start": 232.4,
    "end": 234.4,
    "text": "专家到底是怎么确切知道"
  },
  {
    "start": 234.4,
    "end": 235.6,
    "text": "随着年岁增长"
  },
  {
    "start": 235.6,
    "end": 237.3,
    "text": "人究竟会发生哪些改变呢"
  },
  {
    "start": 237.3,
    "end": 240.1,
    "text": "这就必须看结论背后的测算方法了吧"
  },
  {
    "start": 240.1,
    "end": 240.52,
    "text": "对"
  },
  {
    "start": 240.52,
    "end": 242.42,
    "text": "这就涉及看数据的尺子了"
  },
  {
    "start": 242.42,
    "end": 246.06,
    "text": "现今极为普遍的做法叫横断研究"
  },
  {
    "start": 246.06,
    "end": 250.96,
    "text": "就是在相同的时间点找不同年纪的群体来进行对比"
  },
  {
    "start": 250.96,
    "end": 253.32,
    "text": "这个听起来好像挺合理的"
  },
  {
    "start": 253.32,
    "end": 255.28,
    "text": "他确实出结果极快"
  },
  {
    "start": 255.28,
    "end": 256.56,
    "text": "既省钱又高效"
  },
  {
    "start": 256.56,
    "end": 258.28,
    "text": "但他有个致命缺陷"
  },
  {
    "start": 258.28,
    "end": 262.9,
    "text": "就是极其容易把时代差异误认成年龄衰退"
  },
  {
    "start": 262.9,
    "end": 263.22,
    "text": "等等"
  },
  {
    "start": 263.22,
    "end": 263.84,
    "text": "什么意思"
  },
  {
    "start": 263.84,
    "end": 264.72,
    "text": "能具体说说吗"
  },
  {
    "start": 264.72,
    "end": 269.18,
    "text": "比如让你去跟毫无网络经验的前辈比拼电脑操作"
  },
  {
    "start": 269.18,
    "end": 271.96,
    "text": "前辈的得分肯定踩不人堵"
  },
  {
    "start": 271.96,
    "end": 274.5,
    "text": "但这能说明老人家大脑退化了吗"
  },
  {
    "start": 274.5,
    "end": 275.34,
    "text": "当然不能"
  },
  {
    "start": 275.34,
    "end": 277.9,
    "text": "这纯粹是因为时代变迁造成的鸿沟"
  },
  {
    "start": 277.9,
    "end": 280.7,
    "text": "老前辈年轻时压根没接触过类似技术"
  },
  {
    "start": 280.7,
    "end": 281.2,
    "text": "对"
  },
  {
    "start": 281.2,
    "end": 283.66,
    "text": "如果盲目相信这类静态数据"
  },
  {
    "start": 283.66,
    "end": 287.78,
    "text": "岂不是硬生生把这口锅扣在了岁月催人老的头上"
  },
  {
    "start": 287.78,
    "end": 288.9,
    "text": "确实太荒谬了"
  },
  {
    "start": 288.9,
    "end": 290.7,
    "text": "那怎么修正这种偏差呢"
  },
  {
    "start": 290.7,
    "end": 292.94,
    "text": "学者们一开始尝试了纵向追踪"
  },
  {
    "start": 292.94,
    "end": 295.86,
    "text": "就是死盯着同一批人测上几十年"
  },
  {
    "start": 295.86,
    "end": 299.84,
    "text": "但这也会有受测者中途退出之类的干扰"
  },
  {
    "start": 299.84,
    "end": 301.54,
    "text": "所以这里令人着迷的是"
  },
  {
    "start": 301.54,
    "end": 304.88,
    "text": "书里详细剖析了一个结合两者优势的"
  },
  {
    "start": 304.88,
    "end": 306.32,
    "text": "序列研究法"
  },
  {
    "start": 306.32,
    "end": 309.44,
    "text": "以西雅图研究为代表的这套方法"
  },
  {
    "start": 309.44,
    "end": 311.64,
    "text": "真正做到了把时代变迁"
  },
  {
    "start": 311.64,
    "end": 314.28,
    "text": "从岁月流逝里完美剥离出来"
  },
  {
    "start": 314.28,
    "end": 316.56,
    "text": "西雅图研究是怎么做的"
  },
  {
    "start": 316.56,
    "end": 319.38,
    "text": "这项庞大工程是从1956年启动的"
  },
  {
    "start": 319.38,
    "end": 322.0,
    "text": "起初随机招募了500名参与者"
  },
  {
    "start": 322.0,
    "end": 323.86,
    "text": "跨度极其惊人"
  },
  {
    "start": 323.86,
    "end": 326.94,
    "text": "涵盖了22到67岁的广泛人群"
  },
  {
    "start": 326.94,
    "end": 327.2,
    "text": "哇"
  },
  {
    "start": 327.2,
    "end": 328.54,
    "text": "那怎么一直追踪呢"
  },
  {
    "start": 328.54,
    "end": 333.02,
    "text": "他们不仅每隔七年对原班人马重新进行严苛测试"
  },
  {
    "start": 333.02,
    "end": 336.64,
    "text": "还会同时拉入全新的同龄人作为对照组"
  },
  {
    "start": 336.64,
    "end": 339.52,
    "text": "首批梯队包含了男女各25人"
  },
  {
    "start": 339.52,
    "end": 342.42,
    "text": "去精细测量六种基本心理能力"
  },
  {
    "start": 342.42,
    "end": 344.0,
    "text": "就这样一直测下去"
  },
  {
    "start": 344.0,
    "end": 344.66,
    "text": "没错"
  },
  {
    "start": 344.66,
    "end": 346.96,
    "text": "像滚雪球一样持续追踪"
  },
  {
    "start": 346.96,
    "end": 351.14,
    "text": "直到1994年总计积累了约5000人的海量数据"
  },
  {
    "start": 351.14,
    "end": 351.9,
    "text": "天哪"
  },
  {
    "start": 351.9,
    "end": 354.78,
    "text": "这种极其费时费力的笨功夫"
  },
  {
    "start": 354.78,
    "end": 356.18,
    "text": "简直令人敬畏"
  },
  {
    "start": 356.18,
    "end": 358.56,
    "text": "靠着这种严密剥离"
  },
  {
    "start": 358.56,
    "end": 360.86,
    "text": "他们到底发现了什么震撼的真相"
  },
  {
    "start": 360.86,
    "end": 363.64,
    "text": "数据彻底击碎了诸多伪科学传说"
  },
  {
    "start": 363.64,
    "end": 365.82,
    "text": "大部分人的多数认知能力"
  },
  {
    "start": 365.82,
    "end": 368.68,
    "text": "在60岁前根本没有任何显著下降"
  },
  {
    "start": 368.68,
    "end": 369.34,
    "text": "哇"
  },
  {
    "start": 369.34,
    "end": 370.26,
    "text": "真的吗"
  },
  {
    "start": 370.26,
    "end": 370.82,
    "text": "真的"
  },
  {
    "start": 370.82,
    "end": 374.32,
    "text": "而且更具颠覆性的是代际间的横向对比"
  },
  {
    "start": 374.32,
    "end": 375.48,
    "text": "数据显示"
  },
  {
    "start": 375.48,
    "end": 377.02,
    "text": "出生越晚的群体"
  },
  {
    "start": 377.02,
    "end": 380.02,
    "text": "在逻辑推理和词汇运用上表现越好"
  },
  {
    "start": 380.02,
    "end": 383.48,
    "text": "这是因为教育普及和生活方式更健康了吧"
  },
  {
    "start": 383.48,
    "end": 384.22,
    "text": "没错"
  },
  {
    "start": 384.22,
    "end": 386.9,
    "text": "但是在基础数字运算能力上"
  },
  {
    "start": 386.9,
    "end": 389.88,
    "text": "从1924年出生的那批受测者往后"
  },
  {
    "start": 389.88,
    "end": 391.84,
    "text": "竟然呈现出下滑趋势"
  },
  {
    "start": 391.84,
    "end": 394.36,
    "text": "数字能力反而下滑了"
  },
  {
    "start": 394.36,
    "end": 398.12,
    "text": "这简直是对职场年龄歧视极其有利的反击"
  },
  {
    "start": 398.12,
    "end": 399.38,
    "text": "绝对的"
  },
  {
    "start": 399.38,
    "end": 401.86,
    "text": "各项能力有着各自独立的抛物线"
  },
  {
    "start": 401.86,
    "end": 406.94,
    "text": "所以既不存在脑子过了中年就彻底生锈的断崖式衰退"
  },
  {
    "start": 406.94,
    "end": 410.68,
    "text": "也推翻了长者里应当更加睿智的盲目自信"
  },
  {
    "start": 410.68,
    "end": 412.7,
    "text": "同龄人之间的个体差异"
  },
  {
    "start": 412.7,
    "end": 415.58,
    "text": "往往比跨年龄段群体的差异还要巨大"
  },
  {
    "start": 415.58,
    "end": 416.26,
    "text": "是的"
  },
  {
    "start": 416.26,
    "end": 419.58,
    "text": "掌握了这把科学看待数据的精准尺子"
  },
  {
    "start": 419.58,
    "end": 422.18,
    "text": "你不妨把目光倒回生命的起点"
  },
  {
    "start": 422.4,
    "end": 427.04,
    "text": "看看先天的脾气和后天的环境究竟是如何激烈交锋的"
  },
  {
    "start": 427.04,
    "end": 429.62,
    "text": "这里才是真正有趣的地方"
  },
  {
    "start": 429.62,
    "end": 432.4,
    "text": "平时我们总觉得带孩子心力交瘁"
  },
  {
    "start": 432.4,
    "end": 433.94,
    "text": "是因为孩子脾气太差"
  },
  {
    "start": 433.94,
    "end": 437.04,
    "text": "但当我们翻看那个纽约纵向研究时"
  },
  {
    "start": 437.04,
    "end": 440.44,
    "text": "会发现婴儿的气质被极其细致的归类了"
  },
  {
    "start": 440.44,
    "end": 440.98,
    "text": "嗯"
  },
  {
    "start": 440.98,
    "end": 442.06,
    "text": "是怎么分类的"
  },
  {
    "start": 442.06,
    "end": 444.66,
    "text": "就是容易性占40%"
  },
  {
    "start": 444.66,
    "end": 445.16,
    "text": "嗯哼"
  },
  {
    "start": 445.16,
    "end": 447.26,
    "text": "困难性占10%"
  },
  {
    "start": 447.26,
    "end": 448.76,
    "text": "慢热性有15%"
  },
  {
    "start": 448.76,
    "end": 450.92,
    "text": "然后还有约三分之一的孩子"
  },
  {
    "start": 450.92,
    "end": 453.14,
    "text": "是并不符合这些固定框架的"
  },
  {
    "start": 453.14,
    "end": 455.2,
    "text": "很多家长一看到困难二字"
  },
  {
    "start": 455.2,
    "end": 456.88,
    "text": "估计就如临大敌了"
  },
  {
    "start": 456.88,
    "end": 457.44,
    "text": "是啊"
  },
  {
    "start": 457.44,
    "end": 460.54,
    "text": "总觉得自家的宝宝是不是出厂设置自带缺陷"
  },
  {
    "start": 460.54,
    "end": 461.04,
    "text": "缺陷"
  },
  {
    "start": 461.04,
    "end": 461.9,
    "text": "绝非如此"
  },
  {
    "start": 461.9,
    "end": 465.52,
    "text": "这项分类蕴含着全书极为耀眼的核心概念"
  },
  {
    "start": 465.52,
    "end": 466.48,
    "text": "吻合度"
  },
  {
    "start": 466.48,
    "end": 467.72,
    "text": "吻合度"
  },
  {
    "start": 467.72,
    "end": 469.0,
    "text": "这该怎么理解"
  },
  {
    "start": 469.0,
    "end": 470.5,
    "text": "所谓困难性"
  },
  {
    "start": 470.5,
    "end": 473.06,
    "text": "根本不是指孩子存在病理性缺陷"
  },
  {
    "start": 473.06,
    "end": 474.48,
    "text": "它真正揭示的是"
  },
  {
    "start": 474.48,
    "end": 477.16,
    "text": "孩子自带的神经活跃系统"
  },
  {
    "start": 477.16,
    "end": 478.78,
    "text": "与周围环境的要求之间"
  },
  {
    "start": 478.78,
    "end": 480.82,
    "text": "存在着严重的摩擦缝隙"
  },
  {
    "start": 480.82,
    "end": 481.76,
    "text": "哦"
  },
  {
    "start": 481.76,
    "end": 484.32,
    "text": "这就好比植物与土壤的关系"
  },
  {
    "start": 484.32,
    "end": 488.18,
    "text": "我们绝不能指责某株热带植物是困难型的"
  },
  {
    "start": 488.18,
    "end": 491.5,
    "text": "它只是碰巧被种在了寒冬腊月的雪地里"
  },
  {
    "start": 491.5,
    "end": 493.82,
    "text": "当然会疯狂反抗"
  },
  {
    "start": 493.82,
    "end": 495.04,
    "text": "极其精准的比喻"
  },
  {
    "start": 495.04,
    "end": 498.34,
    "text": "环境绝不仅是供人涂抹的静态化布"
  },
  {
    "start": 498.34,
    "end": 501.82,
    "text": "它是决定种子能否破土而出的培养剂"
  },
  {
    "start": 501.82,
    "end": 502.76,
    "text": "所以"
  },
  {
    "start": 502.76,
    "end": 505.8,
    "text": "假如你要求一个极其活跃的孩子"
  },
  {
    "start": 505.8,
    "end": 507.6,
    "text": "必须连续坐立不动"
  },
  {
    "start": 507.6,
    "end": 509.44,
    "text": "或者把适应急慢的孩子"
  },
  {
    "start": 509.44,
    "end": 511.76,
    "text": "不断推向喧闹的陌生派对"
  },
  {
    "start": 511.76,
    "end": 514.38,
    "text": "情绪大爆发是必然发生的"
  },
  {
    "start": 514.38,
    "end": 515.06,
    "text": "对"
  },
  {
    "start": 515.06,
    "end": 516.68,
    "text": "健康的调整策略"
  },
  {
    "start": 516.68,
    "end": 519.4,
    "text": "绝不是强行扭转孩子的天性"
  },
  {
    "start": 519.4,
    "end": 521.9,
    "text": "而是努力改善那道缝隙"
  },
  {
    "start": 521.9,
    "end": 522.26,
    "text": "没错"
  },
  {
    "start": 522.26,
    "end": 525.14,
    "text": "对于正深陷育儿焦虑的听众而言"
  },
  {
    "start": 525.14,
    "end": 528.4,
    "text": "与其整天担忧自家骨肉是不是有问题"
  },
  {
    "start": 528.4,
    "end": 530.24,
    "text": "不如换个视角审视"
  },
  {
    "start": 530.24,
    "end": 531.92,
    "text": "家庭提供的土壤"
  },
  {
    "start": 531.92,
    "end": 534.32,
    "text": "究竟适不适合这颗种子的本性"
  },
  {
    "start": 534.32,
    "end": 535.18,
    "text": "而且"
  },
  {
    "start": 535.18,
    "end": 536.72,
    "text": "书里也明确证实"
  },
  {
    "start": 536.72,
    "end": 539.6,
    "text": "只要抚养者学会了恰当的安抚方式"
  },
  {
    "start": 539.6,
    "end": 541.04,
    "text": "亲子间的依赖关系"
  },
  {
    "start": 541.04,
    "end": 543.28,
    "text": "完全能够朝着积极方向重塑"
  },
  {
    "start": 543.28,
    "end": 546.28,
    "text": "既然童年时期的这种困难"
  },
  {
    "start": 546.28,
    "end": 549.0,
    "text": "本质上只是环境土壤的不匹配"
  },
  {
    "start": 549.0,
    "end": 551.4,
    "text": "那当人们步入成年"
  },
  {
    "start": 551.4,
    "end": 554.62,
    "text": "社会上口口相传的那些必然危机"
  },
  {
    "start": 554.62,
    "end": 558.74,
    "text": "会不会同样也只是一种被无限夸大的刻板印象呢"
  },
  {
    "start": 559.0,
    "end": 563.8,
    "text": "你是指大家都很恐慌的那个必定会砸下来的雷吗"
  },
  {
    "start": 563.8,
    "end": 564.7,
    "text": "没错"
  },
  {
    "start": 564.7,
    "end": 568.16,
    "text": "特别是那个让无数人闻风丧胆的词汇"
  },
  {
    "start": 568.16,
    "end": 570.26,
    "text": "只要过了某个特定岁数"
  },
  {
    "start": 570.26,
    "end": 572.4,
    "text": "哪怕你只是因为工作累了"
  },
  {
    "start": 572.4,
    "end": 574.04,
    "text": "稍微有点情绪波动"
  },
  {
    "start": 574.04,
    "end": 576.64,
    "text": "旁人马上就会拿那个词来定义你"
  },
  {
    "start": 576.64,
    "end": 579.76,
    "text": "仿佛你正在经历某种不可救药的精神崩溃"
  },
  {
    "start": 579.76,
    "end": 582.48,
    "text": "其实心理学家艾瑞特亚克"
  },
  {
    "start": 582.48,
    "end": 586.48,
    "text": "早在1967年就首创了中年危机这套概念"
  },
  {
    "start": 586.48,
    "end": 588.72,
    "text": "后来的莱文森更是断言"
  },
  {
    "start": 588.72,
    "end": 592.58,
    "text": "这种危机是所有人不可避免的宿命劫难"
  },
  {
    "start": 592.58,
    "end": 595.56,
    "text": "大家好像确实都被这套理论吓住了"
  },
  {
    "start": 595.56,
    "end": 599.22,
    "text": "但如果我们把它和更大的图景联系起来看"
  },
  {
    "start": 599.22,
    "end": 601.66,
    "text": "教材里抛出了极其有力的反驳"
  },
  {
    "start": 601.66,
    "end": 605.82,
    "text": "所谓必然发生的危机其实极少真正应验"
  },
  {
    "start": 605.82,
    "end": 606.98,
    "text": "真的极少发生"
  },
  {
    "start": 606.98,
    "end": 607.34,
    "text": "真的"
  },
  {
    "start": 607.34,
    "end": 611.06,
    "text": "大批成年人反而在经历生命效能的高峰"
  },
  {
    "start": 611.06,
    "end": 614.2,
    "text": "书中甚至举了个极其精彩的跨文化反例"
  },
  {
    "start": 614.2,
    "end": 616.0,
    "text": "肯亚西南部古西人"
  },
  {
    "start": 616.0,
    "end": 617.82,
    "text": "他们是怎么看待中年的"
  },
  {
    "start": 617.82,
    "end": 619.96,
    "text": "在他们的传统部落秩序中"
  },
  {
    "start": 619.96,
    "end": 622.38,
    "text": "人生阶段是完全按照生育"
  },
  {
    "start": 622.38,
    "end": 624.44,
    "text": "和延续后代的能力来划分的"
  },
  {
    "start": 624.44,
    "end": 625.66,
    "text": "在那个社会里"
  },
  {
    "start": 625.66,
    "end": 629.22,
    "text": "压根就不存在中年这种清晰的焦虑概念"
  },
  {
    "start": 629.22,
    "end": 629.92,
    "text": "哇"
  },
  {
    "start": 629.92,
    "end": 631.46,
    "text": "同样的岁月流逝"
  },
  {
    "start": 631.46,
    "end": 633.42,
    "text": "在不同的文化规则下"
  },
  {
    "start": 633.42,
    "end": 635.64,
    "text": "竟然意味着截然不同的境遇"
  },
  {
    "start": 635.64,
    "end": 639.26,
    "text": "假如正收听节目的你恰巧45岁"
  },
  {
    "start": 639.26,
    "end": 640.36,
    "text": "事业稳健"
  },
  {
    "start": 640.36,
    "end": 641.68,
    "text": "生活也算舒心"
  },
  {
    "start": 641.68,
    "end": 644.26,
    "text": "但周围亲友非要凑过来怜悯的说"
  },
  {
    "start": 644.26,
    "end": 645.02,
    "text": "别急"
  },
  {
    "start": 645.02,
    "end": 647.3,
    "text": "你的中年危机还没来呢"
  },
  {
    "start": 647.3,
    "end": 649.34,
    "text": "那就是纯粹把学术理论"
  },
  {
    "start": 649.34,
    "end": 651.94,
    "text": "当成了强行测量他人的紧箍咒了"
  },
  {
    "start": 651.94,
    "end": 653.94,
    "text": "既傲慢又荒谬"
  },
  {
    "start": 653.94,
    "end": 656.04,
    "text": "如果不符合理论模型"
  },
  {
    "start": 656.04,
    "end": 657.72,
    "text": "错的绝对是理论"
  },
  {
    "start": 657.72,
    "end": 659.46,
    "text": "而绝非活生生的人"
  },
  {
    "start": 659.46,
    "end": 660.64,
    "text": "完全同意"
  },
  {
    "start": 660.64,
    "end": 662.36,
    "text": "当我们彻底放下"
  },
  {
    "start": 662.36,
    "end": 663.68,
    "text": "对中年的无畏焦虑"
  },
  {
    "start": 663.68,
    "end": 665.42,
    "text": "继续沿着时间线前行"
  },
  {
    "start": 665.42,
    "end": 668.0,
    "text": "迈向生命的晚期乃至终点时"
  },
  {
    "start": 668.0,
    "end": 669.56,
    "text": "真正严峻的考验"
  },
  {
    "start": 669.56,
    "end": 670.86,
    "text": "才会渐渐显露"
  },
  {
    "start": 670.86,
    "end": 673.44,
    "text": "随着现代医疗的发展"
  },
  {
    "start": 673.44,
    "end": 675.38,
    "text": "多代同堂越来越普遍"
  },
  {
    "start": 675.38,
    "end": 677.22,
    "text": "随之而来的照护重担"
  },
  {
    "start": 677.22,
    "end": 679.78,
    "text": "确实压在了很多成年人肩头"
  },
  {
    "start": 679.78,
    "end": 680.34,
    "text": "是的"
  },
  {
    "start": 680.34,
    "end": 682.66,
    "text": "假如你正在默默承担重任"
  },
  {
    "start": 682.66,
    "end": 683.88,
    "text": "照顾年迈的父母"
  },
  {
    "start": 683.88,
    "end": 685.42,
    "text": "你必然深有体会"
  },
  {
    "start": 685.42,
    "end": 686.82,
    "text": "父母康健时"
  },
  {
    "start": 686.82,
    "end": 687.74,
    "text": "家庭很融洽"
  },
  {
    "start": 687.74,
    "end": 689.3,
    "text": "可一旦长辈衰弱"
  },
  {
    "start": 689.3,
    "end": 691.04,
    "text": "把照护者压垮的"
  },
  {
    "start": 691.04,
    "end": 692.78,
    "text": "往往并非端茶倒水"
  },
  {
    "start": 692.78,
    "end": 694.46,
    "text": "这些体力层面的劳作"
  },
  {
    "start": 694.46,
    "end": 695.52,
    "text": "确实"
  },
  {
    "start": 695.52,
    "end": 697.72,
    "text": "体力上的泪还能缓过来"
  },
  {
    "start": 697.72,
    "end": 698.16,
    "text": "对"
  },
  {
    "start": 698.16,
    "end": 699.96,
    "text": "真正的压力是在于"
  },
  {
    "start": 699.96,
    "end": 702.24,
    "text": "当老人智力出现不可逆衰退"
  },
  {
    "start": 702.24,
    "end": 703.88,
    "text": "或者性格发生骤变时"
  },
  {
    "start": 703.88,
    "end": 707.3,
    "text": "那种最亲密关系中撕裂般的紧张感"
  },
  {
    "start": 707.3,
    "end": 709.9,
    "text": "眼睁睁看着最熟悉的长辈"
  },
  {
    "start": 709.9,
    "end": 711.2,
    "text": "变得极其陌生"
  },
  {
    "start": 711.2,
    "end": 712.28,
    "text": "那种无力感"
  },
  {
    "start": 712.28,
    "end": 714.12,
    "text": "才是最沉重的精神负担"
  },
  {
    "start": 714.12,
    "end": 715.92,
    "text": "这种孤独的重压"
  },
  {
    "start": 715.92,
    "end": 718.06,
    "text": "急需被社会温柔的看见"
  },
  {
    "start": 718.06,
    "end": 719.9,
    "text": "而且不仅是衰老"
  },
  {
    "start": 719.9,
    "end": 722.08,
    "text": "面对死亡这个终极命题"
  },
  {
    "start": 722.08,
    "end": 723.96,
    "text": "大众同样极易掉进"
  },
  {
    "start": 723.96,
    "end": 725.12,
    "text": "刻板理论的陷阱"
  },
  {
    "start": 725.12,
    "end": 727.62,
    "text": "你是说那个很有名的"
  },
  {
    "start": 727.62,
    "end": 728.76,
    "text": "临终阶段理论吗"
  },
  {
    "start": 728.76,
    "end": 729.26,
    "text": "对"
  },
  {
    "start": 729.26,
    "end": 732.8,
    "text": "库伯勒罗斯访谈了500名临终患者后"
  },
  {
    "start": 732.8,
    "end": 736.64,
    "text": "提炼出的那套广为人知的心理防御流转机制"
  },
  {
    "start": 736.64,
    "end": 737.74,
    "text": "否认"
  },
  {
    "start": 737.74,
    "end": 738.48,
    "text": "愤怒"
  },
  {
    "start": 738.48,
    "end": 739.6,
    "text": "讨价还价"
  },
  {
    "start": 739.6,
    "end": 740.3,
    "text": "沮丧"
  },
  {
    "start": 740.3,
    "end": 741.64,
    "text": "以及最终的接受"
  },
  {
    "start": 741.64,
    "end": 746.58,
    "text": "这确实敏锐捕捉到了生命镜头特有的内心风暴啊"
  },
  {
    "start": 746.58,
    "end": 748.26,
    "text": "难道这也有误解"
  },
  {
    "start": 748.26,
    "end": 751.62,
    "text": "这恰恰是被外界误解最深的区域"
  },
  {
    "start": 751.62,
    "end": 757.3,
    "text": "外界经常把这五个阶段当成给丧亲家属规定的标准化哀伤进度条"
  },
  {
    "start": 757.3,
    "end": 759.8,
    "text": "也就是强加给其他人"
  },
  {
    "start": 759.8,
    "end": 763.46,
    "text": "要求家属必须按照这个步骤一步步走出来"
  },
  {
    "start": 763.46,
    "end": 764.46,
    "text": "没错"
  },
  {
    "start": 764.46,
    "end": 769.44,
    "text": "但这只是对临终病人面对自身生命流逝时心理轨迹的观察"
  },
  {
    "start": 769.44,
    "end": 771.9,
    "text": "真实的人性极其复杂由甚"
  },
  {
    "start": 771.9,
    "end": 772.86,
    "text": "确实"
  },
  {
    "start": 772.86,
    "end": 776.76,
    "text": "丧心者与临终病患面对的心理丧失截然不同"
  },
  {
    "start": 776.76,
    "end": 781.04,
    "text": "你可能会在极度愤怒和深度沮丧之间反复横跳"
  },
  {
    "start": 781.04,
    "end": 785.5,
    "text": "甚至在相同瞬间同时体验这两种极端的撕裂痛苦"
  },
  {
    "start": 785.5,
    "end": 789.1,
    "text": "要求伤痛必须按照固定步骤稳步消散"
  },
  {
    "start": 789.1,
    "end": 791.36,
    "text": "本身就是极其残忍的暴政"
  },
  {
    "start": 791.36,
    "end": 793.66,
    "text": "所以所有的阶段模型"
  },
  {
    "start": 793.66,
    "end": 795.68,
    "text": "气质分类或是悲伤曲线"
  },
  {
    "start": 795.68,
    "end": 797.8,
    "text": "无论听起来多么具有权威感"
  },
  {
    "start": 797.8,
    "end": 801.24,
    "text": "都仅仅是帮助我们整理复杂经历的辅助工具而已"
  },
  {
    "start": 801.24,
    "end": 804.32,
    "text": "那么这一切究竟意味着什么呢"
  },
  {
    "start": 804.32,
    "end": 806.72,
    "text": "假如活生生的个体经历"
  },
  {
    "start": 806.72,
    "end": 808.98,
    "text": "并不符合这些冰冷的理论模型"
  },
  {
    "start": 808.98,
    "end": 812.26,
    "text": "该被质疑和修改的永远是理论本身"
  },
  {
    "start": 812.26,
    "end": 815.64,
    "text": "而不是转过头去指责对方没走对路线"
  },
  {
    "start": 815.64,
    "end": 816.96,
    "text": "或者极不正常"
  },
  {
    "start": 816.96,
    "end": 820.2,
    "text": "无论是面对婴儿天生的独特气质"
  },
  {
    "start": 820.2,
    "end": 822.78,
    "text": "还是晚年错综复杂的哀伤过程"
  },
  {
    "start": 822.78,
    "end": 824.6,
    "text": "你都要学会给自己"
  },
  {
    "start": 824.6,
    "end": 825.74,
    "text": "也给身边的亲友"
  },
  {
    "start": 825.74,
    "end": 829.14,
    "text": "溜出足够的不按俱本走的从容余地"
  },
  {
    "start": 829.14,
    "end": 832.26,
    "text": "毕生发展的画卷之所以动人心魄"
  },
  {
    "start": 832.26,
    "end": 836.18,
    "text": "恰恰在于那些无法被轻易预测的斑斓涂抹"
  },
  {
    "start": 836.18,
    "end": 836.86,
    "text": "对"
  },
  {
    "start": 836.86,
    "end": 839.04,
    "text": "正是这些意料之外的变化"
  },
  {
    "start": 839.04,
    "end": 840.48,
    "text": "才构成了完整的一生"
  },
  {
    "start": 840.48,
    "end": 844.64,
    "text": "书中哪类研究最能看出先天条件"
  },
  {
    "start": 844.64,
    "end": 846.54,
    "text": "与后天经历彼此缠绕"
  }
]
