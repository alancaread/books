  {
    "start": 554.6,
    "end": 556.28,
    "text": "作者在查阅文献时"
  },
  {
    "start": 556.28,
    "end": 557.72,
    "text": "筛去了无关的"
  },
  {
    "start": 557.72,
    "end": 561.54,
    "text": "或者未比较左右脑显示等量萎缩的研究后"
  },
  {
    "start": 561.54,
    "end": 565.04,
    "text": "最后留下了五项同向不对称的研究结果"
