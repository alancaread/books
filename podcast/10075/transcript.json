    "text": "哦"
  },
  {
    "start": 473.98,
    "end": 475.64,
    "text": "他不赞同这种流行说法"
  },
  {
    "start": 475.64,
    "end": 476.28,
    "text": "不赞同"
  },
  {
    "start": 476.28,
    "end": 479.48,
    "text": "他提出了一种动态学习的解释"
  },
  {
    "start": 479.48,
    "end": 479.94,
    "text": "他认为"
  },
  {
    "start": 479.94,
    "end": 482.6,
    "text": "终生认知重心是会发生变化的"
  },
  {
    "start": 482.6,
    "end": 487.42,
    "text": "是从处理新奇事物慢慢过渡到形成常规模式"
