    "start": 364.32,
    "end": 364.84,
    "text": "哦"
  },
  {
    "start": 364.84,
    "end": 365.52,
    "text": "怎么说"
  },
  {
    "start": 365.52,
    "end": 367.26,
    "text": "你刚买新手机的时候"
