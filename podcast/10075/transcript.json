  {
    "start": 329.86,
    "end": 330.22,
    "text": "对"
  },
  {
    "start": 330.22,
    "end": 331.24,
    "text": "这绝不是史料"
  },
  {
    "start": 331.24,
    "end": 333.72,
    "text": "也绝不能转变为任何用药意见"
