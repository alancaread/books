  {
    "start": 551.32,
    "end": 552.76,
    "text": "方向一致性计算"
  },
  {
    "start": 552.76,
    "end": 553.62,
    "text": "这怎么理解"
  },
  {
    "start": 553.62,
    "end": 554.6,
    "text": "也就是说"
