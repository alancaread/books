[
  {
    "start": 0.0,
    "end": 1.46,
    "text": "大家想象一场战争"
  },
  {
    "start": 1.46,
    "end": 3.04,
    "text": "在短短十几年间"
  },
  {
    "start": 3.04,
    "end": 6.64,
    "text": "导致了一亿一千多万人口的锐减"
  },
  {
    "start": 6.64,
    "end": 7.2,
    "text": "哇"
  },
  {
    "start": 7.2,
    "end": 8.72,
    "text": "一亿一千多万"
  },
  {
    "start": 8.72,
    "end": 9.78,
    "text": "这个数字"
  },
  {
    "start": 9.78,
    "end": 11.98,
    "text": "这相当于今天英国和法国"
  },
  {
    "start": 11.98,
    "end": 13.06,
    "text": "全国人口的总和"
  },
  {
    "start": 13.06,
    "end": 13.88,
    "text": "直接没了"
  },
  {
    "start": 13.88,
    "end": 14.1,
    "text": "对"
  },
  {
    "start": 14.1,
    "end": 15.94,
    "text": "直接从打底上消失了"
  },
  {
    "start": 15.94,
    "end": 18.32,
    "text": "你脑海中可能浮现出的是"
  },
  {
    "start": 18.32,
    "end": 22.26,
    "text": "第二次世界大战的某种残酷画面"
  },
  {
    "start": 22.26,
    "end": 23.46,
    "text": "但实际上"
  },
  {
    "start": 23.46,
    "end": 26.04,
    "text": "这发生在19世纪中叶的中国"
  },
  {
    "start": 26.04,
    "end": 27.88,
    "text": "也就是太平天国运动时期"
  },
  {
    "start": 27.88,
    "end": 30.2,
    "text": "这确实是一个非常沉重的切入点"
  },
  {
    "start": 30.2,
    "end": 30.66,
    "text": "没错"
  },
  {
    "start": 30.66,
    "end": 33.24,
    "text": "所以今天我们这次深度解析"
  },
  {
    "start": 33.24,
    "end": 35.64,
    "text": "就是要潜入历史的深水区"
  },
  {
    "start": 35.64,
    "end": 38.14,
    "text": "我们要去剥离掉后人"
  },
  {
    "start": 38.14,
    "end": 40.76,
    "text": "那个层层刷上去的意识形态油漆"
  },
  {
    "start": 40.76,
    "end": 42.84,
    "text": "看看那些原始始料"
  },
  {
    "start": 42.84,
    "end": 45.0,
    "text": "到底藏着怎样的本来面貌"
  },
  {
    "start": 45.0,
    "end": 45.28,
    "text": "是的"
  },
  {
    "start": 45.28,
    "end": 46.78,
    "text": "面对复杂的历史"
  },
  {
    "start": 46.78,
    "end": 49.38,
    "text": "我们需要一种近乎严苛的清醒"
  },
  {
    "start": 49.38,
    "end": 51.54,
    "text": "那我们今天的核心材料是"
  },
  {
    "start": 51.54,
    "end": 52.58,
    "text": "缠斗"
  },
  {
    "start": 52.58,
    "end": 53.94,
    "text": "方生与未死"
  },
  {
    "start": 53.94,
    "end": 55.46,
    "text": "在开始之前"
  },
  {
    "start": 55.46,
    "end": 57.38,
    "text": "我得先给大家定个坐标"
  },
  {
    "start": 57.38,
    "end": 58.96,
    "text": "缠斗这个词"
  },
  {
    "start": 58.96,
    "end": 62.36,
    "text": "听起来好像是武侠小说里那种近身肉搏"
  },
  {
    "start": 62.36,
    "end": 63.6,
    "text": "但在材料里"
  },
  {
    "start": 63.6,
    "end": 65.44,
    "text": "它不是指人物之间那种"
  },
  {
    "start": 65.44,
    "end": 67.72,
    "text": "你死我活的宫廷算计"
  },
  {
    "start": 67.72,
    "end": 68.14,
    "text": "对"
  },
  {
    "start": 68.14,
    "end": 69.64,
    "text": "不是那种全母故事"
  },
  {
    "start": 69.64,
    "end": 70.98,
    "text": "这里的缠斗"
  },
  {
    "start": 70.98,
    "end": 72.74,
    "text": "是指现代文化"
  },
  {
    "start": 72.74,
    "end": 76.04,
    "text": "与那些尚未消失的旧思潮之间的缠斗"
  },
  {
    "start": 76.04,
    "end": 78.36,
    "text": "就是一种更深层的新旧挣扎"
  },
  {
    "start": 78.36,
    "end": 78.86,
    "text": "没错"
  },
  {
    "start": 78.86,
    "end": 81.28,
    "text": "而且大家在听的时候要注意"
  },
  {
    "start": 81.28,
    "end": 82.22,
    "text": "这本书"
  },
  {
    "start": 82.22,
    "end": 83.32,
    "text": "这份材料"
  },
  {
    "start": 83.32,
    "end": 86.42,
    "text": "它不能被当作连贯的线性通史来读"
  },
  {
    "start": 86.42,
    "end": 88.32,
    "text": "它实际上是文章"
  },
  {
    "start": 88.32,
    "end": 89.12,
    "text": "讲演"
  },
  {
    "start": 89.12,
    "end": 89.86,
    "text": "访谈"
  },
  {
    "start": 89.86,
    "end": 91.08,
    "text": "与对话的合集"
  },
  {
    "start": 91.08,
    "end": 92.52,
    "text": "就是说"
  },
  {
    "start": 92.52,
    "end": 93.74,
    "text": "不是从头到尾"
  },
  {
    "start": 93.74,
    "end": 95.14,
    "text": "年份讲故事的那种"
  },
  {
    "start": 95.14,
    "end": 95.56,
    "text": "对"
  },
  {
    "start": 95.56,
    "end": 97.8,
    "text": "全书分为四个很清晰的板块"
  },
  {
    "start": 97.8,
    "end": 98.88,
    "text": "第一集是"
  },
  {
    "start": 98.88,
    "end": 99.86,
    "text": "回顾风波"
  },
  {
    "start": 99.86,
    "end": 100.72,
    "text": "然后是"
  },
  {
    "start": 100.72,
    "end": 102.32,
    "text": "另眼看人物"
  },
  {
    "start": 102.32,
    "end": 102.82,
    "text": "接着是"
  },
  {
    "start": 102.82,
    "end": 103.94,
    "text": "另眼看时代"
  },
  {
    "start": 103.94,
    "end": 104.92,
    "text": "最后是"
  },
  {
    "start": 104.92,
    "end": 106.36,
    "text": "中日关系纠结"
  },
  {
    "start": 106.36,
    "end": 108.36,
    "text": "路线图很明确了"
  },
  {
    "start": 108.36,
    "end": 110.28,
    "text": "我也要跟听众朋友们交个底"
  },
  {
    "start": 110.28,
    "end": 111.58,
    "text": "接下来的探讨"
  },
  {
    "start": 111.58,
    "end": 114.86,
    "text": "我们将严格依据材料中的事实和争议展开"
  },
  {
    "start": 114.86,
    "end": 115.86,
    "text": "区分清楚"
  },
  {
    "start": 115.86,
    "end": 118.08,
    "text": "哪些是客观的事实"
  },
  {
    "start": 118.08,
    "end": 119.86,
    "text": "哪些是作者的主观判断"
  },
  {
    "start": 119.86,
    "end": 122.52,
    "text": "我们直接从你刚开上提到的那个"
  },
  {
    "start": 122.52,
    "end": 124.72,
    "text": "一亿一千多万的数字说起吧"
  },
  {
    "start": 124.72,
    "end": 126.0,
    "text": "这是在第一集"
  },
  {
    "start": 126.0,
    "end": 128.48,
    "text": "讨论历史重大争议的时候提到的"
  },
  {
    "start": 128.48,
    "end": 130.58,
    "text": "这是谁统计的数据啊"
  },
  {
    "start": 131.24,
    "end": 132.6,
    "text": "作者引用了复旦大学"
  },
  {
    "start": 132.6,
    "end": 133.88,
    "text": "葛剑雄教授的研究"
  },
  {
    "start": 133.88,
    "end": 136.72,
    "text": "显示在1851到1865年前"
  },
  {
    "start": 136.72,
    "end": 138.72,
    "text": "人口确实锐减了这么多"
  },
  {
    "start": 138.72,
    "end": 140.6,
    "text": "为了说明这种破坏性"
  },
  {
    "start": 140.6,
    "end": 143.6,
    "text": "材料中还引用了马克思在1862年的一个评价"
  },
  {
    "start": 143.6,
    "end": 145.46,
    "text": "马克思是怎么评价的"
  },
  {
    "start": 145.46,
    "end": 148.58,
    "text": "他将其称为魔鬼的in Persona"
  },
  {
    "start": 148.58,
    "end": 150.04,
    "text": "也就是魔鬼的化身"
  },
  {
    "start": 150.04,
    "end": 150.92,
    "text": "哇"
  },
  {
    "start": 150.92,
    "end": 151.84,
    "text": "这个词"
  },
  {
    "start": 151.84,
    "end": 154.2,
    "text": "可以说是相当尖锐了"
  },
  {
    "start": 154.2,
    "end": 154.96,
    "text": "是的"
  },
  {
    "start": 154.96,
    "end": 157.52,
    "text": "而在讨论李鸿章的这部分争议时"
  },
  {
    "start": 157.52,
    "end": 160.62,
    "text": "作者花了篇幅去回应一位叫丹祖的批评者"
  },
  {
    "start": 160.62,
    "end": 161.44,
    "text": "等等"
  },
  {
    "start": 161.44,
    "end": 163.56,
    "text": "在这里我必须向大家插一句"
  },
  {
    "start": 163.56,
    "end": 164.84,
    "text": "澄清一个关键规则"
  },
  {
    "start": 164.84,
    "end": 166.64,
    "text": "就是在这份材料里"
  },
  {
    "start": 166.64,
    "end": 168.76,
    "text": "我们并没有看到这位丹祖"
  },
  {
    "start": 168.76,
    "end": 171.64,
    "text": "或者后来提到的其他反方文章的全文"
  },
  {
    "start": 171.64,
    "end": 172.44,
    "text": "对"
  },
  {
    "start": 172.44,
    "end": 173.28,
    "text": "都没有原文"
  },
  {
    "start": 173.28,
    "end": 174.34,
    "text": "就是说"
  },
  {
    "start": 174.34,
    "end": 176.36,
    "text": "我们所知的所有反方表述"
  },
  {
    "start": 176.36,
    "end": 179.36,
    "text": "都仅仅是来自本书作者的转引和复述"
  },
  {
    "start": 179.36,
    "end": 182.86,
    "text": "大家要把这个当成作者在防守反击来听"
  },
  {
    "start": 182.86,
    "end": 185.64,
    "text": "这种新鲜来源的界限感非常重要"
  },
  {
    "start": 185.64,
    "end": 187.22,
    "text": "那个说到争议"
  },
  {
    "start": 187.22,
    "end": 189.12,
    "text": "里面关于圆明园的那段"
  },
  {
    "start": 189.12,
    "end": 190.64,
    "text": "真的让我有点想不通"
  },
  {
    "start": 190.64,
    "end": 193.08,
    "text": "面对圆明园被毁这样的惨剧"
  },
  {
    "start": 193.08,
    "end": 196.62,
    "text": "作者是如何在事实判断和价值判断之间"
  },
  {
    "start": 196.62,
    "end": 197.58,
    "text": "划清界限的"
  },
  {
    "start": 197.58,
    "end": 199.6,
    "text": "你是觉得哪里有张力"
  },
  {
    "start": 199.6,
    "end": 202.38,
    "text": "就是作者既要谴责暴行"
  },
  {
    "start": 202.38,
    "end": 204.54,
    "text": "又说这是自身落后造成的"
  },
  {
    "start": 204.54,
    "end": 205.66,
    "text": "这不矛盾吗"
  },
  {
    "start": 205.66,
    "end": 207.64,
    "text": "这不是在给侵略者找借口吗"
  },
  {
    "start": 207.64,
    "end": 210.4,
    "text": "听上去确实容易让人产生这种疑问"
  },
  {
    "start": 210.4,
    "end": 213.2,
    "text": "但我们来看材料里的事实层面"
  },
  {
    "start": 213.2,
    "end": 216.48,
    "text": "作者首先明确了英法联军抢掠的暴行"
  },
  {
    "start": 216.48,
    "end": 217.34,
    "text": "这是事实"
  },
  {
    "start": 217.34,
    "end": 219.78,
    "text": "但在此之前还有一个前传"
  },
  {
    "start": 219.78,
    "end": 221.34,
    "text": "什么前传"
  },
  {
    "start": 221.34,
    "end": 226.32,
    "text": "当时的清政府扣留了巴夏礼的39名谈判代表作为人质"
  },
  {
    "start": 226.32,
    "end": 228.16,
    "text": "扣留了外交使节"
  },
  {
    "start": 228.16,
    "end": 228.54,
    "text": "对"
  },
  {
    "start": 228.54,
    "end": 233.16,
    "text": "而且这39人里有20人在狱中被残酷虐待致死了"
  },
  {
    "start": 233.16,
    "end": 237.9,
    "text": "作者指出这是严重违背当时国际规则的行为"
  },
  {
    "start": 237.9,
    "end": 242.18,
    "text": "也就是说暴行之前发生了这样严重的外交事件"
  },
  {
    "start": 242.18,
    "end": 242.54,
    "text": "是的"
  },
  {
    "start": 242.54,
    "end": 244.6,
    "text": "所以从价值判断层面"
  },
  {
    "start": 244.6,
    "end": 251.04,
    "text": "作者认为评价历史事件的最高尺度是它是否有利于中国向现代社会转型"
  },
  {
    "start": 251.04,
    "end": 256.5,
    "text": "作者认为苦难既来自外来侵略更来自自身的落后和封闭"
  },
  {
    "start": 256.5,
    "end": 259.96,
    "text": "就是找病根而不是单纯的宣泄情绪"
  },
  {
    "start": 259.96,
    "end": 260.26,
    "text": "对"
  },
  {
    "start": 260.26,
    "end": 262.1,
    "text": "这是一种更宏观的审视"
  },
  {
    "start": 262.1,
    "end": 264.26,
    "text": "了解了这些宏观争议后"
  },
  {
    "start": 264.26,
    "end": 265.64,
    "text": "我们把目光拉近一点"
  },
  {
    "start": 265.64,
    "end": 268.2,
    "text": "看看这场缠斗里具体的人物"
  },
  {
    "start": 268.2,
    "end": 270.64,
    "text": "第二集里探讨了康有为"
  },
  {
    "start": 270.64,
    "end": 271.32,
    "text": "袁世凯"
  },
  {
    "start": 271.32,
    "end": 272.02,
    "text": "蒋介石"
  },
  {
    "start": 272.02,
    "end": 272.7,
    "text": "胡适"
  },
  {
    "start": 272.7,
    "end": 273.78,
    "text": "傅思年这些人"
  },
  {
    "start": 273.78,
    "end": 275.66,
    "text": "这些名字大家都很熟"
  },
  {
    "start": 275.66,
    "end": 278.0,
    "text": "而且往往身上带着很强的标签"
  },
  {
    "start": 278.0,
    "end": 281.0,
    "text": "我这里有个特别有现实感的细节"
  },
  {
    "start": 281.0,
    "end": 283.42,
    "text": "是在关于袁世凯旧居的访谈里"
  },
  {
    "start": 283.42,
    "end": 286.16,
    "text": "记者彭晓芸向作者提问"
  },
  {
    "start": 286.16,
    "end": 287.52,
    "text": "提到了一句话"
  },
  {
    "start": 287.52,
    "end": 288.62,
    "text": "原话是什么"
  },
  {
    "start": 288.62,
    "end": 292.28,
    "text": "原话是近日河南项城政府宣称"
  },
  {
    "start": 292.28,
    "end": 297.34,
    "text": "要投资6500万元对袁世凯旧居进行维修保护"
  },
  {
    "start": 297.34,
    "end": 299.24,
    "text": "这是一个很有冲击力的数据"
  },
  {
    "start": 299.24,
    "end": 301.02,
    "text": "在这里我又要触发警报了"
  },
  {
    "start": 301.02,
    "end": 304.72,
    "text": "大家注意近日是当时成文时的表述"
  },
  {
    "start": 304.72,
    "end": 306.26,
    "text": "不是我们现在的今日"
  },
  {
    "start": 306.26,
    "end": 308.72,
    "text": "而且这个6500万元"
  },
  {
    "start": 308.72,
    "end": 310.94,
    "text": "仅仅是提问记者在问题里的说法"
  },
  {
    "start": 310.94,
    "end": 313.2,
    "text": "并不是作者亲自核实的金额"
  },
  {
    "start": 313.2,
    "end": 314.9,
    "text": "这个前提必须要讲清楚"
  },
  {
    "start": 314.9,
    "end": 318.18,
    "text": "我们只探讨由这个提问引发的观点"
  },
  {
    "start": 318.18,
    "end": 319.56,
    "text": "那么我的问题是"
  },
  {
    "start": 319.56,
    "end": 323.14,
    "text": "保留这样一个可以说名声很差的人的救居"
  },
  {
    "start": 323.14,
    "end": 324.9,
    "text": "难道不是在为他洗白"
  },
  {
    "start": 324.9,
    "end": 326.5,
    "text": "或者赞成他的行为吗"
  },
  {
    "start": 326.5,
    "end": 329.58,
    "text": "这就把物质遗产和政治评价混淆了"
  },
  {
    "start": 329.58,
    "end": 332.32,
    "text": "作者认为建筑艺术和文化遗产"
  },
  {
    "start": 332.32,
    "end": 333.78,
    "text": "本身是有保留价值的"
  },
  {
    "start": 333.78,
    "end": 335.0,
    "text": "就是建筑归建筑"
  },
  {
    "start": 335.0,
    "end": 335.32,
    "text": "对"
  },
  {
    "start": 335.32,
    "end": 339.0,
    "text": "但这绝不等于赞同他全部的政治行为"
  },
  {
    "start": 339.0,
    "end": 341.4,
    "text": "作者认为袁世凯暗杀宋教人"
  },
  {
    "start": 341.4,
    "end": 342.48,
    "text": "还有复辟帝制"
  },
  {
    "start": 342.48,
    "end": 344.28,
    "text": "这些是真正的罪恶"
  },
  {
    "start": 344.28,
    "end": 346.74,
    "text": "人物从来不是非黑即白的"
  },
  {
    "start": 346.74,
    "end": 347.96,
    "text": "也就是说"
  },
  {
    "start": 347.96,
    "end": 350.36,
    "text": "留着砖头是为了记住历史"
  },
  {
    "start": 350.36,
    "end": 352.28,
    "text": "而不是为了给他发好人卡"
  },
  {
    "start": 352.28,
    "end": 354.7,
    "text": "这个比喻很贴切"
  },
  {
    "start": 354.7,
    "end": 356.72,
    "text": "说到人物的具体行为"
  },
  {
    "start": 356.72,
    "end": 359.16,
    "text": "材料里还有一个傅斯年的例子"
  },
  {
    "start": 359.16,
    "end": 361.0,
    "text": "他被称为反腐大炮"
  },
  {
    "start": 361.0,
    "end": 362.6,
    "text": "这个我也有印象"
  },
  {
    "start": 362.6,
    "end": 363.74,
    "text": "他具体做了什么"
  },
  {
    "start": 363.74,
    "end": 366.52,
    "text": "他当时去质询孔祥熙的部署"
  },
  {
    "start": 366.52,
    "end": 368.8,
    "text": "死死盯住具体的数据"
  },
  {
    "start": 368.8,
    "end": 370.52,
    "text": "私分350万美元"
  },
  {
    "start": 370.52,
    "end": 373.36,
    "text": "以及799.5万美元的美金券"
  },
  {
    "start": 373.36,
    "end": 376.18,
    "text": "这在当时绝对是个天文数字了"
  },
  {
    "start": 376.18,
    "end": 377.12,
    "text": "是的"
  },
  {
    "start": 377.12,
    "end": 378.84,
    "text": "作者通过这个事实"
  },
  {
    "start": 378.84,
    "end": 381.82,
    "text": "展示了对历史人物评价的精确聚焦"
  },
  {
    "start": 381.82,
    "end": 383.42,
    "text": "不看空都的口号"
  },
  {
    "start": 383.42,
    "end": 384.8,
    "text": "就看你在这个位置上"
  },
  {
    "start": 384.8,
    "end": 386.74,
    "text": "到底干了什么具体的事"
  },
  {
    "start": 386.74,
    "end": 389.52,
    "text": "这种细节确实很有质感"
  },
  {
    "start": 389.52,
    "end": 392.68,
    "text": "不过人物的命运最终都是被时代裹挟的"
  },
  {
    "start": 392.68,
    "end": 396.14,
    "text": "接下来我们在第三集里把视角拉高"
  },
  {
    "start": 396.14,
    "end": 399.08,
    "text": "看看百年的时代脉络和宪政对话"
  },
  {
    "start": 399.08,
    "end": 402.06,
    "text": "这部分有一场2011年的三人对话"
  },
  {
    "start": 402.06,
    "end": 403.14,
    "text": "非常关键"
  },
  {
    "start": 403.14,
    "end": 403.9,
    "text": "对"
  },
  {
    "start": 403.9,
    "end": 405.12,
    "text": "看这场对话"
  },
  {
    "start": 405.12,
    "end": 408.96,
    "text": "就像我们要在一张画上分清是谁图的颜色一样"
  },
  {
    "start": 408.96,
    "end": 412.34,
    "text": "我们必须严格分清这场对话里的三个声音"
  },
  {
    "start": 412.34,
    "end": 416.02,
    "text": "第一个声音是对话主持人王维嘉"
  },
  {
    "start": 416.02,
    "end": 418.06,
    "text": "王维嘉的侧重点是什么"
  },
  {
    "start": 418.06,
    "end": 421.8,
    "text": "他提出晚清历史就像被刷了三层油漆"
  },
  {
    "start": 421.8,
    "end": 423.56,
    "text": "现在大家隔着油漆"
  },
  {
    "start": 423.56,
    "end": 425.24,
    "text": "什么本来面目都看不见"
  },
  {
    "start": 425.24,
    "end": 427.94,
    "text": "这是在谈历史被遮蔽的问题"
  },
  {
    "start": 427.94,
    "end": 430.5,
    "text": "然后对谈嘉宾马勇"
  },
  {
    "start": 430.5,
    "end": 432.08,
    "text": "他的角度截然不同"
  },
  {
    "start": 432.08,
    "end": 433.58,
    "text": "他是怎么说的"
  },
  {
    "start": 433.58,
    "end": 438.0,
    "text": "马勇提出马关条约让日本臣民可以自由办厂"
  },
  {
    "start": 438.0,
    "end": 440.74,
    "text": "他认为资本是没有国别属性的"
  },
  {
    "start": 440.74,
    "end": 441.96,
    "text": "打破了经济封锁"
  },
  {
    "start": 441.96,
    "end": 443.66,
    "text": "这个角度很犀利"
  },
  {
    "start": 443.66,
    "end": 446.3,
    "text": "那本书的作者袁伟时呢"
  },
  {
    "start": 446.3,
    "end": 447.74,
    "text": "他的侧重点又是啥"
  },
  {
    "start": 447.74,
    "end": 449.24,
    "text": "顺着这个话题"
  },
  {
    "start": 449.24,
    "end": 451.98,
    "text": "作者认为造成落后的根本原因是"
  },
  {
    "start": 451.98,
    "end": 454.64,
    "text": "官府早前剥夺了中国人的经济自由"
  },
  {
    "start": 454.64,
    "end": 456.92,
    "text": "是被迫给洋人开放后"
  },
  {
    "start": 456.92,
    "end": 459.34,
    "text": "才慢慢倒逼放开了本国人的自由"
  },
  {
    "start": 459.34,
    "end": 460.6,
    "text": "大家看"
  },
  {
    "start": 460.6,
    "end": 462.14,
    "text": "同样是讲这段历史"
  },
  {
    "start": 462.14,
    "end": 463.54,
    "text": "主持人讲遮蔽"
  },
  {
    "start": 463.54,
    "end": 465.18,
    "text": "嘉宾讲资本属性"
  },
  {
    "start": 465.18,
    "end": 466.42,
    "text": "而作者认为"
  },
  {
    "start": 466.42,
    "end": 468.82,
    "text": "核心是制度剥夺了经济自由"
  },
  {
    "start": 468.82,
    "end": 471.34,
    "text": "千万不能把这三人的观点搞混了啊"
  },
  {
    "start": 471.34,
    "end": 472.92,
    "text": "必须界限分明"
  },
  {
    "start": 472.92,
    "end": 474.7,
    "text": "顺着这个时代脉络"
  },
  {
    "start": 474.7,
    "end": 477.98,
    "text": "那个作者在材料里提到北洋时代"
  },
  {
    "start": 477.98,
    "end": 481.66,
    "text": "说他们收回了关税自主权和上海司法权"
  },
  {
    "start": 481.66,
    "end": 483.84,
    "text": "如果按照这种成就来看"
  },
  {
    "start": 483.84,
    "end": 486.92,
    "text": "那是不是意味着北洋时代其实是个好时代"
  },
  {
    "start": 486.92,
    "end": 490.0,
    "text": "这就是一种典型的非黑即白的推论"
  },
  {
    "start": 490.0,
    "end": 492.2,
    "text": "材料里坚决反驳了这种做法"
  },
  {
    "start": 492.2,
    "end": 494.72,
    "text": "为什么收回主权不是好事吗"
  },
  {
    "start": 494.72,
    "end": 497.12,
    "text": "收回主权是事实"
  },
  {
    "start": 497.12,
    "end": 500.56,
    "text": "但这绝对不能独自用来证明北洋时代的总评价"
  },
  {
    "start": 500.56,
    "end": 503.76,
    "text": "因为你不能无视同时期发生的其他事实"
  },
  {
    "start": 503.76,
    "end": 504.6,
    "text": "比如呢"
  },
  {
    "start": 504.6,
    "end": 506.92,
    "text": "比如1926年的三·一八惨案"
  },
  {
    "start": 506.92,
    "end": 509.64,
    "text": "还有军阀之间没完没了的混战"
  },
  {
    "start": 509.64,
    "end": 511.6,
    "text": "你不能用外交上的分数"
  },
  {
    "start": 511.6,
    "end": 514.04,
    "text": "去掩盖内部的流血和混乱"
  },
  {
    "start": 514.04,
    "end": 514.8,
    "text": "明白了"
  },
  {
    "start": 514.8,
    "end": 516.18,
    "text": "不能一白遮白丑"
  },
  {
    "start": 516.18,
    "end": 517.98,
    "text": "那说到时代转型"
  },
  {
    "start": 517.98,
    "end": 520.74,
    "text": "最大的外部阵痛莫过于中日关系了"
  },
  {
    "start": 520.74,
    "end": 521.96,
    "text": "这就来到了第四集"
  },
  {
    "start": 521.96,
    "end": 522.64,
    "text": "是的"
  },
  {
    "start": 522.64,
    "end": 523.72,
    "text": "在这一集里"
  },
  {
    "start": 523.72,
    "end": 526.08,
    "text": "有一段2005年访谈中的表述"
  },
  {
    "start": 526.08,
    "end": 528.7,
    "text": "我必须逐字照录的念给大家听"
  },
  {
    "start": 528.7,
    "end": 529.34,
    "text": "好"
  },
  {
    "start": 529.34,
    "end": 529.78,
    "text": "你念"
  },
  {
    "start": 529.78,
    "end": 532.72,
    "text": "作者在谈及这段历史时说"
  },
  {
    "start": 532.72,
    "end": 536.52,
    "text": "从1874至1945年的71年间"
  },
  {
    "start": 536.52,
    "end": 538.98,
    "text": "终日有过三次半战争"
  },
  {
    "start": 538.98,
    "end": 539.3,
    "text": "等等"
  },
  {
    "start": 539.3,
    "end": 540.42,
    "text": "三次半"
  },
  {
    "start": 540.42,
    "end": 541.58,
    "text": "甲午战争"
  },
  {
    "start": 541.58,
    "end": 542.14,
    "text": "抗日战争"
  },
  {
    "start": 542.14,
    "end": 542.5,
    "text": "我知道"
  },
  {
    "start": 542.5,
    "end": 544.08,
    "text": "这个半次是怎么来的"
  },
  {
    "start": 544.08,
    "end": 546.6,
    "text": "这是需要特别说明语境的地方"
  },
  {
    "start": 546.6,
    "end": 551.08,
    "text": "作者把1874年台湾未设防时的冲突算作了半次"
  },
  {
    "start": 551.08,
    "end": 552.76,
    "text": "我们要向听众强调"
  },
  {
    "start": 552.76,
    "end": 554.76,
    "text": "这只是作者在访谈中"
  },
  {
    "start": 554.76,
    "end": 557.82,
    "text": "对历史事件的一种分类和修辞表述"
  },
  {
    "start": 557.82,
    "end": 558.62,
    "text": "也就是说"
  },
  {
    "start": 558.62,
    "end": 560.8,
    "text": "这不是一个冷冰冰的统计学数据"
  },
  {
    "start": 560.8,
    "end": 560.98,
    "text": "对"
  },
  {
    "start": 560.98,
    "end": 562.4,
    "text": "绝不能把这种提法"
  },
  {
    "start": 562.4,
    "end": 564.36,
    "text": "化成某种统计学上的比较"
  },
  {
    "start": 564.36,
    "end": 566.98,
    "text": "也不能因为我们逐字核对了这句话"
  },
  {
    "start": 566.98,
    "end": 569.06,
    "text": "就把它等同于史实已经定论"
  },
  {
    "start": 569.06,
    "end": 571.44,
    "text": "它保留的是说话者的语境"
  },
  {
    "start": 571.44,
    "end": 572.46,
    "text": "明白了"
  },
  {
    "start": 572.46,
    "end": 573.4,
    "text": "分类归分类"
  },
  {
    "start": 573.4,
    "end": 575.04,
    "text": "但在这个访谈里"
  },
  {
    "start": 575.04,
    "end": 576.86,
    "text": "我有个极其尖锐的问题要追问"
  },
  {
    "start": 576.86,
    "end": 577.34,
    "text": "你说"
  },
  {
    "start": 577.34,
    "end": 578.9,
    "text": "作者提出了"
  },
  {
    "start": 578.9,
    "end": 580.76,
    "text": "甲午战争是中日双输"
  },
  {
    "start": 580.76,
    "end": 582.08,
    "text": "双输这个词"
  },
  {
    "start": 582.08,
    "end": 584.24,
    "text": "这是不是意味着战果相同"
  },
  {
    "start": 584.24,
    "end": 584.94,
    "text": "或者说"
  },
  {
    "start": 584.94,
    "end": 587.16,
    "text": "轻锐者和受害者的责任是对称的"
  },
  {
    "start": 587.16,
    "end": 589.22,
    "text": "我们必须严肃澄清"
  },
  {
    "start": 589.22,
    "end": 590.2,
    "text": "绝非如此"
  },
  {
    "start": 590.2,
    "end": 592.96,
    "text": "双输绝不等于责任对称"
  },
  {
    "start": 592.96,
    "end": 594.68,
    "text": "那这到底是什么意思"
  },
  {
    "start": 594.68,
    "end": 595.94,
    "text": "怎么个书法"
  },
  {
    "start": 595.94,
    "end": 597.5,
    "text": "作者认为"
  },
  {
    "start": 597.5,
    "end": 600.4,
    "text": "日本是蓄谋向外扩张的侵略者"
  },
  {
    "start": 600.4,
    "end": 602.4,
    "text": "而大清是制度的失败者"
  },
  {
    "start": 602.4,
    "end": 604.28,
    "text": "这首先是责任的界定"
  },
  {
    "start": 604.28,
    "end": 606.32,
    "text": "那日本打赢了甲午"
  },
  {
    "start": 606.32,
    "end": 607.54,
    "text": "他输在哪了"
  },
  {
    "start": 607.54,
    "end": 608.46,
    "text": "事实是"
  },
  {
    "start": 608.46,
    "end": 612.14,
    "text": "日本虽然拿到了两亿三千多两的巨额赔款"
  },
  {
    "start": 612.14,
    "end": 615.06,
    "text": "但其中85%都用于扩军"
  },
  {
    "start": 615.06,
    "end": 618.0,
    "text": "就是把钱全拿去造武器了"
  },
  {
    "start": 618.0,
    "end": 618.54,
    "text": "没错"
  },
  {
    "start": 618.54,
    "end": 621.44,
    "text": "这导致日本彻底走上了军国主义邪怒"
  },
  {
    "start": 621.44,
    "end": 624.54,
    "text": "最终在二战中走向了无条件投降的灾难"
  },
  {
    "start": 624.54,
    "end": 626.58,
    "text": "这就是日本的书"
  },
  {
    "start": 626.58,
    "end": 628.08,
    "text": "那中国呢"
  },
  {
    "start": 628.08,
    "end": 630.08,
    "text": "中国最终赢得了抗战"
  },
  {
    "start": 630.08,
    "end": 632.58,
    "text": "但也付出了极其惨痛的代价"
  },
  {
    "start": 632.58,
    "end": 633.36,
    "text": "所以啊"
  },
  {
    "start": 633.36,
    "end": 636.26,
    "text": "双输是对百年历史终局的深刻评判"
  },
  {
    "start": 636.26,
    "end": 638.94,
    "text": "绝对不是去抹杀战争的责任"
  },
  {
    "start": 638.94,
    "end": 642.22,
    "text": "原来是放在百年尺度上看两国命运的终局"
  },
  {
    "start": 642.22,
    "end": 644.18,
    "text": "侵略者引咒子渴"
  },
  {
    "start": 644.18,
    "end": 646.78,
    "text": "受害者付出了血泪代价"
  },
  {
    "start": 646.78,
    "end": 647.1,
    "text": "是的"
  },
  {
    "start": 647.1,
    "end": 648.54,
    "text": "这个逻辑非常深远"
  },
  {
    "start": 648.54,
    "end": 650.02,
    "text": "讨论了这么多"
  },
  {
    "start": 650.02,
    "end": 651.36,
    "text": "其实作为听众"
  },
  {
    "start": 651.36,
    "end": 652.34,
    "text": "我会有个疑问"
  },
  {
    "start": 652.34,
    "end": 655.58,
    "text": "我们凭什么相信这份材料的观点"
  },
  {
    "start": 655.58,
    "end": 657.72,
    "text": "这就得看看书的附录了"
  },
  {
    "start": 657.72,
    "end": 660.88,
    "text": "这里得介绍一下作者的背景"
  },
  {
    "start": 660.88,
    "end": 662.42,
    "text": "他出生于1931年"
  },
  {
    "start": 662.42,
    "end": 664.84,
    "text": "那算是清理了那个动荡年代"
  },
  {
    "start": 664.84,
    "end": 665.44,
    "text": "对"
  },
  {
    "start": 665.44,
    "end": 670.06,
    "text": "他坦言由于无法自由评说1927到1949年的历史"
  },
  {
    "start": 670.06,
    "end": 672.64,
    "text": "他只能在缝隙中寻求话语空间"
  },
  {
    "start": 672.64,
    "end": 675.04,
    "text": "所以掉头去研究晚清"
  },
  {
    "start": 675.04,
    "end": 676.38,
    "text": "这是一种无奈"
  },
  {
    "start": 676.38,
    "end": 677.76,
    "text": "学者的无奈"
  },
  {
    "start": 677.76,
    "end": 680.36,
    "text": "那他的研究方法靠谱吗"
  },
  {
    "start": 680.36,
    "end": 682.8,
    "text": "材料末尾有一个集中注释"
  },
  {
    "start": 682.8,
    "end": 685.3,
    "text": "它跟正文里的脚标是一一对应的"
  },
  {
    "start": 685.3,
    "end": 686.8,
    "text": "这就是他的原则"
  },
  {
    "start": 686.8,
    "end": 689.92,
    "text": "只把看到的历史本来面目写在纸上"
  },
  {
    "start": 689.92,
    "end": 693.12,
    "text": "分辨清楚事实价值以及各种转引"
  },
  {
    "start": 693.12,
    "end": 695.5,
    "text": "既然一切都靠史料说话"
  },
  {
    "start": 695.5,
    "end": 696.64,
    "text": "我想挑战一下"
  },
  {
    "start": 696.64,
    "end": 699.98,
    "text": "有没有什么具体条件会让材料里"
  },
  {
    "start": 699.98,
    "end": 703.36,
    "text": "作者认为的某个结论被直接推翻或者修订"
  },
  {
    "start": 703.36,
    "end": 704.5,
    "text": "当然有"
  },
  {
    "start": 704.5,
    "end": 708.0,
    "text": "比如前面提到的批评者称李鸿章收受了"
  },
  {
    "start": 708.0,
    "end": 709.6,
    "text": "沙俄三百万卢布的贿赂"
  },
  {
    "start": 709.6,
    "end": 711.34,
    "text": "作者是怎么回应的"
  },
  {
    "start": 711.34,
    "end": 714.82,
    "text": "作者用俄方代表维特的回忆录来反驳"
  },
  {
    "start": 714.82,
    "end": 716.0,
    "text": "说这是谣言"
  },
  {
    "start": 716.0,
    "end": 717.92,
    "text": "那万一呢"
  },
  {
    "start": 717.92,
    "end": 718.84,
    "text": "我就说万一"
  },
  {
    "start": 718.84,
    "end": 721.14,
    "text": "未来俄罗斯解密了档案"
  },
  {
    "start": 721.14,
    "end": 723.92,
    "text": "还真的发现了一手直接档案"
  },
  {
    "start": 723.92,
    "end": 726.98,
    "text": "比如李鸿章亲笔签署的领款收据"
  },
  {
    "start": 726.98,
    "end": 727.84,
    "text": "那怎么办"
  },
  {
    "start": 727.84,
    "end": 730.48,
    "text": "如果真的出现了这种直接证据"
  },
  {
    "start": 730.48,
    "end": 733.24,
    "text": "那么这个关于李鸿章未受贿的评价"
  },
  {
    "start": 733.24,
    "end": 734.44,
    "text": "就必须被修订"
  },
  {
    "start": 734.44,
    "end": 737.48,
    "text": "这就是基于一手史料的学术严谨性"
  },
  {
    "start": 737.48,
    "end": 738.42,
    "text": "有一份证据"
  },
  {
    "start": 738.42,
    "end": 739.28,
    "text": "说一份话"
  },
  {
    "start": 739.28,
    "end": 740.64,
    "text": "也就是说"
  },
  {
    "start": 740.64,
    "end": 742.44,
    "text": "结论是跟着证据走的"
  },
  {
    "start": 742.44,
    "end": 743.54,
    "text": "而不是跟着立场走"
  },
  {
    "start": 743.54,
    "end": 744.52,
    "text": "完全正确"
  },
  {
    "start": 744.52,
    "end": 747.04,
    "text": "那么今天的深度探讨差不多了"
  },
  {
    "start": 747.04,
    "end": 750.54,
    "text": "这让我们看到历史研究绝不是简单的贴标签"
  },
  {
    "start": 750.54,
    "end": 755.82,
    "text": "而是需要在事实价值和各种争论的转引中保持清醒"
  },
  {
    "start": 755.82,
    "end": 756.2,
    "text": "是的"
  },
  {
    "start": 756.2,
    "end": 758.44,
    "text": "剥离油漆的过程总是痛苦的"
  },
  {
    "start": 758.44,
    "end": 759.74,
    "text": "但也最有价值"
  },
  {
    "start": 759.74,
    "end": 760.32,
    "text": "最后"
  },
  {
    "start": 760.32,
    "end": 762.08,
    "text": "我想给大家留一个思考题"
  },
  {
    "start": 762.08,
    "end": 763.78,
    "text": "在这个信息爆炸"
  },
  {
    "start": 763.78,
    "end": 765.2,
    "text": "AI生成内容的时代"
  },
  {
    "start": 765.2,
    "end": 769.66,
    "text": "当我们每天面对海量的资讯和各种情绪化的观点时"
  },
  {
    "start": 769.66,
    "end": 772.62,
    "text": "我们是不是也能像今天面对历史那样"
  },
  {
    "start": 772.62,
    "end": 774.9,
    "text": "坚持一种寻找真相的态度"
  },
  {
    "start": 774.9,
    "end": 778.04,
    "text": "这确实是当下每个人都在面对的挑战"
  },
  {
    "start": 778.04,
    "end": 778.3,
    "text": "所以"
  },
  {
    "start": 778.3,
    "end": 779.18,
    "text": "下一次"
  },
  {
    "start": 779.18,
    "end": 781.98,
    "text": "当你看到某个被贴上标签的热点事件时"
  },
  {
    "start": 781.98,
    "end": 783.86,
    "text": "你能不能先停下来"
  },
  {
    "start": 783.86,
    "end": 785.9,
    "text": "像今天探讨历史一样"
  },
  {
    "start": 785.9,
    "end": 789.28,
    "text": "去寻找一下那个最原始的注脚"
  },
  {
    "start": 789.28,
    "end": 791.86,
    "text": "去看看它的出处到底在哪里"
  },
  {
    "start": 791.86,
    "end": 792.86,
    "text": "顺藤摸瓜"
  },
  {
    "start": 792.86,
    "end": 794.36,
    "text": "找到那份集中注释"
  },
  {
    "start": 794.36,
    "end": 795.82,
    "text": "感谢大家的聆听"
  },
  {
    "start": 795.82,
    "end": 797.94,
    "text": "我们下次深度解析再见"
  },
  {
    "start": 797.94,
    "end": 798.76,
    "text": "下次见"
  }
]
