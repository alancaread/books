    "text": "比损失已拥有的金钱"
  },
  {
    "start": 1237.3,
    "end": 1238.66,
    "text": "痛苦要小得多"
  },
  {
    "start": 1238.66,
    "end": 1239.78,
    "text": "安全边际"
  },
  {
    "start": 1239.78,
