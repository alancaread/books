[
  {
    "start": 0.0,
    "end": 1.14,
    "text": "赚钱的交易"
  },
  {
    "start": 1.14,
    "end": 3.04,
    "text": "为什么人可能是错的"
  },
  {
    "start": 3.04,
    "end": 4.52,
    "text": "市场没有确认之前"
  },
  {
    "start": 4.52,
    "end": 6.68,
    "text": "该怎样处理手里的持仓"
  },
  {
    "start": 6.68,
    "end": 8.78,
    "text": "这个问题"
  },
  {
    "start": 8.78,
    "end": 11.54,
    "text": "其实直接切中了交易世界里"
  },
  {
    "start": 11.54,
    "end": 12.92,
    "text": "就是最反直觉"
  },
  {
    "start": 12.92,
    "end": 14.64,
    "text": "但也最致命的盲区了"
  },
  {
    "start": 14.64,
    "end": 15.02,
    "text": "对"
  },
  {
    "start": 15.02,
    "end": 15.94,
    "text": "人的本能"
  },
  {
    "start": 15.94,
    "end": 17.76,
    "text": "就是特别喜欢用结果"
  },
  {
    "start": 17.76,
    "end": 19.68,
    "text": "去推到过程的正确与否"
  },
  {
    "start": 19.68,
    "end": 20.04,
    "text": "没错"
  },
  {
    "start": 20.04,
    "end": 22.12,
    "text": "如果账户现在是红的"
  },
  {
    "start": 22.12,
    "end": 23.22,
    "text": "处于盈利状态"
  },
  {
    "start": 23.22,
    "end": 24.92,
    "text": "大脑马上就会告诉你"
  },
  {
    "start": 24.92,
    "end": 27.04,
    "text": "刚才的买入简直太英明了"
  },
  {
    "start": 27.04,
    "end": 28.2,
    "text": "但金融市场"
  },
  {
    "start": 28.2,
    "end": 31.12,
    "text": "偏偏是个极度扭曲的反馈系统"
  },
  {
    "start": 31.12,
    "end": 32.54,
    "text": "短期的照面复营"
  },
  {
    "start": 32.54,
    "end": 34.82,
    "text": "很多时候不仅不是实力的体现"
  },
  {
    "start": 34.82,
    "end": 36.82,
    "text": "凡是市场在悄悄奖励"
  },
  {
    "start": 36.82,
    "end": 38.26,
    "text": "极度危险的操作习惯"
  },
  {
    "start": 38.26,
    "end": 39.4,
    "text": "是这样的"
  },
  {
    "start": 39.4,
    "end": 41.58,
    "text": "这种机制就在疯狂挑战"
  },
  {
    "start": 41.58,
    "end": 43.5,
    "text": "咱们从小建立的因果逻辑"
  },
  {
    "start": 43.5,
    "end": 45.1,
    "text": "你在市场里赚了钱"
  },
  {
    "start": 45.1,
    "end": 46.4,
    "text": "可能只是因为"
  },
  {
    "start": 46.4,
    "end": 48.12,
    "text": "在错误的高速路上"
  },
  {
    "start": 48.12,
    "end": 49.72,
    "text": "碰巧没撞车而已"
  },
  {
    "start": 49.72,
    "end": 52.2,
    "text": "这其实就是阿瑟·艾奥辛普森"
  },
  {
    "start": 52.2,
    "end": 53.02,
    "text": "整理的这本"
  },
  {
    "start": 53.02,
    "end": 54.54,
    "text": "华尔街幽灵里面"
  },
  {
    "start": 54.54,
    "end": 55.94,
    "text": "最刺痛人心的部分"
  },
  {
    "start": 55.94,
    "end": 57.76,
    "text": "既然我们要带你一起"
  },
  {
    "start": 57.76,
    "end": 59.24,
    "text": "把这位匿名交易员"
  },
  {
    "start": 59.24,
    "end": 60.44,
    "text": "幽灵的思维底牌"
  },
  {
    "start": 60.44,
    "end": 61.22,
    "text": "给掀开看看"
  },
  {
    "start": 61.22,
    "end": 62.54,
    "text": "那咱们得先弄明白"
  },
  {
    "start": 62.54,
    "end": 65.18,
    "text": "这种反直觉观点的源头"
  },
  {
    "start": 65.18,
    "end": 67.52,
    "text": "要理解这种极其反常的理念"
  },
  {
    "start": 67.52,
    "end": 68.5,
    "text": "咱们得先回到"
  },
  {
    "start": 68.5,
    "end": 70.08,
    "text": "97年的股物期货市场"
  },
  {
    "start": 70.08,
    "end": 71.66,
    "text": "那年市场的单边波动"
  },
  {
    "start": 71.66,
    "end": 72.56,
    "text": "可是相当剧烈"
  },
  {
    "start": 72.56,
    "end": 73.2,
    "text": "对"
  },
  {
    "start": 73.2,
    "end": 74.5,
    "text": "简直像赵妖镜一样"
  },
  {
    "start": 74.5,
    "end": 76.64,
    "text": "当时盘面上特别惨烈"
  },
  {
    "start": 76.64,
    "end": 77.78,
    "text": "有部分人"
  },
  {
    "start": 77.78,
    "end": 79.9,
    "text": "其实前期方向完全看对了"
  },
  {
    "start": 79.9,
    "end": 80.22,
    "text": "嗯"
  },
  {
    "start": 80.22,
    "end": 81.24,
    "text": "站对了队伍"
  },
  {
    "start": 81.24,
    "end": 83.12,
    "text": "但就是因为内心深处"
  },
  {
    "start": 83.12,
    "end": 84.56,
    "text": "太害怕利润回撤"
  },
  {
    "start": 84.56,
    "end": 86.06,
    "text": "行情刚给点甜头"
  },
  {
    "start": 86.06,
    "end": 87.62,
    "text": "就迫不及待掏线跑了"
  },
  {
    "start": 87.62,
    "end": 88.76,
    "text": "过早下车"
  },
  {
    "start": 88.76,
    "end": 90.18,
    "text": "结果完美错过了"
  },
  {
    "start": 90.18,
    "end": 91.12,
    "text": "后面的主声浪"
  },
  {
    "start": 91.12,
    "end": 91.44,
    "text": "没错"
  },
  {
    "start": 91.44,
    "end": 93.0,
    "text": "还有很大一批人呢"
  },
  {
    "start": 93.0,
    "end": 95.0,
    "text": "面对突如其来的反向暴跌"
  },
  {
    "start": 95.0,
    "end": 96.68,
    "text": "整个人直接瘫痪了"
  },
  {
    "start": 96.68,
    "end": 98.58,
    "text": "平时倒背如流的纪律"
  },
  {
    "start": 98.58,
    "end": 99.66,
    "text": "全抛在脑后"
  },
  {
    "start": 99.66,
    "end": 101.34,
    "text": "甚至连抓紧电话"
  },
  {
    "start": 101.34,
    "end": 103.24,
    "text": "下达止损单的本能都没了"
  },
  {
    "start": 103.24,
    "end": 103.82,
    "text": "对吧"
  },
  {
    "start": 103.82,
    "end": 104.0,
    "text": "对"
  },
  {
    "start": 104.0,
    "end": 105.5,
    "text": "就像晚上被远光灯"
  },
  {
    "start": 105.5,
    "end": 107.3,
    "text": "照将在马路中间的路一样"
  },
  {
    "start": 107.3,
    "end": 110.0,
    "text": "这也就是这本书诞生的绝佳背景"
  },
  {
    "start": 110.0,
    "end": 112.86,
    "text": "作者阿瑟和这位自称幽灵的交易者"
  },
  {
    "start": 112.86,
    "end": 114.5,
    "text": "最早是在96年"
  },
  {
    "start": 114.5,
    "end": 116.3,
    "text": "一家期货杂志网站论坛里"
  },
  {
    "start": 116.3,
    "end": 117.88,
    "text": "展开这些深度交流的"
  },
  {
    "start": 117.88,
    "end": 118.94,
    "text": "等一下啊"
  },
  {
    "start": 118.94,
    "end": 121.36,
    "text": "既然提到这个论坛和匿名身份"
  },
  {
    "start": 121.36,
    "end": 122.98,
    "text": "我就得替咱们听众"
  },
  {
    "start": 122.98,
    "end": 123.78,
    "text": "也就是你"
  },
  {
    "start": 123.78,
    "end": 125.24,
    "text": "先问一句了"
  },
  {
    "start": 125.24,
    "end": 125.92,
    "text": "问什么"
  },
  {
    "start": 125.92,
    "end": 130.12,
    "text": "这位幽灵自称在市场里摸爬滚打了好多年"
  },
  {
    "start": 130.12,
    "end": 132.64,
    "text": "还说自己首日资本就直接泛泛"
  },
  {
    "start": 132.64,
    "end": 135.14,
    "text": "在那种早期的匿名论坛里"
  },
  {
    "start": 135.14,
    "end": 136.78,
    "text": "连真实身份都查不到"
  },
  {
    "start": 136.78,
    "end": 138.78,
    "text": "业绩也没法考证"
  },
  {
    "start": 138.78,
    "end": 140.76,
    "text": "嗯 听起来确实挺玄乎的"
  },
  {
    "start": 140.76,
    "end": 141.58,
    "text": "对啊"
  },
  {
    "start": 141.58,
    "end": 144.74,
    "text": "咱们去学一个连脸都不敢露的网游经验"
  },
  {
    "start": 144.74,
    "end": 146.96,
    "text": "把真金白银的命运托付给他"
  },
  {
    "start": 146.96,
    "end": 148.14,
    "text": "这靠谱吗"
  },
  {
    "start": 148.14,
    "end": 151.26,
    "text": "如果你非要去核实他的身份标签"
  },
  {
    "start": 151.26,
    "end": 153.5,
    "text": "或者考证那些神话般的业绩故事"
  },
  {
    "start": 153.5,
    "end": 155.86,
    "text": "那确实会掉进盲目崇拜的坑里"
  },
  {
    "start": 155.86,
    "end": 156.42,
    "text": "是吧"
  },
  {
    "start": 156.42,
    "end": 158.58,
    "text": "毕竟谁能在网上自证清白呢"
  },
  {
    "start": 158.58,
    "end": 160.4,
    "text": "但这本书能流传下来"
  },
  {
    "start": 160.4,
    "end": 161.92,
    "text": "核心价值完全不在这里"
  },
  {
    "start": 161.92,
    "end": 164.5,
    "text": "当我们剥离掉那些传奇色彩的外衣"
  },
  {
    "start": 164.5,
    "end": 166.98,
    "text": "直接去审视他对风险的微观解剖"
  },
  {
    "start": 166.98,
    "end": 168.5,
    "text": "对仓位控制的逻辑"
  },
  {
    "start": 168.5,
    "end": 171.16,
    "text": "你会发现这些是做不了假的"
  },
  {
    "start": 171.16,
    "end": 172.46,
    "text": "嗯 也就是说"
  },
  {
    "start": 172.46,
    "end": 174.24,
    "text": "咱们完全不用管他是谁"
  },
  {
    "start": 174.24,
    "end": 177.54,
    "text": "直接拿放大镜去检验他的思维源代码就行"
  },
  {
    "start": 177.54,
    "end": 177.74,
    "text": "对"
  },
  {
    "start": 177.74,
    "end": 179.7,
    "text": "这套应对不确定性的逻辑"
  },
  {
    "start": 179.7,
    "end": 181.2,
    "text": "不管是谁提出来的"
  },
  {
    "start": 181.2,
    "end": 182.62,
    "text": "他本身都极其严密"
  },
  {
    "start": 182.62,
    "end": 185.06,
    "text": "足以经受住任何石盘环境的拷问"
  },
  {
    "start": 185.06,
    "end": 188.9,
    "text": "嗯 既然重点是如何在不确定性中活下来"
  },
  {
    "start": 188.9,
    "end": 190.9,
    "text": "那他最助理的那个规则一"
  },
  {
    "start": 190.9,
    "end": 193.38,
    "text": "到底是怎么重新定义对于错的"
  },
  {
    "start": 193.38,
    "end": 195.68,
    "text": "规则一的原文极其冷酷"
  },
  {
    "start": 195.68,
    "end": 198.1,
    "text": "就是仓位在未被证明正确前"
  },
  {
    "start": 198.1,
    "end": 200.08,
    "text": "必须假定他是错的"
  },
  {
    "start": 200.08,
    "end": 201.76,
    "text": "等等 假定他是错的"
  },
  {
    "start": 201.76,
    "end": 204.04,
    "text": "这不就等于我只要按下买入键"
  },
  {
    "start": 204.04,
    "end": 205.56,
    "text": "就已经是个失败者了吗"
  },
  {
    "start": 205.56,
    "end": 208.94,
    "text": "这就是普通人和顶尖高手的巨大分水岭啊"
  },
  {
    "start": 208.94,
    "end": 210.74,
    "text": "普通人买入之后是怎么做的"
  },
  {
    "start": 210.74,
    "end": 212.08,
    "text": "被动的祈祷"
  },
  {
    "start": 212.08,
    "end": 215.7,
    "text": "对 死盯着设在老远下方的固定止损价"
  },
  {
    "start": 215.7,
    "end": 217.86,
    "text": "没错 只要价格没跌到那儿"
  },
  {
    "start": 217.86,
    "end": 220.26,
    "text": "哪怕行情像一潭死水一样停滞了好久"
  },
  {
    "start": 220.26,
    "end": 222.56,
    "text": "他们还是会死死抱着仓位不放"
  },
  {
    "start": 222.56,
    "end": 225.24,
    "text": "还会找各种利好消息来麻痹自己"
  },
  {
    "start": 225.24,
    "end": 227.28,
    "text": "但幽灵的逻辑截然想法"
  },
  {
    "start": 227.28,
    "end": 229.22,
    "text": "交易的本质不是等待宣判"
  },
  {
    "start": 229.22,
    "end": 230.82,
    "text": "而是主动索取确认"
  },
  {
    "start": 230.82,
    "end": 232.68,
    "text": "如果你在规定时间内"
  },
  {
    "start": 232.68,
    "end": 235.08,
    "text": "没得到市场强有力的正向反馈"
  },
  {
    "start": 235.08,
    "end": 236.98,
    "text": "你就得主动回到"
  },
  {
    "start": 236.98,
    "end": 239.68,
    "text": "也就是必须减仓或者彻底平仓"
  },
  {
    "start": 239.68,
    "end": 242.38,
    "text": "能举个微观推演的例子吗"
  },
  {
    "start": 242.38,
    "end": 243.02,
    "text": "可以"
  },
  {
    "start": 243.02,
    "end": 245.96,
    "text": "咱们看书里那个大豆空头交易的推演"
  },
  {
    "start": 245.96,
    "end": 248.82,
    "text": "假设开盘时以6.30美金"
  },
  {
    "start": 248.82,
    "end": 249.72,
    "text": "卖空大豆"
  },
  {
    "start": 249.98,
    "end": 250.98,
    "text": "嗯 建仓了"
  },
  {
    "start": 250.98,
    "end": 253.98,
    "text": "交易者原本预期在开盘初期会下跌"
  },
  {
    "start": 253.98,
    "end": 254.78,
    "text": "5到8美分"
  },
  {
    "start": 254.78,
    "end": 257.0,
    "text": "但是随着时间流逝"
  },
  {
    "start": 257.0,
    "end": 259.44,
    "text": "盘面的实际跌幅不足3美分"
  },
  {
    "start": 259.44,
    "end": 260.42,
    "text": "那这时候怎么办"
  },
  {
    "start": 260.42,
    "end": 261.48,
    "text": "面对这种情况"
  },
  {
    "start": 261.48,
    "end": 264.6,
    "text": "幽灵的决策是毫不犹豫的在6.29美元平仓"
  },
  {
    "start": 264.6,
    "end": 267.26,
    "text": "哇 这就很反常识了呀"
  },
  {
    "start": 267.26,
    "end": 268.2,
    "text": "我算算啊"
  },
  {
    "start": 268.2,
    "end": 270.62,
    "text": "这笔单子其实它还赚了1美分呢"
  },
  {
    "start": 270.62,
    "end": 272.34,
    "text": "账面明明是红的"
  },
  {
    "start": 272.34,
    "end": 273.1,
    "text": "不仅没亏"
  },
  {
    "start": 273.1,
    "end": 274.02,
    "text": "还有盈余"
  },
  {
    "start": 274.02,
    "end": 275.08,
    "text": "为什么要跑"
  },
  {
    "start": 275.08,
    "end": 277.7,
    "text": "因为时间已经给出答案了"
  },
  {
    "start": 277.7,
    "end": 281.8,
    "text": "市场在预定时间窗口内没有展现出预期的下跌动能"
  },
  {
    "start": 281.8,
    "end": 284.7,
    "text": "预期落空本身就是最大的风险信号"
  },
  {
    "start": 284.7,
    "end": 289.06,
    "text": "所以这微薄的利润其实是个极具欺骗性的陷阱"
  },
  {
    "start": 289.06,
    "end": 289.28,
    "text": "对"
  },
  {
    "start": 289.28,
    "end": 292.3,
    "text": "如果你贪图这点应投小利继续耗着"
  },
  {
    "start": 292.3,
    "end": 298.12,
    "text": "那你就是在拿暴露在未知风险中的巨大本金去赌失效的逻辑"
  },
  {
    "start": 298.12,
    "end": 302.12,
    "text": "书中在讨论关于10%和90%的盈利机会落差"
  },
  {
    "start": 302.12,
    "end": 305.74,
    "text": "以及针对那特定几小时持仓设想的推演时"
  },
  {
    "start": 305.74,
    "end": 307.48,
    "text": "其实都在夯视这个核心"
  },
  {
    "start": 307.48,
    "end": 312.78,
    "text": "就是时间窗口的有效性直接凌驾于价格的账面盈亏之上"
  },
  {
    "start": 312.78,
    "end": 313.1,
    "text": "对吧"
  },
  {
    "start": 313.1,
    "end": 313.98,
    "text": "完全正确"
  },
  {
    "start": 313.98,
    "end": 316.7,
    "text": "怎么把这个逻辑拽回日常生活里"
  },
  {
    "start": 316.7,
    "end": 319.7,
    "text": "这其实非常像你去等末班公交车"
  },
  {
    "start": 319.7,
    "end": 322.02,
    "text": "预期片刻后车会出现在街角"
  },
  {
    "start": 322.02,
    "end": 323.8,
    "text": "结果好半天过去了"
  },
  {
    "start": 323.8,
    "end": 325.24,
    "text": "连个车灯都没看到"
  },
  {
    "start": 325.24,
    "end": 327.98,
    "text": "普通人可能就会站在雨里自我催眠"
  },
  {
    "start": 327.98,
    "end": 329.66,
    "text": "觉得可能只是晚点了"
  },
  {
    "start": 329.66,
    "end": 330.42,
    "text": "再等等吧"
  },
  {
    "start": 330.42,
    "end": 332.32,
    "text": "但规则一的执行者就会觉得"
  },
  {
    "start": 332.32,
    "end": 334.22,
    "text": "时间到了车没来"
  },
  {
    "start": 334.22,
    "end": 338.6,
    "text": "没按时发生这件事本身就已经是个必须警惕的信号了"
  },
  {
    "start": 338.6,
    "end": 339.72,
    "text": "非常准确"
  },
  {
    "start": 339.72,
    "end": 342.26,
    "text": "这说明前面的路可能断了"
  },
  {
    "start": 342.26,
    "end": 344.5,
    "text": "你的出境已经极度危险"
  },
  {
    "start": 344.5,
    "end": 345.74,
    "text": "必须马上找退路"
  },
  {
    "start": 345.74,
    "end": 348.42,
    "text": "而不是把生存希望寄托在失效的时刻表上"
  },
  {
    "start": 348.42,
    "end": 350.54,
    "text": "所以规则一之所以有效"
  },
  {
    "start": 350.54,
    "end": 354.04,
    "text": "关键在于交易者必须事先制定判断标准"
  },
  {
    "start": 354.04,
    "end": 356.72,
    "text": "把可能的亏损提前放进计划里"
  },
  {
    "start": 356.72,
    "end": 358.84,
    "text": "而不是跟着行情临时起义"
  },
  {
    "start": 358.84,
    "end": 359.18,
    "text": "是的"
  },
  {
    "start": 359.18,
    "end": 362.94,
    "text": "这就要求你进场前强制写下明确标准"
  },
  {
    "start": 362.94,
    "end": 364.64,
    "text": "盘面信息再乱"
  },
  {
    "start": 364.64,
    "end": 366.62,
    "text": "你也只需要冷酷的比对标准"
  },
  {
    "start": 366.62,
    "end": 369.54,
    "text": "没按计划发生就立刻启动推出程序"
  },
  {
    "start": 369.54,
    "end": 371.24,
    "text": "没有任何商量的余地"
  },
  {
    "start": 371.24,
    "end": 372.36,
    "text": "拔箭四顾"
  },
  {
    "start": 372.36,
    "end": 373.9,
    "text": "没看到预期的破绽"
  },
  {
    "start": 373.9,
    "end": 375.12,
    "text": "立马收件回撬"
  },
  {
    "start": 375.12,
    "end": 378.6,
    "text": "但这直接引出了个巨大的逻辑漏洞啊"
  },
  {
    "start": 378.6,
    "end": 379.04,
    "text": "呃"
  },
  {
    "start": 379.04,
    "end": 380.24,
    "text": "什么漏洞"
  },
  {
    "start": 380.24,
    "end": 380.86,
    "text": "你想啊"
  },
  {
    "start": 380.86,
    "end": 382.04,
    "text": "只要风吹草动"
  },
  {
    "start": 382.04,
    "end": 383.78,
    "text": "或者行情没立刻如愿"
  },
  {
    "start": 383.78,
    "end": 385.32,
    "text": "我就疯狂砍仓"
  },
  {
    "start": 385.32,
    "end": 386.56,
    "text": "长此以往"
  },
  {
    "start": 386.56,
    "end": 389.34,
    "text": "账户里全都是手续费和摩擦成本"
  },
  {
    "start": 389.34,
    "end": 391.22,
    "text": "我一直在流血防守"
  },
  {
    "start": 391.22,
    "end": 393.1,
    "text": "那靠什么在市场上赚钱"
  },
  {
    "start": 393.1,
    "end": 394.02,
    "text": "问得好"
  },
  {
    "start": 394.02,
    "end": 396.06,
    "text": "这就必须动用它的规则二了"
  },
  {
    "start": 396.06,
    "end": 399.5,
    "text": "规则二可以说是这套防御体系的攻击长矛"
  },
  {
    "start": 399.5,
    "end": 403.12,
    "text": "也就是处理留下来那些正确仓位的方法"
  },
  {
    "start": 403.12,
    "end": 407.9,
    "text": "对 当你像割野草一样清理掉亏损或停滞的仓位后"
  },
  {
    "start": 407.9,
    "end": 412.08,
    "text": "手里剩下的就是被市场真金白银验证过的筹码"
  },
  {
    "start": 412.08,
    "end": 415.4,
    "text": "规则二的使命就是要在这些正确的仓位上加码"
  },
  {
    "start": 415.4,
    "end": 416.22,
    "text": "诶 等一下"
  },
  {
    "start": 416.22,
    "end": 418.44,
    "text": "看到浮营就立刻加仓"
  },
  {
    "start": 418.44,
    "end": 421.48,
    "text": "这听起来是不是有点像盲目贪婪啊"
  },
  {
    "start": 421.48,
    "end": 423.92,
    "text": "这恰恰是很多新手爆仓的原因"
  },
  {
    "start": 423.92,
    "end": 424.56,
    "text": "是啊"
  },
  {
    "start": 424.56,
    "end": 427.04,
    "text": "新手经常在底部买点底仓"
  },
  {
    "start": 427.04,
    "end": 428.58,
    "text": "掌上去信心爆棚"
  },
  {
    "start": 428.58,
    "end": 431.04,
    "text": "半山腰把全部身价压进去"
  },
  {
    "start": 431.04,
    "end": 433.98,
    "text": "航行稍微回调 城门家瞬间被击穿"
  },
  {
    "start": 433.98,
    "end": 435.32,
    "text": "立马游影转窥"
  },
  {
    "start": 435.32,
    "end": 439.04,
    "text": "顺势加码听起来简直是通向爆仓的捷径"
  },
  {
    "start": 439.04,
    "end": 441.1,
    "text": "所以 书里极其强调"
  },
  {
    "start": 441.1,
    "end": 443.18,
    "text": "加码必须是递减式的"
  },
  {
    "start": 443.18,
    "end": 444.86,
    "text": "并且设定了严苛的前提"
  },
  {
    "start": 444.86,
    "end": 447.16,
    "text": "绝对不能倒金子塔式的赌博"
  },
  {
    "start": 447.16,
    "end": 449.26,
    "text": "那正确的机制是什么样的"
  },
  {
    "start": 449.26,
    "end": 452.18,
    "text": "比如你初始底仓投入了固定本金"
  },
  {
    "start": 452.18,
    "end": 454.06,
    "text": "确认安全需要加码时"
  },
  {
    "start": 454.06,
    "end": 455.8,
    "text": "你可能只加注一半体量"
  },
  {
    "start": 455.8,
    "end": 458.14,
    "text": "再确认再追加更少份额"
  },
  {
    "start": 458.14,
    "end": 461.08,
    "text": "持舱重心虽然上移 但始终与试驾"
  },
  {
    "start": 461.08,
    "end": 462.9,
    "text": "保持着安全的护城河"
  },
  {
    "start": 462.9,
    "end": 464.86,
    "text": "这就像古代打仗排兵布阵"
  },
  {
    "start": 464.86,
    "end": 467.44,
    "text": "先派精锐先遣队试探敌情"
  },
  {
    "start": 467.44,
    "end": 469.26,
    "text": "打赢了发挥安全信号"
  },
  {
    "start": 469.26,
    "end": 470.46,
    "text": "才派后续部队"
  },
  {
    "start": 470.46,
    "end": 472.92,
    "text": "而且后续部队规模越来越小"
  },
  {
    "start": 472.92,
    "end": 474.9,
    "text": "防止被敌人反扑包饺子"
  },
  {
    "start": 474.9,
    "end": 476.42,
    "text": "这个比喻太棒了"
  },
  {
    "start": 476.42,
    "end": 477.68,
    "text": "而且除此之外"
  },
  {
    "start": 477.68,
    "end": 481.08,
    "text": "规则二里还隐藏着极其反人性的欠套锁扣"
  },
  {
    "start": 481.08,
    "end": 483.38,
    "text": "你新加进去的任何舱位"
  },
  {
    "start": 483.38,
    "end": 486.38,
    "text": "绝不能躺在底舱的功劳部上睡大觉"
  },
  {
    "start": 486.38,
    "end": 490.56,
    "text": "必须立刻无条件的重新接受规则一的审判"
  },
  {
    "start": 490.56,
    "end": 491.68,
    "text": "完全正确"
  },
  {
    "start": 491.68,
    "end": 493.06,
    "text": "这批新兵一旦上战场"
  },
  {
    "start": 493.06,
    "end": 495.08,
    "text": "不仅要假定他是错的"
  },
  {
    "start": 495.08,
    "end": 496.72,
    "text": "而且如果没立刻打胜仗"
  },
  {
    "start": 496.72,
    "end": 499.26,
    "text": "你也必须像砍掉最初的错单一样"
  },
  {
    "start": 499.26,
    "end": 501.02,
    "text": "冷血的把它砍掉"
  },
  {
    "start": 501.02,
    "end": 502.4,
    "text": "哪怕底舱还赚着钱"
  },
  {
    "start": 502.4,
    "end": 503.82,
    "text": "也不能掩护他"
  },
  {
    "start": 503.82,
    "end": 505.26,
    "text": "绝对不能掩护"
  },
  {
    "start": 505.26,
    "end": 507.9,
    "text": "个比资金都有独立的生存指标"
  },
  {
    "start": 507.9,
    "end": 509.18,
    "text": "这就保证了"
  },
  {
    "start": 509.18,
    "end": 511.2,
    "text": "你永远不会因为加码失误"
  },
  {
    "start": 511.2,
    "end": 512.78,
    "text": "毁掉整段大趋势的利润"
  },
  {
    "start": 512.78,
    "end": 515.36,
    "text": "防守时主动截断不确定性"
  },
  {
    "start": 515.36,
    "end": 516.94,
    "text": "进攻时递减加仓"
  },
  {
    "start": 516.94,
    "end": 518.1,
    "text": "还能随时撤退"
  },
  {
    "start": 518.1,
    "end": 520.68,
    "text": "这两条规则纸面上推演起来"
  },
  {
    "start": 520.68,
    "end": 522.5,
    "text": "简直像瑞士钟表一样完美"
  },
  {
    "start": 522.5,
    "end": 525.58,
    "text": "但这又衍生出个更现实的痛点"
  },
  {
    "start": 525.58,
    "end": 526.68,
    "text": "什么痛点"
  },
  {
    "start": 526.68,
    "end": 527.68,
    "text": "既然密集"
  },
  {
    "start": 527.68,
    "end": 529.08,
    "text": "明晃晃写在书里"
  },
  {
    "start": 529.08,
    "end": 530.68,
    "text": "逻辑也无懈可击"
  },
  {
    "start": 530.68,
    "end": 533.42,
    "text": "为什么到了节奏极快的当日交易中"
  },
  {
    "start": 533.42,
    "end": 535.6,
    "text": "绝大多数人依然会被市场屠杀"
  },
  {
    "start": 535.6,
    "end": 537.4,
    "text": "明明知道该止损"
  },
  {
    "start": 537.4,
    "end": 539.14,
    "text": "手却像灌了签一样"
  },
  {
    "start": 539.14,
    "end": 540.06,
    "text": "摁不下鼠标"
  },
  {
    "start": 540.06,
    "end": 543.12,
    "text": "以为交易本质上是一场失败者的游戏"
  },
  {
    "start": 543.12,
    "end": 544.3,
    "text": "挺起来刺耳"
  },
  {
    "start": 544.3,
    "end": 547.12,
    "text": "但在高频报价剧烈波动的刺激下"
  },
  {
    "start": 547.12,
    "end": 550.08,
    "text": "人的理性防线比纸还要薄"
  },
  {
    "start": 550.08,
    "end": 551.5,
    "text": "这太真实了"
  },
  {
    "start": 551.5,
    "end": 552.74,
    "text": "就像面对工作压力"
  },
  {
    "start": 552.74,
    "end": 554.46,
    "text": "理智告诉你去吃健康餐"
  },
  {
    "start": 554.46,
    "end": 556.82,
    "text": "手却下意识抓起高热量薯片"
  },
  {
    "start": 556.82,
    "end": 559.34,
    "text": "压力会瞬间剥夺控制权"
  },
  {
    "start": 559.34,
    "end": 560.94,
    "text": "交给动物本能"
  },
  {
    "start": 560.94,
    "end": 561.24,
    "text": "是的"
  },
  {
    "start": 561.24,
    "end": 564.2,
    "text": "在屏幕上红绿柱子疯狂扫荡的瞬间"
  },
  {
    "start": 564.2,
    "end": 566.32,
    "text": "大脑完全是彻底空白的"
  },
  {
    "start": 566.32,
    "end": 570.38,
    "text": "那些完美的规则对大脑来说就是毫无意义的字符"
  },
  {
    "start": 570.38,
    "end": 573.52,
    "text": "正在听节目的你肯定也有过这种大脑空白"
  },
  {
    "start": 573.52,
    "end": 575.78,
    "text": "全凭本能胡乱操作的时刻吧"
  },
  {
    "start": 575.78,
    "end": 578.96,
    "text": "既然我们知道极端环境下理性会缺席"
  },
  {
    "start": 578.96,
    "end": 582.76,
    "text": "那唯一的解法就是把这种冷冰冰的风控规则"
  },
  {
    "start": 582.76,
    "end": 584.56,
    "text": "暴力植入到本能里去"
  },
  {
    "start": 584.56,
    "end": 588.7,
    "text": "也就是幽灵强调的日常预备程序和心理强化训练"
  },
  {
    "start": 588.7,
    "end": 589.34,
    "text": "没错"
  },
  {
    "start": 589.34,
    "end": 591.4,
    "text": "不是用意志力对抗恐惧"
  },
  {
    "start": 591.4,
    "end": 594.72,
    "text": "而是在开盘前不断进行条件反射演练"
  },
  {
    "start": 594.72,
    "end": 596.66,
    "text": "只要价格没按预期走"
  },
  {
    "start": 596.66,
    "end": 599.04,
    "text": "手指就应该自动敲击平仓剑"
  },
  {
    "start": 599.04,
    "end": 600.98,
    "text": "必须经过枯燥重复"
  },
  {
    "start": 600.98,
    "end": 603.32,
    "text": "形成不假思索的肌肉记忆"
  },
  {
    "start": 603.32,
    "end": 603.56,
    "text": "对"
  },
  {
    "start": 603.56,
    "end": 604.54,
    "text": "只有这样"
  },
  {
    "start": 604.54,
    "end": 607.52,
    "text": "盘中才有可能真正绕过情绪的阻击"
  },
  {
    "start": 607.52,
    "end": 608.64,
    "text": "活下来"
  },
  {
    "start": 608.64,
    "end": 611.54,
    "text": "把反人性的几率硬生生练成第二天性"
  },
  {
    "start": 611.54,
    "end": 611.96,
    "text": "好"
  },
  {
    "start": 611.96,
    "end": 613.82,
    "text": "现在我们解决了入场验证"
  },
  {
    "start": 613.82,
    "end": 615.88,
    "text": "顺势加码和克服习惯障碍"
  },
  {
    "start": 615.88,
    "end": 619.26,
    "text": "那每笔成功的交易最终得有个出口吧"
  },
  {
    "start": 619.26,
    "end": 621.48,
    "text": "当市场彻底陷入沸腾时"
  },
  {
    "start": 621.48,
    "end": 623.22,
    "text": "咱们该怎么全身而退"
  },
  {
    "start": 623.22,
    "end": 626.02,
    "text": "这就引出了第十四章提到的"
  },
  {
    "start": 626.02,
    "end": 626.98,
    "text": "规则三"
  },
  {
    "start": 626.98,
    "end": 629.16,
    "text": "放巨量后的清仓动作"
  },
  {
    "start": 629.16,
    "end": 631.92,
    "text": "我记得这张的标题非常绝对啊"
  },
  {
    "start": 631.92,
    "end": 634.42,
    "text": "难道说看到盘面爆出天亮"
  },
  {
    "start": 634.42,
    "end": 635.76,
    "text": "就一秒钟都别犹豫"
  },
  {
    "start": 635.76,
    "end": 637.52,
    "text": "直接清空所有仓位吗"
  },
  {
    "start": 637.52,
    "end": 641.6,
    "text": "这个章节的标题确实带有极强的迷惑性"
  },
  {
    "start": 641.6,
    "end": 643.02,
    "text": "如果只扫一眼"
  },
  {
    "start": 643.02,
    "end": 645.84,
    "text": "很容易把它当成绝对化的交易圣碑"
  },
  {
    "start": 645.84,
    "end": 648.38,
    "text": "那仔细推敲正文的话"
  },
  {
    "start": 648.38,
    "end": 650.38,
    "text": "真实的执行过程是什么样的"
  },
  {
    "start": 650.38,
    "end": 653.72,
    "text": "真实操作是非常细腻有弹性的"
  },
  {
    "start": 653.72,
    "end": 654.86,
    "text": "面对极端狂热"
  },
  {
    "start": 654.86,
    "end": 657.64,
    "text": "它采取的是分阶段剥离风险的策略"
  },
  {
    "start": 657.64,
    "end": 658.44,
    "text": "比如"
  },
  {
    "start": 658.44,
    "end": 660.46,
    "text": "此日先处理半数仓位"
  },
  {
    "start": 660.46,
    "end": 661.22,
    "text": "落袋为安"
  },
  {
    "start": 661.22,
    "end": 664.32,
    "text": "后续日子里再根据市场反应处理剩下的"
  },
  {
    "start": 664.32,
    "end": 666.22,
    "text": "这就非常有意思了"
  },
  {
    "start": 666.22,
    "end": 667.58,
    "text": "把标题单独摘出来"
  },
  {
    "start": 667.58,
    "end": 670.14,
    "text": "像是在兜售无脑套现万能攻势"
  },
  {
    "start": 670.14,
    "end": 671.68,
    "text": "但真实执行"
  },
  {
    "start": 671.68,
    "end": 674.46,
    "text": "却在防范绝对化处理带来的踏空风险"
  },
  {
    "start": 674.46,
    "end": 676.7,
    "text": "所以其实并不存在什么"
  },
  {
    "start": 676.7,
    "end": 679.08,
    "text": "适用于所有极端行情的死规矩"
  },
  {
    "start": 679.08,
    "end": 679.58,
    "text": "对吧"
  },
  {
    "start": 679.58,
    "end": 680.16,
    "text": "对"
  },
  {
    "start": 680.16,
    "end": 681.84,
    "text": "你捕捉的很敏锐"
  },
  {
    "start": 681.84,
    "end": 683.78,
    "text": "书里为了解释这种极端情况"
  },
  {
    "start": 683.78,
    "end": 685.74,
    "text": "抛出了个极其精彩的"
  },
  {
    "start": 685.74,
    "end": 687.28,
    "text": "关于飞机失事的意向"
  },
  {
    "start": 687.28,
    "end": 688.66,
    "text": "飞机失事"
  },
  {
    "start": 688.66,
    "end": 689.98,
    "text": "这跨度有点大"
  },
  {
    "start": 689.98,
    "end": 692.32,
    "text": "它是怎么把巨量清仓和空难"
  },
  {
    "start": 692.32,
    "end": 693.14,
    "text": "联系在一起的"
  },
  {
    "start": 693.14,
    "end": 694.36,
    "text": "你回想一下"
  },
  {
    "start": 694.36,
    "end": 696.1,
    "text": "每次航班起飞前"
  },
  {
    "start": 696.1,
    "end": 698.12,
    "text": "空城都会依似不苟的掩饰"
  },
  {
    "start": 698.12,
    "end": 699.0,
    "text": "如果迫降"
  },
  {
    "start": 699.0,
    "end": 700.82,
    "text": "该怎么采取防冲击姿势"
  },
  {
    "start": 700.82,
    "end": 701.54,
    "text": "嗯"
  },
  {
    "start": 701.54,
    "end": 702.64,
    "text": "其实大家都知道"
  },
  {
    "start": 702.64,
    "end": 704.56,
    "text": "真正实实是极小概率的意外"
  },
  {
    "start": 704.56,
    "end": 705.14,
    "text": "对"
  },
  {
    "start": 705.14,
    "end": 707.3,
    "text": "但为什么还要不厌其烦的演练"
  },
  {
    "start": 707.3,
    "end": 709.62,
    "text": "因为一旦飞机剧烈下坠"
  },
  {
    "start": 709.62,
    "end": 711.12,
    "text": "极度恐慌的乘客"
  },
  {
    "start": 711.12,
    "end": 713.16,
    "text": "根本没有思考能力"
  },
  {
    "start": 713.16,
    "end": 713.92,
    "text": "防冲击姿势"
  },
  {
    "start": 713.92,
    "end": 715.44,
    "text": "不是保证绝对存活"
  },
  {
    "start": 715.44,
    "end": 716.82,
    "text": "而是要在混乱中"
  },
  {
    "start": 716.82,
    "end": 719.02,
    "text": "给你个保底的清晰行动指令"
  },
  {
    "start": 719.02,
    "end": 720.98,
    "text": "这个比喻太透彻了"
  },
  {
    "start": 720.98,
    "end": 723.12,
    "text": "市场突然爆出的巨量极端行情"
  },
  {
    "start": 723.12,
    "end": 725.22,
    "text": "就是那架随时可能失控的飞机"
  },
  {
    "start": 725.22,
    "end": 726.1,
    "text": "没错"
  },
  {
    "start": 726.1,
    "end": 727.38,
    "text": "分阶段清仓"
  },
  {
    "start": 727.38,
    "end": 729.84,
    "text": "就是交易员的防冲击姿势"
  },
  {
    "start": 729.84,
    "end": 732.1,
    "text": "它让你在市场极度非理性时刻"
  },
  {
    "start": 732.1,
    "end": 733.94,
    "text": "有个清晰的撤退锚点"
  },
  {
    "start": 733.94,
    "end": 735.06,
    "text": "归根结底"
  },
  {
    "start": 735.06,
    "end": 736.7,
    "text": "幽灵其实承认了"
  },
  {
    "start": 736.7,
    "end": 737.98,
    "text": "所有这些规则"
  },
  {
    "start": 737.98,
    "end": 740.28,
    "text": "都高度依赖千人千面的"
  },
  {
    "start": 740.28,
    "end": 741.56,
    "text": "个人交易计划"
  },
  {
    "start": 741.56,
    "end": 744.1,
    "text": "以及最终落在市场机制上的"
  },
  {
    "start": 744.1,
    "end": 745.84,
    "text": "严苛下单执行"
  },
  {
    "start": 745.84,
    "end": 746.14,
    "text": "是的"
  },
  {
    "start": 746.14,
    "end": 748.56,
    "text": "这就是一套极其冷酷的"
  },
  {
    "start": 748.56,
    "end": 749.56,
    "text": "风险控制机器"
  },
  {
    "start": 749.56,
    "end": 752.08,
    "text": "如果把交易当成"
  },
  {
    "start": 752.08,
    "end": 753.46,
    "text": "先求少输的游戏"
  },
  {
    "start": 753.46,
    "end": 756.06,
    "text": "进场前和进场后的第一步动作"
  },
  {
    "start": 756.06,
    "end": 757.64,
    "text": "分别会变成什么"
  }
]
