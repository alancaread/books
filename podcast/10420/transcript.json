  {
    "start": 461.46,
    "end": 461.94,
    "text": "嗯"
  },
  {
    "start": 461.94,
    "end": 463.4,
    "text": "原话是怎么说的"
  },
  {
    "start": 463.4,
    "end": 464.26,
    "text": "作者认为"
  },
  {
    "start": 464.26,
    "end": 467.54,
    "text": "海星式组织发挥作用的五大要素是"
  },
  {
    "start": 467.54,
    "end": 468.42,
    "text": "圈子"
  },
  {
    "start": 468.42,
    "end": 469.64,
    "text": "触媒式人物"
  },
  {
    "start": 469.64,
    "end": 470.48,
    "text": "信仰"
  },
  {
    "start": 470.48,
    "end": 471.18,
    "text": "平台"
  },
  {
    "start": 471.18,
    "end": 471.76,
    "text": "斗士"
  },
  {
    "start": 471.76,
    "end": 473.38,
    "text": "圈子"
  },
  {
    "start": 473.38,
    "end": 474.04,
    "text": "触媒"
  },
  {
    "start": 474.04,
    "end": 475.02,
    "text": "信仰"
  },
  {
    "start": 475.02,
    "end": 475.58,
    "text": "平台"
  },
  {
    "start": 475.58,
    "end": 476.3,
    "text": "斗士"
  },
  {
    "start": 476.3,
    "end": 477.22,
    "text": "哎"
  },
  {
    "start": 477.22,
    "end": 478.88,
    "text": "这五个词非常有意思"
  },
  {
    "start": 478.88,
    "end": 479.46,
    "text": "没错"
  },
  {
    "start": 479.46,
    "end": 480.94,
    "text": "特别是第五章里"
  },
  {
    "start": 480.94,
    "end": 482.88,
    "text": "重点讲的这个触媒式人物"
  },
  {
    "start": 482.88,
    "end": 485.74,
    "text": "可以说是打破了我们对领导力的传统认知"
  },
  {
    "start": 485.74,
    "end": 489.24,
    "text": "传统的CEO是靠行政权威来做管理的"
