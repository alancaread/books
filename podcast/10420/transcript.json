  {
    "start": 441.48,
    "end": 442.14,
    "text": "对对"
  },
  {
    "start": 442.14,
    "end": 443.08,
    "text": "非常感谢补充"
  },
  {
    "start": 443.08,
    "end": 444.34,
    "text": "这个区分很重要"
  },
  {
    "start": 444.34,
    "end": 447.24,
    "text": "那这些组织到底靠什么维持运转呢"
  },
  {
    "start": 447.24,
    "end": 448.42,
    "text": "没有领导"
  },
  {
    "start": 448.42,
    "end": 449.7,
    "text": "不代表没有核心人物"
  },
  {
    "start": 449.7,
    "end": 451.46,
    "text": "我要逐字引用"
  },
  {
    "start": 451.46,
    "end": 454.24,
    "text": "本期材料里一句非常核心的原话了"
  },
  {
    "start": 454.24,
    "end": 455.26,
    "text": "请大家注意"
  },
  {
    "start": 455.26,
    "end": 457.04,
    "text": "这是原书作者的原话"
  },
  {
    "start": 457.04,
    "end": 458.5,
    "text": "代表作者的总结"
  },
  {
    "start": 458.5,
    "end": 461.46,
    "text": "不代表我们独立证实了它的普世性"
