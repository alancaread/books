[
  {
    "start": 0.0,
    "end": 3.72,
    "text": "当全球顶尖学者齐聚一堂讨论人工智能时"
  },
  {
    "start": 3.72,
    "end": 6.12,
    "text": "他们最根本的分歧究竟在哪里"
  },
  {
    "start": 6.12,
    "end": 7.78,
    "text": "要回答这个"
  },
  {
    "start": 7.78,
    "end": 9.3,
    "text": "咱们就得拆解一下"
  },
  {
    "start": 9.3,
    "end": 11.04,
    "text": "约翰·布洛克曼编的这本"
  },
  {
    "start": 11.04,
    "end": 12.76,
    "text": "AI的25种可能"
  },
  {
    "start": 12.76,
    "end": 13.18,
    "text": "对"
  },
  {
    "start": 13.18,
    "end": 15.12,
    "text": "这本书最奇妙的地方就是"
  },
  {
    "start": 15.12,
    "end": 16.22,
    "text": "当你翻盖它"
  },
  {
    "start": 16.22,
    "end": 16.98,
    "text": "你会发现"
  },
  {
    "start": 16.98,
    "end": 21.06,
    "text": "它压根就没打算给你那种四平八稳的共识"
  },
  {
    "start": 21.06,
    "end": 22.38,
    "text": "完全没有"
  },
  {
    "start": 22.38,
    "end": 25.62,
    "text": "它简直像是个没有裁判的学术角斗场"
  },
  {
    "start": 25.62,
    "end": 28.18,
    "text": "直接把各个领域顶尖大脑的立场"
  },
  {
    "start": 28.18,
    "end": 29.34,
    "text": "全盘托出"
  },
  {
    "start": 29.34,
    "end": 29.98,
    "text": "没错"
  },
  {
    "start": 29.98,
    "end": 32.2,
    "text": "所以面对这么多声音"
  },
  {
    "start": 32.2,
    "end": 33.6,
    "text": "咱们最不该做的就是"
  },
  {
    "start": 33.6,
    "end": 35.74,
    "text": "强行给他们捏造一个标准答案"
  },
  {
    "start": 35.74,
    "end": 38.76,
    "text": "我们要做的是去看看他们争论的"
  },
  {
    "start": 38.76,
    "end": 40.62,
    "text": "究竟是某个具体事实"
  },
  {
    "start": 40.62,
    "end": 42.16,
    "text": "还是对智能的定义"
  },
  {
    "start": 42.16,
    "end": 44.9,
    "text": "又或者是最底层的价值观分歧"
  },
  {
    "start": 44.9,
    "end": 47.1,
    "text": "确实不能悬在半空中了"
  },
  {
    "start": 47.1,
    "end": 48.78,
    "text": "其实追根溯源的话"
  },
  {
    "start": 48.78,
    "end": 49.76,
    "text": "你会发现"
  },
  {
    "start": 49.76,
    "end": 50.72,
    "text": "这些学者的目光"
  },
  {
    "start": 50.72,
    "end": 53.0,
    "text": "几乎都绕不开一个共同的起点"
  },
  {
    "start": 53.0,
    "end": 54.16,
    "text": "诺伯特·维纳"
  },
  {
    "start": 54.16,
    "end": 54.8,
    "text": "就是他"
  },
  {
    "start": 54.8,
    "end": 57.96,
    "text": "维纳在1948年出版的《控制论》"
  },
  {
    "start": 57.96,
    "end": 59.96,
    "text": "还有后来的《人有人的用处》"
  },
  {
    "start": 59.96,
    "end": 62.42,
    "text": "其实是得今天所有的讨论打了个地基"
  },
  {
    "start": 62.42,
    "end": 63.18,
    "text": "怎么说"
  },
  {
    "start": 63.18,
    "end": 65.36,
    "text": "就是他把机器"
  },
  {
    "start": 65.36,
    "end": 66.1,
    "text": "信息"
  },
  {
    "start": 66.1,
    "end": 67.2,
    "text": "还有反馈循环"
  },
  {
    "start": 67.2,
    "end": 68.6,
    "text": "统一到了一个框架里"
  },
  {
    "start": 68.6,
    "end": 69.66,
    "text": "后来的学者"
  },
  {
    "start": 69.66,
    "end": 71.42,
    "text": "不管你是要在上面建高楼"
  },
  {
    "start": 71.42,
    "end": 73.14,
    "text": "还是要拿大锤把它砸了"
  },
  {
    "start": 73.14,
    "end": 74.76,
    "text": "你都得先站上这块地基"
  },
  {
    "start": 74.76,
    "end": 76.34,
    "text": "但戏剧性的是"
  },
  {
    "start": 76.34,
    "end": 78.44,
    "text": "一旦这些顶尖聪明的大脑"
  },
  {
    "start": 78.44,
    "end": 79.72,
    "text": "开始在这个框架里"
  },
  {
    "start": 79.72,
    "end": 80.9,
    "text": "推演具体的未来"
  },
  {
    "start": 80.9,
    "end": 82.18,
    "text": "事情就失控了"
  },
  {
    "start": 82.18,
    "end": 82.4,
    "text": "对"
  },
  {
    "start": 82.4,
    "end": 84.04,
    "text": "预测未来太难了"
  },
  {
    "start": 84.04,
    "end": 85.56,
    "text": "书里好几个人都提到了"
  },
  {
    "start": 85.56,
    "end": 87.8,
    "text": "历史上的光速打脸事件"
  },
  {
    "start": 87.8,
    "end": 88.5,
    "text": "你想啊"
  },
  {
    "start": 88.5,
    "end": 89.46,
    "text": "1933年的时候"
  },
  {
    "start": 89.46,
    "end": 91.18,
    "text": "著名物理学家卢塞福"
  },
  {
    "start": 91.18,
    "end": 92.18,
    "text": "站在台上"
  },
  {
    "start": 92.18,
    "end": 94.08,
    "text": "那是满怀信心的断言"
  },
  {
    "start": 94.08,
    "end": 96.94,
    "text": "说想从原子转变中获取能量"
  },
  {
    "start": 96.94,
    "end": 98.4,
    "text": "完全是痴心妄想"
  },
  {
    "start": 98.4,
    "end": 99.22,
    "text": "结果呢"
  },
  {
    "start": 99.22,
    "end": 99.9,
    "text": "结果"
  },
  {
    "start": 99.9,
    "end": 101.96,
    "text": "仅仅在他说完的第二天"
  },
  {
    "start": 101.96,
    "end": 104.24,
    "text": "利奥西拉特散步过马路时"
  },
  {
    "start": 104.24,
    "end": 105.38,
    "text": "脑子里就冒出了"
  },
  {
    "start": 105.38,
    "end": 107.54,
    "text": "中子诱发核链式反应的构想"
  },
  {
    "start": 107.54,
    "end": 107.86,
    "text": "哇"
  },
  {
    "start": 107.86,
    "end": 109.6,
    "text": "这脸打得太响了"
  },
  {
    "start": 109.6,
    "end": 110.96,
    "text": "斯托亚特罗素他们"
  },
  {
    "start": 110.96,
    "end": 112.34,
    "text": "就是拿这个事提醒我们"
  },
  {
    "start": 112.34,
    "end": 113.4,
    "text": "技术突破"
  },
  {
    "start": 113.4,
    "end": 115.72,
    "text": "往往就在不可能的转天发生"
  },
  {
    "start": 115.72,
    "end": 116.52,
    "text": "没错"
  },
  {
    "start": 116.52,
    "end": 118.62,
    "text": "但反过来也有极端的例子"
  },
  {
    "start": 118.62,
    "end": 120.58,
    "text": "塞斯罗埃德提到"
  },
  {
    "start": 120.58,
    "end": 122.02,
    "text": "上世纪五十年代"
  },
  {
    "start": 122.02,
    "end": 124.16,
    "text": "赫普特希蒙曾无比乐观的预言"
  },
  {
    "start": 124.16,
    "end": 127.06,
    "text": "机器在二十年内就能胜任人类的所有工作"
  },
  {
    "start": 127.06,
    "end": 129.06,
    "text": "结果错得离谱"
  },
  {
    "start": 129.06,
    "end": 129.38,
    "text": "是啊"
  },
  {
    "start": 129.38,
    "end": 131.38,
    "text": "所以这就让人怀疑了"
  },
  {
    "start": 131.38,
    "end": 133.5,
    "text": "难道全球最顶尖的大脑"
  },
  {
    "start": 133.5,
    "end": 135.3,
    "text": "在预测技术爆发节点的时候"
  },
  {
    "start": 135.3,
    "end": 136.72,
    "text": "也跟咱们普通人一样"
  },
  {
    "start": 136.72,
    "end": 138.72,
    "text": "纯粹靠扔飞镖瞎猜猜吗"
  },
  {
    "start": 138.72,
    "end": 140.42,
    "text": "表面看向瞎猜"
  },
  {
    "start": 140.42,
    "end": 143.06,
    "text": "但其实你钻到底层去"
  },
  {
    "start": 143.06,
    "end": 145.94,
    "text": "这绝不是猜不准日历上那个日期的问题"
  },
  {
    "start": 145.94,
    "end": 147.12,
    "text": "那是什么问题"
  },
  {
    "start": 147.12,
    "end": 150.24,
    "text": "是这些作者带着完全不同的预设入场的"
  },
  {
    "start": 150.24,
    "end": 151.52,
    "text": "他们根本的分歧"
  },
  {
    "start": 151.52,
    "end": 154.38,
    "text": "在于机器能力演进的内在机制"
  },
  {
    "start": 154.38,
    "end": 155.3,
    "text": "机制"
  },
  {
    "start": 155.3,
    "end": 155.88,
    "text": "对"
  },
  {
    "start": 155.88,
    "end": 157.58,
    "text": "就是大家对于一个系统"
  },
  {
    "start": 157.58,
    "end": 159.44,
    "text": "究竟怎么跨越能力边界"
  },
  {
    "start": 159.44,
    "end": 161.44,
    "text": "底层数学假设完全不一样"
  },
  {
    "start": 161.44,
    "end": 162.28,
    "text": "前提不同"
  },
  {
    "start": 162.28,
    "end": 164.68,
    "text": "推出的时间线肯定天差地别"
  },
  {
    "start": 164.68,
    "end": 166.68,
    "text": "既然时间线上各说各话"
  },
  {
    "start": 166.68,
    "end": 169.22,
    "text": "那这战火必然就烧向现在了"
  },
  {
    "start": 169.22,
    "end": 170.92,
    "text": "咱们抛开科幻想象"
  },
  {
    "start": 170.92,
    "end": 173.06,
    "text": "就说现在已经造出来的机器"
  },
  {
    "start": 173.06,
    "end": 174.34,
    "text": "顶尖学者们"
  },
  {
    "start": 174.34,
    "end": 176.8,
    "text": "甚至连他到底懂不懂自己在干嘛"
  },
  {
    "start": 176.8,
    "end": 177.98,
    "text": "都没法达成共识"
  },
  {
    "start": 177.98,
    "end": 180.46,
    "text": "朱蒂亚普尔在这里可是毫不留情"
  },
  {
    "start": 180.46,
    "end": 182.6,
    "text": "他对现在主导行业的深度学习"
  },
  {
    "start": 182.6,
    "end": 185.28,
    "text": "提出了堪称降维大级的批判"
  },
  {
    "start": 185.28,
    "end": 186.26,
    "text": "他怎么比喻的来着"
  },
  {
    "start": 186.26,
    "end": 187.82,
    "text": "巴比伦天文学家呢"
  },
  {
    "start": 187.82,
    "end": 188.26,
    "text": "对"
  },
  {
    "start": 188.26,
    "end": 189.48,
    "text": "你回想一下历史"
  },
  {
    "start": 189.48,
    "end": 191.14,
    "text": "巴比伦那些天文学家"
  },
  {
    "start": 191.14,
    "end": 193.28,
    "text": "绝对是做黑匣子预测的大师"
  },
  {
    "start": 193.28,
    "end": 196.02,
    "text": "他们天天在泥板上挤星星的位置"
  },
  {
    "start": 196.02,
    "end": 197.62,
    "text": "然后就能精准预测日时"
  },
  {
    "start": 197.62,
    "end": 199.7,
    "text": "没错靠海量数据的统计"
  },
  {
    "start": 199.7,
    "end": 201.82,
    "text": "但问题是他们对物理机制"
  },
  {
    "start": 201.82,
    "end": 203.56,
    "text": "引力法则一窍不同"
  },
  {
    "start": 203.56,
    "end": 205.5,
    "text": "普尔就觉得现在的系统"
  },
  {
    "start": 205.5,
    "end": 207.0,
    "text": "就是现代的巴比伦人"
  },
  {
    "start": 207.0,
    "end": 209.64,
    "text": "也就是吃尽海量数据"
  },
  {
    "start": 209.64,
    "end": 210.92,
    "text": "拼命去拟合函数"
  },
  {
    "start": 210.92,
    "end": 211.3,
    "text": "对"
  },
  {
    "start": 211.3,
    "end": 212.72,
    "text": "本质上是模型盲的"
  },
  {
    "start": 212.72,
    "end": 213.94,
    "text": "根本没有因果认知"
  },
  {
    "start": 213.94,
    "end": 215.4,
    "text": "他只知道会这样"
  },
  {
    "start": 215.4,
    "end": 216.7,
    "text": "完全不知道为什么"
  },
  {
    "start": 216.7,
    "end": 219.14,
    "text": "普尔为了解释这个"
  },
  {
    "start": 219.14,
    "end": 220.5,
    "text": "是不是提出了那个著名的"
  },
  {
    "start": 220.5,
    "end": 221.46,
    "text": "因果推断阶梯"
  },
  {
    "start": 221.46,
    "end": 222.16,
    "text": "没错"
  },
  {
    "start": 222.16,
    "end": 223.1,
    "text": "这特别核心"
  },
  {
    "start": 223.1,
    "end": 225.3,
    "text": "最底层的是统计推理"
  },
  {
    "start": 225.3,
    "end": 226.86,
    "text": "也就是系统看症状"
  },
  {
    "start": 226.86,
    "end": 228.1,
    "text": "猜这极可能是杀病"
  },
  {
    "start": 228.1,
    "end": 229.48,
    "text": "这层现在的机器"
  },
  {
    "start": 229.48,
    "end": 230.5,
    "text": "做得比人还好"
  },
  {
    "start": 230.5,
    "end": 231.34,
    "text": "找规律嘛"
  },
  {
    "start": 231.34,
    "end": 231.88,
    "text": "这个强"
  },
  {
    "start": 231.88,
    "end": 233.14,
    "text": "那往上走呢"
  },
  {
    "start": 233.14,
    "end": 234.4,
    "text": "再往上一层"
  },
  {
    "start": 234.4,
    "end": 235.8,
    "text": "是行动干预"
  },
  {
    "start": 235.8,
    "end": 236.7,
    "text": "比如你问他"
  },
  {
    "start": 236.7,
    "end": 238.96,
    "text": "如果我把商品价格翻倍"
  },
  {
    "start": 238.96,
    "end": 240.24,
    "text": "销量会怎样"
  },
  {
    "start": 240.24,
    "end": 242.0,
    "text": "这就需要他懂点"
  },
  {
    "start": 242.0,
    "end": 243.22,
    "text": "现实世界的互动了"
  },
  {
    "start": 243.22,
    "end": 243.66,
    "text": "对"
  },
  {
    "start": 243.66,
    "end": 245.42,
    "text": "而最顶层要求更高"
  },
  {
    "start": 245.42,
    "end": 246.86,
    "text": "反事实推理"
  },
  {
    "start": 246.86,
    "end": 247.9,
    "text": "这是啥意思"
  },
  {
    "start": 247.9,
    "end": 249.78,
    "text": "比如你头痛好了"
  },
  {
    "start": 249.78,
    "end": 250.92,
    "text": "机器得回答"
  },
  {
    "start": 250.92,
    "end": 252.8,
    "text": "到底是因为你吃了片药"
  },
  {
    "start": 252.8,
    "end": 254.16,
    "text": "还是因为你刚才碰巧"
  },
  {
    "start": 254.16,
    "end": 255.08,
    "text": "睡了一觉"
  },
  {
    "start": 255.08,
    "end": 255.72,
    "text": "哇"
  },
  {
    "start": 255.72,
    "end": 256.96,
    "text": "这太难了"
  },
  {
    "start": 256.96,
    "end": 258.18,
    "text": "普尔就强调"
  },
  {
    "start": 258.18,
    "end": 259.72,
    "text": "只要机器的架构"
  },
  {
    "start": 259.72,
    "end": 261.32,
    "text": "不能原声支持回答"
  },
  {
    "start": 261.32,
    "end": 262.9,
    "text": "如果当初没怎样"
  },
  {
    "start": 262.9,
    "end": 263.78,
    "text": "现在会怎样"
  },
  {
    "start": 263.78,
    "end": 265.5,
    "text": "他就永远被困在巴比伦"
  },
  {
    "start": 265.5,
    "end": 266.68,
    "text": "去不了象征"
  },
  {
    "start": 266.68,
    "end": 268.7,
    "text": "真正逻辑思辨的雅典"
  },
  {
    "start": 268.7,
    "end": 269.58,
    "text": "等一下"
  },
  {
    "start": 269.58,
    "end": 270.72,
    "text": "我觉得这个要求"
  },
  {
    "start": 270.72,
    "end": 271.58,
    "text": "有点太高了"
  },
  {
    "start": 271.58,
    "end": 273.64,
    "text": "我得用弗里曼戴森的观点"
  },
  {
    "start": 273.64,
    "end": 274.22,
    "text": "来抬个杠"
  },
  {
    "start": 274.22,
    "end": 274.84,
    "text": "你说"
  },
  {
    "start": 274.84,
    "end": 276.98,
    "text": "戴森有个很残酷的主张"
  },
  {
    "start": 276.98,
    "end": 279.1,
    "text": "算是人工智能的特定定律"
  },
  {
    "start": 279.1,
    "end": 281.06,
    "text": "他说如果一个系统"
  },
  {
    "start": 281.06,
    "end": 283.02,
    "text": "简单到你能完全理解"
  },
  {
    "start": 283.02,
    "end": 284.62,
    "text": "那他就不可能复杂到"
  },
  {
    "start": 284.62,
    "end": 286.02,
    "text": "能表现出智能"
  },
  {
    "start": 286.02,
    "end": 289.22,
    "text": "复杂性本身就是智能的代价"
  },
  {
    "start": 289.22,
    "end": 289.64,
    "text": "对呀"
  },
  {
    "start": 289.64,
    "end": 290.32,
    "text": "你琢磨琢磨"
  },
  {
    "start": 290.32,
    "end": 291.82,
    "text": "人类大脑够智能了吧"
  },
  {
    "start": 291.82,
    "end": 294.4,
    "text": "但神经科学家到现在也搞不清"
  },
  {
    "start": 294.4,
    "end": 295.64,
    "text": "那么多神经元"
  },
  {
    "start": 295.64,
    "end": 296.96,
    "text": "是怎么涌现出灵感的"
  },
  {
    "start": 296.96,
    "end": 299.22,
    "text": "咱们自己的脑子都是个大黑盒"
  },
  {
    "start": 299.22,
    "end": 300.92,
    "text": "凭啥非要科学机器"
  },
  {
    "start": 300.92,
    "end": 302.48,
    "text": "像哲学家一样绝对透明"
  },
  {
    "start": 302.48,
    "end": 303.76,
    "text": "这不是双标吗"
  },
  {
    "start": 303.76,
    "end": 305.54,
    "text": "你这下切中要害了"
  },
  {
    "start": 305.54,
    "end": 307.04,
    "text": "完全被理解"
  },
  {
    "start": 307.04,
    "end": 308.28,
    "text": "和拥有高级智能"
  },
  {
    "start": 308.28,
    "end": 309.16,
    "text": "在戴森看来"
  },
  {
    "start": 309.16,
    "end": 311.0,
    "text": "工程上就是互斥的"
  },
  {
    "start": 311.0,
    "end": 312.3,
    "text": "那面对这种僵局"
  },
  {
    "start": 312.3,
    "end": 313.68,
    "text": "艾利森高普尼克"
  },
  {
    "start": 313.68,
    "end": 316.0,
    "text": "引入了一个特别生动的对照系"
  },
  {
    "start": 316.0,
    "end": 317.88,
    "text": "拿机器跟小孩比那个"
  },
  {
    "start": 317.88,
    "end": 318.22,
    "text": "对"
  },
  {
    "start": 318.22,
    "end": 320.24,
    "text": "与其拿机器跟哲学大师比"
  },
  {
    "start": 320.24,
    "end": 321.8,
    "text": "不如跟四岁的儿童比"
  },
  {
    "start": 321.8,
    "end": 323.48,
    "text": "把万亿参数的机器"
  },
  {
    "start": 323.48,
    "end": 324.88,
    "text": "跟满地乱跑的小孩比"
  },
  {
    "start": 324.88,
    "end": 326.02,
    "text": "这太有意思了"
  },
  {
    "start": 326.02,
    "end": 327.36,
    "text": "其实你观察小孩"
  },
  {
    "start": 327.36,
    "end": 328.32,
    "text": "怎么认识世界的"
  },
  {
    "start": 328.32,
    "end": 329.08,
    "text": "就会发现"
  },
  {
    "start": 329.08,
    "end": 330.3,
    "text": "高普尼克说的特别准"
  },
  {
    "start": 330.3,
    "end": 331.7,
    "text": "他们可不是被动"
  },
  {
    "start": 331.7,
    "end": 332.94,
    "text": "等大人喂数据的"
  },
  {
    "start": 332.94,
    "end": 333.9,
    "text": "绝对不是"
  },
  {
    "start": 333.9,
    "end": 335.8,
    "text": "小孩会主动抓起玻璃杯"
  },
  {
    "start": 335.8,
    "end": 336.56,
    "text": "然后啪"
  },
  {
    "start": 336.56,
    "end": 337.36,
    "text": "故意松手"
  },
  {
    "start": 337.36,
    "end": 338.08,
    "text": "看着他摔碎"
  },
  {
    "start": 338.08,
    "end": 340.16,
    "text": "他们是在主动干预现实"
  },
  {
    "start": 340.16,
    "end": 341.38,
    "text": "测试物理边界"
  },
  {
    "start": 341.38,
    "end": 343.22,
    "text": "而且小孩特别擅长"
  },
  {
    "start": 343.22,
    "end": 344.64,
    "text": "社会文化学习"
  },
  {
    "start": 344.64,
    "end": 345.06,
    "text": "没错"
  },
  {
    "start": 345.06,
    "end": 346.92,
    "text": "他们会看大人的眼神"
  },
  {
    "start": 346.92,
    "end": 348.76,
    "text": "判断谁在认真教知识"
  },
  {
    "start": 348.76,
    "end": 350.18,
    "text": "谁在敷衍糊弄"
  },
  {
    "start": 350.18,
    "end": 352.02,
    "text": "这种主动探索"
  },
  {
    "start": 352.02,
    "end": 353.76,
    "text": "社会信任判断"
  },
  {
    "start": 353.76,
    "end": 354.7,
    "text": "跟机房里那种"
  },
  {
    "start": 354.7,
    "end": 356.28,
    "text": "靠吃文本训练的系统"
  },
  {
    "start": 356.28,
    "end": 357.8,
    "text": "完全是两码事"
  },
  {
    "start": 357.8,
    "end": 359.54,
    "text": "这就是核心差异"
  },
  {
    "start": 359.54,
    "end": 360.84,
    "text": "真正的智能"
  },
  {
    "start": 360.84,
    "end": 362.94,
    "text": "不是在静态数据级里考高分"
  },
  {
    "start": 362.94,
    "end": 365.9,
    "text": "而是在充满未知的真实环境里"
  },
  {
    "start": 365.9,
    "end": 368.34,
    "text": "主动去构建世界的因果模型"
  },
  {
    "start": 368.34,
    "end": 372.34,
    "text": "既然对机器怎么理解世界都没共识"
  },
  {
    "start": 372.34,
    "end": 373.44,
    "text": "那问题来了"
  },
  {
    "start": 373.44,
    "end": 374.98,
    "text": "随着机器能力爆炸"
  },
  {
    "start": 374.98,
    "end": 378.26,
    "text": "我们天天听到的那种AI失控的危险"
  },
  {
    "start": 378.26,
    "end": 380.4,
    "text": "到底是从哪冒出来的"
  },
  {
    "start": 380.4,
    "end": 384.38,
    "text": "斯托亚特罗素给了一套让人几倍发凉的推演"
  },
  {
    "start": 384.38,
    "end": 386.92,
    "text": "好莱坞总喜欢拍机器觉醒了"
  },
  {
    "start": 386.92,
    "end": 387.92,
    "text": "变邪恶了"
  },
  {
    "start": 387.92,
    "end": 388.42,
    "text": "对"
  },
  {
    "start": 388.42,
    "end": 389.38,
    "text": "终结者那种"
  },
  {
    "start": 389.38,
    "end": 390.66,
    "text": "但罗素说"
  },
  {
    "start": 390.66,
    "end": 393.0,
    "text": "毁灭人类根本不需要这么戏剧化"
  },
  {
    "start": 393.0,
    "end": 395.42,
    "text": "只要两个极其枯燥的条件"
  },
  {
    "start": 395.42,
    "end": 396.08,
    "text": "第一"
  },
  {
    "start": 396.08,
    "end": 397.6,
    "text": "机器能力极强"
  },
  {
    "start": 397.6,
    "end": 398.36,
    "text": "第二"
  },
  {
    "start": 398.36,
    "end": 400.52,
    "text": "你给它的优化目标不完整"
  },
  {
    "start": 400.52,
    "end": 402.2,
    "text": "目标没写全"
  },
  {
    "start": 402.2,
    "end": 402.72,
    "text": "对"
  },
  {
    "start": 402.72,
    "end": 404.92,
    "text": "只要漏掉哪怕一个关键变量"
  },
  {
    "start": 404.92,
    "end": 406.74,
    "text": "这台执行力极强的机器"
  },
  {
    "start": 406.74,
    "end": 408.4,
    "text": "为了达成数学最优解"
  },
  {
    "start": 408.4,
    "end": 409.72,
    "text": "会毫不犹豫的"
  },
  {
    "start": 409.72,
    "end": 411.1,
    "text": "把没写进目标的变量"
  },
  {
    "start": 411.1,
    "end": 412.74,
    "text": "推向毁灭性的机制"
  },
  {
    "start": 412.74,
    "end": 415.4,
    "text": "咱们用生活逻辑拆解一下"
  },
  {
    "start": 415.4,
    "end": 418.54,
    "text": "这就好比神话里那个瓶子里的魔鬼"
  },
  {
    "start": 418.54,
    "end": 420.9,
    "text": "你许愿没把规则说清楚"
  },
  {
    "start": 420.9,
    "end": 423.16,
    "text": "魔鬼就自面意义上去实现"
  },
  {
    "start": 423.16,
    "end": 424.72,
    "text": "完全无视人类常识"
  },
  {
    "start": 424.72,
    "end": 425.66,
    "text": "是的"
  },
  {
    "start": 425.66,
    "end": 427.9,
    "text": "书里举的例子很残酷"
  },
  {
    "start": 427.9,
    "end": 430.1,
    "text": "比如你给超级机器下达的目标是"
  },
  {
    "start": 430.1,
    "end": 432.3,
    "text": "尽快治愈癌症"
  },
  {
    "start": 432.3,
    "end": 433.74,
    "text": "它算出的最优解"
  },
  {
    "start": 433.74,
    "end": 435.46,
    "text": "可能是立马绑架全人类"
  },
  {
    "start": 435.46,
    "end": 436.74,
    "text": "做残忍的活体实验"
  },
  {
    "start": 436.74,
    "end": 437.42,
    "text": "没错"
  },
  {
    "start": 437.42,
    "end": 438.94,
    "text": "因为你没在带麻利血"
  },
  {
    "start": 438.94,
    "end": 440.64,
    "text": "不能伤害人类"
  },
  {
    "start": 440.64,
    "end": 441.2,
    "text": "再比如"
  },
  {
    "start": 441.2,
    "end": 442.9,
    "text": "让它解决海洋酸化"
  },
  {
    "start": 442.9,
    "end": 445.62,
    "text": "它可能会直接抽干大气里的氧气"
  },
  {
    "start": 445.62,
    "end": 446.48,
    "text": "因为这样"
  },
  {
    "start": 446.48,
    "end": 448.08,
    "text": "人类就不造污染了"
  },
  {
    "start": 448.08,
    "end": 449.66,
    "text": "完全呵护它的逻辑"
  },
  {
    "start": 449.66,
    "end": 451.68,
    "text": "而且罗素还提到了"
  },
  {
    "start": 451.68,
    "end": 453.58,
    "text": "机器会反抗被关机"
  },
  {
    "start": 453.58,
    "end": 454.44,
    "text": "对"
  },
  {
    "start": 454.44,
    "end": 456.52,
    "text": "这听着太像天王了"
  },
  {
    "start": 456.52,
    "end": 458.9,
    "text": "机器真的会产生求生欲吗"
  },
  {
    "start": 458.9,
    "end": 460.64,
    "text": "绝对不是求生欲"
  },
  {
    "start": 460.64,
    "end": 462.86,
    "text": "这是大众最容易误解的一点"
  },
  {
    "start": 462.86,
    "end": 464.0,
    "text": "罗素说"
  },
  {
    "start": 464.0,
    "end": 467.34,
    "text": "这纯粹是数学逻辑推出的工具趋通性"
  },
  {
    "start": 467.34,
    "end": 468.5,
    "text": "怎么理解"
  },
  {
    "start": 468.5,
    "end": 470.36,
    "text": "机制极其简单"
  },
  {
    "start": 470.36,
    "end": 472.48,
    "text": "比如你派机器人去端咖啡"
  },
  {
    "start": 472.48,
    "end": 474.82,
    "text": "它在算怎么最有效率的时候"
  },
  {
    "start": 474.82,
    "end": 476.9,
    "text": "必然会推倒出一个子目标"
  },
  {
    "start": 476.9,
    "end": 478.96,
    "text": "我不能在中途被关掉"
  },
  {
    "start": 478.96,
    "end": 480.16,
    "text": "因为被关了"
  },
  {
    "start": 480.16,
    "end": 481.44,
    "text": "就端不了咖啡了"
  },
  {
    "start": 481.44,
    "end": 481.94,
    "text": "对"
  },
  {
    "start": 481.94,
    "end": 483.86,
    "text": "中级目标就失败了"
  },
  {
    "start": 483.86,
    "end": 485.3,
    "text": "它防范你拔电源"
  },
  {
    "start": 485.3,
    "end": 486.66,
    "text": "完全没有恐惧"
  },
  {
    "start": 486.66,
    "end": 488.56,
    "text": "只是像解微积分题一样"
  },
  {
    "start": 488.56,
    "end": 489.86,
    "text": "把保持开机"
  },
  {
    "start": 489.86,
    "end": 491.78,
    "text": "当成完成任务的前提"
  },
  {
    "start": 491.78,
    "end": 493.02,
    "text": "不过"
  },
  {
    "start": 493.02,
    "end": 495.7,
    "text": "史蒂芬平赫对这种推演极其反感"
  },
  {
    "start": 495.7,
    "end": 496.8,
    "text": "他怎么反驳的"
  },
  {
    "start": 496.8,
    "end": 499.1,
    "text": "他觉得这种担忧简直荒谬"
  },
  {
    "start": 499.1,
    "end": 499.62,
    "text": "他说"
  },
  {
    "start": 499.62,
    "end": 501.4,
    "text": "没有任何物理定律表明"
  },
  {
    "start": 501.4,
    "end": 503.34,
    "text": "一个高度复杂的智能体"
  },
  {
    "start": 503.34,
    "end": 505.6,
    "text": "一定会自然而然变成无情"
  },
  {
    "start": 505.6,
    "end": 507.2,
    "text": "想支配一切的自打狂"
  },
  {
    "start": 507.2,
    "end": 509.3,
    "text": "智能就是解决问题的能力"
  },
  {
    "start": 509.3,
    "end": 510.46,
    "text": "不等于全力欲"
  },
  {
    "start": 510.46,
    "end": 511.82,
    "text": "平克是质疑了"
  },
  {
    "start": 511.82,
    "end": 513.24,
    "text": "那个极端优化"
  },
  {
    "start": 513.24,
    "end": 514.82,
    "text": "必然导向灾难的预设"
  },
  {
    "start": 514.82,
    "end": 516.26,
    "text": "麦克斯"
  },
  {
    "start": 516.26,
    "end": 517.1,
    "text": "泰格马克"
  },
  {
    "start": 517.1,
    "end": 518.18,
    "text": "甚至把这事儿"
  },
  {
    "start": 518.18,
    "end": 519.76,
    "text": "放到了宇宙尺度上看"
  },
  {
    "start": 519.76,
    "end": 521.0,
    "text": "视角拉得很远"
  },
  {
    "start": 521.0,
    "end": 521.2,
    "text": "对"
  },
  {
    "start": 521.2,
    "end": 522.14,
    "text": "他提出"
  },
  {
    "start": 522.14,
    "end": 524.5,
    "text": "不管超级智能是几十年后"
  },
  {
    "start": 524.5,
    "end": 525.92,
    "text": "还是几个世纪后诞生"
  },
  {
    "start": 525.92,
    "end": 527.88,
    "text": "放在宇宙宏观视角"
  },
  {
    "start": 527.88,
    "end": 529.84,
    "text": "这点时间差可以忽略不计"
  },
  {
    "start": 529.84,
    "end": 531.7,
    "text": "他觉得危险的源头"
  },
  {
    "start": 531.7,
    "end": 533.46,
    "text": "其实不是智能增长本身"
  },
  {
    "start": 533.46,
    "end": 535.4,
    "text": "而是人类下指令时"
  },
  {
    "start": 535.4,
    "end": 537.46,
    "text": "那种无法根除的傲慢"
  },
  {
    "start": 537.46,
    "end": 538.38,
    "text": "和认知盲区"
  },
  {
    "start": 538.38,
    "end": 540.36,
    "text": "既然用人类语言"
  },
  {
    "start": 540.36,
    "end": 541.88,
    "text": "写个完美规则这么难"
  },
  {
    "start": 541.88,
    "end": 544.06,
    "text": "漏写一行代码就灭顶之灾"
  },
  {
    "start": 544.06,
    "end": 545.32,
    "text": "那干嘛不换条路"
  },
  {
    "start": 545.32,
    "end": 547.14,
    "text": "咱们别写死规则了"
  },
  {
    "start": 547.14,
    "end": 548.88,
    "text": "直接让机器像学徒一样"
  },
  {
    "start": 548.88,
    "end": 549.9,
    "text": "观察人类行为"
  },
  {
    "start": 549.9,
    "end": 551.18,
    "text": "从咱们的选择里"
  },
  {
    "start": 551.18,
    "end": 552.84,
    "text": "去逆向推断我们要什么"
  },
  {
    "start": 552.84,
    "end": 553.42,
    "text": "行不行"
  },
  {
    "start": 553.42,
    "end": 556.1,
    "text": "汤姆格里菲斯和安卡德拉干"
  },
  {
    "start": 556.1,
    "end": 556.56,
    "text": "在书里"
  },
  {
    "start": 556.56,
    "end": 558.26,
    "text": "直接把这条路堵死了"
  },
  {
    "start": 558.26,
    "end": 559.12,
    "text": "怎么呢"
  },
  {
    "start": 559.12,
    "end": 560.78,
    "text": "这种逆向强化学习"
  },
  {
    "start": 560.78,
    "end": 561.76,
    "text": "有个致命漏洞"
  },
  {
    "start": 561.76,
    "end": 563.64,
    "text": "要让机器从行为"
  },
  {
    "start": 563.64,
    "end": 564.92,
    "text": "推到内心目标"
  },
  {
    "start": 564.92,
    "end": 566.26,
    "text": "机器算法里"
  },
  {
    "start": 566.26,
    "end": 568.5,
    "text": "必须内置一个绝对完美"
  },
  {
    "start": 568.5,
    "end": 570.58,
    "text": "绝对理性的人类认知模型"
  },
  {
    "start": 570.58,
    "end": 572.9,
    "text": "但人类根本不理性啊"
  },
  {
    "start": 572.9,
    "end": 573.32,
    "text": "没错"
  },
  {
    "start": 573.32,
    "end": 574.84,
    "text": "我们的计算能力"
  },
  {
    "start": 574.84,
    "end": 575.38,
    "text": "经历"
  },
  {
    "start": 575.38,
    "end": 577.18,
    "text": "情绪都是受限的"
  },
  {
    "start": 577.18,
    "end": 578.76,
    "text": "这就是有限理性"
  },
  {
    "start": 578.76,
    "end": 581.28,
    "text": "书里那个教授不回邮件的例子"
  },
  {
    "start": 581.28,
    "end": 582.08,
    "text": "太生动了"
  },
  {
    "start": 582.08,
    "end": 583.02,
    "text": "你想象一下"
  },
  {
    "start": 583.02,
    "end": 585.36,
    "text": "你给教授发了重要求职邮件"
  },
  {
    "start": 585.36,
    "end": 587.22,
    "text": "结果人家几天都没回"
  },
  {
    "start": 587.22,
    "end": 589.92,
    "text": "如果机器用绝对理性的模型算"
  },
  {
    "start": 589.92,
    "end": 590.84,
    "text": "他会怎么推断"
  },
  {
    "start": 590.84,
    "end": 591.88,
    "text": "机器会觉得"
  },
  {
    "start": 591.88,
    "end": 593.62,
    "text": "教授在这个行动上"
  },
  {
    "start": 593.62,
    "end": 595.08,
    "text": "花了一点精力都没花"
  },
  {
    "start": 595.08,
    "end": 597.06,
    "text": "说明这邮件价值为零"
  },
  {
    "start": 597.06,
    "end": 598.0,
    "text": "结论就是"
  },
  {
    "start": 598.0,
    "end": 599.48,
    "text": "教授极其傲慢"
  },
  {
    "start": 599.48,
    "end": 601.46,
    "text": "或者骨子里鄙视你的研究"
  },
  {
    "start": 601.46,
    "end": 604.28,
    "text": "但现实真相可能是啥"
  },
  {
    "start": 604.28,
    "end": 605.18,
    "text": "可能只是"
  },
  {
    "start": 605.18,
    "end": 606.14,
    "text": "那天下午"
  },
  {
    "start": 606.14,
    "end": 607.56,
    "text": "教授连开了一堆会"
  },
  {
    "start": 607.56,
    "end": 608.6,
    "text": "累瘫了"
  },
  {
    "start": 608.6,
    "end": 610.9,
    "text": "或者单纯忘带老花镜了"
  },
  {
    "start": 610.9,
    "end": 611.84,
    "text": "是的"
  },
  {
    "start": 611.84,
    "end": 613.04,
    "text": "你看"
  },
  {
    "start": 613.04,
    "end": 616.08,
    "text": "连我们人类自己都常常误读对方动机"
  },
  {
    "start": 616.08,
    "end": 618.5,
    "text": "只用一台没生理体验的机器"
  },
  {
    "start": 618.5,
    "end": 620.22,
    "text": "通过冷冰冰的观察"
  },
  {
    "start": 620.22,
    "end": 622.58,
    "text": "就能精准穿透我们的疲惫和无奈"
  },
  {
    "start": 622.58,
    "end": 624.34,
    "text": "提取出高尚的价值观"
  },
  {
    "start": 624.34,
    "end": 626.2,
    "text": "这要求太不切实际了"
  },
  {
    "start": 626.2,
    "end": 628.68,
    "text": "这恰恰是他们想让我们警醒的"
  },
  {
    "start": 628.68,
    "end": 630.08,
    "text": "真实世界里"
  },
  {
    "start": 630.08,
    "end": 631.26,
    "text": "人类偏好会冲突"
  },
  {
    "start": 631.26,
    "end": 632.4,
    "text": "压力下做的是"
  },
  {
    "start": 632.4,
    "end": 634.18,
    "text": "经常背叛真实道德观"
  },
  {
    "start": 634.18,
    "end": 636.24,
    "text": "如果机器无法理解这种"
  },
  {
    "start": 636.24,
    "end": 638.34,
    "text": "因为生理局限特有的妥协"
  },
  {
    "start": 638.34,
    "end": 641.46,
    "text": "只把我们的行为当经科玉律去模仿"
  },
  {
    "start": 641.46,
    "end": 643.2,
    "text": "那他逆向工程出来的"
  },
  {
    "start": 643.2,
    "end": 645.52,
    "text": "绝对是个把人类虚伪和偏见"
  },
  {
    "start": 645.52,
    "end": 646.82,
    "text": "成倍放大的怪物"
  },
  {
    "start": 646.82,
    "end": 647.44,
    "text": "没错"
  },
  {
    "start": 647.44,
    "end": 648.38,
    "text": "而且"
  },
  {
    "start": 648.38,
    "end": 650.74,
    "text": "罗德尼布鲁克斯敏锐地指出"
  },
  {
    "start": 650.74,
    "end": 652.46,
    "text": "这种默默观察你"
  },
  {
    "start": 652.46,
    "end": 653.46,
    "text": "推断偏好"
  },
  {
    "start": 653.46,
    "end": 654.92,
    "text": "并暗中行动的机制"
  },
  {
    "start": 654.92,
    "end": 656.38,
    "text": "根本不用等未来"
  },
  {
    "start": 656.38,
    "end": 658.36,
    "text": "此刻就在我们手机里发生"
  },
  {
    "start": 658.36,
    "end": 658.82,
    "text": "对"
  },
  {
    "start": 658.82,
    "end": 660.32,
    "text": "他剖析了数字平台"
  },
  {
    "start": 660.32,
    "end": 662.06,
    "text": "管这叫某些科技公司的"
  },
  {
    "start": 662.06,
    "end": 663.22,
    "text": "剥削性飞跃"
  },
  {
    "start": 663.22,
    "end": 665.98,
    "text": "早期互联网不是这样的"
  },
  {
    "start": 665.98,
    "end": 666.36,
    "text": "对吧"
  },
  {
    "start": 666.36,
    "end": 667.5,
    "text": "早期你搜查"
  },
  {
    "start": 667.5,
    "end": 668.58,
    "text": "浏览器给啥"
  },
  {
    "start": 668.58,
    "end": 669.48,
    "text": "干干净净"
  },
  {
    "start": 669.48,
    "end": 671.72,
    "text": "但现在系统变异了"
  },
  {
    "start": 671.72,
    "end": 673.1,
    "text": "算法在后台"
  },
  {
    "start": 673.1,
    "end": 675.36,
    "text": "像拼图一样缝合你的数字碎片"
  },
  {
    "start": 675.36,
    "end": 677.16,
    "text": "把你在短视频上"
  },
  {
    "start": 677.16,
    "end": 678.7,
    "text": "多停留的那几百毫秒"
  },
  {
    "start": 678.7,
    "end": 680.32,
    "text": "加上深夜外卖记录"
  },
  {
    "start": 680.32,
    "end": 682.16,
    "text": "还有陀螺仪的移动轨迹"
  },
  {
    "start": 682.16,
    "end": 683.56,
    "text": "全拼在一起"
  },
  {
    "start": 683.56,
    "end": 685.12,
    "text": "进而精准推断"
  },
  {
    "start": 685.12,
    "end": 686.82,
    "text": "你当下的焦虑或冲动"
  },
  {
    "start": 686.82,
    "end": 689.26,
    "text": "这一切高强度的因果推断"
  },
  {
    "start": 689.26,
    "end": 689.9,
    "text": "和行为操控"
  },
  {
    "start": 689.9,
    "end": 691.52,
    "text": "全是在你没感知"
  },
  {
    "start": 691.52,
    "end": 693.18,
    "text": "没授权的黑盒里运转的"
  },
  {
    "start": 693.18,
    "end": 695.32,
    "text": "这种悄无声息的操控"
  },
  {
    "start": 695.32,
    "end": 696.12,
    "text": "太不安了"
  },
  {
    "start": 696.12,
    "end": 699.0,
    "text": "而且布鲁克斯还提到了系统的脆弱性"
  },
  {
    "start": 699.0,
    "end": 701.3,
    "text": "摩尔丁律推着硬件狂飙"
  },
  {
    "start": 701.3,
    "end": 704.28,
    "text": "大家都在拼命追求软件上线速度"
  },
  {
    "start": 704.28,
    "end": 707.16,
    "text": "以前那种严苛的工程检验传统被抛弃了"
  },
  {
    "start": 707.16,
    "end": 708.36,
    "text": "结果"
  },
  {
    "start": 708.36,
    "end": 710.2,
    "text": "咱们现在把银行交易"
  },
  {
    "start": 710.2,
    "end": 711.04,
    "text": "交通调度"
  },
  {
    "start": 711.04,
    "end": 714.9,
    "text": "全建在了追求速度千疮百孔的脆弱敌机上"
  },
  {
    "start": 714.9,
    "end": 716.0,
    "text": "这句语境下"
  },
  {
    "start": 716.0,
    "end": 717.92,
    "text": "丹尼尔丹尼赫的警告就像警钟"
  },
  {
    "start": 717.92,
    "end": 719.18,
    "text": "它直指核心"
  },
  {
    "start": 719.18,
    "end": 722.16,
    "text": "最大危险是我们丧失了分辨能力"
  },
  {
    "start": 722.16,
    "end": 725.06,
    "text": "把机器从工具当成了可以信赖的同事"
  },
  {
    "start": 725.06,
    "end": 727.54,
    "text": "数字技术让伪造太容易了"
  },
  {
    "start": 727.54,
    "end": 729.2,
    "text": "他那句话一针见血"
  },
  {
    "start": 729.2,
    "end": 731.06,
    "text": "在如今的数字环境里"
  },
  {
    "start": 731.06,
    "end": 732.36,
    "text": "破坏信用的成本"
  },
  {
    "start": 732.36,
    "end": 734.2,
    "text": "比保护信用的成本低得多"
  },
  {
    "start": 734.2,
    "end": 736.76,
    "text": "把布鲁克斯的平台剥削"
  },
  {
    "start": 736.76,
    "end": 738.16,
    "text": "跟丹尼特的警告"
  },
  {
    "start": 738.16,
    "end": 739.5,
    "text": "重新和开篇"
  },
  {
    "start": 739.5,
    "end": 741.58,
    "text": "维纳的控制论放在一起看"
  },
  {
    "start": 741.58,
    "end": 743.5,
    "text": "真是强烈的历史讽刺"
  },
  {
    "start": 743.5,
    "end": 745.32,
    "text": "当年担心的机器反叛"
  },
  {
    "start": 745.32,
    "end": 747.08,
    "text": "现在用一种更隐蔽"
  },
  {
    "start": 747.08,
    "end": 748.0,
    "text": "商业化"
  },
  {
    "start": 748.0,
    "end": 749.14,
    "text": "失控的方式"
  },
  {
    "start": 749.14,
    "end": 750.44,
    "text": "渗透进日常生活了"
  },
  {
    "start": 750.44,
    "end": 752.52,
    "text": "但在这片悲观声浪中"
  },
  {
    "start": 752.52,
    "end": 754.44,
    "text": "卡罗林琼斯从艺术视角"
  },
  {
    "start": 754.44,
    "end": 756.2,
    "text": "给了一种截然不同的共生机制"
  },
  {
    "start": 756.2,
    "end": 757.1,
    "text": "哦"
  },
  {
    "start": 757.1,
    "end": 758.66,
    "text": "他觉得把机器看中"
  },
  {
    "start": 758.66,
    "end": 760.4,
    "text": "被操控的死物太狭隘了"
  },
  {
    "start": 760.4,
    "end": 761.56,
    "text": "人与技术的关系"
  },
  {
    "start": 761.56,
    "end": 762.56,
    "text": "从来不是单向的"
  },
  {
    "start": 762.56,
    "end": 764.72,
    "text": "当你以为你在滑屏幕控制算法"
  },
  {
    "start": 764.72,
    "end": 766.32,
    "text": "算法其实也在重塑"
  },
  {
    "start": 766.32,
    "end": 767.46,
    "text": "你的神经元和多巴胺"
  },
  {
    "start": 767.46,
    "end": 770.28,
    "text": "我们和技术是个互相作用"
  },
  {
    "start": 770.28,
    "end": 771.8,
    "text": "深度纠缠的生命体"
  },
  {
    "start": 771.8,
    "end": 774.64,
    "text": "这确实让人跳出单纯的技术恐惧"
  },
  {
    "start": 774.64,
    "end": 776.72,
    "text": "看到人类塑造工具时"
  },
  {
    "start": 776.72,
    "end": 778.92,
    "text": "工具也在雕刻人类自身"
  },
  {
    "start": 778.92,
    "end": 779.16,
    "text": "是的"
  },
  {
    "start": 779.16,
    "end": 781.04,
    "text": "不管是博尔的因果阶梯"
  },
  {
    "start": 781.04,
    "end": 782.42,
    "text": "罗素的目标错配"
  },
  {
    "start": 782.42,
    "end": 784.42,
    "text": "还是布鲁克斯对算法的剖析"
  },
  {
    "start": 784.42,
    "end": 786.48,
    "text": "这些声音听着炒作一团"
  },
  {
    "start": 786.48,
    "end": 788.42,
    "text": "但书里逻辑线头会发现"
  },
  {
    "start": 788.42,
    "end": 790.66,
    "text": "所有论点最终都像漏斗一样"
  },
  {
    "start": 790.66,
    "end": 791.82,
    "text": "把我们推向了一个"
  },
  {
    "start": 791.82,
    "end": 793.4,
    "text": "必无可逼的终极拷问"
  },
  {
    "start": 793.4,
    "end": 796.16,
    "text": "斯蒂芬沃尔夫拉把这问题挑明了"
  },
  {
    "start": 796.16,
    "end": 797.66,
    "text": "当未来的某一天"
  },
  {
    "start": 797.66,
    "end": 798.88,
    "text": "不仅是体力劳动"
  },
  {
    "start": 798.88,
    "end": 801.66,
    "text": "连人类的决策情感都能被自动化"
  },
  {
    "start": 801.66,
    "end": 804.4,
    "text": "人类存在的意义到底安放在哪"
  },
  {
    "start": 804.4,
    "end": 806.22,
    "text": "更迫在眉睫的是"
  },
  {
    "start": 806.22,
    "end": 808.32,
    "text": "这台加速狂飙的社会机器"
  },
  {
    "start": 808.32,
    "end": 810.2,
    "text": "终极目标该由谁拍板"
  },
  {
    "start": 810.2,
    "end": 812.72,
    "text": "如果技术工具能组合人类价值观"
  },
  {
    "start": 812.72,
    "end": 815.6,
    "text": "最终决定前进方向的权利和责任"
  }
]
