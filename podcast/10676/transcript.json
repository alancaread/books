[
  {
    "start": 0.0,
    "end": 1.84,
    "text": "1975年5月1日"
  },
  {
    "start": 1.84,
    "end": 5.14,
    "text": "在华尔街这一天被称为五一"
  },
  {
    "start": 5.14,
    "end": 6.92,
    "text": "听起来像个节日"
  },
  {
    "start": 6.92,
    "end": 8.96,
    "text": "但显然不是为了庆祝什么劳动节"
  },
  {
    "start": 8.96,
    "end": 9.42,
    "text": "对吧"
  },
  {
    "start": 9.42,
    "end": 9.8,
    "text": "没错"
  },
  {
    "start": 9.8,
    "end": 12.62,
    "text": "其实它是整个传统佣金制度"
  },
  {
    "start": 12.62,
    "end": 14.44,
    "text": "发生巨变的倒计时钟点"
  },
  {
    "start": 14.44,
    "end": 15.76,
    "text": "你想啊"
  },
  {
    "start": 15.76,
    "end": 16.68,
    "text": "在那天之前"
  },
  {
    "start": 16.68,
    "end": 18.96,
    "text": "如果你作为一个普通人"
  },
  {
    "start": 18.96,
    "end": 20.6,
    "text": "想要买卖股票"
  },
  {
    "start": 20.6,
    "end": 21.68,
    "text": "门槛非常高"
  },
  {
    "start": 21.68,
    "end": 21.98,
    "text": "对"
  },
  {
    "start": 21.98,
    "end": 25.3,
    "text": "你不仅要打极其昂贵的长途电话"
  },
  {
    "start": 25.3,
    "end": 27.44,
    "text": "还必须向经纪人支付一笔固定"
  },
  {
    "start": 27.44,
    "end": 29.44,
    "text": "而且极其高昂的佣金"
  },
  {
    "start": 29.44,
    "end": 33.56,
    "text": "就是说华尔街在通往财富增长的路上"
  },
  {
    "start": 33.56,
    "end": 35.0,
    "text": "设下了一个收费站"
  },
  {
    "start": 35.0,
    "end": 36.98,
    "text": "而且只对少数人开放"
  },
  {
    "start": 36.98,
    "end": 38.34,
    "text": "是这样的"
  },
  {
    "start": 38.34,
    "end": 39.94,
    "text": "所以在这档探索中呢"
  },
  {
    "start": 39.94,
    "end": 42.34,
    "text": "我们要一起翻开桌上的这份特别材料"
  },
  {
    "start": 42.34,
    "end": 44.54,
    "text": "就是查尔斯·施瓦布的回忆录"
  },
  {
    "start": 44.54,
    "end": 45.38,
    "text": "投资"
  },
  {
    "start": 45.38,
    "end": 46.38,
    "text": "嘉信理财"
  },
  {
    "start": 46.38,
    "end": 47.82,
    "text": "持续创新之道"
  },
  {
    "start": 47.82,
    "end": 50.42,
    "text": "这本回忆录的视角很独特"
  },
  {
    "start": 50.42,
    "end": 51.04,
    "text": "对的"
  },
  {
    "start": 51.04,
    "end": 53.38,
    "text": "先说明一下咱们今天的任务啊"
  },
  {
    "start": 53.38,
    "end": 55.54,
    "text": "我们不是去品鉴这本书的文学价值"
  },
  {
    "start": 55.54,
    "end": 56.18,
    "text": "肯定不是"
  },
  {
    "start": 56.18,
    "end": 60.66,
    "text": "我们是顺着这位企业创始人的第一人称视角"
  },
  {
    "start": 60.66,
    "end": 62.36,
    "text": "深入去看看一家公司"
  },
  {
    "start": 62.36,
    "end": 64.54,
    "text": "在长达40多年的时间里"
  },
  {
    "start": 64.54,
    "end": 66.28,
    "text": "是如何处理服务"
  },
  {
    "start": 66.28,
    "end": 66.98,
    "text": "定价"
  },
  {
    "start": 66.98,
    "end": 67.76,
    "text": "融资"
  },
  {
    "start": 67.76,
    "end": 69.04,
    "text": "以及应对危机的"
  },
  {
    "start": 69.04,
    "end": 69.74,
    "text": "是的"
  },
  {
    "start": 69.74,
    "end": 72.88,
    "text": "在这个连买卖股票都要看人脸色"
  },
  {
    "start": 72.88,
    "end": 74.52,
    "text": "交高额过路费的年代"
  },
  {
    "start": 74.52,
    "end": 75.94,
    "text": "打破规矩的人"
  },
  {
    "start": 75.94,
    "end": 77.16,
    "text": "到底会遇到什么"
  },
  {
    "start": 77.16,
    "end": 79.12,
    "text": "这是一个绝佳的切入点"
  },
  {
    "start": 79.12,
    "end": 79.7,
    "text": "没错"
  },
  {
    "start": 79.7,
    "end": 81.96,
    "text": "而且在这个过程中"
  },
  {
    "start": 81.96,
    "end": 84.54,
    "text": "我们不仅要看商业故事的起伏"
  },
  {
    "start": 84.54,
    "end": 85.98,
    "text": "还要仔细留意"
  },
  {
    "start": 85.98,
    "end": 88.62,
    "text": "作者是如何得出他的商业主张的"
  },
  {
    "start": 88.62,
    "end": 90.18,
    "text": "我们会客观的拆解"
  },
  {
    "start": 90.18,
    "end": 92.66,
    "text": "看看这些主张在现实压力下"
  },
  {
    "start": 92.66,
    "end": 93.92,
    "text": "边界到底在哪"
  },
  {
    "start": 93.92,
    "end": 97.94,
    "text": "那咱们就直接回到他们创业启航的那个节点"
  },
  {
    "start": 97.94,
    "end": 101.24,
    "text": "嘉信理财初创时的商业定位非常直接"
  },
  {
    "start": 101.24,
    "end": 102.92,
    "text": "就是做折扣交易"
  },
  {
    "start": 102.92,
    "end": 104.92,
    "text": "这个在当时是很反常的"
  },
  {
    "start": 104.92,
    "end": 105.4,
    "text": "对啊"
  },
  {
    "start": 105.4,
    "end": 106.94,
    "text": "大家都说全价佣金"
  },
  {
    "start": 106.94,
    "end": 108.4,
    "text": "他偏偏要打折"
  },
  {
    "start": 108.4,
    "end": 110.66,
    "text": "而且一上来就要把桌子掀了"
  },
  {
    "start": 110.66,
    "end": 111.88,
    "text": "可是问题来了"
  },
  {
    "start": 111.88,
    "end": 115.2,
    "text": "金融后台处理是需要真金白银去维持的"
  },
  {
    "start": 115.2,
    "end": 115.92,
    "text": "没错"
  },
  {
    "start": 115.92,
    "end": 117.0,
    "text": "大幅度降价"
  },
  {
    "start": 117.0,
    "end": 119.82,
    "text": "听起来更像是一种自杀式的营销策略"
  },
  {
    "start": 119.82,
    "end": 120.72,
    "text": "确实"
  },
  {
    "start": 120.72,
    "end": 123.04,
    "text": "如果没有底层的逻辑支撑"
  },
  {
    "start": 123.04,
    "end": 125.06,
    "text": "这就完全是自取灭亡了"
  },
  {
    "start": 125.06,
    "end": 127.92,
    "text": "这里的打折有着严格的前提条件"
  },
  {
    "start": 127.92,
    "end": 130.74,
    "text": "正如查尔斯·史瓦布在书中所说"
  },
  {
    "start": 130.74,
    "end": 134.3,
    "text": "我可以将佣金价格降至原有价格的25%"
  },
  {
    "start": 134.3,
    "end": 136.32,
    "text": "同时还可以获得利润"
  },
  {
    "start": 136.32,
    "end": 137.1,
    "text": "等一下"
  },
  {
    "start": 137.1,
    "end": 138.62,
    "text": "降到25%"
  },
  {
    "start": 138.62,
    "end": 142.56,
    "text": "这可是直接砍掉了原本四分之三的收入啊"
  },
  {
    "start": 142.56,
    "end": 145.3,
    "text": "这在商业账本上到底怎么算得平"
  },
  {
    "start": 145.3,
    "end": 147.72,
    "text": "这里的降至25%"
  },
  {
    "start": 147.72,
    "end": 150.8,
    "text": "是指仅仅保留原价的四分之一"
  },
  {
    "start": 150.8,
    "end": 153.58,
    "text": "但这绝对不是一句随口喊出的口号"
  },
  {
    "start": 153.58,
    "end": 155.08,
    "text": "书中明确表示"
  },
  {
    "start": 155.08,
    "end": 158.6,
    "text": "想要做到只收四分之一佣金还能赚钱"
  },
  {
    "start": 158.6,
    "end": 161.3,
    "text": "前提是必须同时降低成本"
  },
  {
    "start": 161.3,
    "end": 163.76,
    "text": "极大的提高后台运转效率"
  },
  {
    "start": 163.76,
    "end": 164.72,
    "text": "也就是说"
  },
  {
    "start": 164.72,
    "end": 168.3,
    "text": "必须把那些不产生直接价值的冗余环节全部剔除"
  },
  {
    "start": 168.3,
    "end": 168.88,
    "text": "对"
  },
  {
    "start": 168.88,
    "end": 171.86,
    "text": "如果没有后台成本结构的彻底重构"
  },
  {
    "start": 171.86,
    "end": 173.56,
    "text": "仅仅是喊口号减价"
  },
  {
    "start": 173.56,
    "end": 176.22,
    "text": "只会让企业的现金流瞬间枯竭"
  },
  {
    "start": 176.22,
    "end": 178.26,
    "text": "说到重构这个结构啊"
  },
  {
    "start": 178.26,
    "end": 180.0,
    "text": "作者在回忆初创期的时候"
  },
  {
    "start": 180.0,
    "end": 181.88,
    "text": "提到了一个非常个人的细节"
  },
  {
    "start": 181.88,
    "end": 184.64,
    "text": "他从小就患有阅读障碍"
  },
  {
    "start": 184.64,
    "end": 187.58,
    "text": "这在金融行业确实是个大麻烦"
  },
  {
    "start": 187.58,
    "end": 188.56,
    "text": "可不是吗"
  },
  {
    "start": 188.56,
    "end": 188.8,
    "text": "你想"
  },
  {
    "start": 188.8,
    "end": 191.22,
    "text": "金融行业充满了繁杂的报表"
  },
  {
    "start": 191.22,
    "end": 192.14,
    "text": "法律文件"
  },
  {
    "start": 192.14,
    "end": 193.4,
    "text": "还有枯燥的数字"
  },
  {
    "start": 193.4,
    "end": 196.26,
    "text": "而他却无法像常人一样顺畅阅读"
  },
  {
    "start": 196.26,
    "end": 198.82,
    "text": "这就好比拿到了一个乐高玩具"
  },
  {
    "start": 198.82,
    "end": 201.32,
    "text": "但是缺少了最关键的一页说明书"
  },
  {
    "start": 201.32,
    "end": 202.74,
    "text": "这个比喻很贴切"
  },
  {
    "start": 202.74,
    "end": 204.38,
    "text": "为了克服这个困难"
  },
  {
    "start": 204.38,
    "end": 207.8,
    "text": "他不得不逼着自己去锻炼概念化的抽象思维"
  },
  {
    "start": 207.8,
    "end": 210.84,
    "text": "并且花大量精力去寻找互补的人才"
  },
  {
    "start": 210.84,
    "end": 213.2,
    "text": "把具体的执行工作授权出去"
  },
  {
    "start": 213.2,
    "end": 216.3,
    "text": "这是一个关于个人杠杆的好故事"
  },
  {
    "start": 216.3,
    "end": 219.44,
    "text": "不过咱们在这里需要客观的看待他的边界"
  },
  {
    "start": 219.44,
    "end": 220.3,
    "text": "怎么说"
  },
  {
    "start": 220.3,
    "end": 222.48,
    "text": "书里关于阅读障碍的描述"
  },
  {
    "start": 222.48,
    "end": 226.46,
    "text": "仅仅是作者对自己如何形成授权管理风格的个人回忆"
  },
  {
    "start": 226.46,
    "end": 228.06,
    "text": "我们在看这种传记时"
  },
  {
    "start": 228.06,
    "end": 230.04,
    "text": "很容易陷入幸存者偏差"
  },
  {
    "start": 230.04,
    "end": 231.0,
    "text": "哦对"
  },
  {
    "start": 231.0,
    "end": 233.58,
    "text": "不能把这个当成一种必然规律"
  },
  {
    "start": 233.58,
    "end": 234.28,
    "text": "没错"
  },
  {
    "start": 234.28,
    "end": 236.98,
    "text": "我们不能从中推导任何医学诊断"
  },
  {
    "start": 236.98,
    "end": 238.34,
    "text": "更不能得出什么"
  },
  {
    "start": 238.34,
    "end": 242.14,
    "text": "个人缺陷必然带来天才般成功的因果关系"
  },
  {
    "start": 242.14,
    "end": 243.2,
    "text": "事实上"
  },
  {
    "start": 243.2,
    "end": 245.58,
    "text": "第六章里提到的贷款压力就说明了"
  },
  {
    "start": 245.58,
    "end": 246.88,
    "text": "比起阅读困难"
  },
  {
    "start": 246.88,
    "end": 248.26,
    "text": "当时更大的挑战"
  },
  {
    "start": 248.26,
    "end": 250.04,
    "text": "其实是现实的资金问题"
  },
  {
    "start": 250.04,
    "end": 250.96,
    "text": "确实"
  },
  {
    "start": 250.96,
    "end": 252.46,
    "text": "想法再好"
  },
  {
    "start": 252.46,
    "end": 254.02,
    "text": "个人再怎么懂得授权"
  },
  {
    "start": 254.02,
    "end": 256.18,
    "text": "到了月底发不出工资也是白打"
  },
  {
    "start": 256.18,
    "end": 256.82,
    "text": "是的"
  },
  {
    "start": 256.82,
    "end": 259.48,
    "text": "创业不能只有打破规则的点子"
  },
  {
    "start": 259.48,
    "end": 260.78,
    "text": "还得找得到钱"
  },
  {
    "start": 260.78,
    "end": 262.98,
    "text": "并且能承担沉重的损失"
  },
  {
    "start": 262.98,
    "end": 265.18,
    "text": "这种资金链的重压"
  },
  {
    "start": 265.18,
    "end": 266.54,
    "text": "其实也是他们后续"
  },
  {
    "start": 266.54,
    "end": 268.36,
    "text": "每一个商业决策背后的底色"
  },
  {
    "start": 268.36,
    "end": 270.8,
    "text": "当你利润率被压得这么低的时候"
  },
  {
    "start": 270.8,
    "end": 272.82,
    "text": "唯一的出路就是靠规模了"
  },
  {
    "start": 272.82,
    "end": 275.58,
    "text": "但是当你试图去抢占规模时"
  },
  {
    "start": 275.58,
    "end": 278.42,
    "text": "不可避免的就会碰了传统巨头们的奶酪"
  },
  {
    "start": 278.42,
    "end": 280.5,
    "text": "这就带出了他们业务扩张时"
  },
  {
    "start": 280.5,
    "end": 281.44,
    "text": "遇到的巨大阻力"
  },
  {
    "start": 281.44,
    "end": 284.52,
    "text": "当他们开始大肆推广折扣交易的时候"
  },
  {
    "start": 284.52,
    "end": 287.62,
    "text": "遭遇了整个华尔街行业的强烈抵触"
  },
  {
    "start": 287.62,
    "end": 288.66,
    "text": "传统的经纪人"
  },
  {
    "start": 288.66,
    "end": 291.76,
    "text": "甚至会设法阻止客户把资产转移到嘉信理财"
  },
  {
    "start": 291.76,
    "end": 292.4,
    "text": "对"
  },
  {
    "start": 292.4,
    "end": 294.06,
    "text": "就在这种高压下"
  },
  {
    "start": 294.06,
    "end": 297.54,
    "text": "他们做了一个可以说是断臂求生的决定"
  },
  {
    "start": 297.54,
    "end": 299.42,
    "text": "他们坚决不主动推销股票"
  },
  {
    "start": 299.42,
    "end": 300.96,
    "text": "作者在书中坚持"
  },
  {
    "start": 300.96,
    "end": 304.58,
    "text": "不要以提供投资建议为幌子兜售股票"
  },
  {
    "start": 304.58,
    "end": 305.44,
    "text": "你要知道"
  },
  {
    "start": 305.44,
    "end": 308.44,
    "text": "这句话在当时的语境下有多么反叛"
  },
  {
    "start": 308.44,
    "end": 311.06,
    "text": "传统经纪公司最大的利润来源"
  },
  {
    "start": 311.06,
    "end": 315.0,
    "text": "就是向客户推销特定金融产品赚取的高额佣金"
  },
  {
    "start": 315.0,
    "end": 316.56,
    "text": "这本质上就是一种利益冲突"
  },
  {
    "start": 316.56,
    "end": 318.5,
    "text": "经纪人赚大钱的时候"
  },
  {
    "start": 318.5,
    "end": 320.18,
    "text": "未必是客户赚钱的时候"
  },
  {
    "start": 320.18,
    "end": 320.82,
    "text": "没错"
  },
  {
    "start": 320.82,
    "end": 323.38,
    "text": "作者切断了这个最丰厚的利润源"
  },
  {
    "start": 323.38,
    "end": 326.66,
    "text": "意味着他们彻底放弃了以销售为导向的模式"
  },
  {
    "start": 326.66,
    "end": 329.36,
    "text": "转而只能依靠交易通道来获利"
  },
  {
    "start": 329.36,
    "end": 331.12,
    "text": "但是这个逻辑有点难办"
  },
  {
    "start": 331.12,
    "end": 334.0,
    "text": "你不去推销只做便宜的通道"
  },
  {
    "start": 334.0,
    "end": 337.42,
    "text": "这就意味着你必须在服务上做到极致的高效"
  },
  {
    "start": 337.42,
    "end": 340.88,
    "text": "用巨大的交易量来弥补单笔利润的微薄"
  },
  {
    "start": 340.88,
    "end": 341.18,
    "text": "对"
  },
  {
    "start": 341.18,
    "end": 343.7,
    "text": "然而便宜往往跟差劲的服务挂钩"
  },
  {
    "start": 343.7,
    "end": 344.94,
    "text": "书里就记载"
  },
  {
    "start": 344.94,
    "end": 350.12,
    "text": "他们第九章和第十一章里提到曾经尝试把客户的电话服务外包出去"
  },
  {
    "start": 350.12,
    "end": 351.58,
    "text": "结果可想而知"
  },
  {
    "start": 351.58,
    "end": 353.26,
    "text": "彻底搞砸了"
  },
  {
    "start": 353.26,
    "end": 355.74,
    "text": "外包公司根本不在乎你的品牌"
  },
  {
    "start": 355.74,
    "end": 358.8,
    "text": "客户最着急交易的时候只能听到占线音"
  },
  {
    "start": 358.8,
    "end": 361.2,
    "text": "所以为了真正把控质量"
  },
  {
    "start": 361.2,
    "end": 363.2,
    "text": "他们决定把一切收回内部"
  },
  {
    "start": 363.2,
    "end": 366.56,
    "text": "并且在后台系统投入了一份定制合同"
  },
  {
    "start": 366.56,
    "end": 367.0,
    "text": "对吧"
  },
  {
    "start": 367.0,
    "end": 367.58,
    "text": "没错"
  },
  {
    "start": 367.58,
    "end": 370.08,
    "text": "当时高达50万美元的系统合同"
  },
  {
    "start": 370.08,
    "end": 372.76,
    "text": "这里我得适当的厘清一下数字的边界"
  },
  {
    "start": 372.76,
    "end": 378.08,
    "text": "这50万美元是当时为了定制底层计算系统所支付的合同金额"
  },
  {
    "start": 378.08,
    "end": 380.64,
    "text": "大家千万别混淆成公司的总资产"
  },
  {
    "start": 380.64,
    "end": 382.68,
    "text": "或者是客户从容赚到的钱"
  },
  {
    "start": 382.68,
    "end": 383.3,
    "text": "明白"
  },
  {
    "start": 383.3,
    "end": 385.4,
    "text": "在当时这确实是一笔巨资"
  },
  {
    "start": 385.4,
    "end": 386.14,
    "text": "是的"
  },
  {
    "start": 386.14,
    "end": 389.38,
    "text": "为了一套尚未完全验证的系统投入这么多钱"
  },
  {
    "start": 389.38,
    "end": 390.88,
    "text": "其实也是一场豪赌"
  },
  {
    "start": 390.88,
    "end": 392.44,
    "text": "但这也解释了"
  },
  {
    "start": 392.44,
    "end": 395.42,
    "text": "技术本身就是降低成本不可或缺的工程"
  },
  {
    "start": 395.42,
    "end": 397.24,
    "text": "投入巨资苟技术"
  },
  {
    "start": 397.24,
    "end": 398.88,
    "text": "效果确实立竿见影"
  },
  {
    "start": 398.88,
    "end": 401.74,
    "text": "甚至开启了一段狂飙突进的增长期"
  },
  {
    "start": 401.74,
    "end": 403.74,
    "text": "书里第16章记录了"
  },
  {
    "start": 403.74,
    "end": 407.48,
    "text": "他们在1985年和1986年分别达到了里程碑"
  },
  {
    "start": 407.48,
    "end": 409.74,
    "text": "业务体量彻底爆发了"
  },
  {
    "start": 409.74,
    "end": 411.68,
    "text": "为了准确理解这种爆发"
  },
  {
    "start": 411.68,
    "end": 413.82,
    "text": "我们必须严格区分一下历史指标"
  },
  {
    "start": 413.82,
    "end": 415.28,
    "text": "1985年"
  },
  {
    "start": 415.28,
    "end": 417.9,
    "text": "他们达到的是100万个账户的数量"
  },
  {
    "start": 417.9,
    "end": 419.46,
    "text": "数量指标"
  },
  {
    "start": 419.46,
    "end": 419.66,
    "text": "对"
  },
  {
    "start": 419.66,
    "end": 421.1,
    "text": "而到了1986年"
  },
  {
    "start": 421.1,
    "end": 424.02,
    "text": "他们达到的是100亿美元客户资产的规模"
  },
  {
    "start": 424.02,
    "end": 426.56,
    "text": "这两个数字展现了业务的体量"
  },
  {
    "start": 426.56,
    "end": 429.48,
    "text": "但绝对不能和企业利润混为一谈"
  },
  {
    "start": 429.48,
    "end": 429.8,
    "text": "等一下"
  },
  {
    "start": 429.8,
    "end": 431.56,
    "text": "这里我就有点困惑了"
  },
  {
    "start": 431.56,
    "end": 433.24,
    "text": "既然在1986年"
  },
  {
    "start": 433.24,
    "end": 435.94,
    "text": "他们已经掌握了100亿美元的客户资产"
  },
  {
    "start": 435.94,
    "end": 437.58,
    "text": "可以说是顺风顺水"
  },
  {
    "start": 437.58,
    "end": 440.62,
    "text": "那为什么后来还要把公司卖给美国银行呢"
  },
  {
    "start": 440.62,
    "end": 443.02,
    "text": "你抓到了一个核心的商业矛盾"
  },
  {
    "start": 443.02,
    "end": 445.28,
    "text": "这难道不是向旧势力投降吗"
  },
  {
    "start": 445.28,
    "end": 448.16,
    "text": "这其实是资本与自主权之间的剧烈张力"
  },
  {
    "start": 448.16,
    "end": 450.26,
    "text": "维持这种指数级的扩张"
  },
  {
    "start": 450.26,
    "end": 454.62,
    "text": "特别是作为一家券商需要极其庞大的资本金作为安全垫"
  },
  {
    "start": 454.62,
    "end": 458.98,
    "text": "也就是说单纯靠自身利润滚雪球已经撑不住了"
  },
  {
    "start": 458.98,
    "end": 459.6,
    "text": "对"
  },
  {
    "start": 459.6,
    "end": 461.88,
    "text": "引入美国银行这个巨头"
  },
  {
    "start": 461.88,
    "end": 463.98,
    "text": "初衷是为了获得资本弹药"
  },
  {
    "start": 463.98,
    "end": 465.6,
    "text": "结果弹药是有了"
  },
  {
    "start": 465.6,
    "end": 468.54,
    "text": "但连带附赠了一个沉重的枷锁"
  },
  {
    "start": 468.54,
    "end": 471.6,
    "text": "银行那种官僚体制和繁琐的合规流程"
  },
  {
    "start": 471.6,
    "end": 475.06,
    "text": "开始严重侵蚀这家创业公司的创新基因"
  },
  {
    "start": 475.06,
    "end": 477.98,
    "text": "两种截然不同企业文化发生了剧烈的摩擦"
  },
  {
    "start": 477.98,
    "end": 480.4,
    "text": "美国银行习惯了赚高额利差"
  },
  {
    "start": 480.4,
    "end": 483.94,
    "text": "而嘉信理财的基因是薄利多销和快速响应"
  },
  {
    "start": 483.94,
    "end": 486.84,
    "text": "导致决策链条变得极其漫长"
  },
  {
    "start": 486.84,
    "end": 489.66,
    "text": "书里其实详细描述了这种痛苦的拉扯"
  },
  {
    "start": 489.66,
    "end": 493.12,
    "text": "以及查尔斯是如何千辛万苦筹集资金"
  },
  {
    "start": 493.12,
    "end": 495.66,
    "text": "把公司重新买回来并最终上市的"
  },
  {
    "start": 495.66,
    "end": 498.34,
    "text": "不过刚刚重新独立上市"
  },
  {
    "start": 498.34,
    "end": 500.4,
    "text": "一转头就遭遇了当头一棒"
  },
  {
    "start": 500.4,
    "end": 503.34,
    "text": "第十九章记录了一场惊心动魄的危机"
  },
  {
    "start": 503.34,
    "end": 507.8,
    "text": "对 整个系统因为海量的抛售指令几乎瘫痪"
  },
  {
    "start": 507.8,
    "end": 511.0,
    "text": "那是对他们资金链的最极限压力测试"
  },
  {
    "start": 511.0,
    "end": 512.74,
    "text": "这里必须明确指出"
  },
  {
    "start": 512.74,
    "end": 516.96,
    "text": "书里第十九章讲的这场危机是1987年的股灾"
  },
  {
    "start": 516.96,
    "end": 520.26,
    "text": "大家在阅读时不要误以为是其他年份的危机"
  },
  {
    "start": 520.26,
    "end": 522.44,
    "text": "经历了1987年的风暴"
  },
  {
    "start": 522.44,
    "end": 524.7,
    "text": "公司被迫进入了重组期"
  },
  {
    "start": 524.7,
    "end": 527.36,
    "text": "危机往往能逼出创新"
  },
  {
    "start": 527.36,
    "end": 529.74,
    "text": "在这个阶段也就是第二十章"
  },
  {
    "start": 529.74,
    "end": 532.5,
    "text": "作者梳理了一项改变行业的发明"
  },
  {
    "start": 532.5,
    "end": 534.7,
    "text": "共同基金的权一账户"
  },
  {
    "start": 534.7,
    "end": 536.46,
    "text": "没错 在这之前"
  },
  {
    "start": 536.46,
    "end": 539.22,
    "text": "你想把钱从A基金换到B基金"
  },
  {
    "start": 539.22,
    "end": 541.92,
    "text": "那简直就像是你为了换个手机套餐"
  },
  {
    "start": 541.92,
    "end": 544.18,
    "text": "必须先付违约金 注销号码"
  },
  {
    "start": 544.18,
    "end": 546.48,
    "text": "再填几十页表格一样麻烦"
  },
  {
    "start": 546.48,
    "end": 548.14,
    "text": "摩擦成本极高"
  },
  {
    "start": 548.14,
    "end": 551.34,
    "text": "但权一账户就像是一个万能转换插头"
  },
  {
    "start": 551.34,
    "end": 552.96,
    "text": "只要一个账户登陆"
  },
  {
    "start": 552.96,
    "end": 555.8,
    "text": "就可以无缝在各大基金之间调拨资金"
  },
  {
    "start": 555.8,
    "end": 560.84,
    "text": "这个创新的底层逻辑确实体现了他们以客户视角看问题的原则"
  },
  {
    "start": 560.84,
    "end": 562.56,
    "text": "减少了转换障碍"
  },
  {
    "start": 562.56,
    "end": 565.04,
    "text": "但商业世界里总有不可控因素"
  },
  {
    "start": 565.04,
    "end": 568.72,
    "text": "第二十一章就提到管理层关键人物的健康问题"
  },
  {
    "start": 568.72,
    "end": 571.14,
    "text": "给公司带来了巨大冲击"
  },
  {
    "start": 571.14,
    "end": 575.28,
    "text": "确实 关键人物离场瞬间就会打乱既定阵脚"
  },
  {
    "start": 575.28,
    "end": 577.1,
    "text": "不过到了二十世纪末"
  },
  {
    "start": 577.1,
    "end": 578.86,
    "text": "互联网泡沫时期来了"
  },
  {
    "start": 578.86,
    "end": 581.38,
    "text": "那是一个疯狂交易的时代"
  },
  {
    "start": 581.38,
    "end": 582.92,
    "text": "对 互联网渠道兴起"
  },
  {
    "start": 582.92,
    "end": 586.78,
    "text": "公司因为活跃交易的散户获得了大量收入"
  },
  {
    "start": 586.78,
    "end": 587.84,
    "text": "聊到这儿"
  },
  {
    "start": 587.84,
    "end": 589.84,
    "text": "我必须提出一个犀利的追问了"
  },
  {
    "start": 589.84,
    "end": 590.88,
    "text": "哦 什么追问"
  },
  {
    "start": 590.88,
    "end": 592.14,
    "text": "作者一直说"
  },
  {
    "start": 592.14,
    "end": 594.98,
    "text": "核心价值观是以客户视角看问题"
  },
  {
    "start": 594.98,
    "end": 595.46,
    "text": "对吧"
  },
  {
    "start": 595.46,
    "end": 596.82,
    "text": "但是在泡沫期"
  },
  {
    "start": 596.82,
    "end": 599.94,
    "text": "公司明明从客户那些高频活跃的交易里"
  },
  {
    "start": 599.94,
    "end": 601.8,
    "text": "赚取了大量收入"
  },
  {
    "start": 601.8,
    "end": 603.44,
    "text": "公司赚大钱的交易频率"
  },
  {
    "start": 603.44,
    "end": 606.16,
    "text": "真的等同于适合客户的交易频率吗"
  },
  {
    "start": 606.16,
    "end": 608.52,
    "text": "这是一个非常深刻的疑问"
  },
  {
    "start": 608.52,
    "end": 609.3,
    "text": "事实上"
  },
  {
    "start": 609.3,
    "end": 611.54,
    "text": "这也是书内暴露出的一个深刻张力"
  },
  {
    "start": 611.54,
    "end": 612.7,
    "text": "单凭一句"
  },
  {
    "start": 612.7,
    "end": 614.08,
    "text": "以客户为中心"
  },
  {
    "start": 614.08,
    "end": 615.4,
    "text": "并不能自动解决"
  },
  {
    "start": 615.4,
    "end": 616.64,
    "text": "企业盈利冲动"
  },
  {
    "start": 616.64,
    "end": 618.8,
    "text": "与客户长远利益之间的摩擦"
  },
  {
    "start": 618.8,
    "end": 620.0,
    "text": "换句话说"
  },
  {
    "start": 620.0,
    "end": 621.38,
    "text": "在狂热的市场里"
  },
  {
    "start": 621.38,
    "end": 622.62,
    "text": "公司的获利模式"
  },
  {
    "start": 622.62,
    "end": 624.0,
    "text": "和客户的财务健康"
  },
  {
    "start": 624.0,
    "end": 625.54,
    "text": "其实是背离的"
  },
  {
    "start": 625.54,
    "end": 627.1,
    "text": "这种客观分析非常重要"
  },
  {
    "start": 627.1,
    "end": 628.26,
    "text": "能让听众看到"
  },
  {
    "start": 628.26,
    "end": 629.9,
    "text": "商业运行中的复杂性"
  },
  {
    "start": 629.9,
    "end": 630.68,
    "text": "当然"
  },
  {
    "start": 630.68,
    "end": 632.54,
    "text": "这种背离不可能永远持续"
  },
  {
    "start": 632.54,
    "end": 634.6,
    "text": "2004年泡沫破裂后"
  },
  {
    "start": 634.6,
    "end": 636.22,
    "text": "留下的只有一地鸡毛"
  },
  {
    "start": 636.22,
    "end": 637.88,
    "text": "客户账户缩水"
  },
  {
    "start": 637.88,
    "end": 640.06,
    "text": "但公司庞大的成本结构还在"
  },
  {
    "start": 640.06,
    "end": 642.46,
    "text": "这就逼得查尔斯重新出山"
  },
  {
    "start": 642.46,
    "end": 644.2,
    "text": "他回来后的核心动作"
  },
  {
    "start": 644.2,
    "end": 644.98,
    "text": "其实很明确"
  },
  {
    "start": 644.98,
    "end": 647.78,
    "text": "就是领导层的更替和品牌重塑"
  },
  {
    "start": 647.78,
    "end": 649.24,
    "text": "再次降价"
  },
  {
    "start": 649.24,
    "end": 650.76,
    "text": "并且减少复杂性"
  },
  {
    "start": 650.76,
    "end": 652.28,
    "text": "在这个过程中"
  },
  {
    "start": 652.28,
    "end": 653.5,
    "text": "第28章提到"
  },
  {
    "start": 653.5,
    "end": 655.74,
    "text": "他们决定出售美国信托公司"
  },
  {
    "start": 655.74,
    "end": 657.92,
    "text": "在这里需要合成一个事实"
  },
  {
    "start": 657.92,
    "end": 659.22,
    "text": "2006年"
  },
  {
    "start": 659.22,
    "end": 661.68,
    "text": "嘉信理财以33亿美元现金"
  },
  {
    "start": 661.68,
    "end": 662.82,
    "text": "出售了美国信托"
  },
  {
    "start": 662.82,
    "end": 664.24,
    "text": "我必须明确解释"
  },
  {
    "start": 664.24,
    "end": 667.24,
    "text": "这里的33亿美元是交易对价"
  },
  {
    "start": 667.24,
    "end": 668.78,
    "text": "也就是卖了多少钱"
  },
  {
    "start": 668.78,
    "end": 669.82,
    "text": "绝不是收益率"
  },
  {
    "start": 669.82,
    "end": 672.1,
    "text": "那为什么费尽买来的资产"
  },
  {
    "start": 672.1,
    "end": 672.96,
    "text": "又要卖掉呢"
  },
  {
    "start": 672.96,
    "end": 674.2,
    "text": "作者强调"
  },
  {
    "start": 674.2,
    "end": 675.74,
    "text": "这是由于文化不匹配"
  },
  {
    "start": 675.74,
    "end": 678.36,
    "text": "提供折扣经纪服务的公司基因"
  },
  {
    "start": 678.36,
    "end": 680.02,
    "text": "是标准化高效率"
  },
  {
    "start": 680.02,
    "end": 681.42,
    "text": "而传统信托公司"
  },
  {
    "start": 681.42,
    "end": 683.64,
    "text": "是高度定制化的白手套服务"
  },
  {
    "start": 683.64,
    "end": 683.82,
    "text": "对"
  },
  {
    "start": 683.82,
    "end": 685.5,
    "text": "这两者就像水和油"
  },
  {
    "start": 685.5,
    "end": 686.56,
    "text": "无法相容"
  },
  {
    "start": 686.56,
    "end": 688.38,
    "text": "这段经历并不是在宣判"
  },
  {
    "start": 688.38,
    "end": 690.0,
    "text": "所有的并购都是错的"
  },
  {
    "start": 690.0,
    "end": 693.34,
    "text": "而是展示了维持企业基因的代价"
  },
  {
    "start": 693.34,
    "end": 695.02,
    "text": "砍掉了不匹配的资产"
  },
  {
    "start": 695.02,
    "end": 697.3,
    "text": "前方依然充满挑战"
  },
  {
    "start": 697.3,
    "end": 697.82,
    "text": "接下来"
  },
  {
    "start": 697.82,
    "end": 700.3,
    "text": "管理层交接恰好撞上的金融危机"
  },
  {
    "start": 700.3,
    "end": 702.56,
    "text": "还有随之而来的零利率时代"
  },
  {
    "start": 702.56,
    "end": 704.32,
    "text": "提到零利率时代"
  },
  {
    "start": 704.32,
    "end": 705.38,
    "text": "我得提醒一下听众"
  },
  {
    "start": 705.38,
    "end": 708.62,
    "text": "作者在书中对零利率政策提出了批评"
  },
  {
    "start": 708.62,
    "end": 712.5,
    "text": "但这是他站在企业收入环境受压的立场上发出的"
  },
  {
    "start": 712.5,
    "end": 714.36,
    "text": "因为利息差变少了吗"
  },
  {
    "start": 714.36,
    "end": 714.96,
    "text": "是的"
  },
  {
    "start": 714.96,
    "end": 717.04,
    "text": "这代表了作者的个人倾向"
  },
  {
    "start": 717.04,
    "end": 721.08,
    "text": "并不等同于对全球货币政策的独立客观评估"
  },
  {
    "start": 721.08,
    "end": 721.38,
    "text": "明白"
  },
  {
    "start": 721.38,
    "end": 726.04,
    "text": "那抛开这些对于普通人作者在最后留下了哪些反思呢"
  },
  {
    "start": 726.04,
    "end": 729.72,
    "text": "作者认为应该做一个长期的乐观主义者"
  },
  {
    "start": 729.72,
    "end": 734.12,
    "text": "守住低成本分散化和长期持有指数基金的基石"
  },
  {
    "start": 734.12,
    "end": 734.84,
    "text": "没错"
  },
  {
    "start": 734.84,
    "end": 737.02,
    "text": "避免情绪化的恐慌择时"
  },
  {
    "start": 737.02,
    "end": 741.16,
    "text": "另外书中还提到推出罗博机器人投资服务"
  },
  {
    "start": 741.16,
    "end": 744.9,
    "text": "作者认为这是用AI技术降低投资门槛提升效率"
  },
  {
    "start": 744.9,
    "end": 746.36,
    "text": "听起来是很系统的经验"
  },
  {
    "start": 746.36,
    "end": 750.12,
    "text": "但我必须温和但坚决的向听众做个免责说明"
  },
  {
    "start": 750.12,
    "end": 751.58,
    "text": "您请说"
  },
  {
    "start": 751.58,
    "end": 753.56,
    "text": "我们整理作者的这些回忆与判断"
  },
  {
    "start": 753.56,
    "end": 756.8,
    "text": "绝不是在向大家推荐任何具体的投资产品"
  },
  {
    "start": 756.8,
    "end": 759.98,
    "text": "也不构成个人的理财购房或税务建议"
  },
  {
    "start": 759.98,
    "end": 763.18,
    "text": "当然不能当成买卖点位或者产品的推荐"
  },
  {
    "start": 763.18,
    "end": 766.8,
    "text": "历史的假设和做法不能直接折算成今天的收益承诺"
  },
  {
    "start": 766.8,
    "end": 769.1,
    "text": "投资决策需要大家独立做出"
  },
  {
    "start": 769.1,
    "end": 769.78,
    "text": "没错"
  },
  {
    "start": 769.78,
    "end": 775.16,
    "text": "那梳理到这里如果要把全书脉络收拢提炼出原书的一个核心主张"
  },
  {
    "start": 775.16,
    "end": 780.5,
    "text": "其实就是作者认为站在客户角度降低成本减少销售的利益冲突"
  },
  {
    "start": 780.5,
    "end": 784.56,
    "text": "并让技术与服务配合就能形成企业的长期竞争力"
  },
  {
    "start": 784.56,
    "end": 786.28,
    "text": "只是贯穿全书的逻辑"
  },
  {
    "start": 786.28,
    "end": 790.5,
    "text": "但是这也引出了一个留给您去探索的未解决问题"
  },
  {
    "start": 790.5,
    "end": 794.98,
    "text": "这本书让我们清晰看到了作者对创新和商业道德的看法"
  },
  {
    "start": 794.98,
    "end": 797.92,
    "text": "但终究是创始人的第一人称回忆"
  },
  {
    "start": 797.92,
    "end": 799.78,
    "text": "确实带有个人视角"
  },
  {
    "start": 799.78,
    "end": 801.18,
    "text": "单凭这本书"
  },
  {
    "start": 801.18,
    "end": 803.24,
    "text": "我们其实无法独立证明"
  },
  {
    "start": 803.24,
    "end": 806.36,
    "text": "低费率就必然带来更好的绝对净收益"
  },
  {
    "start": 806.36,
    "end": 810.12,
    "text": "也无法确信所有的利益冲突都已经完美消除"
  },
  {
    "start": 810.12,
    "end": 812.24,
    "text": "这是一个很现实的问题"
  },
  {
    "start": 812.24,
    "end": 813.1,
    "text": "是的"
  },
  {
    "start": 813.1,
    "end": 815.98,
    "text": "那么身处信息洪流中的您"
  },
  {
    "start": 815.98,
    "end": 818.2,
    "text": "面对任何一家金融机构时"
  },
  {
    "start": 818.2,
    "end": 819.92,
    "text": "该用什么标准去衡量"
  },
  {
    "start": 819.92,
    "end": 821.94,
    "text": "他们是真的与您的利益一致"
  },
  {
    "start": 821.94,
    "end": 824.96,
    "text": "还是仅仅换了一种高明的营销说辞呢"
  },
  {
    "start": 824.96,
    "end": 827.38,
    "text": "这个反思真的非常到位"
  },
  {
    "start": 827.38,
    "end": 831.56,
    "text": "感谢您参与这趟跨越40年的商业梳理之旅"
  },
  {
    "start": 831.56,
    "end": 834.06,
    "text": "希望大家在面对复杂信息时"
  },
  {
    "start": 834.06,
    "end": 836.26,
    "text": "始终保持批判性思考"
  },
  {
    "start": 836.26,
    "end": 836.86,
    "text": "好"
  },
  {
    "start": 836.86,
    "end": 839.4,
    "text": "我们在这趟探索中就聊到这里"
  },
  {
    "start": 839.4,
    "end": 840.26,
    "text": "下次再见"
  }
]
