[
  {
    "start": 0.0,
    "end": 1.48,
    "text": "1987年6月"
  },
  {
    "start": 1.48,
    "end": 3.74,
    "text": "在斯坦福大学的校园里"
  },
  {
    "start": 3.74,
    "end": 5.16,
    "text": "彼得蒂尔和他的朋友"
  },
  {
    "start": 5.16,
    "end": 6.4,
    "text": "一起创办了一份叫"
  },
  {
    "start": 6.4,
    "end": 8.68,
    "text": "斯坦福评论的刊物"
  },
  {
    "start": 8.68,
    "end": 10.7,
    "text": "这个开头听着挺常见的"
  },
  {
    "start": 10.7,
    "end": 10.92,
    "text": "对"
  },
  {
    "start": 10.92,
    "end": 12.62,
    "text": "这段经历如果单看"
  },
  {
    "start": 12.62,
    "end": 14.1,
    "text": "感觉就像你在大学里"
  },
  {
    "start": 14.1,
    "end": 16.94,
    "text": "就是随便加入了一个普通社团"
  },
  {
    "start": 16.94,
    "end": 17.3,
    "text": "没错"
  },
  {
    "start": 17.3,
    "end": 18.5,
    "text": "学生搞点小报嘛"
  },
  {
    "start": 18.5,
    "end": 19.0,
    "text": "但是"
  },
  {
    "start": 19.0,
    "end": 21.36,
    "text": "如果你顺着这根时间线往后梳理"
  },
  {
    "start": 21.36,
    "end": 23.48,
    "text": "事情的走向就完全不同了"
  },
  {
    "start": 23.48,
    "end": 26.8,
    "text": "到了大约1994年的圣诞节前后"
  },
  {
    "start": 26.8,
    "end": 28.66,
    "text": "那个在加利福尼亚海岸边"
  },
  {
    "start": 28.66,
    "end": 30.24,
    "text": "蒂尔又是和朋友在一起"
  },
  {
    "start": 30.24,
    "end": 32.02,
    "text": "但这次讨论的话题"
  },
  {
    "start": 32.02,
    "end": 34.06,
    "text": "变成了互联网创业"
  },
  {
    "start": 34.06,
    "end": 35.16,
    "text": "跨度开始变大了"
  },
  {
    "start": 35.16,
    "end": 35.46,
    "text": "是的"
  },
  {
    "start": 35.46,
    "end": 37.22,
    "text": "然后你继续追踪这根线"
  },
  {
    "start": 37.22,
    "end": 39.24,
    "text": "大约在1998年的夏天"
  },
  {
    "start": 39.24,
    "end": 41.34,
    "text": "在斯坦福的夏季讲座上"
  },
  {
    "start": 41.34,
    "end": 43.06,
    "text": "他结识了拉夫琴"
  },
  {
    "start": 43.06,
    "end": 45.08,
    "text": "这是一个非常关键的人际节点"
  },
  {
    "start": 45.08,
    "end": 46.14,
    "text": "太关键了"
  },
  {
    "start": 46.14,
    "end": 47.92,
    "text": "紧接着到了1999年7月"
  },
  {
    "start": 47.92,
    "end": 48.6,
    "text": "在硅谷"
  },
  {
    "start": 48.6,
    "end": 50.06,
    "text": "他不仅取得了融资"
  },
  {
    "start": 50.06,
    "end": 51.7,
    "text": "还在众人面前展示了"
  },
  {
    "start": 51.7,
    "end": 52.68,
    "text": "那个转账软件"
  },
  {
    "start": 52.68,
    "end": 53.98,
    "text": "然后同年11月"
  },
  {
    "start": 53.98,
    "end": 56.1,
    "text": "贝宝的用户就迎来了显著增长"
  },
  {
    "start": 56.1,
    "end": 56.4,
    "text": "对吧"
  },
  {
    "start": 56.4,
    "end": 56.84,
    "text": "对"
  },
  {
    "start": 56.84,
    "end": 57.98,
    "text": "同年11月"
  },
  {
    "start": 57.98,
    "end": 59.7,
    "text": "而且同时他们也开始面对"
  },
  {
    "start": 59.7,
    "end": 61.38,
    "text": "X.com的竞争"
  },
  {
    "start": 61.38,
    "end": 62.6,
    "text": "再往后跳跃一下"
  },
  {
    "start": 62.6,
    "end": 63.76,
    "text": "到了2004年"
  },
  {
    "start": 63.76,
    "end": 64.74,
    "text": "他又决定为"
  },
  {
    "start": 64.74,
    "end": 66.78,
    "text": "The Facebook提供种子资金"
  },
  {
    "start": 66.78,
    "end": 68.38,
    "text": "这一路走下来"
  },
  {
    "start": 68.38,
    "end": 69.64,
    "text": "其实节点非常密集"
  },
  {
    "start": 69.64,
    "end": 71.96,
    "text": "你把这些时间节点连在一起看"
  },
  {
    "start": 71.96,
    "end": 73.66,
    "text": "听完最大的感受就是"
  },
  {
    "start": 73.66,
    "end": 75.46,
    "text": "这根本不是媒体上那种"
  },
  {
    "start": 75.46,
    "end": 77.52,
    "text": "那种孤单天才在车库里"
  },
  {
    "start": 77.52,
    "end": 78.72,
    "text": "单打独斗的神话"
  },
  {
    "start": 78.72,
    "end": 79.96,
    "text": "确实不是"
  },
  {
    "start": 79.96,
    "end": 81.52,
    "text": "这听起来更像是一张"
  },
  {
    "start": 81.52,
    "end": 83.16,
    "text": "极其紧密的人际网"
  },
  {
    "start": 83.16,
    "end": 84.46,
    "text": "在拖着他往前走"
  },
  {
    "start": 84.46,
    "end": 86.1,
    "text": "处处都是具体的"
  },
  {
    "start": 86.1,
    "end": 87.8,
    "text": "就是那种朋友圈引荐"
  },
  {
    "start": 87.8,
    "end": 90.24,
    "text": "顺着你说的这个人际网假说"
  },
  {
    "start": 90.24,
    "end": 91.76,
    "text": "其实也就引出了"
  },
  {
    "start": 91.76,
    "end": 94.12,
    "text": "下沉年代这本书的核心探讨"
  },
  {
    "start": 94.12,
    "end": 94.9,
    "text": "嗯哼"
  },
  {
    "start": 94.9,
    "end": 96.72,
    "text": "就是当硅谷的这群精英"
  },
  {
    "start": 96.72,
    "end": 98.96,
    "text": "通过这层极其紧密的网络"
  },
  {
    "start": 98.96,
    "end": 100.34,
    "text": "取得巨大成功的时候"
  },
  {
    "start": 100.34,
    "end": 101.76,
    "text": "这种技术的成功"
  },
  {
    "start": 101.76,
    "end": 104.38,
    "text": "到底能不能等同于我们整个社会的进步"
  },
  {
    "start": 104.38,
    "end": 105.72,
    "text": "这个反差很有意思"
  },
  {
    "start": 105.72,
    "end": 107.5,
    "text": "我们可以先拆解一下这张"
  },
  {
    "start": 107.5,
    "end": 108.94,
    "text": "看似无所不能的网络"
  },
  {
    "start": 108.94,
    "end": 111.3,
    "text": "书里蒂尔的经历确实证明了"
  },
  {
    "start": 111.3,
    "end": 112.46,
    "text": "关系网挺重要的"
  },
  {
    "start": 112.46,
    "end": 113.06,
    "text": "对啊"
  },
  {
    "start": 113.06,
    "end": 115.76,
    "text": "感觉有了圈子就有了一切"
  },
  {
    "start": 115.76,
    "end": 116.04,
    "text": "但是"
  },
  {
    "start": 116.04,
    "end": 118.62,
    "text": "网络只是可能的机会条件"
  },
  {
    "start": 118.62,
    "end": 119.62,
    "text": "既不必要"
  },
  {
    "start": 119.62,
    "end": 120.34,
    "text": "也不充分"
  },
  {
    "start": 120.34,
    "end": 121.06,
    "text": "哦"
  },
  {
    "start": 121.06,
    "end": 121.86,
    "text": "怎么说"
  },
  {
    "start": 121.86,
    "end": 123.52,
    "text": "书里给了一个处境"
  },
  {
    "start": 123.52,
    "end": 125.24,
    "text": "反差极其强烈的反例"
  },
  {
    "start": 125.24,
    "end": 127.68,
    "text": "大概到了2008年9月"
  },
  {
    "start": 127.68,
    "end": 129.52,
    "text": "蒂尔的克莱瑞姆基金"
  },
  {
    "start": 129.52,
    "end": 130.38,
    "text": "扩大了规模"
  },
  {
    "start": 130.38,
    "end": 131.84,
    "text": "并且把大部分业务"
  },
  {
    "start": 131.84,
    "end": 132.62,
    "text": "迁往了纽约"
  },
  {
    "start": 132.62,
    "end": 134.84,
    "text": "2008年9月"
  },
  {
    "start": 134.84,
    "end": 137.14,
    "text": "那可是美国金融危机风暴中心呢"
  },
  {
    "start": 137.14,
    "end": 138.08,
    "text": "没错"
  },
  {
    "start": 138.08,
    "end": 139.8,
    "text": "但到了2009年"
  },
  {
    "start": 139.8,
    "end": 140.98,
    "text": "股价开始回升"
  },
  {
    "start": 140.98,
    "end": 143.02,
    "text": "这反而导致克莱瑞姆基金"
  },
  {
    "start": 143.02,
    "end": 144.3,
    "text": "做空的损失扩大"
  },
  {
    "start": 144.3,
    "end": 145.0,
    "text": "哇"
  },
  {
    "start": 145.0,
    "end": 147.3,
    "text": "等于大方向压反了"
  },
  {
    "start": 147.3,
    "end": 147.86,
    "text": "对"
  },
  {
    "start": 147.86,
    "end": 149.28,
    "text": "最后的结果是"
  },
  {
    "start": 149.28,
    "end": 151.16,
    "text": "大约2010年中期"
  },
  {
    "start": 151.16,
    "end": 153.22,
    "text": "关闭了纽约办公室"
  },
  {
    "start": 153.22,
    "end": 154.72,
    "text": "这就好比"
  },
  {
    "start": 154.72,
    "end": 155.74,
    "text": "呃"
  },
  {
    "start": 155.74,
    "end": 156.9,
    "text": "就好比你拥有一个"
  },
  {
    "start": 156.9,
    "end": 158.28,
    "text": "纯金打造的通讯录"
  },
  {
    "start": 158.28,
    "end": 159.78,
    "text": "但这也不能保证"
  },
  {
    "start": 159.78,
    "end": 161.32,
    "text": "你每次买彩票都能中奖"
  },
  {
    "start": 161.32,
    "end": 161.88,
    "text": "对吧"
  },
  {
    "start": 161.88,
    "end": 163.12,
    "text": "这个类比很精准"
  },
  {
    "start": 163.12,
    "end": 165.92,
    "text": "同样拥有顶配关系和资本的人"
  },
  {
    "start": 165.92,
    "end": 167.92,
    "text": "也会因为独特的判断不同"
  },
  {
    "start": 167.92,
    "end": 169.08,
    "text": "而导致亏损"
  },
  {
    "start": 169.08,
    "end": 171.28,
    "text": "所以我们不能用圈子"
  },
  {
    "start": 171.28,
    "end": 172.8,
    "text": "去抹杀个人的判断"
  },
  {
    "start": 172.8,
    "end": 174.04,
    "text": "和真实的技术贡献"
  },
  {
    "start": 174.04,
    "end": 175.94,
    "text": "但这就引发了下一个"
  },
  {
    "start": 175.94,
    "end": 177.0,
    "text": "让人深思的问题"
  },
  {
    "start": 177.0,
    "end": 177.88,
    "text": "什么问题"
  },
  {
    "start": 177.88,
    "end": 179.38,
    "text": "如果这群人"
  },
  {
    "start": 179.38,
    "end": 181.12,
    "text": "确实做出了技术贡献"
  },
  {
    "start": 181.12,
    "end": 183.04,
    "text": "为什么硅谷旁边的地区"
  },
  {
    "start": 183.04,
    "end": 184.3,
    "text": "依然会陷入困顿"
  },
  {
    "start": 184.3,
    "end": 186.3,
    "text": "这就得看原书作者"
  },
  {
    "start": 186.3,
    "end": 187.1,
    "text": "是怎么写的了"
  },
  {
    "start": 187.1,
    "end": 187.62,
    "text": "对"
  },
  {
    "start": 187.62,
    "end": 190.0,
    "text": "我们要看乔治帕克的独特写法"
  },
  {
    "start": 190.0,
    "end": 191.84,
    "text": "他之前是纽约客的"
  },
  {
    "start": 191.84,
    "end": 192.74,
    "text": "专职撰稿人"
  },
  {
    "start": 192.74,
    "end": 194.54,
    "text": "报道过伊拉克战争"
  },
  {
    "start": 194.54,
    "end": 194.9,
    "text": "哇"
  },
  {
    "start": 194.9,
    "end": 196.22,
    "text": "做战地新闻呢"
  },
  {
    "start": 196.22,
    "end": 196.7,
    "text": "嗯"
  },
  {
    "start": 196.7,
    "end": 199.0,
    "text": "他在2013年的访谈里说过"
  },
  {
    "start": 199.0,
    "end": 200.78,
    "text": "报道伊拉克重建失败"
  },
  {
    "start": 200.78,
    "end": 202.96,
    "text": "让他开始追问制度失灵"
  },
  {
    "start": 202.96,
    "end": 204.66,
    "text": "然后2008年回国"
  },
  {
    "start": 204.66,
    "end": 205.58,
    "text": "遇到金融危机"
  },
  {
    "start": 205.58,
    "end": 207.62,
    "text": "他就把这个问题带回了美国"
  },
  {
    "start": 207.62,
    "end": 210.14,
    "text": "从战场直接切回美国社会"
  },
  {
    "start": 210.14,
    "end": 211.72,
    "text": "那他具体是怎么写的"
  },
  {
    "start": 211.72,
    "end": 215.0,
    "text": "他用了多斯·帕索斯提供的结构参照"
  },
  {
    "start": 215.0,
    "end": 216.06,
    "text": "凭借这个"
  },
  {
    "start": 216.06,
    "end": 217.78,
    "text": "这书还拿了2013年"
  },
  {
    "start": 217.78,
    "end": 219.02,
    "text": "美国国家图书奖"
  },
  {
    "start": 219.02,
    "end": 219.96,
    "text": "非虚构奖"
  },
  {
    "start": 219.96,
    "end": 221.22,
    "text": "核心手法是什么"
  },
  {
    "start": 221.22,
    "end": 222.68,
    "text": "核心就是并置"
  },
  {
    "start": 222.68,
    "end": 224.18,
    "text": "他把普通工人"
  },
  {
    "start": 224.18,
    "end": 225.5,
    "text": "跟那些富裕名人"
  },
  {
    "start": 225.5,
    "end": 226.68,
    "text": "直接并置在一起"
  },
  {
    "start": 226.68,
    "end": 227.66,
    "text": "比如呢"
  },
  {
    "start": 227.66,
    "end": 230.12,
    "text": "比如2009年去达沃斯"
  },
  {
    "start": 230.12,
    "end": 231.9,
    "text": "参加世界经济论坛的蒂尔"
  },
  {
    "start": 231.9,
    "end": 233.96,
    "text": "还有2011年春季"
  },
  {
    "start": 233.96,
    "end": 235.58,
    "text": "在旧金山与罗姆尼"
  },
  {
    "start": 235.58,
    "end": 236.72,
    "text": "共进早餐的蒂尔"
  },
  {
    "start": 236.72,
    "end": 238.18,
    "text": "他把这些场景"
  },
  {
    "start": 238.18,
    "end": 239.42,
    "text": "跟普通人的挣扎"
  },
  {
    "start": 239.42,
    "end": 241.24,
    "text": "摆在同一张纸上"
  },
  {
    "start": 241.24,
    "end": 242.34,
    "text": "等等"
  },
  {
    "start": 242.34,
    "end": 244.78,
    "text": "这种写法就像电影里的"
  },
  {
    "start": 244.78,
    "end": 246.0,
    "text": "分屏镜头啊"
  },
  {
    "start": 246.0,
    "end": 247.42,
    "text": "画面感很强对吧"
  },
  {
    "start": 247.42,
    "end": 249.96,
    "text": "左边是名人在吃高档早餐"
  },
  {
    "start": 249.96,
    "end": 251.64,
    "text": "右边是普通人在挣扎"
  },
  {
    "start": 251.64,
    "end": 253.92,
    "text": "但把这两件事摆在一起"
  },
  {
    "start": 253.92,
    "end": 255.18,
    "text": "就一定证明"
  },
  {
    "start": 255.18,
    "end": 256.36,
    "text": "他们有因果关系吗"
  },
  {
    "start": 256.36,
    "end": 258.44,
    "text": "你这个质询非常核心"
  },
  {
    "start": 258.44,
    "end": 260.3,
    "text": "评论家莱曼就提出了"
  },
  {
    "start": 260.3,
    "end": 261.64,
    "text": "最强反对意见"
  },
  {
    "start": 261.64,
    "end": 262.46,
    "text": "怎么反驳的"
  },
  {
    "start": 262.46,
    "end": 263.62,
    "text": "莱曼认为"
  },
  {
    "start": 263.62,
    "end": 266.3,
    "text": "这种形式可能会把具体的金融"
  },
  {
    "start": 266.3,
    "end": 268.08,
    "text": "分配和政治责任"
  },
  {
    "start": 268.08,
    "end": 271.14,
    "text": "直接压缩成一种抽象的解体"
  },
  {
    "start": 271.14,
    "end": 272.56,
    "text": "也就是unwinding"
  },
  {
    "start": 272.56,
    "end": 274.92,
    "text": "也就是读者的联想"
  },
  {
    "start": 274.92,
    "end": 276.8,
    "text": "可能会掩盖真实的因果缺口"
  },
  {
    "start": 276.8,
    "end": 277.18,
    "text": "对"
  },
  {
    "start": 277.18,
    "end": 278.74,
    "text": "不过帕克的写法"
  },
  {
    "start": 278.74,
    "end": 280.98,
    "text": "其实保留了一种问题生成方法"
  },
  {
    "start": 280.98,
    "end": 282.64,
    "text": "它更像是一张地图"
  },
  {
    "start": 282.64,
    "end": 284.18,
    "text": "帮咱们提出假说"
  },
  {
    "start": 284.18,
    "end": 286.44,
    "text": "但我们自己要去核实"
  },
  {
    "start": 286.44,
    "end": 287.18,
    "text": "发生者"
  },
  {
    "start": 287.18,
    "end": 287.86,
    "text": "时序"
  },
  {
    "start": 287.86,
    "end": 289.26,
    "text": "还有具体的机制"
  },
  {
    "start": 289.26,
    "end": 292.32,
    "text": "既然并置只是提出假说"
  },
  {
    "start": 292.32,
    "end": 293.66,
    "text": "那我们肯定得看"
  },
  {
    "start": 293.66,
    "end": 295.76,
    "text": "真实的研究数据是怎么说的"
  },
  {
    "start": 295.76,
    "end": 297.04,
    "text": "技术的繁荣"
  },
  {
    "start": 297.04,
    "end": 299.4,
    "text": "到底有没有落到普通人身上"
  },
  {
    "start": 299.4,
    "end": 301.2,
    "text": "这里我们得分两层看"
  },
  {
    "start": 301.2,
    "end": 303.66,
    "text": "第一层是技术本身的放缓"
  },
  {
    "start": 303.66,
    "end": 306.66,
    "text": "Gordon对1972年以后MFP"
  },
  {
    "start": 306.66,
    "end": 309.36,
    "text": "也就是多要素生产率的放缓"
  },
  {
    "start": 309.36,
    "end": 310.16,
    "text": "进行了分析"
  },
  {
    "start": 310.16,
    "end": 311.9,
    "text": "整体效率变慢了"
  },
  {
    "start": 311.9,
    "end": 312.36,
    "text": "对"
  },
  {
    "start": 312.36,
    "end": 314.06,
    "text": "而且Bloom等人"
  },
  {
    "start": 314.06,
    "end": 316.44,
    "text": "也给出了关于研究效率下降的证据"
  },
  {
    "start": 316.44,
    "end": 318.6,
    "text": "具体是什么证据"
  },
  {
    "start": 318.6,
    "end": 321.5,
    "text": "成书后大概在2017年工作论文"
  },
  {
    "start": 321.5,
    "end": 323.28,
    "text": "及2020年正式书目里"
  },
  {
    "start": 323.28,
    "end": 325.1,
    "text": "新增了系统案例论据"
  },
  {
    "start": 325.1,
    "end": 327.6,
    "text": "证明研究投入在上升"
  },
  {
    "start": 327.6,
    "end": 329.66,
    "text": "但研究效率在下降"
  },
  {
    "start": 329.66,
    "end": 330.94,
    "text": "这是为什么呢"
  },
  {
    "start": 330.94,
    "end": 332.5,
    "text": "投入变多了"
  },
  {
    "start": 332.5,
    "end": 333.76,
    "text": "效率反而低了"
  },
  {
    "start": 333.76,
    "end": 336.12,
    "text": "那个研究没有给出原因"
  },
  {
    "start": 336.12,
    "end": 338.94,
    "text": "就是单纯在描述客观数据"
  },
  {
    "start": 338.94,
    "end": 339.36,
    "text": "对"
  },
  {
    "start": 339.36,
    "end": 340.54,
    "text": "而且要注意"
  },
  {
    "start": 340.54,
    "end": 343.4,
    "text": "我们绝对不能因为局部地区的困顿"
  },
  {
    "start": 343.4,
    "end": 345.36,
    "text": "或者一个投资者的个人感受"
  },
  {
    "start": 345.36,
    "end": 347.9,
    "text": "就推断出科技全面停止"
  },
  {
    "start": 347.9,
    "end": 349.22,
    "text": "或者净收益为零"
  },
  {
    "start": 349.22,
    "end": 350.32,
    "text": "明白了"
  },
  {
    "start": 350.32,
    "end": 351.76,
    "text": "这不等于技术没用"
  },
  {
    "start": 351.76,
    "end": 353.38,
    "text": "或者总体财富没增加"
  },
  {
    "start": 353.38,
    "end": 354.0,
    "text": "没错"
  },
  {
    "start": 354.0,
    "end": 356.76,
    "text": "所以这就来到了最核心的第二层"
  },
  {
    "start": 356.76,
    "end": 358.14,
    "text": "就是分配问题"
  },
  {
    "start": 358.14,
    "end": 360.32,
    "text": "增长到底由谁获得"
  },
  {
    "start": 360.32,
    "end": 362.12,
    "text": "这确实是关键"
  },
  {
    "start": 362.12,
    "end": 364.46,
    "text": "关于美国历史出生队列的"
  },
  {
    "start": 364.46,
    "end": 365.82,
    "text": "绝对收入流动问题"
  },
  {
    "start": 365.82,
    "end": 367.72,
    "text": "2016年工作论文"
  },
  {
    "start": 367.72,
    "end": 369.48,
    "text": "与2017年发表的研究"
  },
  {
    "start": 369.48,
    "end": 370.92,
    "text": "把这个问题量化了"
  },
  {
    "start": 370.92,
    "end": 372.28,
    "text": "结论是什么"
  },
  {
    "start": 372.28,
    "end": 373.56,
    "text": "结论是"
  },
  {
    "start": 373.56,
    "end": 375.26,
    "text": "只谈总体增长"
  },
  {
    "start": 375.26,
    "end": 376.42,
    "text": "不足以解释"
  },
  {
    "start": 376.42,
    "end": 378.0,
    "text": "子代超越父代的机会"
  },
  {
    "start": 378.0,
    "end": 380.02,
    "text": "全国当期收入改善"
  },
  {
    "start": 380.02,
    "end": 382.22,
    "text": "与长期代际机会变弱"
  },
  {
    "start": 382.22,
    "end": 383.96,
    "text": "是能够同时成立的"
  },
  {
    "start": 383.96,
    "end": 384.74,
    "text": "等等"
  },
  {
    "start": 384.74,
    "end": 388.0,
    "text": "那2026年9月15日Census报告"
  },
  {
    "start": 388.0,
    "end": 389.94,
    "text": "也就是人口普查局那个报告"
  },
  {
    "start": 389.94,
    "end": 390.96,
    "text": "明明显示"
  },
  {
    "start": 390.96,
    "end": 394.12,
    "text": "2025年实际住户收入中位数上升了呀"
  },
  {
    "start": 394.12,
    "end": 395.84,
    "text": "数据是上升的没错"
  },
  {
    "start": 395.84,
    "end": 396.8,
    "text": "对呀"
  },
  {
    "start": 396.8,
    "end": 397.84,
    "text": "这怎么解释"
  },
  {
    "start": 397.84,
    "end": 399.34,
    "text": "这不是证明变好了吗"
  },
  {
    "start": 399.34,
    "end": 401.74,
    "text": "两个测量口径完全不同"
  },
  {
    "start": 401.74,
    "end": 403.18,
    "text": "绝对不能互相抹去"
  },
  {
    "start": 403.18,
    "end": 404.48,
    "text": "总量在涨"
  },
  {
    "start": 404.48,
    "end": 405.52,
    "text": "和谁拿到了"
  },
  {
    "start": 405.52,
    "end": 406.9,
    "text": "这才是实质条件"
  },
  {
    "start": 406.9,
    "end": 408.26,
    "text": "你的意思是"
  },
  {
    "start": 408.26,
    "end": 410.78,
    "text": "平均数掩盖了具体的差异"
  },
  {
    "start": 410.78,
    "end": 411.04,
    "text": "是的"
  },
  {
    "start": 411.04,
    "end": 413.38,
    "text": "我们必须把全国中位数"
  },
  {
    "start": 413.38,
    "end": 414.5,
    "text": "原居民轨迹"
  },
  {
    "start": 414.5,
    "end": 416.54,
    "text": "还有亲子同龄时的比较"
  },
  {
    "start": 416.54,
    "end": 417.74,
    "text": "完全分开看"
  },
  {
    "start": 417.74,
    "end": 419.18,
    "text": "我明白了"
  },
  {
    "start": 419.18,
    "end": 421.0,
    "text": "所以整体在变好"
  },
  {
    "start": 421.0,
    "end": 422.58,
    "text": "和有一部分人在变差"
  },
  {
    "start": 422.58,
    "end": 423.76,
    "text": "是可以同时成立的"
  },
  {
    "start": 423.76,
    "end": 424.84,
    "text": "确实如此"
  },
  {
    "start": 424.84,
    "end": 427.32,
    "text": "这也是为什么技术越来越强"
  },
  {
    "start": 427.32,
    "end": 428.76,
    "text": "但你身边的日子"
  },
  {
    "start": 428.76,
    "end": 430.44,
    "text": "不一定跟着好起来"
  },
  {
    "start": 430.44,
    "end": 431.92,
    "text": "这听起来有点残酷"
  },
  {
    "start": 431.92,
    "end": 434.28,
    "text": "但难处不全是你的错"
  },
  {
    "start": 434.28,
    "end": 436.32,
    "text": "增长由谁获得才是关键"
  },
  {
    "start": 436.32,
    "end": 436.98,
    "text": "对"
  },
  {
    "start": 436.98,
    "end": 438.1,
    "text": "那既然这样"
  },
  {
    "start": 438.1,
    "end": 439.76,
    "text": "我们把这些宏大的叙事"
  },
  {
    "start": 439.76,
    "end": 442.34,
    "text": "赶紧落到你明天一早就能用的"
  },
  {
    "start": 442.34,
    "end": 443.42,
    "text": "具体思维策略上"
  },
  {
    "start": 443.42,
    "end": 444.6,
    "text": "第一条"
  },
  {
    "start": 444.6,
    "end": 447.9,
    "text": "就是如何判断媒体上同时发生的两件事"
  },
  {
    "start": 447.9,
    "end": 450.52,
    "text": "也就是对那个并置手法的反思"
  },
  {
    "start": 450.52,
    "end": 453.38,
    "text": "你要把媒体或者朋友说的因果关系"
  },
  {
    "start": 453.38,
    "end": 455.86,
    "text": "拆成一句句可以检验的联系"
  },
  {
    "start": 455.86,
    "end": 456.32,
    "text": "对"
  },
  {
    "start": 456.32,
    "end": 458.12,
    "text": "问自己时间先后对不对"
  },
  {
    "start": 458.12,
    "end": 459.16,
    "text": "有没有机制"
  },
  {
    "start": 459.16,
    "end": 460.42,
    "text": "样本代表谁"
  },
  {
    "start": 460.42,
    "end": 461.74,
    "text": "证据不到位的"
  },
  {
    "start": 461.74,
    "end": 463.06,
    "text": "一律只当作假说"
  },
  {
    "start": 463.06,
    "end": 463.78,
    "text": "留作问题"
  },
  {
    "start": 463.78,
    "end": 465.56,
    "text": "但这里有个边界提醒"
  },
  {
    "start": 465.56,
    "end": 466.04,
    "text": "嗯"
  },
  {
    "start": 466.04,
    "end": 466.76,
    "text": "什么边界"
  },
  {
    "start": 466.76,
    "end": 470.34,
    "text": "这套方法适合用来训练思维和阅读判断力"
  },
  {
    "start": 470.34,
    "end": 472.7,
    "text": "但判不了的就别应下结论"
  },
  {
    "start": 472.7,
    "end": 475.08,
    "text": "绝对不能用来判断市场走势"
  },
  {
    "start": 475.08,
    "end": 476.22,
    "text": "或作为投资建议"
  },
  {
    "start": 476.22,
    "end": 478.2,
    "text": "这是非常清醒的认知"
  },
  {
    "start": 478.2,
    "end": 479.5,
    "text": "第二条策略"
  },
  {
    "start": 479.5,
    "end": 481.18,
    "text": "就是看宏观数据的时候"
  },
  {
    "start": 481.18,
    "end": 482.94,
    "text": "怎么看待经济复苏"
  },
  {
    "start": 482.94,
    "end": 484.32,
    "text": "城市回暖的新闻"
  },
  {
    "start": 484.32,
    "end": 486.2,
    "text": "对自己家庭的影响"
  },
  {
    "start": 486.2,
    "end": 488.0,
    "text": "核心就是把总量在涨"
  },
  {
    "start": 488.0,
    "end": 489.68,
    "text": "和谁拿到了给分开"
  },
  {
    "start": 489.68,
    "end": 490.76,
    "text": "看新闻时"
  },
  {
    "start": 490.76,
    "end": 493.06,
    "text": "先核对报道里用的是什么时期的"
  },
  {
    "start": 493.06,
    "end": 493.96,
    "text": "什么人口口径"
  },
  {
    "start": 493.96,
    "end": 495.38,
    "text": "然后再去问"
  },
  {
    "start": 495.38,
    "end": 498.06,
    "text": "增长落在了哪些行业和人群"
  },
  {
    "start": 498.06,
    "end": 498.82,
    "text": "对吧"
  },
  {
    "start": 498.82,
    "end": 499.04,
    "text": "对"
  },
  {
    "start": 499.04,
    "end": 500.84,
    "text": "这里要提醒一下边界"
  },
  {
    "start": 500.84,
    "end": 503.08,
    "text": "你可以用它来追问自己"
  },
  {
    "start": 503.08,
    "end": 504.56,
    "text": "属于分布的哪一段"
  },
  {
    "start": 504.56,
    "end": 507.38,
    "text": "但统计分布不能预测个人的得失"
  },
  {
    "start": 507.38,
    "end": 511.14,
    "text": "也就是这套方法适合分析收入趋势"
  },
  {
    "start": 511.14,
    "end": 511.44,
    "text": "是的"
  },
  {
    "start": 511.44,
    "end": 513.76,
    "text": "不适用于预测房产价格"
  },
  {
    "start": 513.76,
    "end": 516.38,
    "text": "也不构成买房或资产配置建议"
  }
]
