[
  {
    "start": 0.0,
    "end": 0.8,
    "text": "想象一下"
  },
  {
    "start": 0.8,
    "end": 2.36,
    "text": "你从小到大"
  },
  {
    "start": 2.36,
    "end": 4.28,
    "text": "听到的都是这样一个标准的剧本"
  },
  {
    "start": 4.28,
    "end": 5.7,
    "text": "好好读书"
  },
  {
    "start": 5.7,
    "end": 6.58,
    "text": "拿个文凭"
  },
  {
    "start": 6.58,
    "end": 7.74,
    "text": "然后认真工作"
  },
  {
    "start": 7.74,
    "end": 9.36,
    "text": "你就能过上好日子"
  },
  {
    "start": 9.36,
    "end": 11.78,
    "text": "非常典型的社会期许"
  },
  {
    "start": 11.78,
    "end": 12.38,
    "text": "对"
  },
  {
    "start": 12.38,
    "end": 13.84,
    "text": "现在你再想象一下"
  },
  {
    "start": 13.84,
    "end": 15.98,
    "text": "你完全照着这个剧本去做了"
  },
  {
    "start": 15.98,
    "end": 17.94,
    "text": "你是一个年轻的母亲"
  },
  {
    "start": 17.94,
    "end": 19.7,
    "text": "一边抱着刚学会走路的女儿"
  },
  {
    "start": 19.7,
    "end": 21.22,
    "text": "一边还要靠着福利补贴"
  },
  {
    "start": 21.22,
    "end": 23.04,
    "text": "来付食物和托儿的费用"
  },
  {
    "start": 23.04,
    "end": 24.46,
    "text": "这压力肯定特别大"
  },
  {
    "start": 24.46,
    "end": 25.42,
    "text": "绝对的"
  },
  {
    "start": 25.42,
    "end": 27.7,
    "text": "但你硬是按时完成了高中学业"
  },
  {
    "start": 27.7,
    "end": 29.28,
    "text": "这是1984年"
  },
  {
    "start": 29.28,
    "end": 30.88,
    "text": "美国杨斯敦的一幕"
  },
  {
    "start": 30.88,
    "end": 32.68,
    "text": "这位年轻的母亲叫塔米"
  },
  {
    "start": 32.68,
    "end": 35.5,
    "text": "我猜故事没这么简单"
  },
  {
    "start": 35.5,
    "end": 36.38,
    "text": "就大团圆了"
  },
  {
    "start": 36.38,
    "end": 37.16,
    "text": "对吗"
  },
  {
    "start": 37.16,
    "end": 37.56,
    "text": "没错"
  },
  {
    "start": 37.56,
    "end": 39.24,
    "text": "当乔治帕克在他那边"
  },
  {
    "start": 39.24,
    "end": 40.58,
    "text": "获得2013年"
  },
  {
    "start": 40.58,
    "end": 41.72,
    "text": "美国国家图书奖"
  },
  {
    "start": 41.72,
    "end": 43.34,
    "text": "非虚构奖的下沉年代里"
  },
  {
    "start": 43.34,
    "end": 44.74,
    "text": "写到塔米的故事时"
  },
  {
    "start": 44.74,
    "end": 46.84,
    "text": "现实特别骨感"
  },
  {
    "start": 46.84,
    "end": 48.8,
    "text": "塔米后来甚至拿到了"
  },
  {
    "start": 48.8,
    "end": 49.52,
    "text": "副学士学位"
  },
  {
    "start": 49.52,
    "end": 50.32,
    "text": "但是"
  },
  {
    "start": 50.32,
    "end": 52.22,
    "text": "但是她没找到对口的工作"
  },
  {
    "start": 52.22,
    "end": 52.82,
    "text": "对"
  },
  {
    "start": 52.82,
    "end": 54.46,
    "text": "她当时所在的超市"
  },
  {
    "start": 54.46,
    "end": 57.24,
    "text": "根本就没有管理岗位的空缺给她"
  },
  {
    "start": 57.24,
    "end": 59.16,
    "text": "这非常值得关注的是"
  },
  {
    "start": 59.16,
    "end": 62.18,
    "text": "很多人以为好好读书这条路走下去"
  },
  {
    "start": 62.18,
    "end": 64.68,
    "text": "路的另一头一定有个位子在等你"
  },
  {
    "start": 64.68,
    "end": 65.66,
    "text": "结果并没有"
  },
  {
    "start": 65.66,
    "end": 66.92,
    "text": "直到四年后"
  },
  {
    "start": 66.92,
    "end": 68.26,
    "text": "也就是1988年"
  },
  {
    "start": 68.26,
    "end": 70.72,
    "text": "她在终于在沃伦的帕卡德电器"
  },
  {
    "start": 70.72,
    "end": 72.34,
    "text": "获得了一份工厂的聘用"
  },
  {
    "start": 72.34,
    "end": 73.88,
    "text": "这说明了什么呢"
  },
  {
    "start": 73.88,
    "end": 76.98,
    "text": "其实如果我们单看塔米个人的坚持"
  },
  {
    "start": 76.98,
    "end": 79.22,
    "text": "是根本无法算出那一笔笔福利"
  },
  {
    "start": 79.22,
    "end": 81.6,
    "text": "究竟使她毕业的概率增加了多少的"
  },
  {
    "start": 81.6,
    "end": 82.44,
    "text": "怎么说"
  },
  {
    "start": 82.44,
    "end": 84.2,
    "text": "因为在她的生活里"
  },
  {
    "start": 84.2,
    "end": 85.68,
    "text": "亲属提供的免费照护"
  },
  {
    "start": 85.68,
    "end": 87.4,
    "text": "很可能也是同时存在的"
  },
  {
    "start": 87.4,
    "end": 90.24,
    "text": "塔米的故事揭示了一个非常残酷的现实"
  },
  {
    "start": 90.24,
    "end": 92.4,
    "text": "就是普通人走通一条路"
  },
  {
    "start": 92.4,
    "end": 94.14,
    "text": "必须同时具备三个条件"
  },
  {
    "start": 94.14,
    "end": 95.2,
    "text": "哪三个"
  },
  {
    "start": 95.2,
    "end": 95.7,
    "text": "第一"
  },
  {
    "start": 95.7,
    "end": 97.08,
    "text": "照护有没有人接"
  },
  {
    "start": 97.08,
    "end": 97.9,
    "text": "第二"
  },
  {
    "start": 97.9,
    "end": 99.38,
    "text": "岗位有没有空缺"
  },
  {
    "start": 99.38,
    "end": 100.18,
    "text": "第三"
  },
  {
    "start": 100.18,
    "end": 101.64,
    "text": "现金跟不跟得上"
  },
  {
    "start": 101.64,
    "end": 102.7,
    "text": "而且啊"
  },
  {
    "start": 102.7,
    "end": 104.18,
    "text": "单个超市没有空缺"
  },
  {
    "start": 104.18,
    "end": 106.36,
    "text": "其实不等于全程都没有工作机会"
  },
  {
    "start": 106.36,
    "end": 107.68,
    "text": "怎么得理一理啊"
  },
  {
    "start": 107.68,
    "end": 109.18,
    "text": "这就像是呃"
  },
  {
    "start": 109.18,
    "end": 112.52,
    "text": "你手里攥着一张辛辛苦苦考来的文凭车票"
  },
  {
    "start": 112.52,
    "end": 113.08,
    "text": "哎"
  },
  {
    "start": 113.08,
    "end": 114.04,
    "text": "这个比喻很贴切"
  },
  {
    "start": 114.04,
    "end": 116.06,
    "text": "你拿着票走到月台上"
  },
  {
    "start": 116.06,
    "end": 117.0,
    "text": "结果发现"
  },
  {
    "start": 117.0,
    "end": 119.24,
    "text": "要么是根本没有这趟车"
  },
  {
    "start": 119.24,
    "end": 120.9,
    "text": "也就是没岗位空缺"
  },
  {
    "start": 120.9,
    "end": 121.84,
    "text": "要么就是"
  },
  {
    "start": 121.84,
    "end": 124.66,
    "text": "因为你手里还抱着需要照护的孩子"
  },
  {
    "start": 124.66,
    "end": 126.84,
    "text": "根本上不去这趟车"
  },
  {
    "start": 126.84,
    "end": 127.82,
    "text": "确实"
  },
  {
    "start": 127.82,
    "end": 129.24,
    "text": "这就打破了那种"
  },
  {
    "start": 129.24,
    "end": 131.26,
    "text": "拿到证就有出路的迷思"
  },
  {
    "start": 131.26,
    "end": 134.48,
    "text": "后来有很多研究专门看过这种培训项目"
  },
  {
    "start": 134.48,
    "end": 137.36,
    "text": "比如那个针对医疗行业培训项目"
  },
  {
    "start": 137.36,
    "end": 139.04,
    "text": "也就是HPOG的研究"
  },
  {
    "start": 139.04,
    "end": 140.36,
    "text": "医疗行业"
  },
  {
    "start": 140.36,
    "end": 142.02,
    "text": "听起来总该稳了吧"
  },
  {
    "start": 142.02,
    "end": 143.34,
    "text": "啊"
  },
  {
    "start": 143.34,
    "end": 144.64,
    "text": "初期看是这样的"
  },
  {
    "start": 144.64,
    "end": 148.8,
    "text": "尽管它确实增加了短期证书和医疗行业的就业"
  },
  {
    "start": 148.8,
    "end": 149.8,
    "text": "嗯哼"
  },
  {
    "start": 149.8,
    "end": 151.82,
    "text": "但是到了第六年的时候"
  },
  {
    "start": 151.82,
    "end": 155.4,
    "text": "研究却没有检出总体就业或者收入的增益"
  },
  {
    "start": 155.4,
    "end": 156.02,
    "text": "等等"
  },
  {
    "start": 156.02,
    "end": 157.22,
    "text": "也就是说"
  },
  {
    "start": 157.22,
    "end": 158.24,
    "text": "大家拿了证"
  },
  {
    "start": 158.24,
    "end": 159.8,
    "text": "也进了医疗行业"
  },
  {
    "start": 159.8,
    "end": 161.06,
    "text": "但六年过去"
  },
  {
    "start": 161.06,
    "end": 163.1,
    "text": "整体看并没有赚的更多"
  },
  {
    "start": 163.1,
    "end": 163.68,
    "text": "是的"
  },
  {
    "start": 163.68,
    "end": 165.26,
    "text": "数据就是这么冷酷"
  },
  {
    "start": 165.26,
    "end": 168.9,
    "text": "我们再看另一个叫Work Advance的随机评估结果"
  },
  {
    "start": 168.9,
    "end": 169.84,
    "text": "也是类似的"
  },
  {
    "start": 169.84,
    "end": 170.8,
    "text": "那个结果怎么样"
  },
  {
    "start": 170.8,
    "end": 172.92,
    "text": "虽然不同承办机构"
  },
  {
    "start": 172.92,
    "end": 175.96,
    "text": "曾经在部分年份帮助参与者增加了收入"
  },
  {
    "start": 175.96,
    "end": 177.8,
    "text": "但是到了十年的随访"
  },
  {
    "start": 177.8,
    "end": 179.66,
    "text": "也就是到2025年的时候"
  },
  {
    "start": 179.66,
    "end": 181.4,
    "text": "十年后还能保持吗"
  },
  {
    "start": 181.4,
    "end": 182.9,
    "text": "所有机构里"
  },
  {
    "start": 182.9,
    "end": 184.0,
    "text": "只有一家机构"
  },
  {
    "start": 184.0,
    "end": 186.46,
    "text": "在两项预定结果上仍然检出了收益"
  },
  {
    "start": 186.46,
    "end": 187.06,
    "text": "哇"
  },
  {
    "start": 187.06,
    "end": 188.0,
    "text": "只有一家"
  },
  {
    "start": 188.0,
    "end": 188.52,
    "text": "对"
  },
  {
    "start": 188.52,
    "end": 190.46,
    "text": "所以这里必须加个限定"
  },
  {
    "start": 190.46,
    "end": 192.56,
    "text": "这种培训的有效前提是"
  },
  {
    "start": 192.56,
    "end": 194.78,
    "text": "必须面向明确的岗位需求"
  },
  {
    "start": 194.78,
    "end": 196.92,
    "text": "还要把技能训练与求职"
  },
  {
    "start": 196.92,
    "end": 198.78,
    "text": "及后续之识结合起来"
  },
  {
    "start": 198.78,
    "end": 201.3,
    "text": "而且它也只对部分申请者有效"
  },
  {
    "start": 201.3,
    "end": 202.3,
    "text": "说实话"
  },
  {
    "start": 202.3,
    "end": 204.08,
    "text": "这听起来有点黑色幽默了"
  },
  {
    "start": 204.08,
    "end": 206.34,
    "text": "你看那些结业宣传册上"
  },
  {
    "start": 206.34,
    "end": 208.1,
    "text": "永远是满脸笑容的照片"
  },
  {
    "start": 208.1,
    "end": 208.74,
    "text": "没错"
  },
  {
    "start": 208.74,
    "end": 210.54,
    "text": "但照相机的框就那么大"
  },
  {
    "start": 210.54,
    "end": 212.46,
    "text": "很容易就把中途退学的人"
  },
  {
    "start": 212.46,
    "end": 214.14,
    "text": "直接捡到了画面外"
  },
  {
    "start": 214.14,
    "end": 215.82,
    "text": "看一项培训能不能做"
  },
  {
    "start": 215.82,
    "end": 217.42,
    "text": "绝对不能只看结业率"
  },
  {
    "start": 217.42,
    "end": 218.4,
    "text": "那还得看什么"
  },
  {
    "start": 218.4,
    "end": 220.12,
    "text": "必须得算一笔账"
  },
  {
    "start": 220.12,
    "end": 221.68,
    "text": "把那个学费"
  },
  {
    "start": 221.68,
    "end": 224.68,
    "text": "还有你因为上课少工作损失的收入"
  },
  {
    "start": 224.68,
    "end": 226.28,
    "text": "以及额外的招呼开支"
  },
  {
    "start": 226.28,
    "end": 227.16,
    "text": "全扣掉"
  },
  {
    "start": 227.16,
    "end": 229.28,
    "text": "你得看最后的净增益"
  },
  {
    "start": 229.28,
    "end": 230.02,
    "text": "到底升多少"
  },
  {
    "start": 230.02,
    "end": 232.5,
    "text": "这确实是一个非常现实的考量"
  },
  {
    "start": 232.5,
    "end": 234.78,
    "text": "那我们再回到塔米的时间线上"
  },
  {
    "start": 234.78,
    "end": 236.56,
    "text": "她1988年进了工厂"
  },
  {
    "start": 236.56,
    "end": 237.26,
    "text": "对吧"
  },
  {
    "start": 237.26,
    "end": 237.54,
    "text": "对"
  },
  {
    "start": 237.54,
    "end": 240.2,
    "text": "进工厂在当时算是个好消息"
  },
  {
    "start": 240.2,
    "end": 241.8,
    "text": "但到了1993年"
  },
  {
    "start": 241.8,
    "end": 243.46,
    "text": "帕卡德电器出了个新合同"
  },
  {
    "start": 243.46,
    "end": 245.5,
    "text": "这个新合同改变了什么"
  },
  {
    "start": 245.5,
    "end": 248.76,
    "text": "它不仅设置了较低待遇的新雇员类别"
  },
  {
    "start": 248.76,
    "end": 250.94,
    "text": "还鼓励实行12小时轮班制"
  },
  {
    "start": 250.94,
    "end": 253.48,
    "text": "这里真正有意思的地方来了"
  },
  {
    "start": 253.48,
    "end": 254.4,
    "text": "你会发现"
  },
  {
    "start": 254.4,
    "end": 257.92,
    "text": "时间表其实也是一种生活条件"
  },
  {
    "start": 257.92,
    "end": 259.32,
    "text": "这个视角很好"
  },
  {
    "start": 259.32,
    "end": 262.46,
    "text": "12小时轮班对单身汉可能就是累点"
  },
  {
    "start": 262.46,
    "end": 265.0,
    "text": "但对有家庭责任的母亲来说"
  },
  {
    "start": 265.0,
    "end": 266.16,
    "text": "简直就是灾难"
  },
  {
    "start": 266.16,
    "end": 266.7,
    "text": "是的"
  },
  {
    "start": 266.7,
    "end": 268.28,
    "text": "这是一个巨大的难题"
  },
  {
    "start": 268.28,
    "end": 271.72,
    "text": "如果我们把它和更大的图景联系起来看"
  },
  {
    "start": 271.72,
    "end": 272.92,
    "text": "工作规则"
  },
  {
    "start": 272.92,
    "end": 275.16,
    "text": "其实是可以拿来试着改的"
  },
  {
    "start": 275.16,
    "end": 276.0,
    "text": "怎么改"
  },
  {
    "start": 276.0,
    "end": 277.36,
    "text": "有成功的例子吗"
  },
  {
    "start": 277.36,
    "end": 279.78,
    "text": "比如在2018到2019年"
  },
  {
    "start": 279.78,
    "end": 282.7,
    "text": "美国零售门店进行过一项排班实验"
  },
  {
    "start": 282.7,
    "end": 284.76,
    "text": "他们试着稳定班表"
  },
  {
    "start": 284.76,
    "end": 287.26,
    "text": "增加员工的选择等组合措施"
  },
  {
    "start": 287.26,
    "end": 289.96,
    "text": "零售业的排班以前可是出了名的乱"
  },
  {
    "start": 289.96,
    "end": 291.54,
    "text": "那改了之后有效果吗"
  },
  {
    "start": 291.54,
    "end": 292.34,
    "text": "有的"
  },
  {
    "start": 292.34,
    "end": 295.78,
    "text": "这些措施确实改善了销售和劳动生产率"
  },
  {
    "start": 295.78,
    "end": 297.88,
    "text": "而且部分员工自报说"
  },
  {
    "start": 297.88,
    "end": 299.7,
    "text": "睡眠也有所改善"
  },
  {
    "start": 299.7,
    "end": 301.3,
    "text": "听起来很不错啊"
  },
  {
    "start": 301.3,
    "end": 302.04,
    "text": "销售上去了"
  },
  {
    "start": 302.04,
    "end": 303.44,
    "text": "员工还能睡个好觉"
  },
  {
    "start": 303.44,
    "end": 305.42,
    "text": "但有一个很大的反转"
  },
  {
    "start": 305.42,
    "end": 307.8,
    "text": "总体留任率并没有提高"
  },
  {
    "start": 307.8,
    "end": 310.88,
    "text": "而且多数员工的实际工时也没有增加"
  },
  {
    "start": 310.88,
    "end": 313.44,
    "text": "为什么大家还是不留下来呢"
  },
  {
    "start": 313.44,
    "end": 316.64,
    "text": "是因为排班稳了之后发现钱还是不够吗"
  },
  {
    "start": 316.64,
    "end": 319.42,
    "text": "这个研究并没有给出具体原因"
  },
  {
    "start": 319.42,
    "end": 321.46,
    "text": "这就让人不得不多想了"
  },
  {
    "start": 321.46,
    "end": 322.54,
    "text": "也许有的人"
  },
  {
    "start": 322.54,
    "end": 323.86,
    "text": "比如为了减少通勤"
  },
  {
    "start": 323.86,
    "end": 327.06,
    "text": "反而主动愿意集中去上那种12小时的长班"
  },
  {
    "start": 327.06,
    "end": 330.6,
    "text": "毕竟这取决于个人家里到底是怎么安排照护的"
  },
  {
    "start": 330.6,
    "end": 331.44,
    "text": "没错"
  },
  {
    "start": 331.44,
    "end": 334.52,
    "text": "所以在看这种所谓的效率改进时"
  },
  {
    "start": 334.52,
    "end": 335.68,
    "text": "除了看产出"
  },
  {
    "start": 335.68,
    "end": 337.54,
    "text": "你必须事先约定好"
  },
  {
    "start": 337.54,
    "end": 339.1,
    "text": "怎么记录收入和时间"
  },
  {
    "start": 339.1,
    "end": 340.54,
    "text": "你得盯着看"
  },
  {
    "start": 340.54,
    "end": 343.58,
    "text": "成本是不是悄悄落到了另一群人身上"
  },
  {
    "start": 343.58,
    "end": 344.78,
    "text": "你是指谁"
  },
  {
    "start": 344.78,
    "end": 347.64,
    "text": "比如那些为了成全别人稳定班表"
  },
  {
    "start": 347.64,
    "end": 350.38,
    "text": "而不得不临时改班去顶上的同事"
  },
  {
    "start": 350.38,
    "end": 354.64,
    "text": "确实 规则改变的代价往往是转移了"
  },
  {
    "start": 354.64,
    "end": 355.6,
    "text": "而不是消失了"
  },
  {
    "start": 355.6,
    "end": 357.88,
    "text": "聊到这儿我挺好奇的"
  },
  {
    "start": 357.88,
    "end": 361.54,
    "text": "是什么促使乔治帕克去写这些普通人的故事"
  },
  {
    "start": 361.54,
    "end": 363.12,
    "text": "这个作者背景挺有意思"
  },
  {
    "start": 363.12,
    "end": 366.1,
    "text": "帕克曾经在多哥的和平队服务过"
  },
  {
    "start": 366.1,
    "end": 368.64,
    "text": "从2003年到2018年"
  },
  {
    "start": 368.64,
    "end": 370.62,
    "text": "他还是纽约客的专职撰稿人"
  },
  {
    "start": 370.62,
    "end": 372.9,
    "text": "哇 那是很资深的记者了"
  },
  {
    "start": 372.9,
    "end": 376.32,
    "text": "对 他报道过伊拉克战争和塞拉利昂冲突"
  },
  {
    "start": 376.32,
    "end": 379.26,
    "text": "而且正是报道伊拉克重建的失败"
  },
  {
    "start": 379.26,
    "end": 381.22,
    "text": "促使他开始转变视角"
  },
  {
    "start": 381.22,
    "end": 383.48,
    "text": "从关注什么转变到什么"
  },
  {
    "start": 383.48,
    "end": 386.08,
    "text": "从追问个别领导人的失败"
  },
  {
    "start": 386.08,
    "end": 388.1,
    "text": "转而去追问制度失灵"
  },
  {
    "start": 388.1,
    "end": 391.06,
    "text": "2008年回国刚好遇上金融危机"
  },
  {
    "start": 391.06,
    "end": 393.38,
    "text": "他就把这个问题带回了美国"
  },
  {
    "start": 393.38,
    "end": 396.36,
    "text": "所以他把目光投向了美国的内部"
  },
  {
    "start": 396.36,
    "end": 396.72,
    "text": "是的"
  },
  {
    "start": 396.72,
    "end": 398.7,
    "text": "这就引出了一个重要的问题"
  },
  {
    "start": 398.7,
    "end": 401.72,
    "text": "为什么书里要把塔米这样的普通工人"
  },
  {
    "start": 401.72,
    "end": 404.26,
    "text": "跟那些富裕的名人并置在一起写"
  },
  {
    "start": 404.26,
    "end": 406.82,
    "text": "这种对比肯定非常强烈"
  },
  {
    "start": 406.82,
    "end": 411.04,
    "text": "帕克其实是借鉴了作家多斯·帕索斯的结构"
  },
  {
    "start": 411.04,
    "end": 414.38,
    "text": "他的目的就是为了考察制度与个人"
  },
  {
    "start": 414.38,
    "end": 416.8,
    "text": "精英与普通人之间的这种关系"
  },
  {
    "start": 416.8,
    "end": 419.02,
    "text": "为了写好这个他花了不少时间吧"
  },
  {
    "start": 419.02,
    "end": 422.22,
    "text": "当然 他愿意花几天甚至几周的时间"
  },
  {
    "start": 422.22,
    "end": 424.16,
    "text": "反复跟访这些受访者"
  },
  {
    "start": 424.16,
    "end": 425.86,
    "text": "去记录他们真实的困境"
  },
  {
    "start": 425.86,
    "end": 427.04,
    "text": "听到这儿"
  },
  {
    "start": 427.04,
    "end": 431.04,
    "text": "其实我想起书里塔米在2012年重访童年故居的那一幕"
  },
  {
    "start": 431.04,
    "end": 433.8,
    "text": "虽然当时确实有部分岗位回流了"
  },
  {
    "start": 433.8,
    "end": 436.3,
    "text": "但受益依然是很不均衡的"
  },
  {
    "start": 436.3,
    "end": 438.72,
    "text": "没错 复苏并没有汇集所有人"
  },
  {
    "start": 438.72,
    "end": 440.62,
    "text": "了解这些现实啊"
  },
  {
    "start": 440.62,
    "end": 442.32,
    "text": "有时候反倒能让我们松一口气"
  },
  {
    "start": 442.32,
    "end": 445.22,
    "text": "你会发现很多生活里的难处"
  },
  {
    "start": 445.22,
    "end": 446.86,
    "text": "并非全是个人的错"
  },
  {
    "start": 446.86,
    "end": 450.16,
    "text": "时代的结构性变化才是更深层的原因"
  },
  {
    "start": 450.16,
    "end": 454.44,
    "text": "如果你打算花钱上一个转行培训或证书课程"
  },
  {
    "start": 454.44,
    "end": 459.48,
    "text": "先向课程方所要包含中途退出者在内的分期收入数据"
  },
  {
    "start": 459.48,
    "end": 462.04,
    "text": "并向真实雇主核实证书认可度"
  },
  {
    "start": 462.04,
    "end": 464.8,
    "text": "这适合有明确求知目标的人"
  },
  {
    "start": 464.8,
    "end": 469.56,
    "text": "一旦数据凑不起或扣除学费和照顾成本后的净成本失控"
  },
  {
    "start": 469.56,
    "end": 470.7,
    "text": "就不适合继续"
  },
  {
    "start": 470.7,
    "end": 473.76,
    "text": "只建议做预算可承受的小不适学"
  },
  {
    "start": 473.76,
    "end": 477.0,
    "text": "如果你在工作团队中有一定自主权"
  },
  {
    "start": 477.0,
    "end": 478.56,
    "text": "向尝试改善排班"
  },
  {
    "start": 478.56,
    "end": 481.24,
    "text": "可以与雇主商定小范围试点"
  },
  {
    "start": 481.24,
    "end": 483.02,
    "text": "先记录临时改班"
  },
  {
    "start": 483.02,
    "end": 486.18,
    "text": "总工时净收入和个人可用时间"
  },
  {
    "start": 486.18,
    "end": 487.86,
    "text": "再比较铲除"
  },
  {
    "start": 487.86,
    "end": 489.72,
    "text": "这适合有协商空间的人"
  },
  {
    "start": 489.72,
    "end": 493.02,
    "text": "如果发现持续丢收入或压缩了他人的选择"
  },
  {
    "start": 493.02,
    "end": 494.64,
    "text": "就不适合盲目扩展"
  },
  {
    "start": 494.64,
    "end": 495.42,
    "text": "哎"
  }
]
