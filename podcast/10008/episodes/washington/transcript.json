[
  {
    "start": 0.0,
    "end": 1.48,
    "text": "想象这样一个画面啊"
  },
  {
    "start": 1.48,
    "end": 3.14,
    "text": "就是1979年"
  },
  {
    "start": 3.14,
    "end": 5.1,
    "text": "在亚拉巴马大学的校园里"
  },
  {
    "start": 5.1,
    "end": 6.96,
    "text": "有个满腔热血的年轻人"
  },
  {
    "start": 6.96,
    "end": 8.2,
    "text": "初次见到了拜登"
  },
  {
    "start": 8.2,
    "end": 10.4,
    "text": "被政治理想赶着了"
  },
  {
    "start": 10.4,
    "end": 11.42,
    "text": "对 深深赶着"
  },
  {
    "start": 11.42,
    "end": 13.18,
    "text": "紧接着他的人生轨迹啊"
  },
  {
    "start": 13.18,
    "end": 15.42,
    "text": "简直就像上井的罚条一样展开"
  },
  {
    "start": 15.42,
    "end": 16.68,
    "text": "1981年"
  },
  {
    "start": 16.68,
    "end": 18.62,
    "text": "他考进了芝加哥大学商学院"
  },
  {
    "start": 18.62,
    "end": 20.28,
    "text": "然后1983年夏天"
  },
  {
    "start": 20.28,
    "end": 21.94,
    "text": "就跻升纽约华尔街了"
  },
  {
    "start": 21.94,
    "end": 23.12,
    "text": "标准的精英路线"
  },
  {
    "start": 23.12,
    "end": 23.62,
    "text": "没错"
  },
  {
    "start": 23.62,
    "end": 25.3,
    "text": "但到了1987年"
  },
  {
    "start": 25.3,
    "end": 27.26,
    "text": "为了追随当年的政治信仰"
  },
  {
    "start": 27.26,
    "end": 28.78,
    "text": "他甚至自愿"
  },
  {
    "start": 28.78,
    "end": 31.4,
    "text": "去接受了一份薪水非常微薄的职位"
  },
  {
    "start": 31.4,
    "end": 33.54,
    "text": "正式加入拜登的精选团队"
  },
  {
    "start": 33.54,
    "end": 35.64,
    "text": "哇 如果故事停在这里"
  },
  {
    "start": 35.64,
    "end": 37.66,
    "text": "这绝对是一部好莱坞经典"
  },
  {
    "start": 37.66,
    "end": 39.08,
    "text": "政治励志片的完美开局"
  },
  {
    "start": 39.08,
    "end": 39.54,
    "text": "真的"
  },
  {
    "start": 39.54,
    "end": 40.98,
    "text": "但现实的齿轮"
  },
  {
    "start": 40.98,
    "end": 42.2,
    "text": "他继续转动了"
  },
  {
    "start": 42.2,
    "end": 45.04,
    "text": "而且剧本走向了完全另一个方向"
  },
  {
    "start": 45.04,
    "end": 46.72,
    "text": "到了1997年"
  },
  {
    "start": 46.72,
    "end": 49.04,
    "text": "这个叫杰夫康诺顿的年轻人"
  },
  {
    "start": 49.04,
    "end": 49.98,
    "text": "进入了华盛顿"
  },
  {
    "start": 49.98,
    "end": 50.56,
    "text": "可是"
  },
  {
    "start": 50.56,
    "end": 53.4,
    "text": "他做的不再是改变世界的梦"
  },
  {
    "start": 53.4,
    "end": 55.36,
    "text": "而是成了一名职业说客"
  },
  {
    "start": 55.36,
    "end": 56.88,
    "text": "彻底转型了"
  },
  {
    "start": 56.88,
    "end": 57.3,
    "text": "对"
  },
  {
    "start": 57.3,
    "end": 59.1,
    "text": "然后到了2001年"
  },
  {
    "start": 59.1,
    "end": 60.84,
    "text": "在华盛顿的筹款圈子里"
  },
  {
    "start": 60.84,
    "end": 63.54,
    "text": "他跟那个曾经的白宫顾问奎恩一起"
  },
  {
    "start": 63.54,
    "end": 65.18,
    "text": "开始为拜登组织筹款"
  },
  {
    "start": 65.18,
    "end": 67.82,
    "text": "大约在2003年年末吧"
  },
  {
    "start": 67.82,
    "end": 69.42,
    "text": "他们组建的游说公司"
  },
  {
    "start": 69.42,
    "end": 70.84,
    "text": "直接被WPP"
  },
  {
    "start": 70.84,
    "end": 73.68,
    "text": "就是那家庞大的跨国公关与广告巨头"
  },
  {
    "start": 73.68,
    "end": 74.52,
    "text": "给收购了"
  },
  {
    "start": 74.52,
    "end": 75.94,
    "text": "这跨度可真够大的"
  },
  {
    "start": 75.94,
    "end": 76.8,
    "text": "还不止呢"
  },
  {
    "start": 76.8,
    "end": 78.16,
    "text": "2007年"
  },
  {
    "start": 78.16,
    "end": 80.84,
    "text": "康诺顿在墨西哥出售了一套豪华公寓"
  },
  {
    "start": 80.84,
    "end": 81.98,
    "text": "狠狠赚了一笔"
  },
  {
    "start": 81.98,
    "end": 82.88,
    "text": "最后"
  },
  {
    "start": 82.88,
    "end": 86.0,
    "text": "时间来到大约2010年1月中旬的纽约"
  },
  {
    "start": 86.0,
    "end": 87.44,
    "text": "他跟康夫曼一起"
  },
  {
    "start": 87.44,
    "end": 90.08,
    "text": "坐在了前美联储主席沃尔克的面前"
  },
  {
    "start": 90.08,
    "end": 93.34,
    "text": "其实这条充满戏剧性反差的时间线"
  },
  {
    "start": 93.34,
    "end": 95.6,
    "text": "正是乔治帕克在下沉年代这本书里"
  },
  {
    "start": 95.6,
    "end": 96.74,
    "text": "真实记录的"
  },
  {
    "start": 96.74,
    "end": 98.72,
    "text": "杰弗康诺顿的人生轨迹"
  },
  {
    "start": 98.72,
    "end": 101.66,
    "text": "这本书还在2013年拿了美国国家图书奖"
  },
  {
    "start": 101.66,
    "end": 102.66,
    "text": "非虚构大奖"
  },
  {
    "start": 102.66,
    "end": 103.84,
    "text": "含金量很高"
  },
  {
    "start": 103.84,
    "end": 104.32,
    "text": "对的"
  },
  {
    "start": 104.32,
    "end": 105.14,
    "text": "你想想看"
  },
  {
    "start": 105.14,
    "end": 106.64,
    "text": "当你把你刚才说的"
  },
  {
    "start": 106.64,
    "end": 108.68,
    "text": "一个理想主义者的起点"
  },
  {
    "start": 108.68,
    "end": 110.88,
    "text": "和他最终在墨西哥套现房产"
  },
  {
    "start": 110.88,
    "end": 113.58,
    "text": "在华盛顿游刃有余运作资金的终点"
  },
  {
    "start": 113.58,
    "end": 114.3,
    "text": "放在一起时"
  },
  {
    "start": 114.3,
    "end": 116.0,
    "text": "这其实把我们推向了一个"
  },
  {
    "start": 116.0,
    "end": 117.86,
    "text": "极其尖锐的现实困境"
  },
  {
    "start": 117.86,
    "end": 118.5,
    "text": "也就是"
  },
  {
    "start": 118.5,
    "end": 120.5,
    "text": "当他真正踏入华盛顿"
  },
  {
    "start": 120.5,
    "end": 122.4,
    "text": "那个深不见底的核心圈时"
  },
  {
    "start": 122.4,
    "end": 124.96,
    "text": "他究竟面对的是一个怎样的系统"
  },
  {
    "start": 124.96,
    "end": 125.52,
    "text": "没错"
  },
  {
    "start": 125.52,
    "end": 128.7,
    "text": "一个曾经试图推动金融问责的人"
  },
  {
    "start": 128.7,
    "end": 130.02,
    "text": "到底遭遇了什么"
  },
  {
    "start": 130.02,
    "end": 132.12,
    "text": "这正是我在读这些材料"
  },
  {
    "start": 132.12,
    "end": 133.7,
    "text": "是觉得极度困惑的地方"
  },
  {
    "start": 133.7,
    "end": 135.5,
    "text": "我们直接切入那个"
  },
  {
    "start": 135.5,
    "end": 137.58,
    "text": "最能体现这种力量的场景吧"
  },
  {
    "start": 137.58,
    "end": 141.06,
    "text": "就是布朗康弗曼修正案的头跳之夜"
  },
  {
    "start": 141.06,
    "end": 143.84,
    "text": "那个晚上确实非常有代表性"
  },
  {
    "start": 143.84,
    "end": 145.02,
    "text": "太典型了"
  },
  {
    "start": 145.02,
    "end": 147.54,
    "text": "这项修正案的核心目标非常明确"
  },
  {
    "start": 147.54,
    "end": 149.22,
    "text": "就是推动金融问责"
  },
  {
    "start": 149.22,
    "end": 151.5,
    "text": "直接拆分那些大到不能倒的"
  },
  {
    "start": 151.5,
    "end": 152.68,
    "text": "华尔街巨头大银行"
  },
  {
    "start": 152.68,
    "end": 153.52,
    "text": "但是"
  },
  {
    "start": 153.52,
    "end": 155.5,
    "text": "你猜那天晚上面对的是什么"
  },
  {
    "start": 155.5,
    "end": 157.42,
    "text": "庞大的游说网络"
  },
  {
    "start": 157.42,
    "end": 157.96,
    "text": "对"
  },
  {
    "start": 157.96,
    "end": 161.1,
    "text": "整整三千名全副武装的说客"
  },
  {
    "start": 161.1,
    "end": 163.28,
    "text": "这就像是你带着一腔热血"
  },
  {
    "start": 163.28,
    "end": 166.7,
    "text": "试图去修理一台精密运转的巨型齿轮机器"
  },
  {
    "start": 166.7,
    "end": 168.28,
    "text": "结果一推门发现"
  },
  {
    "start": 168.28,
    "end": 170.9,
    "text": "那里边连呼吸的空气都早就被标好了架码"
  },
  {
    "start": 170.9,
    "end": 172.4,
    "text": "这个比喻很贴切"
  },
  {
    "start": 172.4,
    "end": 175.56,
    "text": "而且当晚发生的事更是戏剧性"
  },
  {
    "start": 175.56,
    "end": 176.8,
    "text": "简直绝了"
  },
  {
    "start": 176.8,
    "end": 179.16,
    "text": "参议院银行委员会主席多德"
  },
  {
    "start": 179.16,
    "end": 180.82,
    "text": "直接搞了个突击排期"
  },
  {
    "start": 180.82,
    "end": 183.02,
    "text": "就是突然把投票提上日程"
  },
  {
    "start": 183.02,
    "end": 184.52,
    "text": "打乱了所有人的阵脚"
  },
  {
    "start": 184.52,
    "end": 187.72,
    "text": "而且根据作者书里的描述参议员范士坦"
  },
  {
    "start": 187.72,
    "end": 190.1,
    "text": "他可是参议院最富有的成员之一"
  },
  {
    "start": 190.1,
    "end": 193.94,
    "text": "在现场不仅对拆分银行这个概念表现得极其惊讶"
  },
  {
    "start": 193.94,
    "end": 195.94,
    "text": "他甚至脱口而出问了个问题"
  },
  {
    "start": 195.94,
    "end": 196.36,
    "text": "对吧"
  },
  {
    "start": 196.36,
    "end": 196.76,
    "text": "对"
  },
  {
    "start": 196.76,
    "end": 197.68,
    "text": "他直接问"
  },
  {
    "start": 197.68,
    "end": 199.98,
    "text": "这个修正案是关于什么的"
  },
  {
    "start": 199.98,
    "end": 201.44,
    "text": "接着他还补了一句"
  },
  {
    "start": 201.44,
    "end": 203.58,
    "text": "这里仍然是美国不是吗"
  },
  {
    "start": 203.58,
    "end": 205.8,
    "text": "最终的结果大家可能猜到了"
  },
  {
    "start": 205.8,
    "end": 207.66,
    "text": "改革方遭遇了惨败"
  },
  {
    "start": 207.66,
    "end": 208.58,
    "text": "惨不忍睹"
  },
  {
    "start": 208.58,
    "end": 211.14,
    "text": "虽然考夫曼和康多顿在投票前"
  },
  {
    "start": 211.14,
    "end": 213.12,
    "text": "其实已经预感到形势不妙"
  },
  {
    "start": 213.12,
    "end": 216.08,
    "text": "但他们完全没料到会输得那么彻底"
  },
  {
    "start": 216.08,
    "end": 218.2,
    "text": "而且在这场溃败之后"
  },
  {
    "start": 218.2,
    "end": 221.44,
    "text": "出现了一个极具黑色幽默的场景"
  },
  {
    "start": 221.44,
    "end": 222.82,
    "text": "那个吃蛋糕的场景"
  },
  {
    "start": 222.82,
    "end": 223.46,
    "text": "对吧"
  },
  {
    "start": 223.46,
    "end": 225.52,
    "text": "我看到那里真的要破防了"
  },
  {
    "start": 225.52,
    "end": 226.02,
    "text": "是的"
  },
  {
    "start": 226.02,
    "end": 229.42,
    "text": "就在这场关乎华尔街命运的投票结束后"
  },
  {
    "start": 229.42,
    "end": 232.92,
    "text": "主导排期的多德和资深参议员谢尔比"
  },
  {
    "start": 232.92,
    "end": 234.88,
    "text": "依然能像什么都没发生过一样"
  },
  {
    "start": 234.88,
    "end": 236.08,
    "text": "在同一个房间里"
  },
  {
    "start": 236.08,
    "end": 238.78,
    "text": "气乐融融的分享着一块生日蛋糕"
  },
  {
    "start": 238.78,
    "end": 240.5,
    "text": "我必须得停一下"
  },
  {
    "start": 240.5,
    "end": 243.32,
    "text": "因为这就是作为普通人最受不了的地方"
  },
  {
    "start": 243.32,
    "end": 244.34,
    "text": "你看啊"
  },
  {
    "start": 244.34,
    "end": 246.84,
    "text": "外面是三千名随时待命的说客"
  },
  {
    "start": 246.84,
    "end": 248.94,
    "text": "里面是突击排期的手段"
  },
  {
    "start": 248.94,
    "end": 250.38,
    "text": "最富有的参议员"
  },
  {
    "start": 250.38,
    "end": 252.58,
    "text": "连条款是什么都没搞清楚就抵触"
  },
  {
    "start": 252.58,
    "end": 254.02,
    "text": "然后一转头"
  },
  {
    "start": 254.02,
    "end": 256.22,
    "text": "大家一起吃生日蛋糕"
  },
  {
    "start": 256.22,
    "end": 257.58,
    "text": "视觉冲击力太强了"
  },
  {
    "start": 257.58,
    "end": 259.2,
    "text": "任何人看到这一幕"
  },
  {
    "start": 259.2,
    "end": 260.56,
    "text": "大脑里的直觉警报"
  },
  {
    "start": 260.56,
    "end": 262.08,
    "text": "绝对会疯狂作响啊"
  },
  {
    "start": 262.08,
    "end": 265.1,
    "text": "这难道不是最典型的金钱福货系统吗"
  },
  {
    "start": 265.1,
    "end": 267.4,
    "text": "这不是赤裸裸的全权交易吗"
  },
  {
    "start": 267.4,
    "end": 268.92,
    "text": "钱买下了选票"
  },
  {
    "start": 268.92,
    "end": 270.5,
    "text": "逻辑非常简单"
  },
  {
    "start": 270.5,
    "end": 270.9,
    "text": "对啊"
  },
  {
    "start": 270.9,
    "end": 272.14,
    "text": "所以改革被扼撒了"
  },
  {
    "start": 272.14,
    "end": 273.34,
    "text": "就这么简单不是吗"
  },
  {
    "start": 273.34,
    "end": 275.66,
    "text": "我完全理解这种直觉反应"
  },
  {
    "start": 275.66,
    "end": 278.02,
    "text": "这几乎是我们所有人的本能"
  },
  {
    "start": 278.02,
    "end": 280.52,
    "text": "下沉年代把这层庞大的金钱网络"
  },
  {
    "start": 280.52,
    "end": 281.9,
    "text": "和各种巧合摆在面前"
  },
  {
    "start": 281.9,
    "end": 283.56,
    "text": "我们的大脑就会自动"
  },
  {
    "start": 283.56,
    "end": 285.24,
    "text": "把它们连成一条直线"
  },
  {
    "start": 285.24,
    "end": 286.5,
    "text": "难道事实不是这样吗"
  },
  {
    "start": 286.5,
    "end": 288.14,
    "text": "如果你真的想弄清楚"
  },
  {
    "start": 288.14,
    "end": 289.4,
    "text": "这台机器怎么运转"
  },
  {
    "start": 289.4,
    "end": 291.02,
    "text": "我们就必须强迫自己"
  },
  {
    "start": 291.02,
    "end": 293.2,
    "text": "把金钱网络和其他因素"
  },
  {
    "start": 293.2,
    "end": 295.84,
    "text": "拆分成两条完全独立的路径来检验"
  },
  {
    "start": 295.84,
    "end": 298.0,
    "text": "我们不能替议员问编造动机"
  },
  {
    "start": 298.0,
    "end": 300.66,
    "text": "只能看事实和研究到底发现了什么"
  },
  {
    "start": 300.66,
    "end": 301.58,
    "text": "好"
  },
  {
    "start": 301.58,
    "end": 303.36,
    "text": "那用事实来说话"
  },
  {
    "start": 303.36,
    "end": 303.96,
    "text": "首先"
  },
  {
    "start": 303.96,
    "end": 305.42,
    "text": "从程序上来说"
  },
  {
    "start": 305.42,
    "end": 307.68,
    "text": "作者在书里其实并没有主张说"
  },
  {
    "start": 307.68,
    "end": 311.02,
    "text": "突击排期直接改变了最终的否决结果"
  },
  {
    "start": 311.02,
    "end": 311.24,
    "text": "等等"
  },
  {
    "start": 311.24,
    "end": 314.16,
    "text": "没有任何证据表明排期改变了结果"
  },
  {
    "start": 314.16,
    "end": 315.82,
    "text": "没有实质证据表明"
  },
  {
    "start": 315.82,
    "end": 317.44,
    "text": "如果按常规排期"
  },
  {
    "start": 317.44,
    "end": 320.42,
    "text": "那些投反对票的人就会突然改变主意"
  },
  {
    "start": 320.42,
    "end": 322.26,
    "text": "那范斯坦参议员的反应怎么解释"
  },
  {
    "start": 322.26,
    "end": 324.3,
    "text": "书里可是特意强调了"
  },
  {
    "start": 324.3,
    "end": 326.62,
    "text": "她是参议院最富有的成员之一"
  },
  {
    "start": 326.62,
    "end": 328.74,
    "text": "她连条款是什么都不知道"
  },
  {
    "start": 328.74,
    "end": 330.24,
    "text": "作为一个读者"
  },
  {
    "start": 330.24,
    "end": 333.84,
    "text": "我肯定觉得她的票早就被背后的资本搞定了"
  },
  {
    "start": 333.84,
    "end": 335.92,
    "text": "书里确实提供了这些暗示"
  },
  {
    "start": 335.92,
    "end": 337.48,
    "text": "但仔细推敲的话"
  },
  {
    "start": 337.48,
    "end": 339.2,
    "text": "书中并没有定论说"
  },
  {
    "start": 339.2,
    "end": 341.32,
    "text": "她是因为钱而投反对票"
  },
  {
    "start": 341.32,
    "end": 344.54,
    "text": "所以我们不能仅仅因为她有钱"
  },
  {
    "start": 344.54,
    "end": 346.58,
    "text": "她惊讶就直接跳跃到"
  },
  {
    "start": 346.58,
    "end": 349.28,
    "text": "她收了黑钱投反对票的结论"
  },
  {
    "start": 349.34,
    "end": 352.18,
    "text": "如果要讨论金钱到底怎么起作用"
  },
  {
    "start": 352.18,
    "end": 353.7,
    "text": "得看确凿的研究"
  },
  {
    "start": 353.7,
    "end": 356.8,
    "text": "比如安索拉比赫尔等人的研究报告"
  },
  {
    "start": 356.8,
    "end": 358.6,
    "text": "他们专门研究了这个"
  },
  {
    "start": 358.6,
    "end": 359.08,
    "text": "是的"
  },
  {
    "start": 359.08,
    "end": 362.24,
    "text": "政治现金与投票行为的量化分析"
  },
  {
    "start": 362.24,
    "end": 364.36,
    "text": "他们的研究确实支持"
  },
  {
    "start": 364.36,
    "end": 366.52,
    "text": "政治关系可能有市场价值"
  },
  {
    "start": 366.52,
    "end": 368.68,
    "text": "但这通常影响的是什么"
  },
  {
    "start": 368.68,
    "end": 370.66,
    "text": "是准入和议程"
  },
  {
    "start": 370.66,
    "end": 372.36,
    "text": "准入和议程"
  },
  {
    "start": 372.36,
    "end": 374.08,
    "text": "你的意思是"
  },
  {
    "start": 374.08,
    "end": 375.8,
    "text": "这三千名说客花的钱"
  },
  {
    "start": 375.8,
    "end": 378.48,
    "text": "只是买到了一张VIP俱乐部的门票"
  },
  {
    "start": 378.48,
    "end": 379.6,
    "text": "非常贴切"
  },
  {
    "start": 379.6,
    "end": 381.6,
    "text": "钱能让你进那个房间"
  },
  {
    "start": 381.6,
    "end": 383.16,
    "text": "把诉求摆在桌面上"
  },
  {
    "start": 383.16,
    "end": 384.38,
    "text": "但这绝不意味着"
  },
  {
    "start": 384.38,
    "end": 387.38,
    "text": "老板听完就会把整栋楼的钥匙交给你"
  },
  {
    "start": 387.38,
    "end": 387.62,
    "text": "哇"
  },
  {
    "start": 387.62,
    "end": 389.56,
    "text": "所以并不能直接买到选票"
  },
  {
    "start": 389.56,
    "end": 390.24,
    "text": "没错"
  },
  {
    "start": 390.24,
    "end": 391.9,
    "text": "研究摘要显示"
  },
  {
    "start": 391.9,
    "end": 394.22,
    "text": "在控制了选民和议员效应后"
  },
  {
    "start": 394.22,
    "end": 396.76,
    "text": "政治现金与投票之间的直接关系"
  },
  {
    "start": 396.76,
    "end": 397.6,
    "text": "其实很小"
  },
  {
    "start": 397.6,
    "end": 400.62,
    "text": "那游税收入下降和投票之间呢"
  },
  {
    "start": 400.62,
    "end": 401.42,
    "text": "有关系吗"
  },
  {
    "start": 401.42,
    "end": 402.58,
    "text": "另一项研究表明"
  },
  {
    "start": 402.58,
    "end": 406.28,
    "text": "游税收入下降与投票之间只有弱关联"
  },
  {
    "start": 406.28,
    "end": 409.86,
    "text": "因为获得准入和按下表决器"
  },
  {
    "start": 409.86,
    "end": 411.84,
    "text": "衡量的是完全不同的环节"
  },
  {
    "start": 411.84,
    "end": 416.18,
    "text": "我们不能得出金钱必然决定一切的简单结论"
  },
  {
    "start": 416.18,
    "end": 416.9,
    "text": "当然"
  },
  {
    "start": 416.9,
    "end": 419.32,
    "text": "也不能说金钱完全没影响"
  },
  {
    "start": 419.32,
    "end": 420.08,
    "text": "对的"
  },
  {
    "start": 420.08,
    "end": 420.66,
    "text": "对"
  },
  {
    "start": 420.66,
    "end": 423.04,
    "text": "我现在有点转不过弯了"
  },
  {
    "start": 423.04,
    "end": 425.82,
    "text": "如果金钱不能直接买下选票"
  },
  {
    "start": 425.82,
    "end": 427.9,
    "text": "那怎么解释这场亏败"
  },
  {
    "start": 427.9,
    "end": 431.18,
    "text": "在外面塞满三千名说客的情况下"
  },
  {
    "start": 431.18,
    "end": 432.84,
    "text": "修正案依然失败了"
  },
  {
    "start": 432.84,
    "end": 437.16,
    "text": "是不是说明整个立法系统已经无可救药的烂透了"
  },
  {
    "start": 437.16,
    "end": 438.68,
    "text": "恰恰相反"
  },
  {
    "start": 438.68,
    "end": 440.96,
    "text": "如果你认为系统全面失灵"
  },
  {
    "start": 440.96,
    "end": 443.86,
    "text": "最强有力的反方证据就在眼前"
  },
  {
    "start": 443.86,
    "end": 447.14,
    "text": "改革其实取得了成果"
  },
  {
    "start": 447.14,
    "end": 447.68,
    "text": "比如呢"
  },
  {
    "start": 447.68,
    "end": 450.72,
    "text": "比如2010年的Dodd Flank法案"
  },
  {
    "start": 450.72,
    "end": 453.96,
    "text": "这个法案确确实实设立了CFPB"
  },
  {
    "start": 453.96,
    "end": 456.08,
    "text": "也就是消费者金融保护局"
  },
  {
    "start": 456.08,
    "end": 458.98,
    "text": "这是一个保护普通人的强力机构"
  },
  {
    "start": 458.98,
    "end": 459.6,
    "text": "没错"
  },
  {
    "start": 459.6,
    "end": 462.98,
    "text": "并且该法案也纳入了自营交易限制"
  },
  {
    "start": 462.98,
    "end": 465.88,
    "text": "如果系统真的毫无保留的被彻底俘获"
  },
  {
    "start": 465.88,
    "end": 468.82,
    "text": "这些动了华尔街巨大奶酪的实质性改革"
  },
  {
    "start": 468.82,
    "end": 470.3,
    "text": "是绝对不可能通过的"
  },
  {
    "start": 470.3,
    "end": 471.16,
    "text": "嗯"
  },
  {
    "start": 471.16,
    "end": 474.72,
    "text": "不能仅仅因为布朗考夫曼这一项未通过的修正案"
  },
  {
    "start": 474.72,
    "end": 476.36,
    "text": "就概括为全面的俘获"
  },
  {
    "start": 476.36,
    "end": 477.52,
    "text": "就是这个道理"
  },
  {
    "start": 477.52,
    "end": 478.2,
    "text": "好"
  },
  {
    "start": 478.2,
    "end": 481.78,
    "text": "那为什么偏偏是这个修正案遭到了这么惨烈的否决"
  },
  {
    "start": 481.78,
    "end": 484.26,
    "text": "是不是纯粹的党派利益在作祟"
  },
  {
    "start": 484.26,
    "end": 487.7,
    "text": "是不是投反对票的都是同一个党派的"
  },
  {
    "start": 487.7,
    "end": 490.78,
    "text": "这又是一个刻板影响陷阱了"
  },
  {
    "start": 490.78,
    "end": 493.74,
    "text": "事实数据会打破这个设想"
  },
  {
    "start": 493.74,
    "end": 496.46,
    "text": "参议院原夜和GoFutrack点名记录"
  },
  {
    "start": 496.46,
    "end": 497.82,
    "text": "清晰的确认了一件事"
  },
  {
    "start": 497.82,
    "end": 498.7,
    "text": "什么事"
  },
  {
    "start": 498.7,
    "end": 499.84,
    "text": "谢尔比"
  },
  {
    "start": 499.84,
    "end": 500.78,
    "text": "科伯恩"
  },
  {
    "start": 500.78,
    "end": 503.54,
    "text": "恩赛因等共和党人投了赞成票"
  },
  {
    "start": 503.54,
    "end": 504.22,
    "text": "等一下"
  },
  {
    "start": 504.22,
    "end": 506.36,
    "text": "共和党人投了赞成票"
  },
  {
    "start": 506.36,
    "end": 506.84,
    "text": "是的"
  },
  {
    "start": 506.84,
    "end": 508.12,
    "text": "表决记录显示"
  },
  {
    "start": 508.12,
    "end": 511.38,
    "text": "赞成和反对的两侧都有两党意愿"
  },
  {
    "start": 511.38,
    "end": 512.38,
    "text": "这也就是意味着"
  },
  {
    "start": 512.38,
    "end": 516.08,
    "text": "跨党派性同时存在于赞成与反对两侧"
  },
  {
    "start": 516.08,
    "end": 519.3,
    "text": "我们绝不能把党籍当作投票动机的代理"
  },
  {
    "start": 519.3,
    "end": 519.98,
    "text": "没错"
  },
  {
    "start": 519.98,
    "end": 522.72,
    "text": "既然党派和金钱都不能完全解释"
  },
  {
    "start": 522.72,
    "end": 524.06,
    "text": "那专业判断"
  },
  {
    "start": 524.06,
    "end": 525.02,
    "text": "意识程序"
  },
  {
    "start": 525.02,
    "end": 526.02,
    "text": "选民解释"
  },
  {
    "start": 526.02,
    "end": 527.12,
    "text": "还有同僚文化"
  },
  {
    "start": 527.12,
    "end": 528.86,
    "text": "都必须被纳入考量"
  },
  {
    "start": 528.86,
    "end": 529.5,
    "text": "对"
  },
  {
    "start": 529.5,
    "end": 530.62,
    "text": "同僚文化"
  },
  {
    "start": 530.62,
    "end": 533.7,
    "text": "就像那个刺眼的吃生日蛋糕的场景"
  },
  {
    "start": 533.7,
    "end": 533.98,
    "text": "是的"
  },
  {
    "start": 533.98,
    "end": 536.58,
    "text": "同僚文化确实有潜移默化的影响"
  },
  {
    "start": 536.58,
    "end": 539.36,
    "text": "但现有的材料不足以量化这些机制"
  },
  {
    "start": 539.36,
    "end": 540.94,
    "text": "对本次表决的净影响"
  },
  {
    "start": 540.94,
    "end": 544.1,
    "text": "我们也不能凭否决结果就断定个人违法"
  },
  {
    "start": 544.1,
    "end": 545.44,
    "text": "顺着这个思路"
  },
  {
    "start": 545.44,
    "end": 547.22,
    "text": "我发现了一个更有意思的问题"
  },
  {
    "start": 547.22,
    "end": 549.0,
    "text": "如果数据表明"
  },
  {
    "start": 549.0,
    "end": 550.94,
    "text": "金钱不直接买选票"
  },
  {
    "start": 550.94,
    "end": 553.0,
    "text": "党派也不是非黑即白"
  },
  {
    "start": 553.0,
    "end": 555.68,
    "text": "那为什么我们大众脑子里那种"
  },
  {
    "start": 555.68,
    "end": 557.94,
    "text": "全权交易的直觉会这么强烈"
  },
  {
    "start": 557.94,
    "end": 561.22,
    "text": "这启示和故事是怎么讲给我们听的"
  },
  {
    "start": 561.22,
    "end": 562.94,
    "text": "有巨大的关系"
  },
  {
    "start": 562.94,
    "end": 563.16,
    "text": "对"
  },
  {
    "start": 563.16,
    "end": 565.44,
    "text": "下成年代的作者乔治帕克"
  },
  {
    "start": 565.44,
    "end": 567.22,
    "text": "你必须了解一下他的背景"
  },
  {
    "start": 567.22,
    "end": 568.84,
    "text": "他毕业于耶鲁学院"
  },
  {
    "start": 568.84,
    "end": 571.26,
    "text": "参加过赴多哥服务的和平队"
  },
  {
    "start": 571.26,
    "end": 572.3,
    "text": "更重要的是"
  },
  {
    "start": 572.3,
    "end": 574.28,
    "text": "2003年到2018年"
  },
  {
    "start": 574.28,
    "end": 576.4,
    "text": "他是纽约客的专职撰稿人"
  },
  {
    "start": 576.4,
    "end": 579.1,
    "text": "他的报道领域涉及伊拉克战争"
  },
  {
    "start": 579.1,
    "end": 579.44,
    "text": "是的"
  },
  {
    "start": 579.44,
    "end": 581.8,
    "text": "他在2013年访谈中提到"
  },
  {
    "start": 581.8,
    "end": 583.48,
    "text": "报道伊拉克重建失败"
  },
  {
    "start": 583.48,
    "end": 585.18,
    "text": "促使他追问制度失灵"
  },
  {
    "start": 585.18,
    "end": 587.46,
    "text": "2008年回国遇上金融危机"
  },
  {
    "start": 587.46,
    "end": 589.26,
    "text": "又把这个问题带回了美国"
  },
  {
    "start": 589.26,
    "end": 590.78,
    "text": "为了回答这个问题"
  },
  {
    "start": 590.78,
    "end": 592.44,
    "text": "他用了很特殊的写法"
  },
  {
    "start": 592.44,
    "end": 593.7,
    "text": "拼贴式写作"
  },
  {
    "start": 593.7,
    "end": 594.32,
    "text": "没错"
  },
  {
    "start": 594.32,
    "end": 596.42,
    "text": "他参考了多斯·帕索斯的结构"
  },
  {
    "start": 596.42,
    "end": 598.1,
    "text": "把普通工人的挣扎"
  },
  {
    "start": 598.1,
    "end": 599.62,
    "text": "和像康诺顿这样的"
  },
  {
    "start": 599.62,
    "end": 600.78,
    "text": "富裕名人的小传"
  },
  {
    "start": 600.78,
    "end": 601.92,
    "text": "年代材料"
  },
  {
    "start": 601.92,
    "end": 603.32,
    "text": "并置拼贴在一起"
  },
  {
    "start": 603.32,
    "end": 605.0,
    "text": "把一个普通人的挣扎"
  },
  {
    "start": 605.0,
    "end": 606.34,
    "text": "和一个富豪的生活"
  },
  {
    "start": 606.34,
    "end": 607.64,
    "text": "放在同一页纸上"
  },
  {
    "start": 607.64,
    "end": 608.92,
    "text": "强烈的对比"
  },
  {
    "start": 608.92,
    "end": 609.62,
    "text": "对呀"
  },
  {
    "start": 609.62,
    "end": 610.98,
    "text": "读者的脑子就像是"
  },
  {
    "start": 610.98,
    "end": 612.94,
    "text": "自带了连线功能的侦探板"
  },
  {
    "start": 612.94,
    "end": 614.02,
    "text": "会自动给他们"
  },
  {
    "start": 614.02,
    "end": 615.48,
    "text": "画上巨大的因果箭头"
  },
  {
    "start": 615.48,
    "end": 617.12,
    "text": "觉得普通人这么惨"
  },
  {
    "start": 617.12,
    "end": 619.08,
    "text": "肯定是因为富豪这么贪"
  },
  {
    "start": 619.08,
    "end": 620.1,
    "text": "但这种写法"
  },
  {
    "start": 620.1,
    "end": 621.28,
    "text": "会不会有危险"
  },
  {
    "start": 621.28,
    "end": 622.96,
    "text": "你的比喻太准了"
  },
  {
    "start": 622.96,
    "end": 623.86,
    "text": "莱曼就提出了"
  },
  {
    "start": 623.86,
    "end": 624.9,
    "text": "实质的反对意见"
  },
  {
    "start": 624.9,
    "end": 625.62,
    "text": "他认为"
  },
  {
    "start": 625.62,
    "end": 626.68,
    "text": "这种形式"
  },
  {
    "start": 626.68,
    "end": 628.26,
    "text": "可能会把具体的金融"
  },
  {
    "start": 628.26,
    "end": 629.56,
    "text": "分配和政治责任"
  },
  {
    "start": 629.56,
    "end": 631.22,
    "text": "压扁成一个抽象的"
  },
  {
    "start": 631.22,
    "end": 632.64,
    "text": "解体或者下沉"
  },
  {
    "start": 632.64,
    "end": 634.52,
    "text": "把具体的责任压扁了"
  },
  {
    "start": 634.52,
    "end": 636.02,
    "text": "情感冲击力太强"
  },
  {
    "start": 636.02,
    "end": 637.62,
    "text": "理性链条就断了"
  },
  {
    "start": 637.62,
    "end": 638.04,
    "text": "没错"
  },
  {
    "start": 638.04,
    "end": 639.34,
    "text": "故事间的联想"
  },
  {
    "start": 639.34,
    "end": 640.96,
    "text": "可能掩盖了因果缺口"
  },
  {
    "start": 640.96,
    "end": 642.92,
    "text": "也会遗漏未被选中的人"
  },
  {
    "start": 642.92,
    "end": 644.14,
    "text": "但不可否认"
  },
  {
    "start": 644.14,
    "end": 645.14,
    "text": "这种写法"
  },
  {
    "start": 645.14,
    "end": 646.42,
    "text": "是一种值得保留的"
  },
  {
    "start": 646.42,
    "end": 647.3,
    "text": "问题生成方法"
  },
  {
    "start": 647.3,
    "end": 649.0,
    "text": "他把分开报道的事件"
  },
  {
    "start": 649.0,
    "end": 650.88,
    "text": "摆到了同一张问题地图上"
  },
  {
    "start": 650.88,
    "end": 651.58,
    "text": "确实"
  },
  {
    "start": 651.58,
    "end": 652.76,
    "text": "但我们只能用于"
  },
  {
    "start": 652.76,
    "end": 653.92,
    "text": "提出关系假说"
  },
  {
    "start": 653.92,
    "end": 655.46,
    "text": "不能承诺摆在一起"
  },
  {
    "start": 655.46,
    "end": 656.42,
    "text": "就能证明因果"
  },
  {
    "start": 656.42,
    "end": 657.12,
    "text": "也不能说"
  },
  {
    "start": 657.12,
    "end": 658.6,
    "text": "这代表全体美国人"
  },
  {
    "start": 658.6,
    "end": 660.72,
    "text": "面对这种复杂的信息轰炸"
  },
  {
    "start": 660.72,
    "end": 661.96,
    "text": "我们到底该怎么办"
  },
  {
    "start": 661.96,
    "end": 663.18,
    "text": "听众朋友们"
  },
  {
    "start": 663.18,
    "end": 664.0,
    "text": "这里有两条"
  },
  {
    "start": 664.0,
    "end": 665.98,
    "text": "明天就能用的具体策略"
  },
  {
    "start": 665.98,
    "end": 667.06,
    "text": "第一条策略"
  },
  {
    "start": 667.06,
    "end": 668.54,
    "text": "当你读政策"
  },
  {
    "start": 668.54,
    "end": 669.84,
    "text": "或改革叙事时"
  },
  {
    "start": 669.84,
    "end": 671.54,
    "text": "分别列出四个环节"
  },
  {
    "start": 671.54,
    "end": 672.48,
    "text": "接触"
  },
  {
    "start": 672.48,
    "end": 673.36,
    "text": "要求"
  },
  {
    "start": 673.36,
    "end": 674.38,
    "text": "条款变更"
  },
  {
    "start": 674.38,
    "end": 675.4,
    "text": "和实际执行"
  },
  {
    "start": 675.4,
    "end": 677.54,
    "text": "如果有缺失的环节"
  },
  {
    "start": 677.54,
    "end": 679.22,
    "text": "就保持待合状态"
  },
  {
    "start": 679.22,
    "end": 680.68,
    "text": "不要由人物关系"
  },
  {
    "start": 680.68,
    "end": 681.7,
    "text": "直接推定交易"
  },
  {
    "start": 681.7,
    "end": 683.58,
    "text": "这条策略的适用边界是"
  },
  {
    "start": 683.58,
    "end": 684.58,
    "text": "它适合拆解"
  },
  {
    "start": 684.58,
    "end": 685.76,
    "text": "复杂的政策信息"
  },
  {
    "start": 685.76,
    "end": 686.56,
    "text": "但要注意"
  },
  {
    "start": 686.56,
    "end": 687.86,
    "text": "专业判断"
  },
  {
    "start": 687.86,
    "end": 689.52,
    "text": "程序和选民偏好"
  },
  {
    "start": 689.52,
    "end": 690.84,
    "text": "也可能改变结果"
  },
  {
    "start": 690.84,
    "end": 691.84,
    "text": "关系存在"
  },
  {
    "start": 691.84,
    "end": 692.58,
    "text": "不证明"
  },
  {
    "start": 692.58,
    "end": 693.92,
    "text": "每次政策都被买下"
  },
  {
    "start": 693.92,
    "end": 694.4,
    "text": "没错"
  },
  {
    "start": 694.4,
    "end": 695.44,
    "text": "第二条策略"
  },
  {
    "start": 695.44,
    "end": 697.4,
    "text": "当几件事同时发生"
  },
  {
    "start": 697.4,
    "end": 698.2,
    "text": "别人说他们"
  },
  {
    "start": 698.2,
    "end": 699.22,
    "text": "有因果关系时"
  },
  {
    "start": 699.22,
    "end": 700.48,
    "text": "先把他们拆成"
  },
  {
    "start": 700.48,
    "end": 701.06,
    "text": "一句句"
  },
  {
    "start": 701.06,
    "end": 702.34,
    "text": "可以检验的联系"
  },
  {
    "start": 702.34,
    "end": 703.28,
    "text": "问自己"
  },
  {
    "start": 703.28,
    "end": 704.68,
    "text": "时间先后对不对"
  },
  {
    "start": 704.68,
    "end": 706.34,
    "text": "有没有说得通的机制"
  },
  {
    "start": 706.34,
    "end": 707.66,
    "text": "样本代表谁"
  },
  {
    "start": 707.66,
    "end": 708.84,
    "text": "有没有反例"
  },
  {
    "start": 708.84,
    "end": 709.78,
    "text": "或别的解释"
  },
  {
    "start": 709.78,
    "end": 710.92,
    "text": "证据不到位"
  },
  {
    "start": 710.92,
    "end": 711.86,
    "text": "就留作问题"
  },
  {
    "start": 711.86,
    "end": 713.84,
    "text": "这是一种方法论提炼"
  },
  {
    "start": 713.84,
    "end": 715.22,
    "text": "它的边界是"
  },
  {
    "start": 715.22,
    "end": 716.18,
    "text": "判不了的"
  },
  {
    "start": 716.18,
    "end": 716.98,
    "text": "就写判不了"
  },
  {
    "start": 716.98,
    "end": 717.98,
    "text": "不硬下结论"
  },
  {
    "start": 717.98,
    "end": 719.26,
    "text": "而且它不用于"
  },
  {
    "start": 719.26,
    "end": 720.3,
    "text": "判断市场走势"
  },
  {
    "start": 720.3,
    "end": 721.64,
    "text": "也不构成投资建议"
  }
]
