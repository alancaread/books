  {
    "start": 338.36,
    "end": 339.42,
    "text": "大家快看"
  },
  {
    "start": 339.42,
    "end": 341.48,
    "text": "单数楼层有神明保佑"
  },
  {
    "start": 341.48,
    "end": 342.94,
    "text": "有极强的支撑"
  },
  {
    "start": 342.94,
    "end": 344.08,
    "text": "结果下一次"
  },
  {
    "start": 344.08,
    "end": 346.04,
    "text": "那个人直接从八楼摔到了地上"
  },
  {
    "start": 346.04,
    "end": 347.42,
    "text": "旁观者依然不认错"
  },
  {
    "start": 347.42,
    "end": 348.62,
    "text": "还会打补丁说"
  },
  {
    "start": 348.62,
    "end": 349.1,
    "text": "你看"
