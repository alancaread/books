  {
    "start": 359.92,
    "end": 362.08,
    "text": "就是事前可检验信号"
  },
  {
    "start": 362.08,
    "end": 364.42,
    "text": "和事后任意解释的说法"
  },
  {
    "start": 364.42,
    "end": 365.24,
    "text": "没错"
  },
  {
    "start": 365.24,
    "end": 367.52,
    "text": "事后看图表总是无比完美的"
  },
  {
    "start": 367.52,
    "end": 368.94,
    "text": "如果线不能画"
