  {
    "start": 429.34,
    "end": 432.16,
    "text": "只能说明在那一刻有筹码交换"
  },
  {
    "start": 432.16,
    "end": 433.74,
    "text": "绝不代表后续有动力"
  },
  {
    "start": 433.74,
    "end": 434.98,
    "text": "更可怕的是"
  },
  {
    "start": 434.98,
    "end": 437.08,
    "text": "多头建了那么庞大的仓位"
  },
  {
    "start": 437.08,
    "end": 438.32,
    "text": "他们要想赚钱"
  },
  {
    "start": 438.32,
    "end": 439.48,
    "text": "最后必须得干嘛"
  },
  {
    "start": 439.48,
    "end": 441.24,
    "text": "得卖出平仓啊"
  },
  {
    "start": 441.24,
    "end": 441.5,
    "text": "对"
  },
  {
    "start": 441.5,
    "end": 443.72,
    "text": "所以当他们平仓的时候"
  },
  {
    "start": 443.72,
    "end": 444.84,
