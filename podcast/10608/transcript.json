  {
    "start": 415.14,
    "end": 416.82,
    "text": "开发商拿地成本高"
  },
  {
    "start": 416.82,
    "end": 418.88,
    "text": "不代表未来建好的房子"
  },
  {
    "start": 418.88,
    "end": 420.56,
